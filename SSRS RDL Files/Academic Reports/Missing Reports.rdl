<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>Integrated</rd:SecurityType><rd:DataSourceID>6e0f53eb-f373-4cf2-bc05-8ebc31e05bb9</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Subject"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intReportCycle"><Value>=Parameters!intReportCycle.Value</Value></QueryParameter><QueryParameter Name="@intReportTypes"><Value>=Parameters!intReportTypes.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @blnPrimaryTeacherOnly INT;
SET @blnPrimaryTeacherOnly =
(
    SELECT blnPrimaryTeacherOnly
    FROM tblReportsManagementCycle
    WHERE tblReportsManagementCycleID = @intReportCycle
);
     -- Total Form Reports grouped by Teacher, Year, Form and Subject -- 

     SELECT 1 AS SQLGroup, 
            MissingReports.txtTeacher AS [Teacher], 
            TblStaff.Surname, 
            TblStaff.Firstname, 
            TblStaff.Initials, 
            MissingReports.intNCYear AS [Year], 
            txtForm AS txtFormSet, 
            txtSubjectName, 
            txttimetablecode AS txtIDDrill, 
            0 AS Progress, 
            COUNT(1) AS [Total]
     FROM uf_Reports_MissingReport_Sets_Total_Forms(@intReportCycle, 1) AS MissingReports
          LEFT OUTER JOIN TblTeachingManagerSubjectForms ON MissingReports.TblTeachingManagerSubjectFormsID = TblTeachingManagerSubjectForms.TblTeachingManagerSubjectFormsID
          LEFT OUTER JOIN TblTeachingManagerSubjects ON TblTeachingManagerSubjectForms.intSubject = TblTeachingManagerSubjects.TblTeachingManagerSubjectsID
          INNER JOIN TblStaff ON MissingReports.txtTeacher = TblStaff.User_code
     WHERE 1 IN(@intReportTypes)
     AND ((iYear = 1
           OR iSubject = 1
           OR iForm = 1)
          AND NOT(iYear = -1
                  OR iForm = -1
                  OR iPupil = -1
                  OR iSubject = -1))
     GROUP BY MissingReports.txtTeacher, 
              TblStaff.Surname, 
              TblStaff.FirstName, 
              TblStaff.Initials, 
              MissingReports.intNCYear, 
              txtForm, 
              txtSubjectName, 
              txttimetablecode
     UNION ALL
     -- Entered/started Reports in reportstore
     SELECT 2 AS SQLGroup, 
            store.txtSubmitBy AS [Teacher], 
            TblStaff.Surname, 
            TblStaff.FirstName, 
            TblStaff.Initials, 
            pupils.intNCYear AS [Year], 
            pupils.txtForm AS txtFormSet, 
            TblTeachingManagerSubjects.txtSubjectName, 
            txttimetablecode AS txtIDDrill, 
            store.intProgress AS [Progress], 
            COUNT(TblReportsStoreId) AS [Count]
     FROM TblReportsStore AS store
          INNER JOIN TblTeachingManagerSubjectForms AS subjectforms ON store.txtSubID = subjectforms.txtForm
                                                                       AND store.txtSubmitBy = subjectforms.txtTeacher
                                                                       AND store.intID = subjectforms.intSubject
          INNER JOIN TblSchoolManagementForms AS forms ON subjectforms.txtForm = forms.txtForm
          INNER JOIN TblPupilManagementPupils AS pupils ON pupils.txtSchoolid = store.txtschoolid
          LEFT OUTER JOIN TblTeachingManagerSubjects ON store.intID = TblTeachingManagerSubjects.TblTeachingManagerSubjectsID
          INNER JOIN TblStaff ON store.txtSubmitBy = TblStaff.User_code
     WHERE store.intReportType = 1
           AND store.intReportCycle = @intReportCycle
           AND 1 IN(@intReportTypes)
          AND (([dbo].[uf_Reports_isInAllocation_Year](@intReportCycle, 1, forms.intNCYear) = 1)
     OR ([dbo].[uf_Reports_isInAllocation_Form](@intReportCycle, 1, subjectforms.txtForm) = 1)
     OR ([dbo].[uf_Reports_isInAllocation_Subject](@intReportCycle, 1, subjectforms.intSubject) = 1))
AND NOT(([dbo].[uf_Reports_isInAllocation_Year](@intReportCycle, 1, forms.intNCYear) = -1)
OR ([dbo].[uf_Reports_isInAllocation_Form](@intReportCycle, 1, subjectforms.txtForm) = -1)
OR ([dbo].[uf_Reports_isInAllocation_Pupil](@intReportCycle, 1, store.txtSchoolID) = -1)
OR ([dbo].[uf_Reports_isInAllocation_Subject](@intReportCycle, -1, subjectforms.intSubject) = -1))
     GROUP BY store.txtSubmitBy, 
              TblStaff.Surname, 
              TblStaff.FirstName, 
              TblStaff.Initials, 
              pupils.intNCYear, 
              pupils.txtForm, 
              TblTeachingManagerSubjects.txtSubjectName, 
              txttimetablecode, 
              store.intProgress
     UNION ALL

     -- Total Set Reports grouped by Teacher, Year, Form and Subject -- 
     SELECT 3 AS SQLGroup, 
            MissingReports.txtTeacher AS [Teacher], 
            TblStaff.Surname, 
            TblStaff.FirstName, 
            TblStaff.Initials, 
            MissingReports.intYear AS [Year], 
            tblTeachingManagerSets.txtName AS txtFormSet, 
            txtSubjectName, 
            txtSetCode AS txtIDDrill, 
            0 AS Progress, 
            COUNT(1) AS [Total]
     FROM uf_Reports_MissingReport_Sets_Total_Teachers(@intReportCycle, 1) AS MissingReports
          INNER JOIN tblTeachingManagerSetLists ON MissingReports.TblTeachingManagerSetListsID = tblTeachingManagerSetLists.TblTeachingManagerSetListsID
          LEFT OUTER JOIN TblTeachingManagerSets ON tblTeachingManagerSetLists.intSetID = TblTeachingManagerSets.TblTeachingManagerSetsID
          LEFT OUTER JOIN TblTeachingManagerSubjects ON TblTeachingManagerSets.intSubject = TblTeachingManagerSubjects.TblTeachingManagerSubjectsID
          INNER JOIN TblStaff ON MissingReports.txtTeacher = TblStaff.User_code
     WHERE 1 IN(@intReportTypes)
     AND ((iYear = 1
           OR iSubject = 1
           OR iForm = 1)
          AND NOT(iYear = -1
                  OR iForm = -1
                  OR iPupil = -1
                  OR iSubject = -1))
     GROUP BY MissingReports.txtTeacher, 
              TblStaff.Surname, 
              TblStaff.FirstName, 
              TblStaff.Initials, 
              MissingReports.intYear, 
              tblTeachingManagerSets.txtName, 
              txtSubjectName, 
              txtSetCode
     UNION ALL

     --entered/started set reports in reportsstore
     SELECT 4 AS SQLGroup, 
            store.txtSubmitBy AS [Teacher], 
            TblStaff.Surname, 
            TblStaff.FirstName, 
            TblStaff.Initials, 
            TblTeachingManagerSets.intYear AS [Year], 
            tblTeachingManagerSets.txtName AS txtFormSet, 
            txtSubjectName, 
            txtSetCode AS txtIDDrill, 
            store.intProgress AS [Progress], 
            COUNT(TblReportsStoreID) AS [Count]
     FROM TblReportsStore AS store
          INNER JOIN TblTeachingManagerSets ON store.txtSubID = TblTeachingManagerSets.txtSetCode
                                               AND store.txtSubmitBy = TblTeachingManagerSets.txtTeacher
          INNER JOIN TblPupilManagementPupils ON TblPupilManagementPupils.txtSchoolID = store.txtSchoolID
          INNER JOIN TblTeachingManagerSetLists ON TblTeachingManagerSets.TblTeachingManagerSetsID = TblTeachingManagerSetLists.intSetID
                                                   AND TblPupilManagementPupils.txtSchoolID = TblTeachingManagerSetLists.txtSchoolID
          LEFT OUTER JOIN TblTeachingManagerSubjects ON TblTeachingManagerSets.intSubject = TblTeachingManagerSubjects.TblTeachingManagerSubjectsID
          INNER JOIN TblStaff ON store.txtSubmitBy = TblStaff.User_code
     WHERE 1 IN(@intReportTypes)
          AND (store.intReportType = 1
               AND store.intReportCycle = @intReportCycle
               AND (([dbo].[uf_Reports_isInAllocation_Year](@intReportCycle, 1, TblTeachingManagerSets.intYear) = 1)
          OR ([dbo].[uf_Reports_isInAllocation_Subject](@intReportCycle, 1, TblTeachingManagerSets.intSubject) = 1)
     OR ([dbo].[uf_Reports_isInAllocation_Form](@intReportCycle, 1, TblPupilManagementPupils.txtForm) = 1))
AND NOT(([dbo].[uf_Reports_isInAllocation_Year](@intReportCycle, 1, TblTeachingManagerSets.intYear) = -1)
OR ([dbo].[uf_Reports_isInAllocation_Form](@intReportCycle, 1, TblPupilManagementPupils.txtForm) = -1)
OR ([dbo].[uf_Reports_isInAllocation_Pupil](@intReportCycle, 1, store.txtSchoolID) = -1)
OR ([dbo].[uf_Reports_isInAllocation_Subject](@intReportCycle, 1, TblTeachingManagerSets.intSubject) = -1)))
     GROUP BY store.txtSubmitBy, 
              TblStaff.Surname, 
              TblStaff.FirstName, 
              TblStaff.Initials, 
              TblTeachingManagerSets.intYear, 
              tblTeachingManagerSets.txtName, 
              txtSubjectName, 
              txtSetCode, 
              store.intProgress
-------------------------------------------------------------------------------------------------------------------
     UNION ALL

     -- Total Form Reports grouped by Teacher, Year, Form and Subject -- 

     SELECT 1 AS SQLGroup, 
            [TblSchoolManagementForms].txtAsstFormTutor AS [Teacher], 
            TblStaff.Surname, 
            TblStaff.Firstname, 
            TblStaff.Initials, 
            MissingReports.intNCYear AS [Year], 
            TblTeachingManagerSubjectForms.txtForm AS txtFormSet, 
            txtSubjectName, 
            txttimetablecode AS txtIDDrill, 
            0 AS Progress, 
            COUNT(1) AS [Total]
     FROM uf_Reports_MissingReport_Sets_Total_Forms(@intReportCycle, 1) AS MissingReports
          LEFT OUTER JOIN TblTeachingManagerSubjectForms ON MissingReports.TblTeachingManagerSubjectFormsID = TblTeachingManagerSubjectForms.TblTeachingManagerSubjectFormsID
          INNER JOIN [TblSchoolManagementForms] ON TblTeachingManagerSubjectForms.txtForm = [TblSchoolManagementForms].txtForm
                                                   AND [TblSchoolManagementForms].txtAsstFormTutor IS NOT NULL
          LEFT OUTER JOIN TblTeachingManagerSubjects ON TblTeachingManagerSubjectForms.intSubject = TblTeachingManagerSubjects.TblTeachingManagerSubjectsID
          INNER JOIN TblStaff ON [TblSchoolManagementForms].txtAsstFormTutor = TblStaff.User_code
     WHERE 1 IN(@intReportTypes)
     AND ((iYear = 1
           OR iSubject = 1
           OR iForm = 1)
          AND NOT(iYear = -1
                  OR iForm = -1
                  OR iPupil = -1
                  OR iSubject = -1))
     AND @blnPrimaryTeacherOnly = 0
     GROUP BY [TblSchoolManagementForms].txtAsstFormTutor, 
              TblStaff.Surname, 
              TblStaff.FirstName, 
              TblStaff.Initials, 
              MissingReports.intNCYear, 
              TblTeachingManagerSubjectForms.txtForm, 
              txtSubjectName, 
              txttimetablecode
     UNION ALL
     -- Entered/started Reports in reportstore
     SELECT 2 AS SQLGroup, 
            store.txtSubmitBy AS [Teacher], 
            TblStaff.Surname, 
            TblStaff.FirstName, 
            TblStaff.Initials, 
            pupils.intNCYear AS [Year], 
            pupils.txtForm AS txtFormSet, 
            TblTeachingManagerSubjects.txtSubjectName, 
            txttimetablecode AS txtIDDrill, 
            store.intProgress AS [Progress], 
            COUNT(TblReportsStoreId) AS [Count]
     FROM TblReportsStore AS store
          INNER JOIN TblTeachingManagerSubjectForms AS subjectforms ON store.txtSubID = subjectforms.txtForm
                                                                       AND store.intID = subjectforms.intSubject
          INNER JOIN TblSchoolManagementForms ON subjectforms.txtForm = TblSchoolManagementForms.txtForm
                                                 AND store.txtSubmitBy = TblSchoolManagementForms.txtAsstFormTutor
          INNER JOIN TblSchoolManagementForms AS forms ON subjectforms.txtForm = forms.txtForm
          INNER JOIN TblPupilManagementPupils AS pupils ON pupils.txtSchoolid = store.txtschoolid
          LEFT OUTER JOIN TblTeachingManagerSubjects ON store.intID = TblTeachingManagerSubjects.TblTeachingManagerSubjectsID
          INNER JOIN TblStaff ON store.txtSubmitBy = TblStaff.User_code
     WHERE store.intReportType = 1
           AND store.intReportCycle = @intReportCycle
           AND 1 IN(@intReportTypes)
          AND @blnPrimaryTeacherOnly = 0
          AND (([dbo].[uf_Reports_isInAllocation_Year](@intReportCycle, 1, forms.intNCYear) = 1)
     OR ([dbo].[uf_Reports_isInAllocation_Form](@intReportCycle, 1, subjectforms.txtForm) = 1)
     OR ([dbo].[uf_Reports_isInAllocation_Subject](@intReportCycle, 1, subjectforms.intSubject) = 1))
AND NOT(([dbo].[uf_Reports_isInAllocation_Year](@intReportCycle, 1, forms.intNCYear) = -1)
OR ([dbo].[uf_Reports_isInAllocation_Form](@intReportCycle, 1, subjectforms.txtForm) = -1)
OR ([dbo].[uf_Reports_isInAllocation_Pupil](@intReportCycle, 1, store.txtSchoolID) = -1)
OR ([dbo].[uf_Reports_isInAllocation_Subject](@intReportCycle, -1, subjectforms.intSubject) = -1))
     GROUP BY store.txtSubmitBy, 
              TblStaff.Surname, 
              TblStaff.FirstName, 
              TblStaff.Initials, 
              pupils.intNCYear, 
              pupils.txtForm, 
              TblTeachingManagerSubjects.txtSubjectName, 
              txttimetablecode, 
              store.intProgress
     UNION ALL
     SELECT 3 AS SQLGroup, 
            TblTeachingManagerSetAssociatedTeachers.txtTeacher AS [Teacher], 
            TblStaff.Surname, 
            TblStaff.FirstName, 
            TblStaff.Initials, 
            MissingReports.intYear AS [Year], 
            tblTeachingManagerSets.txtName AS txtFormSet, 
            txtSubjectName, 
            txtSetCode AS txtIDDrill, 
            0 AS Progress, 
            COUNT(1) AS [Total]
     FROM uf_Reports_MissingReport_Sets_Total_Teachers(@intReportCycle, 1) AS MissingReports
          LEFT OUTER JOIN tblTeachingManagerSetLists ON MissingReports.TblTeachingManagerSetListsID = tblTeachingManagerSetLists.TblTeachingManagerSetListsID
          LEFT OUTER JOIN TblTeachingManagerSets ON tblTeachingManagerSetLists.intSetID = TblTeachingManagerSets.TblTeachingManagerSetsID
          LEFT OUTER JOIN TblTeachingManagerSubjects ON TblTeachingManagerSets.intSubject = TblTeachingManagerSubjects.TblTeachingManagerSubjectsID
          INNER JOIN TblTeachingManagerSetAssociatedTeachers ON TblTeachingManagerSets.TblTeachingManagerSetsID = TblTeachingManagerSetAssociatedTeachers.intSetID
          INNER JOIN TblStaff ON TblTeachingManagerSetAssociatedTeachers.txtTeacher = TblStaff.User_code
     WHERE 1 IN(@intReportTypes)
     AND ((iYear = 1
           OR iSubject = 1
           OR iForm = 1)
          AND NOT(iYear = -1
                  OR iForm = -1
                  OR iPupil = -1
                  OR iSubject = -1))
     AND @blnPrimaryTeacherOnly = 0
     GROUP BY TblTeachingManagerSetAssociatedTeachers.txtTeacher, 
              TblStaff.Surname, 
              TblStaff.FirstName, 
              TblStaff.Initials, 
              MissingReports.intYear, 
              tblTeachingManagerSets.txtName, 
              txtSubjectName, 
              txtSetCode
     UNION ALL

     --entered/started set reports in reportsstore
     SELECT 4 AS SQLGroup, 
            store.txtSubmitBy AS [Teacher], 
            TblStaff.Surname, 
            TblStaff.FirstName, 
            TblStaff.Initials, 
            TblTeachingManagerSets.intYear AS [Year], 
            tblTeachingManagerSets.txtName AS txtFormSet, 
            txtSubjectName, 
            txtSetCode AS txtIDDrill, 
            store.intProgress AS [Progress], 
            COUNT(TblReportsStoreID) AS [Count]
     FROM TblReportsStore AS store
          INNER JOIN TblTeachingManagerSets ON store.txtSubID = TblTeachingManagerSets.txtSetCode
          INNER JOIN TblTeachingManagerSetAssociatedTeachers ON TblTeachingManagerSets.TblTeachingManagerSetsID = TblTeachingManagerSetAssociatedTeachers.intSetID
                                                                AND store.txtSubmitBy = TblTeachingManagerSetAssociatedTeachers.txtTeacher
          INNER JOIN TblPupilManagementPupils ON TblPupilManagementPupils.txtSchoolID = store.txtSchoolID
          INNER JOIN TblTeachingManagerSetLists ON TblTeachingManagerSets.TblTeachingManagerSetsID = TblTeachingManagerSetLists.intSetID
                                                   AND TblPupilManagementPupils.txtSchoolID = TblTeachingManagerSetLists.txtSchoolID
          LEFT OUTER JOIN TblTeachingManagerSubjects ON TblTeachingManagerSets.intSubject = TblTeachingManagerSubjects.TblTeachingManagerSubjectsID
          INNER JOIN TblStaff ON store.txtSubmitBy = TblStaff.User_code
     WHERE 1 IN(@intReportTypes)
          AND (store.intReportType = 1
               AND store.intReportCycle = @intReportCycle
               AND (([dbo].[uf_Reports_isInAllocation_Year](@intReportCycle, 1, TblTeachingManagerSets.intYear) = 1)
          OR ([dbo].[uf_Reports_isInAllocation_Subject](@intReportCycle, 1, TblTeachingManagerSets.intSubject) = 1)
     OR ([dbo].[uf_Reports_isInAllocation_Form](@intReportCycle, 1, TblPupilManagementPupils.txtForm) = 1))
AND NOT(([dbo].[uf_Reports_isInAllocation_Year](@intReportCycle, 1, TblTeachingManagerSets.intYear) = -1)
OR ([dbo].[uf_Reports_isInAllocation_Form](@intReportCycle, 1, TblPupilManagementPupils.txtForm) = -1)
OR ([dbo].[uf_Reports_isInAllocation_Pupil](@intReportCycle, 1, store.txtSchoolID) = -1)
OR ([dbo].[uf_Reports_isInAllocation_Subject](@intReportCycle, 1, TblTeachingManagerSets.intSubject) = -1)))
AND @blnPrimaryTeacherOnly = 0
     GROUP BY store.txtSubmitBy, 
              TblStaff.Surname, 
              TblStaff.FirstName, 
              TblStaff.Initials, 
              TblTeachingManagerSets.intYear, 
              tblTeachingManagerSets.txtName, 
              txtSubjectName, 
              txtSetCode, 
              store.intProgress</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="SQLGroup"><DataField>SQLGroup</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Teacher"><DataField>Teacher</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Initials"><DataField>Initials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Year"><DataField>Year</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtFormSet"><DataField>txtFormSet</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSubjectName"><DataField>txtSubjectName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtIDDrill"><DataField>txtIDDrill</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Progress"><DataField>Progress</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Total"><DataField>Total</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="ReportTypes"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>select 
intType,
ISNULL(txtReportName,txtName) AS txtReportTypeName
 from
TblReportsManagementReportTypes 

Where
intType in (1,6,7,8,9)</CommandText></Query><Fields><Field Name="intType"><DataField>intType</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtReportTypeName"><DataField>txtReportTypeName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Form"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intReportCycle"><Value>=Parameters!intReportCycle.Value</Value></QueryParameter><QueryParameter Name="@intReportTypes"><Value>=Parameters!intReportTypes.Value</Value></QueryParameter></QueryParameters><CommandText>Declare @blnPrimaryTeacherOnly int;
Set @blnPrimaryTeacherOnly = (select blnPrimaryTeacherOnly  from tblReportsManagementCycle where tblReportsManagementCycleID = @intReportCycle)



SELECT 
       ISNULL(
             (
                 SELECT COUNT(TblReportsStore.txtID) AS Expr1
                 FROM TblSchoolManagementForms
                      INNER JOIN TblReportsStore ON TblSchoolManagementForms.txtForm = TblReportsStore.txtID
                 WHERE((TblSchoolManagementForms.txtFormTutor = t.txtFormTutor)
                       OR (TblSchoolManagementForms.txtAsstFormTutor = t.txtFormTutor)
                       OR (TblSchoolManagementForms.txtAsstFormTutor2 = t.txtFormTutor))
                      AND (tblReportsStore.txtSubmitBy = t.txtFormTutor)
                      AND (TblSchoolManagementForms.intNCYear = t.intYear)
                      AND (tblReportsStore.intReportCycle = @intReportCycle)
                      AND (tblReportsStore.intProgress = 1)
                      AND (TblReportsStore.txtSchoolID NOT IN
                          (
                              SELECT DISTINCT txtAllValue
                              FROM TblReportsManagementCycleAllocations
                              WHERE intReportCycle = @intReportCycle
                                    AND intReportType = 6
                                    AND blnExclusion = 1
                                    AND txtAllValue &gt; ''
                          ))
                 GROUP BY TblSchoolManagementForms.intNCYear
             ), 0) AS intStatus1Count,
       ISNULL(
             (
                 SELECT COUNT(TblReportsStore.txtID) AS Expr1
                 FROM TblSchoolManagementForms
                      INNER JOIN TblReportsStore ON TblSchoolManagementForms.txtForm = TblReportsStore.txtID
                 WHERE((TblSchoolManagementForms.txtFormTutor = t.txtFormTutor)
                       OR (TblSchoolManagementForms.txtAsstFormTutor = t.txtFormTutor)
                       OR (TblSchoolManagementForms.txtAsstFormTutor2 = t.txtFormTutor))
                      AND (tblReportsStore.txtSubmitBy = t.txtFormTutor)
                      AND (TblSchoolManagementForms.intNCYear = t.intYear)
                      AND (tblReportsStore.intReportCycle = @intReportCycle)
                      AND (tblReportsStore.intProgress = 2)
                      AND (TblReportsStore.txtSchoolID NOT IN
                          (
                              SELECT DISTINCT txtAllValue
                              FROM TblReportsManagementCycleAllocations
                              WHERE intReportCycle = @intReportCycle
                                    AND intReportType = 6
                                    AND blnExclusion = 1
                                    AND txtAllValue &gt; ''
                          ))
                 GROUP BY TblSchoolManagementForms.intNCYear
             ), 0) AS intStatus2Count,
       ISNULL(
             (
                 SELECT COUNT(TblReportsStore.txtID) AS Expr1
                 FROM TblSchoolManagementForms
                      INNER JOIN TblReportsStore ON TblSchoolManagementForms.txtForm = TblReportsStore.txtID
                 WHERE((TblSchoolManagementForms.txtFormTutor = t.txtFormTutor)
                       OR (TblSchoolManagementForms.txtAsstFormTutor = t.txtFormTutor)
                       OR (TblSchoolManagementForms.txtAsstFormTutor2 = t.txtFormTutor))
                      AND (tblReportsStore.txtSubmitBy = t.txtFormTutor)
                      AND (TblSchoolManagementForms.intNCYear = t.intYear)
                      AND (tblReportsStore.intReportCycle = @intReportCycle)
                      AND (tblReportsStore.intProgress = 3)
                      AND (TblReportsStore.txtSchoolID NOT IN
                          (
                              SELECT DISTINCT txtAllValue
                              FROM TblReportsManagementCycleAllocations
                              WHERE intReportCycle = @intReportCycle
                                    AND intReportType = 6
                                    AND blnExclusion = 1
                                    AND txtAllValue &gt; ''
                          ))
                 GROUP BY TblSchoolManagementForms.intNCYear
             ), 0) AS intStatus3Count,
       ISNULL(
             (
                 SELECT COUNT(TblPupilManagementPupils.txtForm) AS Expr1
                 FROM TblPupilManagementPupils
                      INNER JOIN TblSchoolManagementForms ON TblPupilManagementPupils.txtForm = TblSchoolManagementForms.txtForm
                 WHERE(((TblSchoolManagementForms.txtFormTutor = t.txtFormTutor)
                        OR (TblSchoolManagementForms.txtAsstFormTutor = t.txtFormTutor)
                        OR (TblSchoolManagementForms.txtAsstFormTutor2 = t.txtFormTutor))
                       AND (TblSchoolManagementForms.intNCYear = t.intYear))
                      AND (TblPupilManagementPupils.intSystemStatus = 1)
				  AND TblPupilManagementPupils.txtForm = t.txtForm
                      AND (TblPupilManagementPupils.txtSchoolID NOT IN
                          (
                              SELECT DISTINCT txtAllValue
                              FROM TblReportsManagementCycleAllocations
                              WHERE intReportCycle = @intReportCycle
                                    AND intReportType = 6
                                    AND blnExclusion = 1
                                    AND txtAllValue &gt; ''
                          ))
                 GROUP BY TblSchoolManagementForms.txtForm
             ), 0) AS intTotalCount,
       *
FROM
(
    SELECT DISTINCT
           tForms.txtFormTutor,
           tForms.intNCYear AS intYear,
           tForms.txtForm,
           TblStaff.Surname,
           TblStaff.Firstname,
           TblStaff.Initials,
           TblStaff.User_Code
    FROM TblStaff
         INNER JOIN TblSchoolManagementForms AS tForms ON TblStaff.User_Code = tForms.txtFormTutor
         LEFT OUTER JOIN TblReportsStore ON tForms.txtForm = TblReportsStore.txtID
	    where 6 IN (@intReportTypes) 


    --CASE WHEN not blnPrimaryOnly then
    UNION
    SELECT DISTINCT
           tForms.txtAsstFormTutor,
           tForms.intNCYear AS intYear,
           tForms.txtForm,
           TblStaff.Surname,
           TblStaff.Firstname,
           TblStaff.Initials,
           TblStaff.User_Code
    FROM TblStaff
         INNER JOIN TblSchoolManagementForms AS tForms ON TblStaff.User_Code = tForms.txtAsstFormTutor
         LEFT OUTER JOIN TblReportsStore ON tForms.txtForm = TblReportsStore.txtID
	    where 6 IN (@intReportTypes) 
    UNION
    SELECT DISTINCT
           tForms.txtAsstFormTutor2,
           tForms.intNCYear AS intYear,
           tForms.txtForm,
           TblStaff.Surname,
           TblStaff.Firstname,
           TblStaff.Initials,
           TblStaff.User_Code
    FROM TblStaff
         INNER JOIN TblSchoolManagementForms AS tForms ON TblStaff.User_Code = tForms.txtAsstFormTutor2
         LEFT OUTER JOIN TblReportsStore ON tForms.txtForm = TblReportsStore.txtID  
	    where 6 IN (@intReportTypes) 
	    and @blnPrimaryTeacherOnly = 0
    --end 

) AS t  
                
              

--This is added to show only allocated years to the missing report 
WHERE
6 IN (@intReportTypes) AND (

((t.intYear IN
      (
          SELECT intAllValue
          FROM TblReportsManagementCycleAllocations
          WHERE(intReportCycle = @intReportCycle
                AND intReportType = 6
                AND blnExclusion = 0)
               AND NOT(intReportCycle = @intReportCycle
                       AND intReportType = 6
                       AND blnExclusion = 1)
      ))
      -- Also show form tutors where the specific form has been allocated
      OR (t.txtFormTutor IN
         (
             SELECT txtFormTutor
             FROM tblschoolmanagementforms f
                  JOIN TblReportsManagementCycleAllocations ON txtAllValue = f.txtForm
             WHERE(intReportCycle = @intReportCycle
                   AND intReportType = 6
                   AND t.intYear = f.intNCYear
                   AND blnExclusion = 0)
         ))
             OR (0 IN
                (
                    SELECT intAllType
                    FROM TblReportsManagementCycleAllocations
                    WHERE intReportCycle = @intReportCycle
                          AND intReportType = 6
                          AND intAllType = 0
                ))
			 )
      AND (t.intYear NOT IN
          (
              SELECT intAllValue
              FROM TblReportsManagementCycleAllocations
              WHERE(intReportCycle = @intReportCycle
                    AND intReportType = 6
                    AND blnExclusion = 1
                    AND isnumeric(intAllValue) =1)
          ))
      AND (t.txtFormTutor NOT IN
          (
              SELECT txtFormTutor
              FROM tblschoolmanagementforms f
                   JOIN TblReportsManagementCycleAllocations ON txtAllValue = f.txtForm
              WHERE(intReportCycle = @intReportCycle
                    AND intReportType = 6
                    AND t.intYear = f.intNCYear
                    AND blnExclusion = 1)
          ))

-- Also show form tutors where a specific pupil has been allocated

)
GROUP BY t.txtFormTutor,
         t.intYear,
         t.txtForm,
         t.Surname,
         t.Firstname,
         t.Initials,
         t.User_Code;</CommandText></Query><Fields><Field Name="intStatus1Count"><DataField>intStatus1Count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intStatus2Count"><DataField>intStatus2Count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intStatus3Count"><DataField>intStatus3Count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intTotalCount"><DataField>intTotalCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtFormTutor"><DataField>txtFormTutor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intYear"><DataField>intYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Initials"><DataField>Initials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="User_Code"><DataField>User_Code</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Pastoral"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intReportCycle"><Value>=Parameters!intReportCycle.Value</Value></QueryParameter><QueryParameter Name="@intReportTypes"><Value>=Parameters!intReportTypes.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT ISNULL((SELECT	COUNT(TblReportsStore.txtID) AS 'Total'
               FROM		TblReportsStore
               LEFT OUTER JOIN TblPupilManagementPupils ON TblPupilManagementPupils.txtSchoolID = TblReportsStore.txtSchoolID
               WHERE	tblReportsStore.txtSubmitBy = TotalsTable.txtTutor
						AND tblReportsStore.intReportType = 7
						AND tblReportsStore.intReportCycle = @intReportCycle
						AND tblReportsStore.intProgress = 1
						AND TblReportsStore.txtSchoolID NOT IN (SELECT	DISTINCT txtAllValue
																FROM	TblReportsManagementCycleAllocations
																WHERE	intReportCycle = @intReportCycle
																		AND intReportType = 7
																		AND blnExclusion = 1
																		AND txtAllValue &gt; '')
						AND TblPupilManagementPupils.txtForm NOT IN (SELECT	DISTINCT txtAllValue
																	 FROM	TblReportsManagementCycleAllocations
																	 WHERE	intReportCycle = @intReportCycle
																			AND intReportType = 7
																			AND blnExclusion = 1
																			AND txtAllValue &gt; '')
						AND TblPupilManagementPupils.intNCYear NOT IN (SELECT	DISTINCT ISNULL(intAllValue, 999)
																	   FROM		TblReportsManagementCycleAllocations
																	   WHERE	intReportCycle = @intReportCycle
																				AND intReportType = 7
																				AND blnExclusion = 1
																				AND txtAllValue &gt; '')), 0) AS 'intStatus1Count',
		ISNULL((SELECT	COUNT(TblReportsStore.txtID) AS 'Total'
				FROM	TblReportsStore
				LEFT OUTER JOIN TblPupilManagementPupils ON TblPupilManagementPupils.txtSchoolID = TblReportsStore.txtSchoolID
				WHERE	tblReportsStore.txtSubmitBy = TotalsTable.txtTutor
						AND tblReportsStore.intReportType = 7
						AND tblReportsStore.intReportCycle = @intReportCycle
						AND tblReportsStore.intProgress = 2
						AND TblReportsStore.txtSchoolID NOT IN (SELECT	DISTINCT txtAllValue
																FROM	TblReportsManagementCycleAllocations
																WHERE	intReportCycle = @intReportCycle
																		AND intReportType = 7
																		AND blnExclusion = 1
																		AND txtAllValue &gt; '')
						AND TblPupilManagementPupils.txtForm NOT IN (SELECT	DISTINCT txtAllValue
																	 FROM	TblReportsManagementCycleAllocations
																	 WHERE	intReportCycle = @intReportCycle
																			AND intReportType = 7
																			AND blnExclusion = 1
																			AND txtAllValue &gt; '')
						AND TblPupilManagementPupils.intNCYear NOT IN (SELECT	DISTINCT ISNULL(intAllValue, 999)
																	   FROM		TblReportsManagementCycleAllocations
																	   WHERE	intReportCycle = @intReportCycle
																				AND intReportType = 7
																				AND blnExclusion = 1
																				AND intAllValue &gt; '')), 0) AS 'intStatus2Count',
		ISNULL((SELECT	COUNT(TblReportsStore.txtID) AS 'Total'
                FROM	TblReportsStore
                LEFT OUTER JOIN TblPupilManagementPupils ON TblPupilManagementPupils.txtSchoolID = TblReportsStore.txtSchoolID
                WHERE	tblReportsStore.txtSubmitBy = TotalsTable.txtTutor
						AND tblReportsStore.intReportType = 7
						AND tblReportsStore.intReportCycle = @intReportCycle
						AND tblReportsStore.intProgress = 3
						AND TblReportsStore.txtSchoolID NOT IN (SELECT	DISTINCT txtAllValue
																FROM	TblReportsManagementCycleAllocations
																WHERE	intReportCycle = @intReportCycle
																		AND intReportType = 7
																		AND blnExclusion = 1
																		AND txtAllValue &gt; '')
						AND TblPupilManagementPupils.txtForm NOT IN (SELECT	DISTINCT txtAllValue
																	 FROM	TblReportsManagementCycleAllocations
																	 WHERE	intReportCycle = @intReportCycle
																			AND intReportType = 7
																			AND blnExclusion = 1
																			AND txtAllValue &gt; '')
						AND TblPupilManagementPupils.intNCYear NOT IN (SELECT	DISTINCT ISNULL(intAllValue, 999)
																	   FROM		TblReportsManagementCycleAllocations
																	   WHERE	intReportCycle = @intReportCycle
																				AND intReportType = 7
																				AND blnExclusion = 1
																				AND intAllValue &gt; '')), 0) AS 'intStatus3Count',
		ISNULL((SELECT	COUNT(TblPupilManagementPupils.txtTutor) AS 'Total'
				FROM	TblPupilManagementPupils
				WHERE	TblPupilManagementPupils.txtTutor = TotalsTable.txtTutor
						AND TblPupilManagementPupils.intSystemStatus = 1
						AND TblPupilManagementPupils.txtSchoolID NOT IN (SELECT	DISTINCT txtAllValue
																		 FROM	TblReportsManagementCycleAllocations
																		 WHERE	intReportCycle = @intReportCycle
																				AND intReportType = 7
																				AND blnExclusion = 1
																				AND txtAllValue &gt; '')
						AND TblPupilManagementPupils.txtForm NOT IN (SELECT	DISTINCT txtAllValue
																	 FROM	TblReportsManagementCycleAllocations
																	 WHERE	intReportCycle = @intReportCycle
																			AND intReportType = 7
																			AND blnExclusion = 1
																			AND txtAllValue &gt; '')
						AND TblPupilManagementPupils.intNCYear NOT IN (SELECT	DISTINCT ISNULL(intAllValue, 999)
																	   FROM		TblReportsManagementCycleAllocations
																	   WHERE	intReportCycle = @intReportCycle
																				AND intReportType = 7
																				AND blnExclusion = 1)
						AND (TblPupilManagementPupils.intNCYear IN (SELECT	DISTINCT intAllValue 
																   FROM		TblReportsManagementCycleAllocations 
																   WHERE	intReportCycle = @intReportCycle
																			AND intReportType = 7 
																			AND blnExclusion = 0 )
OR 0 IN (SELECT	intAllType
				 FROM	TblReportsManagementCycleAllocations
				 WHERE	intReportCycle = @intReportCycle
						AND intReportType = 7
						AND intAllType = 0)
						OR TblPupilManagementPupils.txtForm IN (SELECT	txtAllValue
								    FROM	TblReportsManagementCycleAllocations 
								    WHERE	intReportCycle = @intReportCycle
											AND intReportType = 7
											AND blnExclusion = 0
											AND intAllType = 3))

				GROUP BY TblPupilManagementPupils.txtTutor), 0) AS 'intTotalCount',
		TotalsTable.txtTutor,
		TotalsTable.Surname,
		TotalsTable.Firstname,
		TotalsTable.Initials
FROM (SELECT	DISTINCT
				TblStaff.User_Code AS 'txtTutor',
				TblStaff.Surname,
				TblStaff.Firstname,
				TblStaff.Initials
	  FROM	TblStaff
      INNER JOIN TblPupilManagementPupils ON TblStaff.User_Code = TblPupilManagementPupils.txtTutor) AS TotalsTable
	  --This is added to show only allocated years to the missing report 
WHERE	7 IN (@intReportTypes) 
		AND (TotalsTable.txtTutor IN (SELECT	txtTutor
									  FROM		TblPupilManagementPupils
									  JOIN		TblReportsManagementCycleAllocations ON TblPupilManagementPupils.intNCYear = intAllValue
									  WHERE		intReportCycle = @intReportCycle
												AND intReportType = 7
												AND blnExclusion = 0
												AND NOT(intReportCycle = @intReportCycle AND intReportType = 7 AND blnExclusion = 1))
		--Also show tutors where the specific form has been allocated
		OR TotalsTable.txtTutor IN (SELECT	txtTutor
								    FROM	TblPupilManagementPupils
								    JOIN	TblReportsManagementCycleAllocations ON TblPupilManagementPupils.txtForm = txtAllValue
								    WHERE	intReportCycle = @intReportCycle
											AND intReportType = 7
											AND blnExclusion = 0)
		--This is added to check if all pupils are allocated.
		OR 0 IN (SELECT	intAllType
				 FROM	TblReportsManagementCycleAllocations
				 WHERE	intReportCycle = @intReportCycle
						AND intReportType = 7
						AND intAllType = 0)
		AND TotalsTable.txtTutor NOT IN (SELECT	txtTutor
									     FROM	TblPupilManagementPupils
									     JOIN	TblReportsManagementCycleAllocations ON TblPupilManagementPupils.txtForm = txtAllValue
									     WHERE	intReportCycle = @intReportCycle
												AND intReportType = 7
												AND blnExclusion = 1)
		AND TotalsTable.txtTutor NOT IN (SELECT	txtTutor
									     FROM	TblPupilManagementPupils
									     JOIN	TblReportsManagementCycleAllocations ON TblPupilManagementPupils.intNCYear = intAllValue
									     WHERE	intReportCycle = @intReportCycle
												AND intReportType = 7
												AND blnExclusion = 1)
		)
GROUP BY txtTutor, Surname, Firstname, Initials;</CommandText></Query><Fields><Field Name="intStatus1Count"><DataField>intStatus1Count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intStatus2Count"><DataField>intStatus2Count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intStatus3Count"><DataField>intStatus3Count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intTotalCount"><DataField>intTotalCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtTutor"><DataField>txtTutor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Initials"><DataField>Initials</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="House"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intReportCycle"><Value>=Parameters!intReportCycle.Value</Value></QueryParameter><QueryParameter Name="@intReportTypes"><Value>=Parameters!intReportTypes.Value</Value></QueryParameter></QueryParameters><CommandText>Declare @blnPrimaryTeacherOnly int;
Set @blnPrimaryTeacherOnly = (select blnPrimaryTeacherOnly  from tblReportsManagementCycle where tblReportsManagementCycleID = @intReportCycle)

SELECT ISNULL(ISNULL(NULLIF(
                    (
                        SELECT COUNT(TblReportsStore.txtID) AS Expr1
                        FROM TblSchoolManagementHouses
                             INNER JOIN TblReportsStore ON TblSchoolManagementHouses.txtHouseName = TblReportsStore.txtID
                        WHERE((TblSchoolManagementHouses.txtHouseMaster = h.txtHouseMaster)
                              OR (TblSchoolManagementHouses.txtAssistantHouseMaster = h.txtHouseMaster))
                             AND (tblReportsStore.txtSubmitBy = h.txtHouseMaster)
                             AND (tblReportsStore.intReportCycle = @intReportCycle)
                             AND (tblReportsStore.intProgress = 1)
                             AND (TblSchoolManagementHouses.txtHouseType = 'Academic')
                             AND (TblReportsStore.txtSchoolID NOT IN
                                 (
                                     SELECT DISTINCT
                                            txtAllValue
                                     FROM TblReportsManagementCycleAllocations
                                     WHERE intReportCycle = @intReportCycle
                                           AND intReportType = 9
                                           AND blnExclusion = 1
                                           AND txtAllValue &gt; ''
                                 ))
                        GROUP BY TblSchoolManagementHouses.txtHouseName
                    ), 0),
             (
                 SELECT COUNT(TblReportsStore.txtID) AS Expr1
                 FROM TblSchoolManagementHouses
                      INNER JOIN TblReportsStore ON TblSchoolManagementHouses.txtHouseName = TblReportsStore.txtID
                 WHERE((TblSchoolManagementHouses.txtHouseMaster = h.txtHouseMaster)
                       OR (TblSchoolManagementHouses.txtAssistantHouseMaster = h.txtHouseMaster))
                      AND (tblReportsStore.txtSubmitBy = h.txtHouseMaster)
                      AND (tblReportsStore.intReportCycle = @intReportCycle)
                      AND (tblReportsStore.intProgress = 1)
                      AND (TblSchoolManagementHouses.txtHouseType = 'Boarding')
                      AND (TblReportsStore.txtSchoolID NOT IN
                          (
                              SELECT DISTINCT
                                     txtAllValue
                              FROM TblReportsManagementCycleAllocations
                              WHERE intReportCycle = @intReportCycle
                                    AND intReportType = 9
                                    AND blnExclusion = 1
                                    AND txtAllValue &gt; ''
                          ))
                 GROUP BY TblSchoolManagementHouses.txtHouseName
             )),0) AS intStatus1Count,
       ISNULL(ISNULL(NULLIF(
                    (
                        SELECT COUNT(TblReportsStore.txtID) AS Expr1
                        FROM TblSchoolManagementHouses
                             INNER JOIN TblReportsStore ON TblSchoolManagementHouses.txtHouseName = TblReportsStore.txtID
                        WHERE((TblSchoolManagementHouses.txtHouseMaster = h.txtHouseMaster)
                              OR (TblSchoolManagementHouses.txtAssistantHouseMaster = h.txtHouseMaster))
                             AND (tblReportsStore.txtSubmitBy = h.txtHouseMaster)
                             AND (tblReportsStore.intReportCycle = @intReportCycle)
                             AND (tblReportsStore.intProgress = 2)
                             AND (TblSchoolManagementHouses.txtHouseType = 'Academic')
                             AND (TblReportsStore.txtSchoolID NOT IN
                                 (
                                     SELECT DISTINCT
                                            txtAllValue
                                     FROM TblReportsManagementCycleAllocations
                                     WHERE intReportCycle = @intReportCycle
                                           AND intReportType = 9
                                           AND blnExclusion = 1
                                           AND txtAllValue &gt; ''
                                 ))
                        GROUP BY TblSchoolManagementHouses.txtHouseName
                    ), 0),
             (
                 SELECT COUNT(TblReportsStore.txtID) AS Expr1
                 FROM TblSchoolManagementHouses
                      INNER JOIN TblReportsStore ON TblSchoolManagementHouses.txtHouseName = TblReportsStore.txtID
                 WHERE((TblSchoolManagementHouses.txtHouseMaster = h.txtHouseMaster)
                       OR (TblSchoolManagementHouses.txtAssistantHouseMaster = h.txtHouseMaster))
                      AND (tblReportsStore.txtSubmitBy = h.txtHouseMaster)
                      AND (tblReportsStore.intReportCycle = @intReportCycle)
                      AND (tblReportsStore.intProgress = 2)
                      AND (TblSchoolManagementHouses.txtHouseType = 'Boarding')
                      AND (TblReportsStore.txtSchoolID NOT IN
                          (
                              SELECT DISTINCT
                                     txtAllValue
                              FROM TblReportsManagementCycleAllocations
                              WHERE intReportCycle = @intReportCycle
                                    AND intReportType = 9
                                    AND blnExclusion = 1
                                    AND txtAllValue &gt; ''
                          ))
                 GROUP BY TblSchoolManagementHouses.txtHouseName
             )),0) AS intStatus2Count,
       ISNULL(ISNULL(NULLIF(
                    (
                        SELECT COUNT(TblReportsStore.txtID) AS Expr1
                        FROM TblSchoolManagementHouses
                             INNER JOIN TblReportsStore ON TblSchoolManagementHouses.txtHouseName = TblReportsStore.txtID
                        WHERE((TblSchoolManagementHouses.txtHouseMaster = h.txtHouseMaster)
                              OR (TblSchoolManagementHouses.txtAssistantHouseMaster = h.txtHouseMaster))
                             AND (tblReportsStore.txtSubmitBy = h.txtHouseMaster)
                             AND (tblReportsStore.intReportCycle = @intReportCycle)
                             AND (tblReportsStore.intProgress = 3)
                             AND (TblSchoolManagementHouses.txtHouseType = 'Boarding')
                             AND (TblReportsStore.txtSchoolID NOT IN
                                 (
                                     SELECT DISTINCT
                                            txtAllValue
                                     FROM TblReportsManagementCycleAllocations
                                     WHERE intReportCycle = @intReportCycle
                                           AND intReportType = 9
                                           AND blnExclusion = 1
                                           AND txtAllValue &gt; ''
                                 ))
                        GROUP BY TblSchoolManagementHouses.txtHouseName
                    ), 0),
             (
                 SELECT COUNT(TblReportsStore.txtID) AS Expr1
                 FROM TblSchoolManagementHouses
                      INNER JOIN TblReportsStore ON TblSchoolManagementHouses.txtHouseName = TblReportsStore.txtID
                 WHERE((TblSchoolManagementHouses.txtHouseMaster = h.txtHouseMaster)
                       OR (TblSchoolManagementHouses.txtAssistantHouseMaster = h.txtHouseMaster))
                      AND (tblReportsStore.txtSubmitBy = h.txtHouseMaster)
                      AND (tblReportsStore.intReportCycle = @intReportCycle)
                      AND (tblReportsStore.intProgress = 3)
                      AND (TblSchoolManagementHouses.txtHouseType = 'Academic')
                      AND (TblReportsStore.txtSchoolID NOT IN
                          (
                              SELECT DISTINCT
                                     txtAllValue
                              FROM TblReportsManagementCycleAllocations
                              WHERE intReportCycle = @intReportCycle
                                    AND intReportType = 9
                                    AND blnExclusion = 1
                                    AND txtAllValue &gt; ''
                          ))
                 GROUP BY TblSchoolManagementHouses.txtHouseName
             )),0) AS intStatus3Count,
       ISNULL(ISNULL(NULLIF(
                    (
                        SELECT COUNT(TblPupilManagementPupils.txtSchoolID) AS Expr1
                        FROM TblPupilManagementPupils
                             INNER JOIN TblSchoolManagementHouses ON TblPupilManagementPupils.txtAcademicHouse = TblSchoolManagementHouses.txtHouseName
                        WHERE TblPupilManagementPupils.txtAcademicHouse = h.txtHouseName
                              AND (TblPupilManagementPupils.intSystemStatus = 1)
                              AND (TblPupilManagementPupils.txtSchoolID NOT IN
                                  (
                                      SELECT DISTINCT
                                             txtAllValue
                                      FROM TblReportsManagementCycleAllocations
                                      WHERE intReportCycle = @intReportCycle
                                            AND intReportType = 9
                                            AND blnExclusion = 1
                                            AND txtAllValue &gt; ''
                                  ))
                              AND (TblPupilManagementPupils.intNCYear NOT IN
                                  (
                                      SELECT DISTINCT
                                             intAllValue
                                      FROM TblReportsManagementCycleAllocations
                                      WHERE intReportCycle = @intReportCycle
                                            AND intReportType = 9
                                            AND blnExclusion = 1
                                            AND intAllValue &gt; ''
                                  ))
                              AND (TblPupilManagementPupils.txtAcademicHouse NOT IN
                                  (
                                      SELECT DISTINCT
                                             txtAllValue
                                      FROM TblReportsManagementCycleAllocations
                                      WHERE intReportCycle = @intReportCycle
                                            AND intReportType = 9
                                            AND blnExclusion = 1
                                            AND txtAllValue &gt; ''
                                  ))
                    ), 0),
             (
                 SELECT COUNT(TblPupilManagementPupils.txtSchoolID) AS Expr1
                 FROM TblPupilManagementPupils
                      INNER JOIN TblSchoolManagementHouses ON TblPupilManagementPupils.txtBoardingHouse = TblSchoolManagementHouses.txtHouseName
                 WHERE TblPupilManagementPupils.txtBoardingHouse = h.txtHouseName
                       AND (TblPupilManagementPupils.intSystemStatus = 1)
                       AND (TblPupilManagementPupils.txtSchoolID NOT IN
                           (
                               SELECT DISTINCT
                                      txtAllValue
                               FROM TblReportsManagementCycleAllocations
                               WHERE intReportCycle = @intReportCycle
                                     AND intReportType = 9
                                     AND blnExclusion = 1
                                     AND txtAllValue &gt; ''
                           ))
                       AND (TblPupilManagementPupils.intNCYear NOT IN
                           (
                               SELECT DISTINCT
                                      intAllValue
                               FROM TblReportsManagementCycleAllocations
                               WHERE intReportCycle = @intReportCycle
                                     AND intReportType = 9
                                     AND blnExclusion = 1
                                     AND intAllValue &gt; ''
                           ))
                       AND (TblPupilManagementPupils.txtBoardingHouse NOT IN
                           (
                               SELECT DISTINCT
                                      txtAllValue
                               FROM TblReportsManagementCycleAllocations
                               WHERE intReportCycle = 735
                                     AND intReportType = 9
                                     AND blnExclusion = 1
                                     AND txtAllValue &gt; ''
                           ))
             )),0) AS intTotalCount,
       *
FROM
(
    SELECT DISTINCT
           tHouse.txtHouseMaster,
           tHouse.txtHouseName,
		 tHouse.TblSchoolManagementHousesID,
		 tHouse.txtHouseType,
           TblStaff.Surname,
           TblStaff.Firstname,
           TblStaff.Initials,
           TblStaff.User_Code
    FROM TblStaff
         INNER JOIN TblSchoolManagementHouses AS tHouse ON TblStaff.User_Code = tHouse.txtHouseMaster
         LEFT OUTER JOIN TblReportsStore ON tHouse.txtHouseName = TblReportsStore.txtID



    --CASE WHEN not blnPrimaryOnly then
    UNION
    SELECT DISTINCT
           tHouse.txtAssistantHouseMaster,
           tHouse.txtHouseName,
		 tHouse.TblSchoolManagementHousesID,
		 tHouse.txtHouseType,
           TblStaff.Surname,
           TblStaff.Firstname,
           TblStaff.Initials,
           TblStaff.User_Code
    FROM TblStaff
         INNER JOIN TblSchoolManagementHouses AS tHouse ON TblStaff.User_Code = tHouse.txtAssistantHouseMaster
         LEFT OUTER JOIN TblReportsStore ON tHouse.txtHouseName = TblReportsStore.txtID

	    where @blnPrimaryTeacherOnly = 0
) AS h  
                
              

----This is added to show only allocated years to the missing report 
WHERE
9 IN (@intReportTypes) AND (
((h.txtHouseName IN
      (
          SELECT txtAcademicHouse
          FROM TblPupilManagementPupils
               JOIN TblReportsManagementCycleAllocations ON TblPupilManagementPupils.intNCYear = intAllValue
          WHERE intReportCycle = @intReportCycle
                AND intReportType = 9
                AND blnExclusion = 0
                AND NOT(intReportCycle = @intReportCycle
                        AND intReportType = 9
                        AND blnExclusion = 1)
          UNION
          SELECT txtBoardingHouse
          FROM TblPupilManagementPupils
               JOIN TblReportsManagementCycleAllocations ON TblPupilManagementPupils.intNCYear = intAllValue
          WHERE intReportCycle = @intReportCycle
                AND intReportType = 9
                AND blnExclusion = 0
                AND NOT(intReportCycle = @intReportCycle
                        AND intReportType = 9
                        AND blnExclusion = 1)
      ))
          --      -- Also show form tutors where the specific form has been allocated
          OR (h.txtHouseMaster IN
             (
                 SELECT txtHouseMaster
                 FROM TblSchoolManagementHouses
                      JOIN TblReportsManagementCycleAllocations ON TblSchoolManagementHousesID = TblReportsManagementCycleAllocations.intAllValue
                 WHERE(intReportCycle = @intReportCycle
                       AND intReportType = 9
                       AND blnExclusion = 0)
             ))

                 --	    ----This is added to check if all pupils are allocated.
                 OR ((0 IN
                     (
                         SELECT intAllType
                         FROM TblReportsManagementCycleAllocations
                         WHERE intReportCycle = @intReportCycle
                               AND intReportType = 9
                               AND intAllType = 0
                     ))
                     AND (h.txtHouseName NOT IN
                         (
                             SELECT txtAcademicHouse
                             FROM TblPupilManagementPupils
                                  JOIN TblReportsManagementCycleAllocations ON TblPupilManagementPupils.intNCYear = intAllValue
                             WHERE intReportCycle = @intReportCycle
                                   AND intReportType = 9
                                   AND blnExclusion = 1
                             UNION
                             SELECT txtBoardingHouse
                             FROM TblPupilManagementPupils
                                  JOIN TblReportsManagementCycleAllocations ON TblPupilManagementPupils.intNCYear = intAllValue
                             WHERE intReportCycle = @intReportCycle
                                   AND intReportType = 9
                                   AND blnExclusion = 1
                         ))
                             AND (h.txtHouseMaster NOT IN
                                 (
                                     SELECT txtHouseMaster
                                     FROM TblSchoolManagementHouses
                                          JOIN TblReportsManagementCycleAllocations ON TblSchoolManagementHousesID = TblReportsManagementCycleAllocations.intAllValue
                                     WHERE(intReportCycle = @intReportCycle
                                           AND intReportType = 9
                                           AND blnExclusion = 1)
                                 ))))
						   )
GROUP BY h.txtHouseMaster,
         h.txtHouseName,
	    h.TblSchoolManagementHousesID,
	    h.txtHouseType,
         h.Surname,
         h.Firstname,
         h.Initials,
         h.User_Code;</CommandText></Query><Fields><Field Name="intStatus1Count"><DataField>intStatus1Count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intStatus2Count"><DataField>intStatus2Count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intStatus3Count"><DataField>intStatus3Count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intTotalCount"><DataField>intTotalCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtHouseMaster"><DataField>txtHouseMaster</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtHouseName"><DataField>txtHouseName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblSchoolManagementHousesID"><DataField>TblSchoolManagementHousesID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtHouseType"><DataField>txtHouseType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Initials"><DataField>Initials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="User_Code"><DataField>User_Code</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Years"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intReportCycle"><Value>=Parameters!intReportCycle.Value</Value></QueryParameter><QueryParameter Name="@intReportTypes"><Value>=Parameters!intReportTypes.Value</Value></QueryParameter></QueryParameters><CommandText>Declare @blnPrimaryTeacherOnly int;
Set @blnPrimaryTeacherOnly = (select blnPrimaryTeacherOnly  from tblReportsManagementCycle where tblReportsManagementCycleID = @intReportCycle)


SELECT ISNULL(
             (
                 SELECT COUNT(TblReportsStore.intID) AS Expr1
                 FROM tblSchoolManagementYears
                      INNER JOIN TblReportsStore ON tblSchoolManagementYears.intNCYear = TblReportsStore.intID
                 WHERE((tblSchoolManagementYears.txtYearTutor = t.txtYearTutor)
                       OR (tblSchoolManagementYears.txtAsstYearTutor = t.txtYearTutor))
                      AND (tblSchoolManagementYears.intNCYear = t.intYear)
                      AND (tblReportsStore.intReportCycle = @intReportCycle)
                      AND (tblReportsStore.intProgress = 1)
                      AND (TblReportsStore.txtSchoolID NOT IN
                          (
                              SELECT txtAllValue
                              FROM TblReportsManagementCycleAllocations
                              WHERE intReportCycle = @intReportCycle
                                    AND intReportType = 8
                                    AND blnExclusion = 1
                                    AND txtAllValue &gt; ''
                          ))
                 GROUP BY tblSchoolManagementYears.intNCYear
             ), 0) AS intStatus1Count,
       ISNULL(
             (
                 SELECT COUNT(TblReportsStore.intID) AS Expr1
                 FROM tblSchoolManagementYears
                      INNER JOIN TblReportsStore ON tblSchoolManagementYears.intNCYear = TblReportsStore.intID
                 WHERE((tblSchoolManagementYears.txtYearTutor = t.txtYearTutor)
                       OR (tblSchoolManagementYears.txtAsstYearTutor = t.txtYearTutor))
                      AND (tblSchoolManagementYears.intNCYear = t.intYear)
                      AND (tblReportsStore.intReportCycle = @intReportCycle)
                      AND (tblReportsStore.intProgress = 2)
                      AND (TblReportsStore.txtSchoolID NOT IN
                          (
                              SELECT txtAllValue
                              FROM TblReportsManagementCycleAllocations
                              WHERE intReportCycle = @intReportCycle
                                    AND intReportType = 8
                                    AND blnExclusion = 1
                                    AND txtAllValue &gt; ''
                          ))
                 GROUP BY TblSchoolManagementYears.intNCYear
             ), 0) AS intStatus2Count,
       ISNULL(
             (
                 SELECT COUNT(TblReportsStore.intID) AS Expr1
                 FROM tblSchoolManagementYears
                      INNER JOIN TblReportsStore ON tblSchoolManagementYears.intNCYear = TblReportsStore.intID
                 WHERE((tblSchoolManagementYears.txtYearTutor = t.txtYearTutor)
                       OR (tblSchoolManagementYears.txtAsstYearTutor = t.txtYearTutor))
                      AND (tblSchoolManagementYears.intNCYear = t.intYear)
                      AND (tblReportsStore.intReportCycle = @intReportCycle)
                      AND (tblReportsStore.intProgress = 3)
                      AND (TblReportsStore.txtSchoolID NOT IN
                          (
                              SELECT txtAllValue
                              FROM TblReportsManagementCycleAllocations
                              WHERE intReportCycle = @intReportCycle
                                    AND intReportType = 8
                                    AND blnExclusion = 1
                                    AND txtAllValue &gt; ''
                          ))
                 GROUP BY TblSchoolManagementYears.intNCYear
             ), 0) AS intStatus3Count,
       ISNULL(
             (
                 SELECT COUNT(TblPupilManagementPupils.intNCYear) AS Expr1
                 FROM TblPupilManagementPupils
                      INNER JOIN tblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = tblSchoolManagementYears.intNCYear
                 WHERE((tblSchoolManagementYears.txtYearTutor = t.txtYearTutor)
                       OR (tblSchoolManagementYears.txtAsstYearTutor = t.txtYearTutor))
                      AND (tblSchoolManagementYears.intNCYear = t.intYear)
                      AND (TblPupilManagementPupils.intSystemStatus = 1)
                      AND (TblPupilManagementPupils.txtSchoolID NOT IN
                          (
                              SELECT txtAllValue
                              FROM TblReportsManagementCycleAllocations
                              WHERE intReportCycle = @intReportCycle
                                    AND intReportType = 8
                                    AND blnExclusion = 1
                                    AND txtAllValue &gt; ''
                          ))
                 GROUP BY TblPupilManagementPupils.intNCYear
             ), 0) AS intTotalCount,
       *
FROM
(
    SELECT DISTINCT
           tYears.txtYearTutor,
           tYears.intNCYear AS intYear,
           TblStaff.Surname,
           TblStaff.Firstname,
           TblStaff.Initials,
           TblStaff.User_Code,
           tYears.txtYearName
    FROM TblStaff
         INNER JOIN TblSchoolManagementYears AS tYears ON TblStaff.User_Code = tYears.txtYearTutor
         LEFT OUTER JOIN TblReportsStore ON tYears.intNCYear = TblReportsStore.intID


    --CASE WHEN not blnPrimaryOnly then
    UNION
    SELECT DISTINCT
           tYears.txtAsstYearTutor,
           tYears.intNCYear AS intYear,
           TblStaff.Surname,
           TblStaff.Firstname,
           TblStaff.Initials,
           TblStaff.User_Code,
           tYears.txtYearName
    FROM TblStaff
         INNER JOIN TblSchoolManagementYears AS tYears ON TblStaff.User_Code = tYears.txtAsstYearTutor
         LEFT OUTER JOIN TblReportsStore ON tYears.intNCYear = TblReportsStore.intID

	    where @blnPrimaryTeacherOnly = 0 

	        --end 

) AS t  
                
              
----This is added to show only allocated years to the missing report 
WHERE
8 IN (@intReportTypes) AND (
(((t.intYear IN
       (
           SELECT intAllValue
           FROM TblReportsManagementCycleAllocations
           WHERE(intReportCycle = @intReportCycle
                 AND intReportType = 8
                 AND blnExclusion = 0)
                AND NOT(intReportCycle = @intReportCycle
                        AND intReportType = 8
                        AND blnExclusion = 1)
       )))

      ----This is added to check if all pupils are allocated.
      OR (0 IN
         (
             SELECT intAllType
             FROM TblReportsManagementCycleAllocations
             WHERE intReportCycle = @intReportCycle
                   AND intReportType = 8
                   AND intAllType = 0
         )))
     AND (t.intYear NOT IN
         (
             SELECT intAllValue
             FROM TblReportsManagementCycleAllocations
             WHERE(intReportCycle = @intReportCycle
                   AND intReportType = 8
                   AND blnExclusion = 1
                   AND ISNUMERIC(intAllValue) = 1)
         ))
	    )
GROUP BY t.txtYearTutor,
         t.intYear,
         t.Surname,
         t.Firstname,
         t.Initials,
         t.User_Code,
         t.txtYearName;</CommandText></Query><Fields><Field Name="intStatus1Count"><DataField>intStatus1Count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intStatus2Count"><DataField>intStatus2Count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intStatus3Count"><DataField>intStatus3Count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intTotalCount"><DataField>intTotalCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearTutor"><DataField>txtYearTutor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intYear"><DataField>intYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Initials"><DataField>Initials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="User_Code"><DataField>User_Code</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Cycles"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT *, 
       CAST(txtReportName AS NVARCHAR) + ' (' + CAST(intReportYear AS NVARCHAR) + '/' + RIGHT(CAST((intReportYear + 1) AS NVARCHAR), 2) + ')' AS txtCycleAndYear
FROM TblReportsManagementCycle
WHERE CASE
          WHEN DATEPART(MONTH, GETDATE()) &gt; 8
          THEN DATEPART(year, GETDATE())
          ELSE DATEPART(year, GETDATE()) - 1
      END = intReportYear
ORDER BY txtPrintReports DESC;</CommandText></Query><Fields><Field Name="TblReportsManagementCycleID"><DataField>TblReportsManagementCycleID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intType"><DataField>intType</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtReportName"><DataField>txtReportName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTrackingName"><DataField>txtTrackingName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtShortName"><DataField>txtShortName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intPreviousCycle"><DataField>intPreviousCycle</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtStartReports"><DataField>txtStartReports</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtFinishReports"><DataField>txtFinishReports</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtPrintReports"><DataField>txtPrintReports</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intReportYear"><DataField>intReportYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intReportTerm"><DataField>intReportTerm</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intReportsProfile"><DataField>intReportsProfile</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intPrintingProfile"><DataField>intPrintingProfile</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intActive"><DataField>intActive</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="blnPrimaryTeacherOnly"><DataField>blnPrimaryTeacherOnly</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="intiSAMS"><DataField>intiSAMS</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intSP"><DataField>intSP</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intPP"><DataField>intPP</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="blnDownload"><DataField>blnDownload</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="blnUpload"><DataField>blnUpload</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtSubmitBy"><DataField>txtSubmitBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSubmitDateTime"><DataField>txtSubmitDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtCycleAndYear"><DataField>txtCycleAndYear</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="CurrentYear"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>select top 1 * from TblSchoolManagementTermDates
where GETDATE() &gt; txtStartDate  
order by txtStartDate desc</CommandText></Query><Fields><Field Name="TblSchoolManagementTermDatesID"><DataField>TblSchoolManagementTermDatesID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intTerm"><DataField>intTerm</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intSchoolYear"><DataField>intSchoolYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtStartDate"><DataField>txtStartDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtFinishDate"><DataField>txtFinishDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="TblSchoolManagementAcademicYearID"><DataField>TblSchoolManagementAcademicYearID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSubmitDateTime"><DataField>txtSubmitDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtSubmitBy"><DataField>txtSubmitBy</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="CurrentCycleDetails"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intReportCycle"><Value>=Parameters!intReportCycle.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 
*,
cast(txtReportName as nvarchar) + ' (' + cast(intReportYear as nvarchar) +  '/' + right(cast((intReportYear + 1) AS nvarchar),2) + ')' AS txtCycleAndYear
 FROM TblReportsManagementCycle

where TblReportsManagementCycleID = @intReportCycle</CommandText></Query><Fields><Field Name="TblReportsManagementCycleID"><DataField>TblReportsManagementCycleID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intType"><DataField>intType</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtReportName"><DataField>txtReportName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTrackingName"><DataField>txtTrackingName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtShortName"><DataField>txtShortName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intPreviousCycle"><DataField>intPreviousCycle</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtStartReports"><DataField>txtStartReports</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtFinishReports"><DataField>txtFinishReports</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtPrintReports"><DataField>txtPrintReports</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intReportYear"><DataField>intReportYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intReportTerm"><DataField>intReportTerm</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intReportsProfile"><DataField>intReportsProfile</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intPrintingProfile"><DataField>intPrintingProfile</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intActive"><DataField>intActive</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="blnPrimaryTeacherOnly"><DataField>blnPrimaryTeacherOnly</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="intiSAMS"><DataField>intiSAMS</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intSP"><DataField>intSP</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intPP"><DataField>intPP</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="blnDownload"><DataField>blnDownload</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="blnUpload"><DataField>blnUpload</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtSubmitBy"><DataField>txtSubmitBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSubmitDateTime"><DataField>txtSubmitDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtCycleAndYear"><DataField>txtCycleAndYear</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SetColouring"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>WITH SetAdditions
     AS (SELECT txtCode, 
                COUNT(DISTINCT txtSchoolID) AS intAdditionCount
         FROM TblTeachingManagerSetChangesAddition
         GROUP BY TblTeachingManagerSetChangesAddition.txtCode
         UNION
         SELECT txtCode AS txtCode, 
                COUNT(DISTINCT txtSchoolID) AS intAdditionCount
         FROM TblTeachingManagerSetChangesMoved
         GROUP BY TblTeachingManagerSetChangesMoved.txtCode),
     SetRemoval
     AS (SELECT txtCode, 
                COUNT(DISTINCT txtSchoolID) AS intRemovalCount
         FROM TblTeachingManagerSetChangesDeleted
         GROUP BY TblTeachingManagerSetChangesDeleted.txtCode
         UNION
         SELECT txtOldCode AS txtCode, 
                COUNT(DISTINCT txtSchoolID) AS intAdditionCount
         FROM TblTeachingManagerSetChangesMoved
         GROUP BY TblTeachingManagerSetChangesMoved.txtOldCode)
     SELECT CASE
                WHEN SetAdditions.txtCode IS NULL
                THEN SetRemoval.txtCode
                ELSE SetAdditions.txtCode
            END AS txtSetCode, 
            SUM(intAdditionCount) AS intAdditionCount, 
            SUM(intRemovalCount) AS intRemovalCount
     FROM SetAdditions
          LEFT OUTER JOIN SetRemoval ON SetAdditions.txtCode = SetRemoval.txtCode
		  GROUP BY CASE
                WHEN SetAdditions.txtCode IS NULL
                THEN SetRemoval.txtCode
                ELSE SetAdditions.txtCode END</CommandText></Query><Fields><Field Name="txtSetCode"><DataField>txtSetCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intAdditionCount"><DataField>intAdditionCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intRemovalCount"><DataField>intRemovalCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Rectangle Name="Rectangle7"><ReportItems><Tablix Name="Tablix2"><TablixBody><TablixColumns><TablixColumn><Width>20cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>2.9cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle9"><ReportItems><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Label>SubjectForms</Label><Value>=lookup(1,Fields!intType.Value, Fields!txtReportTypeName.Value, "ReportTypes")</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><TextDecoration>Underline</TextDecoration><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Top>0.5cm</Top><Left>0.00002cm</Left><Height>0.6cm</Height><Width>20cm</Width><Style><Border><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Tablix Name="Tablix14"><TablixBody><TablixColumns><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox137"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Draft</Value><Style><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox8</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><TopBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></TopBorder><BottomBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><LeftBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></LeftBorder><RightBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></RightBorder><BackgroundColor>#ffcaca</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox153"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Incomplete</Value><Style><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox10</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><TopBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></TopBorder><BottomBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><LeftBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></LeftBorder><RightBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></RightBorder><BackgroundColor>#cae3f9</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBo