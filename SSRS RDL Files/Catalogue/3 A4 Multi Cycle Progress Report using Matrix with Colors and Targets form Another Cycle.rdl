                                          <BackgroundColor>=IIF(Fields!txtGradingName.Value="Attainment",
SWITCH(Fields!txtGrade.Value="" OR Fields!txtGrade.Value="N/A" OR Fields!txtTargetGrade.Value="" OR Fields!txtTargetGrade.Value="N/A","Transparent",
Fields!intTargetGradeTransposeValue.Value&lt;Fields!intGradeTransposeValue.Value,"Lime",
Fields!intTargetGradeTransposeValue.Value=Fields!intGradeTransposeValue.Value,"Orange",
