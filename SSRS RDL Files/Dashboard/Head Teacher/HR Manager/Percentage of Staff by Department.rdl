<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>1632427e-cc57-4b2e-8e08-67dc46f97e75</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Staff"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT  ISNULL(TblTeachingManagerSubjectDepartments.txtDepartmentName, 'No Department Set') AS 'Department',
		COUNT(DISTINCT TblStaff.TblStaffID) AS 'StaffCount'
FROM    TblStaff
		LEFT OUTER JOIN TblStaffManagementDepartmentLink ON TblStaff.TblStaffID = TblStaffManagementDepartmentLink.intStaffID
		LEFT OUTER JOIN TblTeachingManagerSubjectDepartments ON TblStaffManagementDepartmentLink.intDepartmentID = TblTeachingManagerSubjectDepartments.TblTeachingManagerSubjectDepartmentsID
		AND TblTeachingManagerSubjectDepartments.blnActive = 1
WHERE    TblStaff.SystemStatus = 1
GROUP BY TblTeachingManagerSubjectDepartments.txtDepartmentName</CommandText></Query><Fields><Field Name="Department"><DataField>Department</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="StaffCount"><DataField>StaffCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Chart Name="Chart1"><ChartCategoryHierarchy><ChartMembers><ChartMember><Label /></ChartMember></ChartMembers></ChartCategoryHierarchy><ChartSeriesHierarchy><ChartMembers><ChartMember><Group Name="Chart1_SeriesGroup"><GroupExpressions><GroupExpression>=Fields!Department.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!StaffCount.Value</Value><Direction>Descending</Direction></SortExpression></SortExpressions><Label>=Fields!Department.Value &amp; " #PERCENT"</Label></ChartMember></ChartMembers></ChartSeriesHierarchy><ChartData><ChartSeriesCollection><ChartSeries Name="Student_Reward"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Sum(Fields!StaffCount.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style><UseValueAsLabel>true</UseValueAsLabel></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Shape</Type><Subtype>Doughnut</Subtype><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style /></ChartDataLabel></ChartEmptyPoints><CustomProperties><CustomProperty><Name>DoughnutRadius</Name><Value>25</Value></CustomProperty><CustomProperty><Name>PieStartAngle</Name><Value>270</Value></CustomProperty></CustomProperties><ChartItemInLegend><LegendText>Rewards</LegendText></ChartItemInLegend><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries></ChartSeriesCollection></ChartData><ChartAreas><ChartArea Name="Default"><ChartCategoryAxes><ChartAxis Name="Primary"><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border><FontSize>12pt</FontSize><Color>#373948</Color></Style><ChartAxisTitle><Caption /><Style><FontSize>9pt</FontSize><Color>#5c5c5c</Color></Style></ChartAxisTitle><Interval>1</Interval><ChartMajorGridLines><Enabled>False</Enabled><Style><Border><Color>Gainsboro</Color></Border></Style></ChartMajorGridLines><ChartMinorGridLines><Style><Border><Color>Gainsboro</Color><Style>Dotted</Style></Border></Style></ChartMinorGridLines><ChartMajorTickMarks><Type>Inside</Type><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border></Style></ChartMajorTickMarks><ChartMinorTickMarks><Enabled>True</Enabled><Style><Border><Color>Gainsboro</Color></Border></Style><Length>0.5</Length></ChartMinorTickMarks><CrossAt>NaN</CrossAt><Minimum>NaN</Minimum><Maximum>NaN</Maximum><Angle>25</Angle><ChartAxisScaleBreak><Style /></ChartAxisScaleBreak></ChartAxis><ChartAxis Name="Secondary"><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border><FontSize>8pt</FontSize><Color>#5c5c5c</Color></Style><ChartAxisTitle><Caption /><Style><FontSize>9pt</FontSize><Color>#5c5c5c</Color></Style></ChartAxisTitle><ChartMajorGridLines><Enabled>False</Enabled><Style><Border><Color>Gainsboro</Color></Border></Style></ChartMajorGridLines><ChartMinorGridLines><Style><Border><Color>Gainsboro</Color><Style>Dotted</Style></Border></Style></ChartMinorGridLines><ChartMajorTickMarks><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border></Style></ChartMajorTickMarks><ChartMinorTickMarks><Style><Border><Color>Gainsboro</Color></Border></Style><Length>0.5</Length></ChartMinorTickMarks><CrossAt>NaN</CrossAt><Location>Opposite</Location><Minimum>NaN</Minimum><Maximum>NaN</Maximum><ChartAxisScaleBreak><Style /></ChartAxisScaleBreak></ChartAxis></ChartCategoryAxes