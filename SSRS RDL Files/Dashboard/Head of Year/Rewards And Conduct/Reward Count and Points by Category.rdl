<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>1632427e-cc57-4b2e-8e08-67dc46f97e75</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="RewardsBetweenTwoDates"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @intYear INT, @dtStartDate DATETIME, @dtEndDate DATETIME;

SET @intYear = (SELECT TOP 1 intSchoolYear FROM TblSchoolManagementTermDates WHERE GETDATE() BETWEEN txtStartDate AND txtFinishDate)
SET @dtStartDate = (SELECT MIN(txtStartDate) FROM TblSchoolManagementTermDates WHERE intSchoolYear = @intYear)
SET @dtEndDate = (SELECT MAX(txtFinishDate) FROM TblSchoolManagementTermDates WHERE intSchoolYear = @intYear);

WITH ApplicablePupils AS
	(SELECT	DISTINCT txtSchoolID
	 FROM	TblPupilManagementPupils
	 WHERE	intNCYear IN (SELECT DISTINCT intNCYear FROM TblSchoolManagementYears WHERE txtYearTutor = @userCode OR txtAsstYearTutor = @userCode)
	)

SELECT	vwRewardType.Name AS 'TypeName',
		vwRewardType.ID AS 'TypeID',
		vwRewardType.[Order] AS 'TypeOrder',
		vwRewardCategory.Name AS 'CategoryName',
		vwRewardCategory.ID AS 'CategoryID',
		vwRewardCategory.[Order] AS 'CategoryOrder',
		vwRewardCategory.Points,
		vwRewardType.Positive,
		vwReward.RewardDate,
		vwReward.Id AS 'RewardID'
FROM	rewardsandconduct.vwReward
		INNER JOIN rewardsandconduct.vwRewardType ON rewardsandconduct.vwReward.TypeId = rewardsandconduct.vwRewardType.Id
		INNER JOIN rewardsandconduct.vwRewardCategory ON rewardsandconduct.vwReward.CategoryId = rewardsandconduct.vwRewardCategory.Id
		INNER JOIN ApplicablePupils ON vwReward.SchoolId = ApplicablePupils.txtSchoolID
WHERE	vwReward.Authorised = 1
		AND vwReward.RewardDate BETWEEN @dtStartDate AND @dtEndDate</CommandText></Query><Fields><Field Name="TypeName"><DataField>TypeName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TypeID"><DataField>TypeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="CategoryName"><DataField>CategoryName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TypeOrder"><DataField>TypeOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Points"><DataField>Points</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Positive"><DataField>Positive</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="CategoryID"><DataField>CategoryID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="RewardDate"><DataField>RewardDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="CategoryOrder"><DataField>CategoryOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="RewardID"><DataField>RewardID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Chart Name="Chart1"><ChartCategoryHierarchy><ChartMembers><ChartMember><Group Name="Chart1_CategoryGroup"><GroupExpressions><GroupExpression>=Fields!CategoryID.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!TypeOrder.Value</Value></SortExpression><SortExpression><Value>=Fields!CategoryOrder.Value</Value></SortExpression></SortExpressions><Label>=Fields!CategoryName.Value</Label></ChartMember></ChartMembers></ChartCategoryHierarchy><ChartSeriesHierarchy><ChartMembers><ChartMember><Label>Points</Label></ChartMember><ChartMember><Label>Reward ID</Label></ChartMember></ChartMembers></ChartSeriesHierarchy><ChartData><ChartSeriesCollection><ChartSeries Name="Points"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=Sum(Fields!Points.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style><UseValueAsLabel>true</UseValueAsLabel></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style /></ChartDataLabel></ChartEmptyPoints><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries><ChartSeries Name="Student_Reward"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=CountDistinct(Fields!RewardID.Value)</Y></ChartDataPointValues><ChartDataLabel><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style><UseValueAsLabel>true</UseValueAsLabel></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Type>Bar</Type><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style /></ChartDataLabel></ChartEmptyPoints><ChartItemInLegend><LegendText>Rewards</LegendText></ChartItemInLegend><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries></ChartSeriesCollection></ChartData><ChartAreas><ChartArea Name="Default"><ChartCategoryAxes><ChartAxis Name="Primary"><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border><FontSize>12pt</FontSize><Color>#373948</Color></Style><ChartAxisTitle><Caption /><Style><FontSize>9pt</FontSize><Color>#5c5c5c</Color></Style></ChartAxisTitle><Interval>1</Interval><ChartMajorGridLines><Enabled>False</Enabled><Style><Border><Color>Gainsboro</Color></Border></Style></ChartMajorGridLine