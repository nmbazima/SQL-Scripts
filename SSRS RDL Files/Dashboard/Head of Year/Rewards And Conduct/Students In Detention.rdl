<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>1632427e-cc57-4b2e-8e08-67dc46f97e75</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Detentions"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @intYear INT, @dtStartDate DATETIME, @dtEndDate DATETIME;

SET @intYear = (SELECT TOP 1 intSchoolYear FROM TblSchoolManagementTermDates WHERE GETDATE() BETWEEN txtStartDate AND txtFinishDate)
SET @dtStartDate = (SELECT MIN(txtStartDate) FROM TblSchoolManagementTermDates WHERE intSchoolYear = @intYear)
SET @dtEndDate = (SELECT MAX(txtFinishDate) FROM TblSchoolManagementTermDates WHERE intSchoolYear = @intYear);

WITH ApplicablePupils AS
	(SELECT	DISTINCT txtSchoolID
	 FROM	TblPupilManagementPupils
	 WHERE	intNCYear IN (SELECT DISTINCT intNCYear FROM TblSchoolManagementYears WHERE txtYearTutor = @userCode OR txtAsstYearTutor = @userCode)
	)
	,TotalCounts AS
	(SELECT	COUNT(DISTINCT TblDisciplineManagerDetentionsPupils.TblDisciplineManagerDetentionsPupilsID) AS 'DetentionCount'
	 FROM	TblDisciplineManagerDetentionsPupils
			INNER JOIN ApplicablePupils ON TblDisciplineManagerDetentionsPupils.txtSchoolID = ApplicablePupils.txtSchoolID
	 WHERE	TblDisciplineManagerDetentionsPupils.intAuthorised = 1
			AND TblDisciplineManagerDetentionsPupils.dDetentionDate BETWEEN CAST(FLOOR(CAST(GETDATE() AS FLOAT)) AS DATETIME) AND DATEADD(DAY, 1, CAST(FLOOR(CAST(GETDATE() AS FLOAT)) AS DATETIME))
	)

SELECT	COUNT(DISTINCT TblDisciplineManagerDetentionsPupils.TblDisciplineManagerDetentionsPupilsID) AS 'DetentionCount',
		CASE WHEN TblPupilManagementPupils.txtGender = 'M' THEN 'Male' WHEN TblPupilManagementPupils.txtGender = 'F' THEN 'Female' ELSE 'Other' END AS 'Gender',
		CAST(COUNT(DISTINCT TblDisciplineManagerDetentionsPupils.TblDisciplineManagerDetentionsPupilsID) AS DECIMAL(18,2)) / CAST(TotalCounts.DetentionCount AS DECIMAL(18,2)) AS 'PupilPercentage'
FROM    TblDisciplineManagerDetentionsPupils
		INNER JOIN TblPupilManagementPupils ON TblDisciplineManagerDetentionsPupils.txtSchoolID = TblPupilManagementPupils.txtSchoolID
		INNER JOIN TotalCounts ON 1 = 1
		INNER JOIN ApplicablePupils ON TblDisciplineManagerDetentionsPupils.txtSchoolID = ApplicablePupils.txtSchoolID
WHERE	TblDisciplineManagerDetentionsPupils.intAuthorised = 1
		AND TblDisciplineManagerDetentionsPupils.dDetentionDate BETWEEN CAST(FLOOR(CAST(GETDATE() AS FLOAT)) AS DATETIME) AND DATEADD(DAY, 1, CAST(FLOOR(CAST(GETDATE() AS FLOAT)) AS DATETIME))
GROUP BY CASE WHEN TblPupilManagementPupils.txtGender = 'M' THEN 'Male' WHEN TblPupilManagementPupils.txtGender = 'F' THEN 'Female' ELSE 'Other' END, TotalCounts.DetentionCount</CommandText></Query><Fields><Field Name="DetentionCount"><DataField>DetentionCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Gender"><DataField>Gender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PupilPercentage"><DataField>PupilPercentage</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>6cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>5cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle2"><ReportItems><Textbox Name="Textbox8"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=iif(Fields!DetentionCount.Value is nothing, 0, Fields!DetentionCount.Value)</Value><Style><FontSize>26pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox8</rd:DefaultName><Top>0.94932cm</Top><Left>0.70489cm</Left><Height>0.97042cm</Height><Width>4.59021cm</Width><Style><Border><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Textbox9"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=iif(Fields!DetentionCount.Value is nothing, 0, Fields!PupilPercentage.Value)</Value><Style><FontSize>18pt</FontSize><Format>0.0%</Format><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox8</rd:DefaultName><Top>2.09613cm</Top><Left>0.70489cm</Left><Height>0.97042cm</Height><Width>4.59021cm</Width><ZIndex>1</ZIndex><Style><Border><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></ReportItems><KeepTogether>true</KeepTogether><Style><Border><Style>None</Style></Border></Style></Rectangle></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixRowHierarchy><DataSetName>Detentions</DataSetName><Height>5cm</Height><Width>6cm</Width><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><Height>5cm</Height><Style><Border><Style>None</Style></Border></Style></Body><Width>6cm</Width><Page><PageHeight>21cm</PageHeight><PageWidth>29.7cm</PageWidth><LeftMargin>1cm</LeftMargin><RightMargin>1cm</RightMargin><TopMargin>1cm</TopMargin><BottomMargin>1cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page></ReportSection></ReportSections><ReportParameters><ReportParameter Name="userCode"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>User Code:</Prompt></ReportParameter></ReportParameters><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>e8d9a35f-c82b-49ec-b282-74c700d7a411</rd:ReportID></Report>