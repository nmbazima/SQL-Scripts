<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>1632427e-cc57-4b2e-8e08-67dc46f97e75</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Rewards"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @intYear INT, @dtStartDate DATETIME, @dtEndDate DATETIME;

SET @intYear = (SELECT TOP 1 intSchoolYear FROM TblSchoolManagementTermDates WHERE GETDATE() BETWEEN txtStartDate AND txtFinishDate)
SET @dtStartDate = (SELECT MIN(txtStartDate) FROM TblSchoolManagementTermDates WHERE intSchoolYear = @intYear)
SET @dtEndDate = (SELECT MAX(txtFinishDate) FROM TblSchoolManagementTermDates WHERE intSchoolYear = @intYear);

WITH ApplicablePupils AS
	(SELECT	DISTINCT txtSchoolID
	 FROM	TblPupilManagementPupils
	 WHERE	intNCYear IN (SELECT DISTINCT intNCYear FROM TblSchoolManagementYears WHERE txtYearTutor = @userCode OR txtAsstYearTutor = @userCode)
	)
	,MainTable AS
	(SELECT TblRewardsManagerRewards.txtSchoolID AS 'SchoolID',
			TblPupilManagementPupils.txtForename + ' ' + TblPupilManagementPupils.txtSurname AS 'StudentName',
			CASE WHEN TblPupilManagementPupils.txtGender = 'M' THEN 'Male' WHEN TblPupilManagementPupils.txtGender = 'F' THEN 'Female' ELSE 'Other' END AS 'Gender',
			CASE WHEN TblRewardsManagerRewardTypes.intPositive = 1 THEN 'Positive' ELSE 'Negative' END AS 'RewardType',
			SUM(TblRewardsManagerRewardTypesCategories.intValue) AS 'RewardSum',
			COUNT(DISTINCT TblRewardsManagerRewards.TblRewardsManagerRewardsID) AS 'RewardCount'
	 FROM	TblRewardsManagerRewards
			INNER JOIN TblRewardsManagerRewardTypesCategories ON TblRewardsManagerRewards.intCategory = TblRewardsManagerRewardTypesCategories.TblRewardsManagerRewardTypesCategoriesID
			INNER JOIN TblRewardsManagerRewardTypes ON TblRewardsManagerRewards.intType = TblRewardsManagerRewardTypes.TblRewardsManagerRewardTypesID
			INNER JOIN TblPupilManagementPupils ON TblRewardsManagerRewards.txtSchoolID = TblPupilManagementPupils.txtSchoolID
			INNER JOIN ApplicablePupils ON TblPupilManagementPupils.txtSchoolID = ApplicablePupils.txtSchoolID
	 WHERE	TblRewardsManagerRewards.intAuthorised = 1
			AND TblRewardsManagerRewards.txtDate BETWEEN @dtStartDate AND DATEADD(DAY, 1, @dtEndDate)
	GROUP BY TblRewardsManagerRewards.txtSchoolID, 
			TblPupilManagementPupils.txtForename + ' ' + TblPupilManagementPupils.txtSurname, 
			CASE WHEN TblRewardsManagerRewardTypes.intPositive = 1 THEN 'Positive' ELSE 'Negative' END,
			CASE WHEN TblPupilManagementPupils.txtGender = 'M' THEN 'Male' WHEN TblPupilManagementPupils.txtGender = 'F' THEN 'Female' ELSE 'Other' END
	)
	,Positive AS
	(SELECT	TOP 5 SchoolID, StudentName, Gender, RewardType, RewardSum, RewardCount, 'Top 5' AS 'TableType'
	 FROM	MainTable
	 ORDER BY RewardSum DESC, RewardCount DESC
	)
	,Negative AS
	(SELECT	TOP 5 SchoolID, StudentName, Gender, RewardType, RewardSum, RewardCount, 'Bottom 5' AS 'TableType'
	 FROM	MainTable
	 ORDER BY RewardSum, RewardCount
	)

SELECT	SchoolID, StudentName, Gender, RewardType, RewardSum, RewardCount, TableType
FROM	Positive
	UNION ALL
SELECT	SchoolID, StudentName, Gender, RewardType, RewardSum, RewardCount, TableType
FROM	Negative</CommandText></Query><Fields><Field Name="SchoolID"><DataField>SchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="StudentName"><DataField>StudentName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Gender"><DataField>Gender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="RewardType"><DataField>RewardType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="RewardSum"><DataField>RewardSum</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="RewardCount"><DataField>RewardCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="TableType"><DataField>TableType</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>6.5cm</Width></TablixColumn><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>2cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="TableType"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!TableType.Value</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>TableType</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>4</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox7"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Name</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox7</rd:DefaultName><Style><Border><Color>#373948</Color><Style>None</Style><Width>0.5pt</Width></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Gender</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox2</rd:DefaultName><Style><Border><Color>#373948</Color><Style>None</Style><Width>0.5pt</Width></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Points</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Color>#373948</Color><Style>None</Style><Width>0.5pt</Width></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox27"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Rewards</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox27</rd:DefaultName><Style><Border><Color>#373948</Color><Style>None</Style><Width>0.5pt</Width></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="StudentName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!StudentName.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>StudentName</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><TopBorder><Style>None</Style></TopBorder><RightBorder><Style>None</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Gender"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Gender.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Gender</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><TopBorder><Style>None</Style></TopBorder><LeftBorder><Style>None</Style></LeftBorder><RightBorder><Style>None</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="RewardSum"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!RewardSum.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>RewardSum</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><TopBorder><Style>None</Style></TopBorder><LeftBorder><Style>None</Style></LeftBorder><RightBorder><Style>None</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="RewardCount"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!RewardCount.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>RewardCount</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><TopBorder><Style>None</Style></TopBorder><LeftBorder><Style>None</Style></LeftBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells>