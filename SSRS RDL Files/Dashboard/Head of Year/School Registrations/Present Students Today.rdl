<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>1632427e-cc57-4b2e-8e08-67dc46f97e75</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Attendance"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @PupilID AS NVARCHAR(MAX), @dtStartDate DATETIME, @dtEndDate DATETIME;

SET @dtStartDate = CAST(FLOOR(CAST(GETDATE() AS FLOAT)) AS DATETIME) ;
SET @dtEndDate =  @dtStartDate;

SET @PupilID = STUFF(
	(SELECT	DISTINCT ',' + TblPupilManagementPupils.txtSchoolID
	 FROM	TblPupilManagementPupils
	 CROSS APPLY dbo.uf_Registration_getPupilArchive(TblPupilManagementPupils.txtSchoolID, @dtEndDate) AS PupilArchive
	 WHERE	PupilArchive.intNCYear IN (SELECT DISTINCT intNCYear FROM TblSchoolManagementYears WHERE txtYearTutor = @userCode OR txtAsstYearTutor = @userCode)
	 FOR XML PATH('')), 1, 1, ''
	);

WITH MainTable AS
	(SELECT	COUNT(DISTINCT Attendance.intRegistrationDateTimeID) AS 'intRegistrationCount',
			COUNT(DISTINCT CASE Attendance.txtRegistrationStatisticalStatus WHEN 'Present' THEN Attendance.intRegistrationDateTimeID ELSE NULL END) AS 'intPresentCount',
			COUNT(DISTINCT CASE WHEN Attendance.txtRegistrationStatisticalStatus = 'Present' AND Attendance.intIsLate = 1 THEN Attendance.intRegistrationDateTimeID ELSE NULL END) AS 'intLateCount',
			COUNT(DISTINCT CASE Attendance.txtRegistrationStatisticalStatus WHEN 'Absent' THEN Attendance.intRegistrationDateTimeID ELSE NULL END) AS 'intAbsentCount',
			COUNT(DISTINCT CASE WHEN Attendance.txtRegistrationStatisticalStatus = 'Absent' AND Attendance.intIsAuthorisedAbsence = 1 THEN Attendance.intRegistrationDateTimeID ELSE NULL END) AS 'intAuthorisedAbsentCount',
			COUNT(DISTINCT CASE WHEN Attendance.txtRegistrationStatisticalStatus = 'Absent' AND Attendance.intIsAuthorisedAbsence = 0 THEN Attendance.intRegistrationDateTimeID ELSE NULL END) AS 'intUnAuthorisedAbsentCount',
			COUNT(DISTINCT CASE Attendance.txtRegistrationStatisticalStatus WHEN 'Not Registered' THEN Attendance.intRegistrationDateTimeID ELSE NULL END) AS 'intNotRegisteredCount',
			Attendance.txtSchoolID AS 'txtSchoolID'
	 FROM	dbo.uf_Registration_AttendanceBetweenDates(@dtStartDate, DATEADD(DAY,1, @dtEndDate), @PupilID) AS Attendance
	 WHERE	(Attendance.intIsIncludedInStatistics = 1)
			AND Attendance.txtRegistrationAMPM = 'AM'
	 GROUP BY Attendance.txtSchoolID
	)

SELECT	SUM(intPresentCount) AS 'PresentCount',
		SUM(intRegistrationCount) / 60 AS 'RegistrationCount',
		(CAST(SUM(intPresentCount) AS DECIMAL(18,2)) / CAST(SUM(intRegistrationCount) / 60 AS DECIMAL(18,2))) * 100 AS 'PresentPercentage'
FROM	MainTable</CommandText></Query><Fields><Field Name="PresentCount"><DataField>PresentCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="RegistrationCount"><DataField>RegistrationCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="PresentPercentage"><DataField>PresentPercentage</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><GaugePanel Name="GaugePanel5"><RadialGauges><RadialGauge Name="RadialGauge1"><PivotX>47</PivotX><PivotY>85</PivotY><GaugeScales><RadialScale Name="RadialScale1"><Radius>55</Radius><StartAngle>90</StartAngle><SweepAngle>180</SweepAngle><GaugePointers><RadialPointer Name="RadialPointer1"><Type>Bar</Type><PointerCap><Style><BackgroundColor>White</BackgroundColor><BackgroundGradientType>DiagonalLeft</BackgroundGradientType><BackgroundGradientEndColor>DimGray</BackgroundGradientEndColor><BackgroundHatchType>None</BackgroundHatchType></Style><CapImage><OffsetX>0pt</OffsetX><OffsetY>0pt</OffsetY><Source>External</Source><Value /></CapImage><OnTop>true</OnTop><CapStyle>RoundedWithWideIndentation</CapStyle><Width>33</Width></PointerCap><NeedleStyle>Tapered</NeedleStyle><Style><Border><Style>None</Style></Border><BackgroundColor>#4ba73e</BackgroundColor><BackgroundGradientType>None</BackgroundGradientType><BackgroundGradientEndColor>Orange</BackgroundGradientEndColor><BackgroundHatchType>None</BackgroundHatchType><ShadowOffset>0pt</ShadowOffset></Style><GaugeInputValue><Value>=Sum(Fields!PresentPercentage.Value)</Value><Multiplier>1</Multiplier></GaugeInputValue><PointerImage><OffsetX>0pt</OffsetX><OffsetY>0pt</OffsetY><Source>External</Source><Value /></PointerImage><MarkerLength>25</MarkerLength><MarkerStyle>Wedge</MarkerStyle><Placement>Cross</Placement><Width>30</Width></RadialPointer></GaugePointers><Style><Border><Style>None</Style></Border><BackgroundColor>#f0f0f0</BackgroundColor><BackgroundGradientType>None</BackgroundGradientType><BackgroundGradientEndColor>White</BackgroundGradientEndColor><BackgroundHatchType>None</BackgroundHatchType><ShadowOffset>0pt</ShadowOffset></Style><Interval>10</Interval><IntervalOffset>NaN</IntervalOffset><MaximumValue><Value>100</Value><Multiplier>1</Multiplier></MaximumValue><MinimumValue><Value>0</Value><Multiplier>1</Multiplier></MinimumValue><GaugeMajorTickMarks><Interval>NaN</Interval><IntervalOffset>NaN</IntervalOffset><Style><Border><Color>DimGray</Color><Style>Solid</Style></Border><BackgroundColor>WhiteSmoke</BackgroundColor></Style><Placement>Cross</Placement><TickMarkImage><Source>External</Source><Value /></TickMarkImage><Length>14</Length><Width>8</Width><Shape>Trapezoid</Shape><Hidden>true</Hidden></GaugeMajorTickMarks><GaugeMinorTickMarks><Interval>NaN</Interval><IntervalOffset>NaN</IntervalOffset><Style><Border><Color>DimGray</Color><Style>Solid</Style></Border><BackgroundColor>WhiteSmoke</BackgroundColor></Style><Placement>Cross</Placement><TickMarkImage><Source>External</Source><Value /></TickMarkImage><Length>8</Length><Width>3</Width><Hidden>true</Hidden></GaugeMinorTickMarks><MaximumPin><PinLabel><Style><FontSize>12pt</FontSize></Style><DistanceFromScale>0</DistanceFromScale></PinLabel><Style><Border><Color>DimGray</Color><Style>Solid</Style></Border><BackgroundColor>WhiteSmoke</BackgroundColor></Style><Placement>Cross</Placement><TickMarkImage><Source>External</Source><Value /></TickMarkImage><Length>6</Length><Width>6</Width><Shape>Circle</Shape></MaximumPin><MinimumPin><PinLabel><Style><FontSize>12pt</FontSize></Style><DistanceFromScale>0</DistanceFromScale></PinLabel><Style><Border><Color>DimGray</Color><Style>Solid</Style></Border><BackgroundColor>WhiteSmoke</BackgroundColor></Style><Placement>Cross</Placement><TickMarkImage><Source>External</Source><Value /></TickMarkImage><Length>6</Length><Width>6</Width><Shape>Circle</Shape></MinimumPin><ScaleLabels><Style><FontSize>14pt</FontSize><Color>#373948</Color></Style><Interval>NaN</Interval><IntervalOffset>NaN</IntervalOffset><DistanceFromScale>0</DistanceFromScale><Placement>Outside</Placement><ShowEndLabels>true</ShowEndLabels><Hidden>true</Hidden><UseFontPercent>true</UseFontPercent></ScaleLabels><Width>30</Width></RadialScale></GaugeScales><BackFrame><Style><Border><Style>None</Style></Border><BackgroundColor>WhiteSmoke</BackgroundColor><BackgroundGradientType>None</BackgroundGradientType><BackgroundGradientEndColor>Gainsboro</BackgroundGradientEndColor><BackgroundHatchType>None</BackgroundHatchType><ShadowOffset>0pt</ShadowOffset></Style><FrameShape>CustomSemiCircularN1</FrameShape><FrameBackground><Style><BackgroundColor>WhiteSmoke</BackgroundColor><BackgroundGradientType>DiagonalLeft</BackgroundGradientType><BackgroundGradientEndColor>Gray</BackgroundGradientEndColor><BackgroundHatchType>None</BackgroundHatchType></Style></FrameBackground><FrameImage><Source>External</Source><Value /></FrameImage></BackFrame><ClipContent>true</ClipContent><TopImage><Source>External</Source><Value /></TopImage><AspectRatio>1.48</AspectRatio><Height>100</Height><Width>100</Width></RadialGauge></RadialGauges><GaugeLabels><GaugeLabel Name="GaugeLabel1"><Text>=IIF(Fields!PresentCount.Value is nothing, vbcrlf &amp; "No Data", Fields!PresentCount.Value )</Text><ResizeMode>None</ResizeMode><TextShadowOffset>0pt</TextShadowOffset><UseFontPercent>true</UseFontPercent><Style><Border><Style>None</Style></Border><BackgroundColor>#00ffffff</BackgroundColor><BackgroundGradientType>None</BackgroundGradientType><BackgroundGradientEndColor>#00ffffff</BackgroundGradientEndColor><FontSize>12pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign><Color>#373948</Color><ShadowOffset>0pt</ShadowOffset></Style><Top>39.1234588623047</Top><Left>27.2581462860107</Left><Height>50</Height><Width>40</Width><ParentItem>RadialGauges.RadialGauge1</ParentItem></GaugeLabel><GaugeLabel Name="GaugeLabel2"><Text>=IIF(Fields!PresentCount.Value is nothing, "", FORMATNUMBER(Fields!PresentPercentage.Value,0) &amp;"%" )</Text><ResizeMode>None</ResizeMode><TextShadowOffset>0pt</TextShadowOffset><UseFontPercent>true</UseFontPercent><Style><Border><Style>None</Style></Border><BackgroundColor>#00ffffff</BackgroundColor><BackgroundGradientType>None</BackgroundGradientType><BackgroundGradientEndColor>#00ffffff</BackgroundGradientEndColor><FontSize>8pt</FontSize><TextAlign>Center</TextAlign><VerticalAlign>Top</VerticalAlign><Color>#404040</Color><ShadowOffset>0pt</ShadowOffset></Style><Top>65.9574432373047</Top><Left>29.646017074585</Left><Height>9</Height><Width>40</Width></GaugeLabel></GaugeLabels><AutoLayout>true</AutoLayout><BackFrame><Style><Border><Style>None</Style></Border><BackgroundColor>Gainsboro</BackgroundColor><BackgroundGradientType>None</BackgroundGradientType><BackgroundGradientEndColor>Gray</BackgroundGradientEndColor><BackgroundHatchType>None</BackgroundHatchType><ShadowOffset>0pt</ShadowOffset></Style><FrameBackground><Style><BackgroundColor>Silver</BackgroundColor><BackgroundGradientType>DiagonalLeft</BackgroundGradientType><BackgroundGradientEndColor>Gray</BackgroundGradientEndColor><BackgroundHatchType>None</BackgroundHatchType></Style></FrameBackground><FrameImage><Source>External</Source><Value /></FrameImage></BackFrame><TopImage><Source>External</Source><Value /></TopImage><DataSetName>Attendance</DataSetName><Height>5cm</Height><Width>6cm</Width><Style><Border><Color>Green</Color><Style>None</Style></Border><BackgroundColor>White</BackgroundColor></Style></GaugePanel></ReportItems><Height>5cm</Height><Style><Border><Color>Red</Color><Style>None</Style></Border></Style></Body><Width>6cm</Width><Page><PageHeight>21cm</PageHeight><PageWidth>29.7cm</PageWidth><LeftMargin>1cm</LeftMargin><RightMargin>1cm</RightMargin><TopMargin>1cm</TopMargin><BottomMargin>1cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page></ReportSection></ReportSections><ReportParameters><ReportParameter Name="userCode"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>User Code:</Prompt></ReportParameter></ReportParameters><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>e8d9a35f-c82b-49ec-b282-74c700d7a411</rd:ReportID></Report>