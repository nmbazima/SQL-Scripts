SELECT 
	'Detentions' AS txtDataType,
	DetentionTypes.txtType AS txtDataCategory,
	IsNull(Detentions.intDetentions,0) AS intDataCount,
	NULL AS intDataSum,
	NULL AS intAditionalData,
	DistinctStudents.txtSchoolID,
		DistinctStudents.txtOnSENRegister,
	DistinctStudents.txtOnLACRegister,
	DistinctStudents.txtOnSCRegister,
	DistinctStudents.txtOnFSMRegister,
	DistinctStudents.txtOnPPRegister,
	DistinctStudents.txtSENLevel,
	--Detentions.intWeekNumber,
	Detentions.dtFirstDayOfWeek
FROM DistinctStudents
CROSS APPLY (SELECT DISTINCT Detentions.txtType
FROM Detentions) AS DetentionTypes
LEFT OUTER JOIN Detentions ON DistinctStudents.txtSchoolID = Detentions.txtSchoolID AND DetentionTypes.txtType = Detentions.txtType
WHERE  @txtDataType = 'Detentions'

UNION ALL

SELECT 
	'Exclusions' AS txtDataType,
	ExclusionTypes.txtName AS txtDataCategory,
	isNull(Exclusions.intExclusions,0) AS intDataCount,
	ISNULL(Exclusions.intSessions,0) AS intDataSum,
	NULL AS intAditionalData,
	DistinctStudents.txtSchoolID,
		DistinctStudents.txtOnSENRegister,
	DistinctStudents.txtOnLACRegister,
	DistinctStudents.txtOnSCRegister,
	DistinctStudents.txtOnFSMRegister,
	DistinctStudents.txtOnPPRegister,
	DistinctStudents.txtSENLevel,
	--Exclusions.intWeekNumber,
	Exclusions.dtFirstDayOfWeek
FROM DistinctStudents
CROSS APPLY (SELECT DISTINCT Exclusions.txtName
FROM Exclusions) AS ExclusionTypes
LEFT OUTER JOIN Exclusions ON DistinctStudents.txtSchoolID = Exclusions.txtSchoolID AND ExclusionTypes.txtName = Exclusions.txtName
WHERE  @txtDataType = 'Exclusions'

UNION ALL

SELECT 
	'Concerns' AS txtDataType,
	ConcernTypes.Name AS txtDataCategory,
	ISNULL(Concerns.intConcerns,0) AS intDataCount,
	NULL AS intDataSum,
	NULL AS intAditionalData,
	DistinctStudents.txtSchoolID,
		DistinctStudents.txtOnSENRegister,
	DistinctStudents.txtOnLACRegister,
	DistinctStudents.txtOnSCRegister,
	DistinctStudents.txtOnFSMRegister,
	DistinctStudents.txtOnPPRegister,
	DistinctStudents.txtSENLevel,
	--Concerns.intWeekNumber,
	Concerns.dtFirstDayOfWeek
FROM DistinctStudents
CROSS APPLY (SELECT DISTINCT Concerns.Name
FROM Concerns) AS ConcernTypes
LEFT OUTER JOIN Concerns ON DistinctStudents.txtSchoolID = Concerns.SchoolId AND ConcernTypes.Name = Concerns.Name
WHERE  @txtDataType = 'Concerns'
) 

SELECT 
	StudentsAndData.*,
	TblPupilManagementPupils.txtFullName, 
	TblPupilManagementPupils.txtSurname, 
	TblPupilManagementPupils.txtForename, 
	TblPupilManagementPupils.txtGender, 
	TblPupilManagementPupils.txtEthnicGroup, 
	TblPupilManagementPupils.txtForm,
	TblPupilManagementPupils.intNCYear,
	TblPupilManagementPupils.txtDOB,
	TblSchoolManagementYears.txtYearName,
	TblPupilManagementPupils.txtAcademicHouse,
	TblPupilManagementPupils.txtBoardingHouse,
	TblPupilManagementPupils.txtType AS txtBoardingStatus
FROM StudentsAndData
INNER JOIN TblPupilManagementPupils ON StudentsAndData.txtSchoolID = TblPupilManagementPupils.txtSchoolID
LEFT OUTER JOIN TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear

WHERE CASE WHEN @GroupBy = 'txtGender' THEN TblPupilManagementPupils.txtGender
			WHEN @GroupBy = 'txtEthnicGroup' THEN TblPupilManagementPupils.txtEthnicGroup
			WHEN @GroupBy = 'intNCYear' THEN TblSchoolManagementYears.txtYearName
			WHEN @GroupBy = 'txtForm' THEN TblPupilManagementPupils.txtForm
			WHEN @GroupBy = 'txtAcademicHouse' THEN TblPupilManagementPupils.txtAcademicHouse
			WHEN @GroupBy = 'txtBoardingHouse' THEN TblPupilManagementPupils.txtBoardingHouse
			WHEN @GroupBy = 'txtBoardingStatus' THEN TblPupilManagementPupils.txtType
			ELSE 'N/A' END = (CASE WHEN @GroupBy ='NoGroup' THEN 'N/A' ELSE @StudentGroup END)</CommandText></Query><Fields><Field Name="txtDataType"><DataField>txtDataType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDataCategory"><DataField>txtDataCategory</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intDataCount"><DataField>intDataCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intDataSum"><DataField>intDataSum</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intAditionalData"><DataField>intAditionalData</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnSENRegister"><DataField>txtOnSENRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnLACRegister"><DataField>txtOnLACRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnSCRegister"><DataField>txtOnSCRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnFSMRegister"><DataField>txtOnFSMRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnPPRegister"><DataField>txtOnPPRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSENLevel"><DataField>txtSENLevel</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtFirstDayOfWeek"><DataField>dtFirstDayOfWeek</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtFullName"><DataField>txtFullName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd