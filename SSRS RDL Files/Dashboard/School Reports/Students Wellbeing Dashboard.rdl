<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>0d779b1c-a681-4fc9-a266-a9061d62ab94</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Disclaimer"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Path"><Value>=Globals!ReportFolder</Value></QueryParameter><QueryParameter Name="@Report"><Value>=Globals!ReportName</Value></QueryParameter></QueryParameters><CommandText>
				  SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
				  FROM	TblSQLReportingServicesDisclaimerReport
				  INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
				  WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
				  AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
				  AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report
			  </CommandText></Query><Fields><Field Name="txtDisclaimerBackgroundColour"><DataField>txtDisclaimerBackgroundColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerBorderColour"><DataField>txtDisclaimerBorderColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerDescription"><DataField>txtDisclaimerDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTextColour"><DataField>txtDisclaimerTextColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTitle"><DataField>txtDisclaimerTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolRoles"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>WITH TeachingGroups AS
(
	SELECT DISTINCT
		TblTeachingManagerSets.txtTeacher
	FROM TblTeachingManagerSets 
	WHERE TblTeachingManagerSets.blnActive = 1

	UNION ALL

	SELECT DISTINCT
		TblTeachingManagerSetAssociatedTeachers.txtTeacher
	FROM TblTeachingManagerSets 
	INNER JOIN TblTeachingManagerSetAssociatedTeachers ON TblTeachingManagerSets.TblTeachingManagerSetsID = TblTeachingManagerSetAssociatedTeachers.intSetID
	WHERE TblTeachingManagerSets.blnActive = 1

	UNION ALL

	SELECT DISTINCT
		TblTeachingManagerSubjectForms.txtTeacher
	FROM TblTeachingManagerSubjectForms 
)

--Year
SELECT DISTINCT 
	'Year' AS txtRole,
	1 AS intOrder
FROM TblSchoolManagementYears
WHERE TblSchoolManagementYears.txtYearTutor = @userCode
	OR TblSchoolManagementYears.txtAsstYearTutor = @userCode

UNION ALL
--Form
SELECT DISTINCT 
	'Form' AS txtRole,
	2 AS intOrder
FROM TblSchoolManagementForms
WHERE TblSchoolManagementForms.txtFormTutor = @userCode
	OR TblSchoolManagementForms.txtAsstFormTutor = @userCode
	OR TblSchoolManagementForms.txtAsstFormTutor2 = @userCode

UNION ALL
--A House
SELECT DISTINCT 
	'Academic House' AS txtRole,
	3 AS intOrder
FROM TblSchoolManagementHouses
WHERE TblSchoolManagementHouses.txtHouseType = 'Academic'
	AND (TblSchoolManagementHouses.txtHouseMaster = @userCode
	OR TblSchoolManagementHouses.txtAssistantHouseMaster = @userCode)

UNION ALL
--B House
SELECT DISTINCT 
	'Boarding House'AS txtRole,
	4 AS intOrder
FROM TblSchoolManagementHouses
WHERE TblSchoolManagementHouses.txtHouseType = 'Boarding'
	AND (TblSchoolManagementHouses.txtHouseMaster = @userCode
	OR TblSchoolManagementHouses.txtAssistantHouseMaster = @userCode)

UNION ALL
-- Pastoral Tutor
SELECT DISTINCT 
	'Pastoral Tutor' AS txtRole,
	5 AS intOrder
FROM TblPupilManagementPupils
WHERE TblPupilManagementPupils.txtTutor = @userCode
	AND TblPupilManagementPupils.intSystemStatus = 1

UNION ALL
-- Teaching Group
SELECT DISTINCT
	'Teacher' AS txtRole,
	6 AS intOrder
FROM TeachingGroups
WHERE TeachingGroups.txtTeacher = @userCode

UNION ALL
-- Head of subject
SELECT DISTINCT 
	'Subject' AS txtRole,
	7 AS intOrder
FROM TblTeachingManagerSubjects
INNER JOIN TblTeachingManagerSubjectsHeads ON TblTeachingManagerSubjects.TblTeachingManagerSubjectsID = TblTeachingManagerSubjectsHeads.intSubject
WHERE TblTeachingManagerSubjects.intActive = 1
	AND TblTeachingManagerSubjectsHeads.txtHOS = @userCode

UNION ALL
-- Head of Department
SELECT DISTINCT 
	'Teaching Department' AS txtRole,
	8 AS intOrder
FROM TblTeachingManagerSubjectDepartments
INNER JOIN TblTeachingManagerSubjectDepartmentsHeads ON TblTeachingManagerSubjectDepartments.TblTeachingManagerSubjectDepartmentsID = TblTeachingManagerSubjectDepartmentsHeads.intDepartment
WHERE TblTeachingManagerSubjectDepartments.blnActive = 1
	AND TblTeachingManagerSubjectDepartmentsHeads.txtHOD = @userCode

UNION ALL
-- Register?
SELECT DISTINCT
	'Student Register' AS txtRole,
	9 AS intOrder
FROM f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegistersAccess
INNER JOIN TblPupilRegistersRegister ON RegistersAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId
WHERE	(TblPupilRegistersRegister.bActive = 1)

UNION ALL
-- Admin
SELECT DISTINCT
	'Student Manager' AS txtRole,
	10 AS intOrder
FROM TbliSAMSManagerUsers
INNER JOIN TbliSAMSManagerModuleSecurity ON TbliSAMSManagerUsers.txtSecurityID = TbliSAMSManagerModuleSecurity.txtSecurityID
INNER JOIN TbliSAMSManagerModules ON  TbliSAMSManagerModuleSecurity.intModuleID = TbliSAMSManagerModules.TbliSAMSManagerModulesID
WHERE TbliSAMSManagerUsers.txtUserCode = @userCode
AND TbliSAMSManagerModules.txtModuleID ='iSAMS_STUDENTMANAGEMENT'
AND TbliSAMSManagerUsers.intiSAMSLogin = 1
AND (TbliSAMSManagerModuleSecurity.intRead = 1 OR TbliSAMSManagerModuleSecurity.intWrite = 1 OR TbliSAMSManagerModuleSecurity.intModify = 1 OR TbliSAMSManagerModuleSecurity.intFull = 1)

ORDER BY intOrder</CommandText></Query><Fields><Field Name="txtRole"><DataField>txtRole</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="StudentGroups"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter><QueryParameter Name="@txtRole"><Value>=Parameters!txtRole.Value</Value></QueryParameter></QueryParameters><CommandText>WITH TeachingGroups AS
(
	SELECT DISTINCT
		TblTeachingManagerSets.txtTeacher,
		TblTeachingManagerSets.txtSetCode AS txtTeachingGroupCode
	FROM TblTeachingManagerSets 
	WHERE TblTeachingManagerSets.blnActive = 1

	UNION ALL

	SELECT DISTINCT
		TblTeachingManagerSetAssociatedTeachers.txtTeacher,
		TblTeachingManagerSets.txtSetCode AS txtTeachingGroupCode
	FROM TblTeachingManagerSets 
	INNER JOIN TblTeachingManagerSetAssociatedTeachers ON TblTeachingManagerSets.TblTeachingManagerSetsID = TblTeachingManagerSetAssociatedTeachers.intSetID
	WHERE TblTeachingManagerSets.blnActive = 1

	UNION ALL

	SELECT DISTINCT
		TblTeachingManagerSubjectForms.txtTeacher,
		TblTeachingManagerSubjectForms.txtTimetableCode AS txtTeachingGroupCode
	FROM TblTeachingManagerSubjectForms 
)

--Year
SELECT DISTINCT 
	TblSchoolManagementYears.txtYearName AS txtElementName,
	TblSchoolManagementYears.intNCYear AS intElementId
FROM TblSchoolManagementYears
WHERE (TblSchoolManagementYears.txtYearTutor = @userCode
	OR TblSchoolManagementYears.txtAsstYearTutor = @userCode)
	AND 'Year' = @txtRole

UNION ALL
--Form
SELECT DISTINCT 
	TblSchoolManagementForms.txtForm AS txtElementName,
	2 AS intElementId
FROM TblSchoolManagementForms
WHERE (TblSchoolManagementForms.txtFormTutor = @userCode
	OR TblSchoolManagementForms.txtAsstFormTutor = @userCode
	OR TblSchoolManagementForms.txtAsstFormTutor2 = @userCode)
	AND 'Form' = @txtRole

UNION ALL
--A House
SELECT DISTINCT 
	TblSchoolManagementHouses.txtHouseName AS txtElementName,
	3 AS intElementId
FROM TblSchoolManagementHouses
WHERE TblSchoolManagementHouses.txtHouseType = 'Academic'
	AND (TblSchoolManagementHouses.txtHouseMaster = @userCode
	OR TblSchoolManagementHouses.txtAssistantHouseMaster = @userCode)
	AND 'Academic House' = @txtRole

UNION ALL
--B House
SELECT DISTINCT 
	TblSchoolManagementHouses.txtHouseName AS txtElementName,
	4 AS intElementId
FROM TblSchoolManagementHouses
WHERE TblSchoolManagementHouses.txtHouseType = 'Boarding'
	AND (TblSchoolManagementHouses.txtHouseMaster = @userCode
	OR TblSchoolManagementHouses.txtAssistantHouseMaster = @userCode)
	AND 'Boarding House' = @txtRole

UNION ALL
-- Pastoral Tutor
SELECT DISTINCT 
	'Tutees' AS txtElementName,
	5 AS intElementId
FROM TblPupilManagementPupils
WHERE TblPupilManagementPupils.txtTutor = @userCode
	AND TblPupilManagementPupils.intSystemStatus = 1
	AND 'Pastoral Tutor' = @txtRole

UNION ALL
-- Teaching Group
SELECT DISTINCT
	TeachingGroups.txtTeachingGroupCode AS txtElementName,
	6 AS intElementId
FROM TeachingGroups
WHERE TeachingGroups.txtTeacher = @userCode
	AND 'Teacher' = @txtRole

UNION ALL
-- Head of subject
SELECT DISTINCT 
	TblTeachingManagerSubjects.txtSubjectName AS txtElementName,
	7 AS intElementId
FROM TblTeachingManagerSubjects
INNER JOIN TblTeachingManagerSubjectsHeads ON TblTeachingManagerSubjects.TblTeachingManagerSubjectsID = TblTeachingManagerSubjectsHeads.intSubject
WHERE TblTeachingManagerSubjects.intActive = 1
	AND TblTeachingManagerSubjectsHeads.txtHOS = @userCode
	AND 'Subject' = @txtRole

UNION ALL
-- Head of Department
SELECT DISTINCT 
	TblTeachingManagerSubjectDepartments.txtDepartmentName AS txtElementName,
	8 AS intElementId
FROM TblTeachingManagerSubjectDepartments
INNER JOIN TblTeachingManagerSubjectDepartmentsHeads ON TblTeachingManagerSubjectDepartments.TblTeachingManagerSubjectDepartmentsID = TblTeachingManagerSubjectDepartmentsHeads.intDepartment
WHERE TblTeachingManagerSubjectDepartments.blnActive = 1
	AND TblTeachingManagerSubjectDepartmentsHeads.txtHOD = @userCode
	AND 'Teaching Department'= @txtRole

UNION ALL
-- Register?
SELECT DISTINCT
	TblPupilRegistersRegister.txtName AS txtElementName,
	9 AS intElementId
FROM f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegistersAccess
INNER JOIN TblPupilRegistersRegister ON RegistersAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId
WHERE	(TblPupilRegistersRegister.bActive = 1)
	AND 'Student Register' = @txtRole

UNION ALL

-- Admin
SELECT DISTINCT 
	TblSchoolManagementYears.txtYearName AS txtElementName,
	TblSchoolManagementYears.intNCYear AS intElementId
FROM TblSchoolManagementYears
WHERE 'Student Manager' = @txtRole

ORDER BY intElementId, txtElementName</CommandText></Query><Fields><Field Name="txtElementName"><DataField>txtElementName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intElementId"><DataField>intElementId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="Students"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtElementName"><Value>=Parameters!txtElementName.Value</Value></QueryParameter><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter><QueryParameter Name="@txtRole"><Value>=Parameters!txtRole.Value</Value></QueryParameter><QueryParameter Name="@txtTime"><Value>=Parameters!txtTime.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationType"><Value>=Parameters!txtRegistrationType.Value</Value></QueryParameter><QueryParameter Name="@intCategory"><Value>=Parameters!intCategory.Value</Value></QueryParameter><QueryParameter Name="@txtDetentionType"><Value>=Parameters!txtDetentionType.Value</Value></QueryParameter><QueryParameter Name="@intExclusionType"><Value>=Parameters!intExclusionType.Value</Value></QueryParameter><QueryParameter Name="@ConcernType"><Value>=Parameters!ConcernType.Value</Value></QueryParameter></QueryParameters><CommandText>--DECLARE @userCode AS NVARCHAR(max);
--SET @userCode = 'SallyWalls194863988959936';
--DECLARE @txtRole AS NVARCHAR(max);
--SET @txtRole = 'Head of Teaching Department';
--DECLARE @txtElementName AS NVARCHAR(max);
--SET @txtElementName = 'Sciences';


DECLARE @SEN AS Integer;
SET @SEN = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
			CROSS APPLY f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegisterAccess
			WHERE txtReportingKey = '$SEN'
			AND RegisterAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId);
DECLARE @LAC AS Integer;
SET @LAC = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
			CROSS APPLY f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegisterAccess
			WHERE txtReportingKey = '$LookedAfter'
			AND RegisterAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId);
DECLARE @FSM AS Integer;
SET @FSM = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
			CROSS APPLY f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegisterAccess
			WHERE txtReportingKey = '$FreeSchoolMeals' AND RegisterAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId);
DECLARE @PP AS Integer;
SET @PP = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
			CROSS APPLY f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegisterAccess
			WHERE txtReportingKey = '$PupilPremium' AND RegisterAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId);
DECLARE @SC AS Integer;
SET @SC = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
			CROSS APPLY f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegisterAccess
			WHERE txtReportingKey = '$ServiceChildren' AND RegisterAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId);

WITH TeachingGroups AS
(
	SELECT DISTINCT
		TblTeachingManagerSets.txtTeacher,
		TblTeachingManagerSets.txtSetCode AS txtTeachingGroupCode,
		TblTeachingManagerSetLists.txtSchoolID,
		TblTeachingManagerSets.intSubject
	FROM TblTeachingManagerSets 
	INNER JOIN TblTeachingManagerSetLists ON TblTeachingManagerSets.TblTeachingManagerSetsID = TblTeachingManagerSetLists.intSetID
	INNER JOIN TblPupilManagementPupils ON TblTeachingManagerSetLists.txtSchoolID = TblPupilManagementPupils.txtSchoolID
	WHERE TblTeachingManagerSets.blnActive = 1
	AND TblPupilManagementPupils.intSystemStatus = 1

	UNION ALL

	SELECT DISTINCT
		TblTeachingManagerSetAssociatedTeachers.txtTeacher,
		TblTeachingManagerSets.txtSetCode AS txtTeachingGroupCode,
		TblTeachingManagerSetLists.txtSchoolID,
		TblTeachingManagerSets.intSubject
	FROM TblTeachingManagerSets 
	INNER JOIN TblTeachingManagerSetAssociatedTeachers ON TblTeachingManagerSets.TblTeachingManagerSetsID = TblTeachingManagerSetAssociatedTeachers.intSetID
	INNER JOIN TblTeachingManagerSetLists ON TblTeachingManagerSets.TblTeachingManagerSetsID = TblTeachingManagerSetLists.intSetID
	INNER JOIN TblPupilManagementPupils ON TblTeachingManagerSetLists.txtSchoolID = TblPupilManagementPupils.txtSchoolID
	WHERE TblTeachingManagerSets.blnActive = 1
	AND TblPupilManagementPupils.intSystemStatus = 1

	UNION ALL

	SELECT DISTINCT
		TblTeachingManagerSubjectForms.txtTeacher,
		TblTeachingManagerSubjectForms.txtTimetableCode AS txtTeachingGroupCode,
		TblPupilManagementPupils.txtSchoolID,
		TblTeachingManagerSubjectForms.intSubject
	FROM TblTeachingManagerSubjectForms 
	INNER JOIN TblPupilManagementPupils ON TblTeachingManagerSubjectForms.txtForm = TblPupilManagementPupils.txtForm
	WHERE TblPupilManagementPupils.intSystemStatus = 1
),

StudentsOnRegister AS
(

	SELECT	TblPupilRegistersRegister.txtName AS txtRegisterName,
	--TblPupilRegistersRegister.txtWorkflow,
       TblPupilRegistersRegisterId,
	   RegisterStatus.txtSchoolId
	FROM dbo.f_PupilRegisters_GetLatestScreeningLogsOnRegisterWithRanges(Null, NULL) AS RegisterStatus
	INNER JOIN TblPupilRegistersRegister ON RegisterStatus.intRegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId
	INNER JOIN TblPupilManagementPupils ON RegisterStatus.txtSchoolId = TblPupilManagementPupils.txtSchoolID
	WHERE	TblPupilRegistersRegister.txtWorkflow = 'RegisterWithRanges'
	AND TblPupilRegistersRegister.txtName IN (@txtElementName)
	AND RegisterStatus.bOnRegister = 1
AND TblPupilManagementPupils.intSystemStatus = 1

UNION ALL

SELECT	txtName AS txtRegisterName,
       TblPupilRegistersRegisterId,
	   RegisterStatus.txtSchoolId
FROM    [dbo].[f_PupilRegisters_GetLatestScreeningLogs] (NULL, NULL) AS RegisterStatus
INNER JOIN TblPupilRegistersRegister ON RegisterStatus.intRegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId
INNER JOIN TblPupilManagementPupils ON RegisterStatus.txtSchoolId = TblPupilManagementPupils.txtSchoolID
WHERE    TblPupilRegistersRegister.txtName IN (@txtElementName)
AND RegisterStatus.bOnRegister = 1
AND TblPupilManagementPupils.intSystemStatus = 1
AND TblPupilRegistersRegister.txtWorkflow = 'Register'

UNION ALL

SELECT	txtName AS txtRegisterName,
       TblPupilRegistersRegisterId,
	   RegisterStatus.txtSchoolId
FROM   TblPupilRegistersRegister

CROSS APPLY [dbo].[f_PupilRegisters_GetPupilsWithDataForRegister] (TblPupilRegistersRegister.TblPupilRegistersRegisterID) AS RegisterStatus
INNER JOIN TblPupilManagementPupils ON RegisterStatus.txtSchoolId = TblPupilManagementPupils.txtSchoolID
WHERE    TblPupilRegistersRegister.txtName IN (@txtElementName)

AND TblPupilManagementPupils.intSystemStatus = 1
AND TblPupilRegistersRegister.txtWorkflow = 'None'


),

SENLevel AS

(
SELECT 
SENLevelData.[$SEN_Requirements_CensusData_Level_Display] AS txtSENLevel,
SENLevelData.SchoolId AS txtSchoolID,
ROW_NUMBER() OVER(PARTITION BY SENLevelData.SchoolId ORDER BY SENLevelData.[$SEN_Requirements_CensusData_StartDate] DESC) AS intSENLevelRank
FROM f_PupilRegisters_GetSectionsWithReadActivityPermission(@userCode) AS SENRequirements


INNER JOIN [generated_views].[VwPupilRegisters_RecordCollection_$SEN_Requirements_CensusData] AS SENLevelData  ON 1=1
WHERE SENRequirements.SectionReportingKey = '$SEN_Requirements'
AND SENLevelData.[$SEN_Requirements_CensusData_StartDate] &lt;= @EndDate
AND (SENLevelData.[$SEN_Requirements_CensusData_EndDate] &gt;= @StartDate OR SENLevelData.[$SEN_Requirements_CensusData_EndDate] IS NULL)


),

Students AS 
(

--Year
SELECT DISTINCT 
	TblSchoolManagementYears.txtYearName AS txtElementName,
	TblSchoolManagementYears.intNCYear AS intElementId,
	TblPupilManagementPupils.txtSchoolID
FROM TblSchoolManagementYears
INNER JOIN TblPupilManagementPupils ON TblSchoolManagementYears.intNCYear = TblPupilManagementPupils.intNCYear
WHERE (TblSchoolManagementYears.txtYearTutor = @userCode
	OR TblSchoolManagementYears.txtAsstYearTutor = @userCode)
	AND 'Year' = @txtRole
	AND TblSchoolManagementYears.txtYearName IN (@txtElementName)
	AND TblPupilManagementPupils.intSystemStatus = 1

UNION ALL
--Form
SELECT DISTINCT 
	TblSchoolManagementForms.txtForm AS txtElementName,
	2 AS intElementId,
	TblPupilManagementPupils.txtSchoolID
FROM TblSchoolManagementForms
INNER JOIN TblPupilManagementPupils ON TblSchoolManagementForms.txtForm = TblPupilManagementPupils.txtForm
WHERE (TblSchoolManagementForms.txtFormTutor = @userCode
	OR TblSchoolManagementForms.txtAsstFormTutor = @userCode
	OR TblSchoolManagementForms.txtAsstFormTutor2 = @userCode)
	AND 'Tutor' = @txtRole
	AND TblSchoolManagementForms.txtForm IN (@txtElementName)
	AND TblPupilManagementPupils.intSystemStatus = 1

UNION ALL
--A House
SELECT DISTINCT 
	TblSchoolManagementHouses.txtHouseName AS txtElementName,
	3 AS intElementId,
	TblPupilManagementPupils.txtSchoolID
FROM TblSchoolManagementHouses
INNER JOIN TblPupilManagementPupils ON TblSchoolManagementHouses.txtHouseName = TblPupilManagementPupils.txtAcademicHouse
WHERE TblSchoolManagementHouses.txtHouseType = 'Academic'
	AND (TblSchoolManagementHouses.txtHouseMaster = @userCode
	OR TblSchoolManagementHouses.txtAssistantHouseMaster = @userCode)
	AND 'Academic House' = @txtRole
	AND TblSchoolManagementHouses.txtHouseName IN (@txtElementName)
	AND TblPupilManagementPupils.intSystemStatus = 1

UNION ALL
--B House
SELECT DISTINCT 
	TblSchoolManagementHouses.txtHouseName AS txtElementName,
	4 AS intElementId,
	TblPupilManagementPupils.txtSchoolID
FROM TblSchoolManagementHouses
INNER JOIN TblPupilManagementPupils ON TblSchoolManagementHouses.txtHouseName = TblPupilManagementPupils.txtBoardingHouse
WHERE TblSchoolManagementHouses.txtHouseType = 'Boarding'
	AND (TblSchoolManagementHouses.txtHouseMaster = @userCode
	OR TblSchoolManagementHouses.txtAssistantHouseMaster = @userCode)
	AND 'Boarding House' = @txtRole
	AND TblSchoolManagementHouses.txtHouseName IN (@txtElementName)
	AND TblPupilManagementPupils.intSystemStatus = 1

UNION ALL
-- Pastoral Tutor
SELECT DISTINCT 
	'Tutees' AS txtElementName,
	5 AS intElementId,
	TblPupilManagementPupils.txtSchoolID
FROM TblPupilManagementPupils
WHERE TblPupilManagementPupils.txtTutor = @userCode
	AND TblPupilManagementPupils.intSystemStatus = 1
	AND 'Pastoral Tutor' = @txtRole

UNION ALL
-- Teaching Group
SELECT DISTINCT
	TeachingGroups.txtTeachingGroupCode AS txtElementName,
	6 AS intElementId,
	TeachingGroups.txtSchoolID
FROM TeachingGroups
WHERE TeachingGroups.txtTeacher = @userCode
	AND 'Teacher' = @txtRole
	AND TeachingGroups.txtTeachingGroupCode IN (@txtElementName)

UNION ALL
-- Head of subject
SELECT DISTINCT 
	TblTeachingManagerSubjects.txtSubjectName AS txtElementName,
	7 AS intElementId,
	TeachingGroups.txtSchoolID
FROM TblTeachingManagerSubjects
INNER JOIN TeachingGroups ON TblTeachingManagerSubjects.TblTeachingManagerSubjectsID = TeachingGroups.intSubject 
INNER JOIN TblTeachingManagerSubjectsHeads ON TblTeachingManagerSubjects.TblTeachingManagerSubjectsID = TblTeachingManagerSubjectsHeads.intSubject
WHERE TblTeachingManagerSubjects.intActive = 1
	AND TblTeachingManagerSubjectsHeads.txtHOS = @userCode
	AND 'Subject' = @txtRole
	AND TblTeachingManagerSubjects.txtSubjectName IN (@txtElementName)

UNION ALL
-- Head of Department
SELECT DISTINCT 
	TblTeachingManagerSubjectDepartments.txtDepartmentName AS txtElementName,
	8 AS intElementId,
	TeachingGroups.txtSchoolID
FROM TblTeachingManagerSubjectDepartments
INNER JOIN TblTeachingManagerSubjectDepartmentsHeads ON TblTeachingManagerSubjectDepartments.TblTeachingManagerSubjectDepartmentsID = TblTeachingManagerSubjectDepartmentsHeads.intDepartment
INNER JOIN TblTeachingManagerSubjectDepartmentsSubjectLinks ON TblTeachingManagerSubjectDepartments.TblTeachingManagerSubjectDepartmentsID = TblTeachingManagerSubjectDepartmentsSubjectLinks.intDepartment
INNER JOIN TeachingGroups ON TblTeachingManagerSubjectDepartmentsSubjectLinks.intSubject = TeachingGroups.intSubject 
WHERE TblTeachingManagerSubjectDepartments.blnActive = 1
	AND TblTeachingManagerSubjectDepartmentsHeads.txtHOD = @userCode
	AND 'Teaching Department' = @txtRole
	AND TblTeachingManagerSubjectDepartments.txtDepartmentName IN (@txtElementName)

UNION ALL
-- Register?
SELECT DISTINCT
   StudentsOnRegister.txtRegisterName AS txtElementName,
   9 AS intElementId,
   StudentsOnRegister.txtSchoolID
FROM StudentsOnRegister
WHERE 'Student Register' = @txtRole

UNION ALL

-- Admin
SELECT DISTINCT 
	TblSchoolManagementYears.txtYearName AS txtElementName,
	TblSchoolManagementYears.intNCYear AS intElementId,
	TblPupilManagementPupils.txtSchoolID
FROM TblSchoolManagementYears
INNER JOIN TblPupilManagementPupils ON TblSchoolManagementYears.intNCYear = TblPupilManagementPupils.intNCYear
WHERE 'Student Manager' = @txtRole
	AND TblSchoolManagementYears.txtYearName IN (@txtElementName)
	AND TblPupilManagementPupils.intSystemStatus = 1

),

KeyRegisters AS
(
SELECT	DISTINCT
	txtSchoolID,
	bOnRegister,
	intRegisterId
FROM    [dbo].[f_PupilRegisters_GetLatestScreeningLogs] (NULL, NULL) AS Register
INNER JOIN TblPupilRegistersRegister ON Register.intRegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId
WHERE intRegisterId IN (@SEN,@LAC,@SC)
AND TblPupilRegistersRegister.txtWorkflow &lt;&gt; 'RegisterWithRanges'
AND bOnRegister = 1

UNION ALL

SELECT	DISTINCT
	txtSchoolID,
	bOnRegister,
	intRegisterId
FROM    [dbo].f_PupilRegisters_GetLatestScreeningLogsOnRegisterWithRanges (NULL, @FSM) AS Register
INNER JOIN TblPupilRegistersRegister ON Register.intRegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId
WHERE bOnRegister = 1

UNION ALL
SELECT	DISTINCT
	txtSchoolID,
	bOnRegister,
	intRegisterId
FROM    [dbo].f_PupilRegisters_GetLatestScreeningLogsOnRegisterWithRanges (NULL, @PP) AS Register
INNER JOIN TblPupilRegistersRegister ON Register.intRegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId
WHERE bOnRegister = 1
),

DistinctStudents AS 
(
	SELECT  DISTINCT
   Students.txtSchoolID,
   (CASE WHEN SENRegister.txtSchoolId IS NULL THEN 'No' WHEN SENRegister.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnSENRegister,
   (CASE WHEN LACRegister.txtSchoolId IS NULL THEN 'No' WHEN LACRegister.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnLACRegister,
   (CASE WHEN SCRegister.txtSchoolId IS NULL THEN 'No' WHEN SCRegister.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnSCRegister,
   (CASE WHEN FSMRegister.txtSchoolId IS NULL THEN 'No' WHEN FSMRegister.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnFSMRegister,
   (CASE WHEN PPRegister.txtSchoolId IS NULL THEN 'No' WHEN PPRegister.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnPPRegister,
   (CASE WHEN SENLevel.txtSENLevel IS NULL THEN 'No SEN Level' ELSE SENLevel.txtSENLevel END) AS txtSENLevel
   FROM Students
   LEFT OUTER JOIN KeyRegisters AS SENRegister ON Students.txtSchoolID = SENRegister.txtSchoolId AND SENRegister.intRegisterId = @SEN
   LEFT OUTER JOIN KeyRegisters AS LACRegister ON Students.txtSchoolID = LACRegister.txtSchoolId AND LACRegister.intRegisterId = @LAC
   LEFT OUTER JOIN KeyRegisters AS SCRegister ON Students.txtSchoolID = SCRegister.txtSchoolId AND SCRegister.intRegisterId = @SC
   LEFT OUTER JOIN KeyRegisters AS FSMRegister ON Students.txtSchoolID = FSMRegister.txtSchoolId AND FSMRegister.intRegisterId = @FSM
   LEFT OUTER JOIN KeyRegisters AS PPRegister ON Students.txtSchoolID = PPRegister.txtSchoolId AND PPRegister.intRegisterId = @PP
   LEFT OUTER JOIN SENLevel ON SENRegister.txtSchoolId = SENLevel.txtSchoolID AND SENRegister.bOnRegister = 1 AND SENLevel.intSENLevelRank =1
),

Attendance AS 
(
	SELECT	COUNT(DISTINCT Attendance.intRegistrationDateTimeID) AS intRegistrationCount, 
			COUNT(DISTINCT CASE Attendance.txtRegistrationStatisticalStatus WHEN 'Present' THEN Attendance.intRegistrationDateTimeID ELSE NULL END) AS intPresentCount,
			Attendance.txtSchoolID
	FROM	dbo.uf_Registration_AttendanceBetweenDates(@StartDate, DATEADD(DAY, 1, @EndDate), STUFF(
	(SELECT	DISTINCT ',' + txtSchoolID
	 FROM	DistinctStudents
	 FOR XML PATH('')), 1, 1, ''
	)) AS Attendance
	WHERE	LEFT(CONVERT(varchar(8), Attendance.dtRegistrationDateTime, 108), 5) IN (@txtTime)
			AND Attendance.intIsIncludedInStatistics = 1
			AND CASE WHEN Attendance.txtRegistrationAMPM IS NULL THEN 'Other' ELSE UPPER(Attendance.txtRegistrationAMPM) END IN (@txtRegistrationType)
			--AND (Attendance.txtRegistrationStatisticalStatus = 'Absent' OR (Attendance.txtRegistrationStatisticalStatus = 'Present' AND Attendance.intIsLate = 1))
	GROUP BY Attendance.txtSchoolID
),

Rewards AS 
(
	SELECT	COUNT(DISTINCT TblRewardsManagerRewards.TblRewardsManagerRewardsID) AS intRewards,
			SUM(TblRewardsManagerRewardTypesCategories.intValue) AS intPoints,
			TblRewardsManagerRewards.txtSchoolID,
			TblRewardsManagerRewardTypes.TblRewardsManagerRewardTypesID AS intRewardType,
			TblRewardsManagerRewardTypes.intPositive,
			TblRewardsManagerRewardTypes.txtName AS txtRewardType
	FROM	TblRewardsManagerRewards 
	INNER JOIN DistinctStudents ON TblRewardsManagerRewards.txtSchoolID = DistinctStudents.txtSchoolID
	INNER JOIN TblRewardsManagerRewardTypesCategories ON TblRewardsManagerRewards.intCategory = TblRewardsManagerRewardTypesCategories.TblRewardsManagerRewardTypesCategoriesID
	INNER JOIN TblRewardsManagerRewardTypes ON TblRewardsManagerRewards.intType = TblRewardsManagerRewardTypes.TblRewardsManagerRewardTypesID
	WHERE	CONVERT(date,TblRewardsManagerRewards.txtDate) BETWEEN  @StartDate AND @EndDate
			AND TblRewardsManagerRewards.intCategory IN (@intCategory)
			AND TblRewardsManagerRewards.intAuthorised = 1
	GROUP BY TblRewardsManagerRewards.txtSchoolID, TblRewardsManagerRewardTypes.TblRewardsManagerRewardTypesID, TblRewardsManagerRewardTypes.intPositive, TblRewardsManagerRewardTypes.txtName
),

Detentions AS 
(
	SELECT	COUNT(DISTINCT TblDisciplineManagerDetentionsPupils.TblDisciplineManagerDetentionsPupilsID) AS intDetentions,
			TblDisciplineManagerDetentionsPupils.txtSchoolID,
			CASE WHEN NULLIF(TblDisciplineManagerDetentionsSessions.txtType,'') IS NULL THEN 'No Type' ELSE TblDisciplineManagerDetentionsSessions.txtType END AS  txtType
	FROM	TblDisciplineManagerDetentionsPupils 
	INNER JOIN DistinctStudents ON TblDisciplineManagerDetentionsPupils.txtSchoolID = DistinctStudents.txtSchoolID
	INNER JOIN TblDisciplineManagerDetentionsSessions ON TblDisciplineManagerDetentionsPupils.intDetentionSessionID = TblDisciplineManagerDetentionsSessions.TblDisciplineManagerDetentionsSessionsID
	WHERE	CONVERT(date,TblDisciplineManagerDetentionsPupils.dDetentionDate) BETWEEN  @StartDate AND @EndDate
			AND CASE WHEN NULLIF(TblDisciplineManagerDetentionsSessions.txtType,'') IS NULL THEN 'No Type' ELSE TblDisciplineManagerDetentionsSessions.txtType END IN (@txtDetentionType)
			AND TblDisciplineManagerDetentionsPupils.intAuthorised = 1
	GROUP BY TblDisciplineManagerDetentionsPupils.txtSchoolID, TblDisciplineManagerDetentionsSessions.txtType
),

Exclusions AS 
(
	SELECT	COUNT(DISTINCT TblDisciplineManagerExclusion.TblDisciplineManagerExclusionID) AS intExclusions,
		SUM(TblDisciplineManagerExclusion.intSessionsAM) + SUM(TblDisciplineManagerExclusion.intSessionsPM) AS intSessions,
			TblDisciplineManagerExclusion.txtSchoolID,
			TblDisciplineManagerExclusionTypeList.txtName
	FROM	TblDisciplineManagerExclusion 
	INNER JOIN DistinctStudents ON TblDisciplineManagerExclusion.txtSchoolID = DistinctStudents.txtSchoolID
	LEFT OUTER JOIN TblDisciplineManagerExclusionTypeList ON TblDisciplineManagerExclusion.intExclusionType = TblDisciplineManagerExclusionTypeList.TblDisciplineManagerExclusionTypeListID
	WHERE	((CONVERT(date,TblDisciplineManagerExclusion.dteStartDateTime) &lt;= @EndDate AND CONVERT(date,TblDisciplineManagerExclusion.dteEndDate) &gt; = @StartDate) OR (TblDisciplineManagerExclusion.dteEndDate IS NULL AND CONVERT(date,TblDisciplineManagerExclusion.dteStartDateTime) &lt;= @EndDate))
		AND TblDisciplineManagerExclusionTypeList.TblDisciplineManagerExclusionTypeListID IN (@intExclusionType)
	GROUP BY TblDisciplineManagerExclusion.txtSchoolID, TblDisciplineManagerExclusionTypeList.txtName
),

Concerns AS 
(
	SELECT	COUNT(DISTINCT Concern.Id) AS intConcerns, 
			Concern.SchoolID,
			ConcernType.Name
	FROM [pastoral].[GetConcerns](@userCode) AS Concern	
	INNER JOIN DistinctStudents ON Concern.SchoolId = DistinctStudents.txtSchoolID
	LEFT OUTER JOIN pastoral.ConcernType AS ConcernType ON Concern.TypeId = ConcernType.Id
	WHERE	CAST(FLOOR(CAST(Concern.RaisedOn AS FLOAT)) AS DATETIME) BETWEEN  @StartDate AND @EndDate
	AND ConcernType.Name IN (@ConcernType)
	GROUP BY Concern.SchoolID, ConcernType.Name
),


StudentsAndData AS
(
-- Present
SELECT 
	'Attendance' AS txtDataType,
	'Attendance' AS txtDataCategory,
	Attendance.intPresentCount AS intDataCount,
	Attendance.intRegistrationCount AS intDataSum,
	DistinctStudents.txtSchoolID,
			DistinctStudents.txtOnSENRegister,
	DistinctStudents.txtOnLACRegister,
	DistinctStudents.txtOnSCRegister,
	DistinctStudents.txtOnFSMRegister,
	DistinctStudents.txtOnPPRegister,
	DistinctStudents.txtSENLevel
FROM DistinctStudents
LEFT OUTER JOIN Attendance ON DistinctStudents.txtSchoolID = Attendance.txtSchoolID


UNION ALL

SELECT 
	'Positive Entries' AS txtDataType,
	Rewards.txtRewardType  AS txtDataCategory,
	isnull(Rewards.intRewards,0) AS intDataCount,
	isnull(Rewards.intPoints,0) AS intDataSum,
	DistinctStudents.txtSchoolID,
			DistinctStudents.txtOnSENRegister,
	DistinctStudents.txtOnLACRegister,
	DistinctStudents.txtOnSCRegister,
	DistinctStudents.txtOnFSMRegister,
	DistinctStudents.txtOnPPRegister,
	DistinctStudents.txtSENLevel
FROM DistinctStudents
LEFT OUTER JOIN Rewards ON DistinctStudents.txtSchoolID = Rewards.txtSchoolID AND Rewards.intPositive=1
 

UNION ALL

SELECT 
	'Negative Entries' AS txtDataType,
	Rewards.txtRewardType  AS txtDataCategory,
	isnull(Rewards.intRewards,0) AS intDataCount,
	isnull(Rewards.intPoints,0) AS intDataSum,
	DistinctStudents.txtSchoolID,
			DistinctStudents.txtOnSENRegister,
	DistinctStudents.txtOnLACRegister,
	DistinctStudents.txtOnSCRegister,
	DistinctStudents.txtOnFSMRegister,
	DistinctStudents.txtOnPPRegister,
	DistinctStudents.txtSENLevel
FROM DistinctStudents
LEFT OUTER JOIN Rewards ON DistinctStudents.txtSchoolID = Rewards.txtSchoolID AND Rewards.intPositive&lt;&gt;1
 

UNION ALL

SELECT 
	'Detentions' AS txtDataType,
	Detentions.txtType AS txtDataCategory,
	isnull(Detentions.intDetentions,0) AS intDataCount,
	NULL AS intDataSum,
	DistinctStudents.txtSchoolID,
			DistinctStudents.txtOnSENRegister,
	DistinctStudents.txtOnLACRegister,
	DistinctStudents.txtOnSCRegister,
	DistinctStudents.txtOnFSMRegister,
	DistinctStudents.txtOnPPRegister,
	DistinctStudents.txtSENLevel
FROM DistinctStudents
LEFT OUTER JOIN Detentions ON DistinctStudents.txtSchoolID = Detentions.txtSchoolID

UNION ALL

SELECT 
	'Exclusions' AS txtDataType,
	Exclusions.txtName AS txtDataCategory,
	isnull(Exclusions.intExclusions,0) AS intDataCount,
	isnull(Exclusions.intSessions,0) AS intDataSum,
	DistinctStudents.txtSchoolID,
			DistinctStudents.txtOnSENRegister,
	DistinctStudents.txtOnLACRegister,
	DistinctStudents.txtOnSCRegister,
	DistinctStudents.txtOnFSMRegister,
	DistinctStudents.txtOnPPRegister,
	DistinctStudents.txtSENLevel
FROM DistinctStudents
LEFT OUTER JOIN Exclusions ON DistinctStudents.txtSchoolID = Exclusions.txtSchoolID

UNION ALL

SELECT 
	'Concerns' AS txtDataType,
	Concerns.Name AS txtDataCategory,
	isnull(Concerns.intConcerns,0) AS intDataCount,
	NULL AS intDataSum,
	DistinctStudents.txtSchoolID,
			DistinctStudents.txtOnSENRegister,
	DistinctStudents.txtOnLACRegister,
	DistinctStudents.txtOnSCRegister,
	DistinctStudents.txtOnFSMRegister,
	DistinctStudents.txtOnPPRegister,
	DistinctStudents.txtSENLevel
FROM DistinctStudents
LEFT OUTER JOIN Concerns ON DistinctStudents.txtSchoolID = Concerns.SchoolId

) 

SELECT 
	StudentsAndData.*,
	TblPupilManagementPupils.txtFullName, 
	TblPupilManagementPupils.txtSurname, 
	TblPupilManagementPupils.txtForename, 
	TblPupilManagementPupils.txtGender, 
	TblPupilManagementPupils.txtEthnicGroup, 
	TblPupilManagementPupils.txtForm,
	TblPupilManagementPupils.intNCYear,
	TblPupilManagementPupils.txtDOB,
	TblSchoolManagementYears.txtYearName,
	TblPupilManagementPupils.txtAcademicHouse,
	TblPupilManagementPupils.txtBoardingHouse,
	TblPupilManagementPupils.txtType AS txtBoardingStatus

FROM StudentsAndData
INNER JOIN TblPupilManagementPupils ON StudentsAndData.txtSchoolID = TblPupilManagementPupils.txtSchoolID
LEFT OUTER JOIN TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear</CommandText></Query><Fields><Field Name="txtDataType"><DataField>txtDataType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDataCategory"><DataField>txtDataCategory</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intDataCount"><DataField>intDataCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intDataSum"><DataField>intDataSum</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtOnSENRegister"><DataField>txtOnSENRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFullName"><DataField>txtFullName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnLACRegister"><DataField>txtOnLACRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnSCRegister"><DataField>txtOnSCRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnFSMRegister"><DataField>txtOnFSMRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnPPRegister"><DataField>txtOnPPRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEthnicGroup"><DataField>txtEthnicGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSENLevel"><DataField>txtSENLevel</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtDOB"><DataField>txtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingStatus"><DataField>txtBoardingStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="NoGroup"><Value>NoGroup</Value></Field></Fields></DataSet><DataSet Name="RegistrationTimes"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationType"><Value>=Parameters!txtRegistrationType.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT DISTINCT LEFT(CONVERT(varchar(8), TblRegistrationSchoolRegistrationDateTime.txtDateTime, 108), 5) AS txtTime
FROM TblRegistrationSchoolRegistrationDateTime
WHERE TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @StartDate AND @EndDate
AND CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 'Other' ELSE UPPER(TblRegistrationSchoolRegistrationDateTime.txtAmPm) END IN (@txtRegistrationType)
ORDER BY txtTime</CommandText></Query><Fields><Field Name="txtTime"><DataField>txtTime</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS txtSchoolLogoPath, 
		TblReportsCustomImages.txtName
FROM	TblReportsCustomImages
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Address"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS txtiSAMSAddress
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="EntryTypes"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT -100 AS TblRewardsManagerRewardTypesID,
'N/A' AS txtName,
-100 AS intOrder

UNION ALL

SELECT TblRewardsManagerRewardTypes.TblRewardsManagerRewardTypesID, TblRewardsManagerRewardTypes.txtName,
TblRewardsManagerRewardTypes.intOrder
FROM TblRewardsManagerRewardTypes
ORDER BY intOrder</CommandText></Query><Fields><Field Name="TblRewardsManagerRewardTypesID"><DataField>TblRewardsManagerRewardTypesID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="EntryCategories"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intType"><Value>=Parameters!intType.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT -100 AS TblRewardsManagerRewardTypesCategoriesID,
'N/A' AS txtName,
-100 AS intTypeOrder,
-100 AS intOrder
WHERE '-100' IN (@intType) 
AND ( SELECT COUNT(TblRewardsManagerRewardTypesCategoriesID) FROM TblRewardsManagerRewardTypesCategories WHERE intType IN (@intType))= 0


UNION ALL

SELECT TblRewardsManagerRewardTypesCategories.TblRewardsManagerRewardTypesCategoriesID, TblRewardsManagerRewardTypesCategories.txtName,
TblRewardsManagerRewardTypes.intOrder AS intTypeOrder, 
TblRewardsManagerRewardTypesCategories.intOrder
FROM TblRewardsManagerRewardTypesCategories
INNER JOIN TblRewardsManagerRewardTypes ON TblRewardsManagerRewardTypesCategories.intType = TblRewardsManagerRewardTypes.TblRewardsManagerRewardTypesID
WHERE TblRewardsManagerRewardTypesCategories.intActive = 1
AND TblRewardsManagerRewardTypesCategories.intType IN (@intType)
ORDER BY  intTypeOrder, intOrder</CommandText></Query><Fields><Field Name="TblRewardsManagerRewardTypesCategoriesID"><DataField>TblRewardsManagerRewardTypesCategoriesID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intTypeOrder"><DataField>intTypeOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="Detentions"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 
'N/A' AS txtType,
-100 AS intOrder

UNION ALL

	SELECT	DISTINCT 
	CASE WHEN NULLIF(TblDisciplineManagerDetentionsSessions.txtType,'') IS NULL THEN 'No Type' ELSE TblDisciplineManagerDetentionsSessions.txtType END AS txtType,
2 AS intOrder
	FROM	TblDisciplineManagerDetentionsPupils 
	INNER JOIN TblDisciplineManagerDetentionsSessions ON TblDisciplineManagerDetentionsPupils.intDetentionSessionID = TblDisciplineManagerDetentionsSessions.TblDisciplineManagerDetentionsSessionsID
	WHERE	TblDisciplineManagerDetentionsPupils.dDetentionDate BETWEEN  @StartDate AND @EndDate
	AND TblDisciplineManagerDetentionsPupils.intAuthorised = 1


ORDER BY intOrder, txtType</CommandText></Query><Fields><Field Name="txtType"><DataField>txtType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="ExclusionTypes"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT 

-100 AS TblDisciplineManagerExclusionTypeListID,
'N/A' AS txtName,
-100 AS intOrder

UNION ALL

SELECT DISTINCT 
TblDisciplineManagerExclusionTypeList.TblDisciplineManagerExclusionTypeListID,
TblDisciplineManagerExclusionTypeList.txtName,
1 AS intOrder
FROM TblDisciplineManagerExclusionTypeList 


ORDER BY intOrder, txtName</CommandText></Query><Fields><Field Name="TblDisciplineManagerExclusionTypeListID"><DataField>TblDisciplineManagerExclusionTypeListID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="ConcernTypes"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 
'N/A' AS txtType, 
1 AS intOrder

UNION ALL

SELECT DISTINCT
ConcernType.Name AS txtType,
2 AS intOrder
FROM [pastoral].[GetConcerns](@userCode) AS Concern
LEFT OUTER JOIN pastoral.ConcernType AS ConcernType ON Concern.TypeId = ConcernType.Id
WHERE iSNull(Deleted,0) &lt;&gt; 1

ORDER BY intOrder, txtType</CommandText></Query><Fields><Field Name="txtType"><DataField>txtType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="StartOfAcademicYear"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TOP 1 TblSchoolManagementTermDates.txtStartDate
		 FROM	TblSchoolManagementTermDates
		 WHERE	TblSchoolManagementTermDates.intSchoolYear = (
		 SELECT Top(1) intSchoolYear FROM TblSchoolManagementTermDates WHERE txtStartDate &lt;= GETDATE() ORDER BY txtStartDate DESC
		 )
		 ORDER BY TblSchoolManagementTermDates.txtStartDate ASC</CommandText></Query><Fields><Field Name="txtStartDate"><DataField>txtStartDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields></DataSet><DataSet Name="RegisterAccess"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>--DECLARE @userCode AS NVARCHAR(max);
--SET @userCode = 'SallyWalls194863988959936';

DECLARE @SEN AS Integer;
SET @SEN = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
			CROSS APPLY f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegisterAccess
			WHERE txtReportingKey = '$SEN'
			AND RegisterAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId);
DECLARE @LAC AS Integer;
SET @LAC = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
			CROSS APPLY f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegisterAccess
			WHERE txtReportingKey = '$LookedAfter'
			AND RegisterAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId);
DECLARE @FSM AS Integer;
SET @FSM = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
			CROSS APPLY f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegisterAccess
			WHERE txtReportingKey = '$FreeSchoolMeals' AND RegisterAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId);
DECLARE @PP AS Integer;
SET @PP = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
			CROSS APPLY f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegisterAccess
			WHERE txtReportingKey = '$PupilPremium' AND RegisterAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId);
DECLARE @SC AS Integer;
SET @SC = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
			CROSS APPLY f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegisterAccess
			WHERE txtReportingKey = '$ServiceChildren' AND RegisterAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId);

SELECT
CASE WHEN  @SEN IS NOT NULL THEN 'Yes' ELSE 'No' END AS txtSENAccess,
CASE WHEN  @LAC IS NOT NULL THEN 'Yes' ELSE 'No' END AS txtLACAccess,
CASE WHEN  @FSM IS NOT NULL THEN 'Yes' ELSE 'No' END AS txtFSMAccess,
CASE WHEN  @PP IS NOT NULL THEN 'Yes' ELSE 'No' END AS txtPPAccess,
CASE WHEN  @SC IS NOT NULL THEN 'Yes' ELSE 'No' END AS txtSCAccess</CommandText></Query><Fields><Field Name="txtSENAccess"><DataField>txtSENAccess</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLACAccess"><DataField>txtLACAccess</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFSMAccess"><DataField>txtFSMAccess</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPPAccess"><DataField>txtPPAccess</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSCAccess"><DataField>txtSCAccess</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="RegistrationTypes"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT DISTINCT CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 'Other' ELSE UPPER(TblRegistrationSchoolRegistrationDateTime.txtAmPm) END AS txtType,
CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 2 ELSE 1 END AS intTypeOrder
FROM TblRegistrationSchoolRegistrationDateTime
WHERE TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @StartDate AND @EndDate
