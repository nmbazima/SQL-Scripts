<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>100ed8fb-e4a2-4b82-96f2-9bf7e7bae13d</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Detentions"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@intAuthorised"><Value>=Parameters!intAuthorised.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @SEN AS Integer;
SET @SEN = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
	WHERE txtReportingKey = '$SEN');
DECLARE @LAC AS Integer;
SET @LAC = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
	WHERE txtReportingKey = '$LookedAfter');
DECLARE @FSM AS Integer;
SET @FSM = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
	WHERE txtReportingKey = '$FreeSchoolMeals');
DECLARE @PP AS Integer;
SET @PP = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
	WHERE txtReportingKey = '$PupilPremium');
DECLARE @SC AS Integer;
SET @SC = (SELECT TblPupilRegistersRegister.TblPupilRegistersRegisterId FROM TblPupilRegistersRegister 
	WHERE txtReportingKey = '$ServiceChildren');


WITH PupilAddress AS 
(
SELECT	TblPupilManagementAddresses.TblPupilManagementAddressesID, 
TblPupilManagementAddresses.txtRelationType, 
TblPupilManagementAddresses.txtLabelSalutation,
TblPupilManagementAddresses.txtLetterSalutation,
TblPupilManagementAddresses.txtAddressType, 
TblPupilManagementAddresses.txtContactsTitle, 
TblPupilManagementAddresses.txtContactsForename, 
TblPupilManagementAddresses.txtContactsSurname, 
TblPupilManagementAddresses.txtSecondaryTitle, 
TblPupilManagementAddresses.txtSecondaryForename, 
TblPupilManagementAddresses.txtSecondarySurname, 
TblPupilManagementAddresses.txtAddress1, 
TblPupilManagementAddresses.txtAddress2, 
TblPupilManagementAddresses.txtAddress3, 
TblPupilManagementAddresses.txtTown, 
TblPupilManagementAddresses.txtCounty, 
TblPupilManagementAddresses.txtCountry, 
TblPupilManagementAddresses.txtPostcode, 
TblPupilManagementAddresses.txtWorkTelephone, 
TblPupilManagementAddresses.txtDayTelephone AS txtNotWorkTelephone, 
TblPupilManagementAddresses.txtMobile1, 
TblPupilManagementAddresses.txtMobile2, 
TblPupilManagementAddresses.txtEmail1, 
TblPupilManagementAddresses.txtEmail2, 
TblPupilManagementAddresses.intOrder AS intAddressOrder, 
TblPupilManagementAddresses.intStudentHome, 
TblPupilManagementAddressLink.txtSchoolID, 
TblUsefulLists.Description AS txtNumberOfPeople
FROM	TblPupilManagementAddresses
INNER JOIN TblPupilManagementAddressLink ON TblPupilManagementAddresses.TblPupilManagementAddressesID = TblPupilManagementAddressLink.intAddressID
LEFT OUTER JOIN TblUsefulLists ON TblPupilManagementAddresses.txtRelationType = TblUsefulLists.Name AND TblUsefulLists.ListType = 'ContactType'
WHERE	(TblPupilManagementAddresses.intStudentHome = 1)
),




KeyRegisters AS
(
SELECT	
	txtSchoolID,
	bOnRegister,
	intRegisterId
FROM    [dbo].[f_PupilRegisters_GetLatestScreeningLogs] (NULL, NULL) AS Register
INNER JOIN TblPupilRegistersRegister ON Register.intRegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId
WHERE intRegisterId IN (@SEN,@LAC,@SC)
AND TblPupilRegistersRegister.txtWorkflow &lt;&gt; 'RegisterWithRanges'

UNION ALL

SELECT	DISTINCT
	txtSchoolID,
	bOnRegister,
	intRegisterId
FROM    [dbo].f_PupilRegisters_GetLatestScreeningLogsOnRegisterWithRanges (NULL, @FSM) AS Register
INNER JOIN TblPupilRegistersRegister ON Register.intRegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId
WHERE bOnRegister = 1

UNION ALL
SELECT	DISTINCT
	txtSchoolID,
	bOnRegister,
	intRegisterId
FROM    [dbo].f_PupilRegisters_GetLatestScreeningLogsOnRegisterWithRanges (NULL, @PP) AS Register
INNER JOIN TblPupilRegistersRegister ON Register.intRegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId
WHERE bOnRegister = 1
)

SELECT	--core
		TblPupilManagementPupils.txtSchoolID, 
		TblPupilManagementPupils.txtForename, 
		TblPupilManagementPupils.txtSurname, 
		TblPupilManagementPupils.txtMiddleNames, 
		TblPupilManagementPupils.txtPreName, 
		TblPupilManagementPupils.txtDOB AS 'dtDOB', 
		TblPupilManagementPupils.intSystemStatus, 
		PupilArchive.txtForm, 
		TblPupilManagementPupils.txtGender, 
		TblPupilManagementPupils.txtNationality, 
		TblPupilManagementPupils.txtType, 
		TblPupilManagementPupils.txtEmailAddress, 
		TblPupilManagementPupils.txtCountryofResidence, 
		TblPupilManagementPupils.txtEthnicGroup, 
		TblPupilManagementPupils.txtBirthCountry, 
		TblPupilManagementPupils.txtLanguage, 
		PupilArchive.txtAcademicHouse, 
		PupilArchive.txtBoardingHouse, 
		PupilArchive.intNCYear,
		TblSchoolManagementYears.txtYearName,
	(CASE WHEN SENRegister.txtSchoolId IS NULL THEN 'No' WHEN SENRegister.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnSENRegister,
   (CASE WHEN LACRegister.txtSchoolId IS NULL THEN 'No' WHEN LACRegister.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnLACRegister,
   (CASE WHEN SCRegister.txtSchoolId IS NULL THEN 'No' WHEN SCRegister.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnSCRegister,
   (CASE WHEN FSMRegister.txtSchoolId IS NULL THEN 'No' WHEN FSMRegister.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnFSMRegister,
   (CASE WHEN PPRegister.txtSchoolId IS NULL THEN 'No' WHEN PPRegister.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnPPRegister,
		--detentions
		TblDisciplineManagerDetentionsPupils.TblDisciplineManagerDetentionsPupilsID, 
		TblDisciplineManagerDetentionsPupils.dDetentionDate,
		TblDisciplineManagerDetentionsPupils.txtOffenceCode,
		TblDisciplineManagerDetentionsPupils.txtOffenceDescription,

		TblTeachingManagerSubjectDepartments.txtDepartmentName,

		TblStaff.Title AS 'txtSubmittedByTitle',
		TblStaff.Firstname AS 'txtSubmittedByForename',
		TblStaff.Surname AS 'txtSubmittedBySurname',

		CASE WHEN TblDisciplineManagerDetentionsPupils.intHalfDt = 1 THEN 'Single' ELSE 'Double'  END AS 'Length',
		TblDisciplineManagerDetentionsPupils.txtWorkSet,
		CASE WHEN TblDisciplineManagerDetentionsPupils.intPresent = 1 THEN 'Yes' ELSE 'No'  END AS 'Present',
		CASE WHEN TblDisciplineManagerDetentionsPupils.intAuthorised = 1 THEN 'Yes' ELSE 'No'  END AS 'Authorised',

		TblDisciplineManagerDetentionsSessions.txtSessionName,
		TblDisciplineManagerDetentionsSessions.txtType AS txtDetentionType,
		TblSchoolManagementClassrooms.txtName AS txtDetentionLocation,
		
		
		--Address
		PupilAddress.TblPupilManagementAddressesID, 
		PupilAddress.txtRelationType, 
		PupilAddress.txtAddressType, 
		PupilAddress.txtContactsTitle, 
		PupilAddress.txtContactsForename, 
		PupilAddress.txtContactsSurname, 
		PupilAddress.txtSecondaryTitle, 
		PupilAddress.txtSecondaryForename, 
		PupilAddress.txtSecondarySurname, 
		PupilAddress.txtLabelSalutation,
		PupilAddress.txtLetterSalutation,
		PupilAddress.txtAddress1, 
		PupilAddress.txtAddress2, 
		PupilAddress.txtAddress3, 
		PupilAddress.txtTown, 
		PupilAddress.txtCounty, 
		PupilAddress.txtCountry, 
		PupilAddress.txtPostcode, 
		PupilAddress.txtWorkTelephone, 
		PupilAddress.txtNotWorkTelephone, 
		PupilAddress.txtMobile1, 
		PupilAddress.txtMobile2, 
		PupilAddress.txtEmail1, 
		PupilAddress.txtEmail2, 
		PupilAddress.intAddressOrder, 
		PupilAddress.intStudentHome, 
		PupilAddress.txtNumberOfPeople
FROM	TblPupilManagementPupils
INNER JOIN TblDisciplineManagerDetentionsPupils ON TblPupilManagementPupils.txtSchoolID = TblDisciplineManagerDetentionsPupils.txtSchoolID
CROSS APPLY uf_Registration_getPupilArchive(TblPupilManagementPupils.txtSchoolID,DateAdd(DAY,1,@EndDate)) AS PupilArchive
LEFT OUTER JOIN TblSchoolManagementYears ON PupilArchive.intNCYear = TblSchoolManagementYears.intNCYear
LEFT OUTER JOIN TblStaff ON TblDisciplineManagerDetentionsPupils.txtSubmittedBy = TblStaff.User_Code
LEFT OUTER JOIN TblTeachingManagerSubjectDepartments ON TblDisciplineManagerDetentionsPupils.intDepartment = TblTeachingManagerSubjectDepartments.TblTeachingManagerSubjectDepartmentsID
		
		LEFT OUTER JOIN TblDisciplineManagerDetentionsSessions ON TblDisciplineManagerDetentionsPupils.intDetentionSessionID = TblDisciplineManagerDetentionsSessions.TblDisciplineManagerDetentionsSessionsID
		LEFT OUTER JOIN TblSchoolManagementClassrooms ON TblDisciplineManagerDetentionsSessions.intLocation = TblSchoolManagementClassrooms.TblSchoolManagementClassroomsID
		LEFT OUTER JOIN PupilAddress ON TblPupilManagementPupils.txtSchoolID = PupilAddress.txtSchoolID
   LEFT OUTER JOIN KeyRegisters AS SENRegister ON TblPupilManagementPupils.txtSchoolID = SENRegister.txtSchoolId AND SENRegister.intRegisterId = @SEN
   LEFT OUTER JOIN KeyRegisters AS LACRegister ON TblPupilManagementPupils.txtSchoolID = LACRegister.txtSchoolId AND LACRegister.intRegisterId = @LAC
   LEFT OUTER JOIN KeyRegisters AS SCRegister ON TblPupilManagementPupils.txtSchoolID = SCRegister.txtSchoolId AND SCRegister.intRegisterId = @SC
   LEFT OUTER JOIN KeyRegisters AS FSMRegister ON TblPupilManagementPupils.txtSchoolID = FSMRegister.txtSchoolId AND FSMRegister.intRegisterId = @FSM
   LEFT OUTER JOIN KeyRegisters AS PPRegister ON TblPupilManagementPupils.txtSchoolID = PPRegister.txtSchoolId AND PPRegister.intRegisterId = @PP

WHERE TblDisciplineManagerDetentionsPupils.dDetentionDate BETWEEN @StartDate AND DateAdd(DAY,1,@EndDate)
AND TblDisciplineManagerDetentionsPupils.txtSchoolID IN (@txtSchoolID)
AND TblDisciplineManagerDetentionsPupils.intAuthorised IN (@intAuthorised);</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtDOB"><DataField>dtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intSystemStatus"><DataField>intSystemStatus</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtNationality"><DataField>txtNationality</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtType"><DataField>txtType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEmailAddress"><DataField>txtEmailAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCountryofResidence"><DataField>txtCountryofResidence</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEthnicGroup"><DataField>txtEthnicGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBirthCountry"><DataField>txtBirthCountry</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLanguage"><DataField>txtLanguage</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnSENRegister"><DataField>txtOnSENRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnLACRegister"><DataField>txtOnLACRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnSCRegister"><DataField>txtOnSCRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnFSMRegister"><DataField>txtOnFSMRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnPPRegister"><DataField>txtOnPPRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblDisciplineManagerDetentionsPupilsID"><DataField>TblDisciplineManagerDetentionsPupilsID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="dDetentionDate"><DataField>dDetentionDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtOffenceCode"><DataField>txtOffenceCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOffenceDescription"><DataField>txtOffenceDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDepartmentName"><DataField>txtDepartmentName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSubmittedByTitle"><DataField>txtSubmittedByTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSubmittedByForename"><DataField>txtSubmittedByForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSubmittedBySurname"><DataField>txtSubmittedBySurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Length"><DataField>Length</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtWorkSet"><DataField>txtWorkSet</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Present"><DataField>Present</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Authorised"><DataField>Authorised</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSessionName"><DataField>txtSessionName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDetentionType"><DataField>txtDetentionType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDetentionLocation"><DataField>txtDetentionLocation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblPupilManagementAddressesID"><DataField>TblPupilManagementAddressesID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRelationType"><DataField>txtRelationType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddressType"><DataField>txtAddressType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtContactsTitle"><DataField>txtContactsTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtContactsForename"><DataField>txtContactsForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtContactsSurname"><DataField>txtContactsSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSecondaryTitle"><DataField>txtSecondaryTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSecondaryForename"><DataField>txtSecondaryForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSecondarySurname"><DataField>txtSecondarySurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLabelSalutation"><DataField>txtLabelSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLetterSalutation"><DataField>txtLetterSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress1"><DataField>txtAddress1</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress2"><DataField>txtAddress2</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress3"><DataField>txtAddress3</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTown"><DataField>txtTown</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCounty"><DataField>txtCounty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCountry"><DataField>txtCountry</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPostcode"><DataField>txtPostcode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtWorkTelephone"><DataField>txtWorkTelephone</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtNotWorkTelephone"><DataField>txtNotWorkTelephone</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMobile1"><DataField>txtMobile1</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMobile2"><DataField>txtMobile2</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEmail1"><DataField>txtEmail1</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEmail2"><DataField>txtEmail2</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intAddressOrder"><DataField>intAddressOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intStudentHome"><DataField>intStudentHome</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtNumberOfPeople"><DataField>txtNumberOfPeople</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS txtSchoolLogoPath, txtName
FROM TblReportsCustomImages
WHERE TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Disclaimer"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Path"><Value>=Globals!ReportFolder</Value></QueryParameter><QueryParameter Name="@Report"><Value>=Globals!ReportName</Value></QueryParameter></QueryParameters><CommandText>SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
FROM	TblSQLReportingServicesDisclaimerReport
		INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report</CommandText></Query><Fields><Field Name="txtDisclaimerBackgroundColour"><DataField>txtDisclaimerBackgroundColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerBorderColour"><DataField>txtDisclaimerBorderColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerDescription"><DataField>txtDisclaimerDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTextColour"><DataField>txtDisclaimerTextColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTitle"><DataField>txtDisclaimerTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SEN"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT SchoolId AS txtSchoolId, 
       OnRegister
FROM f_PupilRegisters_GetSenRegisterStudents();</CommandText></Query><Fields><Field Name="txtSchoolId"><DataField>txtSchoolId</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="OnRegister"><DataField>OnRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="YearGroups"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	-100 AS intNCYear, 'No Year Group' AS txtYearName
	UNION ALL
SELECT	intNCYear, txtYearName
FROM	TblSchoolManagementYears
ORDER BY intNCYear</CommandText></Query><Fields><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Students"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter><QueryParameter Name="@intAuthorised"><Value>=Parameters!intAuthorised.Value</Value></QueryParameter></QueryParameters><CommandText>

SELECT	DISTINCT
		TblPupilManagementPupils.txtSchoolID, 
		TblPupilManagementPupils.txtSurname + ', ' + TblPupilManagementPupils.txtForename  AS txtStudentName
		

FROM	TblPupilManagementPupils
INNER JOIN TblDisciplineManagerDetentionsPupils ON TblPupilManagementPupils.txtSchoolID = TblDisciplineManagerDetentionsPupils.txtSchoolID
CROSS APPLY uf_Registration_getPupilArchive(TblDisciplineManagerDetentionsPupils.txtSchoolID,DateAdd(DAY,1,@EndDate)) AS PupilArchive

LEFT OUTER JOIN TblDisciplineManagerDetentionsSessions ON TblDisciplineManagerDetentionsPupils.intDetentionSessionID = TblDisciplineManagerDetentionsSessions.TblDisciplineManagerDetentionsSessionsID

WHERE
Convert(Date,TblDisciplineManagerDetentionsPupils.dDetentionDate) BETWEEN @StartDate AND DateAdd(DAY,1,@EndDate)
AND (CASE WHEN PupilArchive.intNCYear IS NULL THEN -100 ELSE PupilArchive.intNCYear END IN (@intNCYear))
AND TblDisciplineManagerDetentionsPupils.intAuthorised IN (@intAuthorised)

ORDER BY txtStudentName</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtStudentName"><DataField>txtStudentName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="User"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 
	TbliSAMSManagerUsers.txtUsername,
	TbliSAMSManagerUsers.txtFirstname,
	TbliSAMSManagerUsers.txtSurname,
	TbliSAMSManagerUsers.txtEmailAddress
FROM TbliSAMSManagerUsers
WHERE TbliSAMSManagerUsers.txtUserCode = @userCode</CommandText></Query><Fields><Field Name="txtUsername"><DataField>txtUsername</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFirstname"><DataField>txtFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEmailAddress"><DataField>txtEmailAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="LACAccess"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	RegisterId 
FROM	[dbo].[f_PupilRegisters_GetRegistersWithReadActivityPermission] (@userCode)
WHERE	RegisterId = (SELECT TblPupilRegistersRegisterID FROM TblPupilRegistersRegister WHERE txtReportingKey ='$LookedAfter')</CommandText></Query><Fields><Field Name="RegisterId"><DataField>RegisterId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="SENAccess"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	RegisterId 
FROM	[dbo].[f_PupilRegisters_GetRegistersWithReadActivityPermission] (@userCode)
WHERE	RegisterId = (SELECT TblPupilRegistersRegisterID FROM TblPupilRegistersRegister WHERE txtReportingKey ='$SEN')</CommandText></Query><Fields><Field Name="RegisterId"><DataField>RegisterId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="FSMAccess"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	RegisterId 
FROM	[dbo].[f_PupilRegisters_GetRegistersWithReadActivityPermission] (@userCode)
WHERE	RegisterId = (SELECT TblPupilRegistersRegisterID FROM TblPupilRegistersRegister WHERE txtReportingKey ='$FreeSchoolMeals')</CommandText></Query><Fields><Field Name="RegisterId"><DataField>RegisterId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="PPAccess"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	RegisterId 
FROM	[dbo].[f_PupilRegisters_GetRegistersWithReadActivityPermission] (@userCode)
