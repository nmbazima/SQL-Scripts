<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>271a32af-b61c-4a8b-b114-0e61e813fcdc</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="StaffContract"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intDivisions"><Value>=Parameters!intDivisions.Value</Value></QueryParameter><QueryParameter Name="@IncArchived"><Value>=Parameters!IncArchived.Value</Value></QueryParameter><QueryParameter Name="@EmploymentType"><Value>=Parameters!EmploymentType.Value</Value></QueryParameter><QueryParameter Name="@StaffRole"><Value>=Parameters!StaffRole.Value</Value></QueryParameter></QueryParameters><CommandText>WITH StaffContractDivisions AS
(
SELECT STUFF((SELECT DISTINCT ',' + TblSchoolManagementSchoolDivisions.txtName
FROM TblStaffManagementContract AS ContactDivision
LEFT OUTER JOIN TblSchoolManagementSchoolDivisions ON TblSchoolManagementSchoolDivisions.txtCode IN (SELECT Element FROM f_SplitStringByDelimiter(ContactDivision.txtContractSchoolDivision, '@'))
WHERE ContactDivision.intStaffID = TblStaffManagementContract.intStaffID
FOR XML PATH('')), 1, 1, '') AS txtStaffContactDivisionName,
TblStaffManagementContract.intStaffID AS intStaffContactDivisionStaffID,
TblStaffManagementContract.TblStaffManagementContractID AS intStaffContactDivisionContractID
FROM TblStaffManagementContract
)
SELECT	StaffContractDivisions.txtStaffContactDivisionName AS txtSchoolDivisionName, TblStaffManagementContract.*,  TblStaff.*
FROM	TblStaffManagementContract
INNER JOIN TblStaff ON TblStaffManagementContract.intStaffID = TblStaff.tblStaffID
LEFT OUTER JOIN StaffContractDivisions ON TblStaffManagementContract.intStaffID = StaffContractDivisions.intStaffContactDivisionStaffID AND TblStaffManagementContract.TblStaffManagementContractID = StaffContractDivisions.intStaffContactDivisionContractID
LEFT OUTER JOIN TblStaffManagementDivisions ON TblStaff.TblStaffID = TblStaffManagementDivisions.intStaff
LEFT OUTER JOIN TblSchoolManagementSchoolDivisions ON TblSchoolManagementSchoolDivisions.txtCode IN (SELECT Element FROM f_SplitStringByDelimiter(TblStaffManagementContract.txtContractSchoolDivision, '@'))
WHERE	ISNULL(TblSchoolManagementSchoolDivisions.TblSchoolManagementSchoolDivisionsID,0) IN (@intDivisions)
		AND CASE WHEN dteDateArchived IS NULL THEN 1 ELSE 0 END &gt;= @IncArchived
		AND txtEmploymentType IN (@EmploymentType)
		AND txtStaffRole IN (@StaffRole)</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="TblStaffManagementContractID"><DataField>TblStaffManagementContractID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="TblStaffID"><DataField>TblStaffID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intStaffID"><DataField>intStaffID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtContract"><DataField>txtContract</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dteContractStartDate"><DataField>dteContractStartDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dteContractFinishDate"><DataField>dteContractFinishDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtEmploymentType"><DataField>txtEmploymentType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDfeRoleIdentifier"><DataField>txtDfeRoleIdentifier</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtContractType"><DataField>txtContractType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtContractSchoolDivision"><DataField>txtContractSchoolDivision</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtStaffRole"><DataField>txtStaffRole</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dteDateArchived"><DataField>dteDateArchived</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dteDateCreated"><DataField>dteDateCreated</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dteSubmitDateTime"><DataField>dteSubmitDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtSubmitBy"><DataField>txtSubmitBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOrigin"><DataField>txtOrigin</DataField><rd:TypeName>System.String</rd:TypeName>