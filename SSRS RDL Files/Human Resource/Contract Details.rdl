ORDER BY TblSchoolManagementSchoolDivisionsID</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="TblSchoolManagementSchoolDivisionsID"><DataField>TblSchoolManagementSchoolDivisionsID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="EmploymentType"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT DISTINCT txtEmploymentType
