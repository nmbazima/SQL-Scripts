rver/reporting/reportdesigner">System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets><Code>
		Shared offset As Integer
		Public pageCountSubjects As Integer =0
		Public pageCountExtra As Integer =0
		Public pageCountBoarding As Integer =0

		Public Function GetPN(reset As Boolean, pagenumber As Integer) As Integer
		If reset
		offset = pagenumber - 1
		End If

		Return pagenumber - offset
		End Function


		Public Function ResetV() As Integer
		pageCountExtra =0
		pageCountSubjects =0
		pageCountBoarding =0
		End Function

		Public Function CountSubjects() As Integer
		pageCountSubjects = pageCountSubjects + 1
		Return pageCountSubjects
		End Function

		Public Function CountExtra() As Integer
		pageCountExtra =1
		Return pageCountExtra
		End Function

		Public Function CountBoarding() As Integer
		pageCountBoarding = 1
		Return pageCountBoarding
		End Function
	</Code><EmbeddedImages><EmbeddedImage Name="princethorpe"><MIMEType>image/png</MIMEType><ImageData>



























