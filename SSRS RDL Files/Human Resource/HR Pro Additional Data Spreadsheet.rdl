ts><Textbox Name="Textbox223"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">Textbox223</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox219"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">Textbox219</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox236"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">Textbox236</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox232"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">Textbox232</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><Group Name="Details"><GroupExpressions><GroupExpression>=Fields!TblStaffID.Value</GroupExpression><GroupExpression>=Fields!TblStaffManagementContractID.Value</GroupExpression></GroupExpressions></Group></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>iSAMS</DataSetName><Height>2.4cm</Height><Width>233.61125cm</Width><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><Height>2.4cm</Height><Style /></Body><Width>233.61125cm</Width><Page><PageHeight>29.7cm</PageHeight><PageWidth>21cm</PageWidth><InteractiveHeight>11in</InteractiveHeight><InteractiveWidth>8.5in</InteractiveWidth><ColumnSpacing>1cm</ColumnSpacing><Style /></Page><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">None</rd:SecurityType><rd:DataSourceID xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">321bffd8-e727-43e0-a334-a5c0f89fb3b6</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="iSAMS"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>With PersonalAddress AS (
Select 
TblStaffManagementAddressLink.intStaffID,
TblStaffManagementAddresses.*

FROM TblStaffManagementAddressLink
	  LEFT OUTER JOIN
	  TblStaffManagementAddresses
	  ON TblStaffManagementAddressLink.intAddressID = TblStaffManagementAddresses.TblStaffManagementAddressesID
	  Where txtRelationType = 'self'
	  ) 

Select 
TblStaff.*,
PersonalAddress.*,
TblStaffManagementHealth.txtDisabilityStatus,
TblStaffManagementHealth.txtAdditionalHealth,

TblStaffManagementContract.TblStaffManagementContractID,
TblStaffManagementContract.txtContractType,
TblStaffManagementContract.txtEmploymentType,
TblStaffManagementContract.txtContractSchoolDivision,
TblStaffManagementContract.dteContractStartDate,
TblStaffManagementContract.dteContractFinishDate,
TblStaffManagementContract.txtStaffRole,

TblSchoolManagementSchoolDivisions.txtName AS txtStaffManagementDivision,


TblSchoolManagementSchoolDivisions.txtName,
TblStaffManagementSchoolRolesObjects.txtSchoolRolesName,
TblStaffManagementSchoolRoles.intOrder,


TblSchoolManagementNonTeachingDepartments.txtDepartmentName AS txtNonTeachingDepartmentsName,
TblTeachingManagerSubjectDepartments.txtDepartmentName AS txtTeachingDepartmentsName,

tblstaffmanagementEthnicCategory.txtDescription AS txtEthnicCategory

from
TblStaff

LEFT OUTER JOIN TblStaffManagementDivisions ON TblStaff.TblStaffID = TblStaffManagementDivisions.intStaff
LEFT OUTER JOIN TblSchoolManagementSchoolDivisions ON TblStaffManagementDivisions.intDivision = TblSchoolManagementSchoolDivisions.TblSchoolManagementSchoolDivisionsID

LEFT OUTER JOIN TblStaffManagementSchoolRoles ON TblStaff.TblstaffID = TblStaffManagementSchoolRoles.intStaff 
		and ISNULL(TblStaffManagementSchoolRoles.intOrder,0) = 0
LEFT OUTER JOIN TblStaffManagementSchoolRolesObjects ON TblStaffManagementSchoolRoles.intSchoolRole = TblStaffManagementSchoolRolesObjects.TblStaffManagementSchoolRolesObjectsID

LEFT OUTER JOIN	TblStaffManagementContract ON TblStaff.tblStaffID = TblStaffManagementContract.intStaffID

LEFT OUTER JOIN TblStaffManagementDepartmentLink ON TblStaff.tblStaffID = TblStaffManagementDepartmentLink.intStaffID

LEFT OUTER JOIN TblSchoolManagementNonTeachingDepartments ON TblStaffManagementDepartmentLink.intDepartmentID = TblSchoolManagementNonTeachingDepartments.TblSchoolManagementNonTeachingDepartmentsID
			AND TblStaffManagementDepartmentLink.blnTeaching = 0

LEFT OUTER JOIN TblTeachingManagerSubjectDepartments ON TblStaffManagementDepartmentLink.intDepartmentID = TblTeachingManagerSubjectDepartments.TblTeachingManagerSubjectDepartmentsID
			AND TblStaffManagementDepartmentLink.blnTeaching = 1

LEFT OUTER JOIN PersonalAddress ON TblStaff.tblStaffID = PersonalAddress.intStaffID

LEFT OUTER JOIN tblstaffmanagementethniccategorylink ON TblStaff.TblStaffID = tblstaffmanagementethniccategorylink.intStaffID
LEFT OUTER JOIN tblstaffmanagementEthnicCategory ON tblstaffmanagementethniccategorylink.intEthnicCategoryID = tblstaffmanagementEthnicCategory.TblStaffManagementEthnicCategoryID

LEFT OUTER JOIN TblStaffManagementHealth ON TblStaff.TblStaffID = TblStaffManagementHealth.intStaff



WHERE
TblStaff.SystemStatus = 1</CommandText></Query><Fields><Field Name="TblStaffID"><DataField>TblStaffID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="StaffID"><DataField>StaffID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtContractType"><DataField>txtContractType</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="TblStaffID_Old"><DataField>TblStaffID_Old</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtEmploymentType"><DataField>txtEmploymentType</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intPersonID"><DataField>intPersonID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtContractSchoolDivision"><DataField>txtContractSchoolDivision</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtPreviousMISStaffID"><DataField>txtPreviousMISStaffID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtStaffManagementDivision"><DataField>txtStaffManagementDivision</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="EthnicGroup"><DataField>EthnicGroup</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="Initials"><D