<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>f53182da-1c75-4920-bcdb-db24829fa752</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Staff"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT ExternalSystemId.ExternalId AS [HR Pro Id], TblStaff.TblStaffID, TblStaff.Firstname, TblStaff.Surname, TblStaff.DOB, TblStaff.SchoolEmailAddress
FROM TblStaff
INNER JOIN systemconfig.ExternalSystemId ON TblStaff.TblStaffID = ExternalSystemId.InternalId
WHERE ExternalSystemId.Entity = 'Employee' AND ExternalSystemId.ExternalSystemKey = 'IHRP'</CommandText></Query><Fields><Field Name="HR_Pro_Id"><DataField>HR Pro Id</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblStaffID"><DataField>TblStaffID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DOB"><DataField>DOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="SchoolEmailAddress"><DataField>SchoolEmailAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>4.5cm</Width></TablixColumn><TablixColumn><Width>4.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>7.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>HR Pro ID</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><rd:Selected>true</rd:Selected></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>iSAMS Staff ID</Va