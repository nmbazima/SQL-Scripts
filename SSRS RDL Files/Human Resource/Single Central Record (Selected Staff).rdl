blixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember><TablixMember><FixedData>true</FixedData></TablixMember></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><Group Name="Details"><GroupExpressions><GroupExpression>=Fields!TblStaffID.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=iif(Fields!intStaffSystemStatus.Value=1, 0, iif(Fields!intStaffSystemStatus.Value=-1, 1,2))</Value></SortExpression><SortExpression><Value>txtOrginalPostStartDate</Value><Direction>Descending</Direction></SortExpression><SortExpression><Value>=Fields!txtStaffSurname.Value</Value></SortExpression><SortExpression><Value>=Fields!txtStaffFirstname.Value</Value></SortExpression><SortExpression><Value>=Fields!TblStaffID.Value</Value></SortExpression><SortExpression><Value>=Fields!dtStaffEnrolmentDate.Value</Value></SortExpression></SortExpressions></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>SCR</DataSetName><Height>3.28521cm</Height><Width>185cm</Width><Visibility><Hidden>=IIF(Parameters!TblStaffID.Value="", True, False)</Hidden></Visibility><Style><Border><Style>None</Style></Border></Style></Tablix><Textbox Name="Textbox12"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>This report is designed to work only in the staff selector instead of Reports tab.
Please select this report in Human Resources Manager &gt; Manage Staff &gt; search for staff, select members of staff &gt; white drop down &gt; Custom Reports.</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox11</rd:DefaultName><Top>3.36816cm</Top><Height>0.77368cm</Height><Width>29.64626cm</Width><ZIndex>1</ZIndex><Visibility><Hidden>=IIF(Parameters!TblStaffID.Value = "", False, True)</Hidden></Visibility><Style><Border><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></ReportItems><Height>1.63065in</Height><Style /></Body><Width>72.83465in</Width><Page><PageHeight>21cm</PageHeight><PageWidth>29.7cm</PageWidth><LeftMargin>0.2cm</LeftMargin><RightMargin>0cm</RightMargin><TopMargin>0.2cm</TopMargin><BottomMargin>0cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>271a32af-b61c-4a8b-b114-0e61e813fcdc</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="SCR"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@TblStaffID"><Value>=Parameters!TblStaffID.Value</Value></QueryParameter></QueryParameters><CommandText>with Roles as  (select * from (SELECT TblStaffManagementSchoolRoles.intStaff,  
 TblStaffManagementSchoolRolesObjects.tblStaffManagementSchoolRolesObjectsID,
    TblStaffManagementSchoolRolesObjects.txtSchoolRolesName, TblStaffManagementSchoolRoles.intOrder
, rank() over(partition by TblStaffManagementSchoolRoles.intStaff ORDER BY TblStaffManagementSchoolRoles.intOrder) as rnk

FROM TblStaffManagementSchoolRoles 
	INNER JOIN TblStaffManagementSchoolRolesObjects ON TblStaffManagementSchoolRoles.intSchoolRole = TblStaffManagementSchoolRolesObjects.tblStaffManagementSchoolRolesObjectsID
where TblStaffManagementSchoolRolesObjects.intDelete = 0
) tmpRoles
 where rnk = 1
  )  


SELECT

--Staff Details

    TblStaff.TblStaffID, 
    TblStaff.Title as txtStaffTitle,
    TblStaff.Firstname as txtStaffFirstname,
    TblStaff.Surname as txtStaffSurname,
    TblStaff.fullname as txtStaffFullname,
    TblStaff.Dob as dtStaffDOB,
    TblStaff.Sex as txtStaffGender,
    TblStaff.SystemStatus as intStaffSystemStatus,
    TblStaff.EnrolmentDate as dtStaffEnrolmentDate,
    TblStaff.intEnrolmentSchoolYear as intStaffEnrolmentSchoolYear,
    TblStaff.EnrolmentTerm as txtEnrolmentTerm,
    TblStaff.LeavingDate as dtStaffLeavingDate,
    TblStaff.intLeavingSchoolYear as intStaffLEavingSchoolYear,
    TblStaff.LeavingTerm as txtStaffLeavingTerm,
    TblStaff.TeachingStaff as blnStaffTeachingStaff,
------------------------ADD MORE STAFF DETAILS HERE
 
--Staff Roles
    MainRole.tblStaffManagementSchoolRolesObjectsID as intStaffMainRoleID,
    MainRole.txtSchoolRolesName AS txtStaffMainRole, 
      MainRole.intorder,

--Identity
    TblStaffManagementSCRIdentityDetails.TblStaffManagementSCRIdentityDetailsID as intIdentityDetailsID,
    TblStaffManagementSCRIdentityDetails.txtForename as txtIdentityDetailsForename,
    TblStaffManagementSCRIdentityDetails.txtSurname as txtIdentityDetailsSurname,
    TblStaffManagementSCRIdentityDetails.txtAddress1 as txtIdentityDetailsAddress1,
    TblStaffManagementSCRIdentityDetails.txtAddress2 as txtIdentityDetailsAddress2,
    TblStaffManagementSCRIdentityDetails.txtAddress3 as txtIdentityDetailsAddress3,
    TblStaffManagementSCRIdentityDetails.txtTown as txtIdentityDetailsTown,
    TblStaffManagementSCRIdentityDetails.txtCounty as txtIdentityDetailsCounty,
    TblStaffManagementSCRIdentityDetails.txtCountry as txtIdentityDetailsCountry,
    TblStaffManagementSCRIdentityDetails.txtPostcode as txtIdentityDetailsPostcode,
    
    TblStaffManagementSCRIdentityCheck.TblStaffManagementSCRIdentityCheckID as intIdentityCheckID,
    TblStaffManagementSCRIdentityCheck.txtCheckStatus as txtIdentityCheckStatusOfCheck,
    TblStaffManagementSCRIdentityCheck.txtEvidenceSeen as txtIdentityCheckEvidenceSeen,
    TblStaffManagementSCRIdentityCheck.dtDateChecked as dtIdentityCheckDateChecked,
    TblStaffManagementSCRIdentityCheck.txtCheckedBy as txtIdentityCheckCheckedBy,
    IIF(TblStaffManagementSCRIdentityCheckUsers.txtFirstname  is null, TblStaffSCRIdentityCheckUsers.Firstname, TblStaffManagementSCRIdentityCheckUsers.txtFirstname) as txtIdentityCheckCheckedByFirstname,
    IIF(TblStaffManagementSCRIdentityCheckUsers.txtSurname  is null, TblStaffSCRIdentityCheckUsers.Surname,TblStaffManagementSCRIdentityCheckUsers.txtSurname) as txtIdentityCheckCheckedBySurname,

--Qualifications

    TblStaffManagementSCRChecks.blnQualificationCheckRequired as blnQualificationRequirementCheckRequired,
    
    TblStaffManagementSCRQualificationCheck.TblStaffManagementSCRQualificationCheckID as intQualificationCheckID,
    TblStaffManagementSCRQualificationCheck.txtCheckStatus as txtQualificationCheckStatusOfCheck,
    TblStaffManagementSCRQualificationCheck.txtEvidenceSeen as txtQualificationCheckQualificationEvidenced,
    TblStaffManagementSCRQualificationCheck.dtDateChecked as dtQualificationCheckDateChecked,
    TblStaffManagementSCRQualificationCheck.txtCheckedBy as txtQualificationCheckCheckedBy,
    IIF(TblStaffManagementSCRQualificationCheckUsers.txtFirstname is null, TblStaffSCRQualificationCheckUsers.Firstname, TblStaffManagementSCRQualificationCheckUsers.txtFirstname) as txtQualificationCheckCheckedByFirstname,
    IIF(TblStaffManagementSCRQualificationCheckUsers.txtSurname is null, TblStaffSCRQualificationCheckUsers.Surname, TblStaffManagementSCRQualificationCheckUsers.txtSurname) as txtQualificationCheckCheckedBySurname,

--Registration

    TblStaffManagementSCRChecks.blnRegistrationCheckRequired as blnRegistrationRequirementCheckedRequired,
    
    TblStaffManagementSCRRegistrationCheck.TblStaffManagementSCRRegistrationCheckID as intRegistrationCheckID,
    TblStaffManagementSCRRegistrationCheck.txtCheckStatus as txtRegistrationCheckStatusOfCheck,
    TblStaffManagementSCRRegistrationCheck.txtRegistrationEvidenced as txtRegistrationCheckRegistrationEvidenced,
    TblStaffManagementSCRRegistrationCheck.dtDateChecked as dtRegistrationCheckDateChecked,
    TblStaffManagementSCRRegistrationCheck.txtCheckedBy as txtRegistrationCheckCheckedBy,
    IIF(TblStaffManagementSCRRegistrationCheckUsers.txtFirstname  is null, TblStaffSCRRegistrationCheckUsers.Firstname, TblStaffManagementSCRRegistrationCheckUsers.txtFirstname)  as txtRegistrationCheckCheckedFirstname,
    IIF(TblStaffManagementSCRRegistrationCheckUsers.txtSurname  is null,TblStaffSCRRegistrationCheckUsers.Surname, TblStaffManagementSCRRegistrationCheckUsers.txtSurname) as txtRegistrationCheckCheckedSurname,

--Teaching

    TblStaffManagementSCRChecks.blnTeachingCheckRequired as blnProhibitionFromTeachingRequirementCheckRequired,
    
    TblStaffManagementSCRTeachingCheck.TblStaffManagementSCRTeachingCheckID as intProhibitionFromTeachingCheckID,
	TblStaffManagementSCRTeachingCheck.txtCheckType as intProhibitionFromTeachingCheckType,
    TblStaffManagementSCRTeachingCheck.txtCheckStatus as txtProhibitionFromTeachingCheckStatusOfCheck,
    TblStaffManagementSCRTeachingCheck.dtDateChecked as dtProhibitionFromTeachingCheckDateChecked,
    TblStaffManagementSCRTeachingCheck.txtCheckedBy as txtProhibitionFromTeachingCheckCheckedBy,
    IIF(TblStaffManagementSCRTeachingCheckUsers.txtFirstname  is null,TblStaffSCRTeachingCheckUsers.Firstname, TblStaffManagementSCRTeachingCheckUsers.txtFirstname) as txtProhibitionFromTeachingCheckCheckedFirstname,
	IIF(TblStaffManagementSCRTeachingCheckUsers.txtSurname  is null, TblStaffSCRTeachingCheckUsers.Surname,TblStaffManagementSCRTeachingCheckUsers.txtSurname) as txtProhibitionFromTeachingCheckCheckedSurname,
--DBS

    TblStaffManagementSCRChecks.blnDBSCheckRequired as blnDBSRequirementCheckRequired,
    
    TblStaffManagementSCRDisclosureBarringServiceCheck.TblStaffManagementSCRDisclosureBarringServiceCheckID as intDBSCheckID,
    TblStaffManagementSCRDisclosureBarringServiceCheck.txtCheckStatus as txtDBSCheckStatusOfCheck,
    TblStaffManagementSCRDisclosureBarringServiceCheck.txtDisclosureType as txtDBSCheckDisclosureType,
    TblStaffManagementSCRDisclosureBarringServiceCheck.txtDBSNumber as txtDBSCheckDBSNumber,
    TblStaffManagementSCRDisclosureBarringServiceCheck.dtDateRequested as dtDBSCheckDateRequested,
    TblStaffManagementSCRDisclosureBarringServiceCheck.txtRequestedBy as txtDBSCheckRequestedBy,
    IIF(TblStaffManagementSCRDisclosureBarringServiceCheckRequestedByUsers.txtFirstname  is null, TblStaffSCRDisclosureBarringServiceCheckRequestedByUsers.Firstname,TblStaffManagementSCRDisclosureBarringServiceCheckRequestedByUsers.txtFirstname) as txtDBSCheckRequestedByFirstname,
	IIF(TblStaffManagementSCRDisclosureBarringServiceCheckRequestedByUsers.txtSurname is null, TblStaffSCRDisclosureBarringServiceCheckRequestedByUsers.Surname,TblStaffManagementSCRDisclosureBarringServiceCheckRequestedByUsers.txtSurname) as txtDBSCheckRequestedBySurname,

   TblStaffManagementSCRDisclosureBarringServiceCheck.dtDateReceived as dtDBSCheckDateReceived,
    TblStaffManagementSCRDisclosureBarringServiceCheck.dtDateOfDisclosure as dtDBSOrignialCheckDateOfDisclosure,
    TblStaffManagementSCRDisclosureBarringServiceCheck.dtCurrentDateOfDisclosure as dtDBSCurrentCheckDateOfDisclosure,
    TblStaffManagementSCRDisclosureBarringServiceCheck.dtDateChecked as dtDBSCheckDateChecked,
    TblStaffManagementSCRDisclosureBarringServiceCheck.txtCheckedBy as txtDBSCheckCheckedBy,
    TblStaffManagementSCRDisclosureBarringServiceCheckUsers.txtFullName as txtDBSCheckCheckedByName,
    IIF(TblStaffManagementSCRDisclosureBarringServiceCheckUsers.txtFirstname  is null, TblStaffSCRDisclosureBarringServiceCheckUsers.Firstname, TblStaffManagementSCRDisclosureBarringServiceCheckUsers.txtFirstname) as txtDBSCheckCheckedByFirstName,
    IIF(TblStaffManagementSCRDisclosureBarringServiceCheckUsers.txtSurname  is null, TblStaffSCRDisclosureBarringServiceCheckUsers.Surname, TblStaffManagementSCRDisclosureBarringServiceCheckUsers.txtSurname) as txtDBSCheckCheckedBySurname,
    TblStaffManagementSCRDisclosureBarringServiceCheck.blnIncludeBarredListCheck as blnDBSCheckIncludeABarredListCheck,
    TblStaffManagementSCRDisclosureBarringServiceCheck.txtNotes as txtDBSCheckNotes,

    TblStaffManagementSCRChecks.blnDBSPortabilityCheckRequired as blnDBSUpdatedServicePortabilityCheckCheckRequired,
    TblStaffManagementSCRPortableDisclosureBarringServiceCheck.TblStaffManagementSCRPortableDisclosureBarringServiceCheckID as intDBSUpdatedServicePortabilityCheckID,
    TblStaffManagementSCRPortableDisclosureBarringServiceCheck.txtCheckStatus as txtDBSUpdatedServicePortabilityCheckStatusOfCheck,
    TblStaffManagementSCRPortableDisclosureBarringServiceCheck.dtDateChecked as dtDBSUpdatedServicePortabilityCheckDateChecked,
    TblStaffManagementSCRPortableDisclosureBarringServiceCheck.txtCheckedBy as txtDBSUpdatedServicePortabilityCheckCheckedBy,
    TblStaffManagementSCRPortableDisclosureBarringServiceCheckUsers.txtFullName as txtDBSUpdatedServicePortabilityCheckCheckedByName,
    IIF(TblStaffManagementSCRPortableDisclosureBarringServiceCheckUsers.txtFirstname  is null, TblStaffSCRPortableDisclosureBarringServiceCheckUsers.Firstname, TblStaffManagementSCRPortableDisclosureBarringServiceCheckUsers.txtFirstname) as txtDBSUpdatedServicePortabilityCheckCheckedByFirstName,
    IIF( TblStaffManagementSCRPortableDisclosureBarringServiceCheckUsers.txtSurname is null, TblStaffSCRPortableDisclosureBarringServiceCheckUsers.Surname, TblStaffManagementSCRPortableDisclosureBarringServiceCheckUsers.txtSurname) as txtDBSUpdatedServicePortabilityCheckCheckedBySurname,
    TblStaffManagementSCRChecks.blnChildrensBarredListCheckRequired as blnChildrensBarredListRequirementSeparateCheckRequired, 

 
 
    TblStaffManagementSCRChildrensBarredListCheck.TblStaffManagementSCRChildrensBarredListCheckID as intChildrensBarredListCheckID,
    TblStaffManagementSCRChildrensBarredListCheck.txtCheckStatus as txtChildrensBarredListCheckStatusOfCheck,
    TblStaffManagementSCRChildrensBarredListCheck.dtDateRequested as dtChildrensBarredListCheckDateRequested,
    TblStaffManagementSCRChildrensBarredListCheck.txtRequestedBy as txtChildrensBarredListCheckRequestedBy,
    TblStaffManagementSCRChildrensBarredListCheckRequestedByUsers.txtFullName as txtChildrensBarredListCheckRequestedByName,
    TblStaffManagementSCRChildrensBarredListCheck.dtDateReceived as dtChildrensBarredListCheckDateReceived,
    TblStaffManagementSCRChildrensBarredListCheck.dtDateChecked as dtChildrensBarredListCheckDateOfCheck,
    TblStaffManagementSCRChildrensBarredListCheck.txtCheckedBy as txtChildrensBarredListCheckCheckedBy,
    IIF(TblStaffManagementSCRChildrensBarredListCheckUsers.txtFirstname is null, TblStaffSCRChildrensBarredListCheckUsers.Firstname, TblStaffManagementSCRChildrensBarredListCheckUsers.txtFirstname) as txtChildrensBarredListCheckCheckedByFirstname,
	IIF( TblStaffManagementSCRChildrensBarredListCheckUsers.txtSurname is null, TblStaffSCRChildrensBarredListCheckUsers.Surname, TblStaffManagementSCRChildrensBarredListCheckUsers.txtSurname) as txtChildrensBarredListCheckCheckedBySurname,
    TblStaffManagementSCRChildrensBarredListCheck.txtNotes as txtChildrensBarredListCheckNotes,

--Right to Work

    TblStaffManagementSCRChecks.blnRightToWorkCheckRequired as blnRightToWorkRequirementCheckRequired,
    
    TblStaffManagementSCRRightToWorkCheck.TblStaffManagementSCRRightToWorkCheckID as intRightToWorkCheckID,
    TblStaffManagementSCRRightToWorkCheck.txtCheckStatus as txtRightToWorkCheckStatusOfCheck,
    TblStaffManagementSCRRightToWorkCheck.txtCheckType as txtRightToWorkCheckCheckType,
    TblStaffManagementSCRRightToWorkCheck.txtCheckCarriedOut as txtRightToWorkCheckCheckCarriedOut,
    TblStaffManagementSCRRightToWorkCheck.txtEvidenceSeen as txtRightToWorkCheckEvidenceSeen,
    TblStaffManagementSCRRightToWorkCheck.dtDateChecked as dtRightToWorkCheckDateChecked,
    TblStaffManagementSCRRightToWorkCheck.txtCheckedBy as txtRightToWorkCheckCheckedBy,
    IIF(TblStaffManagementSCRRightToWorkCheckUsers.txtFirstname is null, TblStaffSCRRightToWorkCheckUsers.Firstname, TblStaffManagementSCRRightToWorkCheckUsers.txtFirstname) as txtRightToWorkCheckCheckedByFirstname,
	IIF(TblStaffManagementSCRRightToWorkCheckUsers.txtSurname  is null, TblStaffSCRRightToWorkCheckUsers.Surname,TblStaffManagementSCRRightToWorkCheckUsers.txtSurname) as txtRightToWorkCheckCheckedBySurname,

--References

    TblStaffManagementSCRReferenceCheck.TblStaffManagementSCRReferenceCheckID as intReferencesCheckID,
    TblStaffManagementSCRReferenceCheck.txtCheckStatus as txtReferencesCheckStatusOfCheck,
    TblStaffManagementSCRReferenceCheck.txtReferenceFrom as txtReferencesCheckReferenceFrom,
    TblStaffManagementSCRReferenceCheck.dtDateRequested as dtReferencesCheckDateRequested,
    TblStaffManagementSCRReferenceCheck.dtDateReceived as dtReferencesCheckDateReceived,
    TblStaffManagementSCRReferenceCheck.dtDateChecked as dtReferencesCheckDateChecked,
    TblStaffManagementSCRReferenceCheck.txtCheckedBy as txtReferencesCheckCheckedBy,
    IIF(TblStaffManagementSCRReferenceCheckUsers.txtFirstname is null, TblStaffSCRReferenceCheckUsers.Firstname, TblStaffManagementSCRReferenceCheckUsers.txtFirstname) as txtReferencesCheckCheckedByFirstname,
	IIF(TblStaffManagementSCRReferenceCheckUsers.txtSurname is null, TblStaffSCRReferenceCheckUsers.Surname, TblStaffManagementSCRReferenceCheckUsers.txtSurname) as txtReferencesCheckCheckedBySurname,
    
--Under 8's

    TblStaffManagementSCRChecks.blnUnderEightsCheckRequired as blnDisqualificationByAssociationRequirementSelfDeclarationRequired,

    TblStaffManagementSCRUnderEightsCheck.TblStaffManagementSCRUnderEightsCheckID as intDisqualificationByAssociationCheckID,
    TblStaffManagementSCRUnderEightsCheck.txtCheckStatus as txtDisqualificationByAssociationCheckStatusOfCheck,
	TblStaffManagementSCRUnderEightsCheck.dtDateChecked as dtDisqualificationByAssociationCheckCheckedDateChecked,
    TblStaffManagementSCRUnderEightsCheck.dtDateOfDeclaration as dtDisqualificationByAssociationCheckDateOfDeclaration,
    TblStaffManagementSCRUnderEightsCheck.txtCheckedBy as txtDisqualificationByAssociationCheckCheckedActionedBy,
    TblStaffManagementSCRUnderEightsCheckUsers.txtFullName as txtDisqualificationByAssociationCheckCheckedActionedByName,
    TblStaffManagementSCRUnderEightsCheck.dtOfstedWaiver as dtDisqualificationByAssociationCheckDateOfOfstedWaiver,

    TblStaffManagementSCRUnderEightsCheck.txtDisqualifyingCriteria as txtDisqualificationReasonDisqualifyingCriteria,

--Induction

    TblStaffManagementSCRInductionCheck.txtCheckStatus as txtInductionCheckStatusOfCheck,
    TblStaffManagementSCRInductionCheck.TblStaffManagementSCRInductionCheckID as intInductionCheckID,
    TblStaffManagementSCRInductionCheck.dtDateOfInduction as dtInductionCheckDateOfInduction,
    TblStaffManagementSCRInductionCheck.txtInductionCarriedOutBy as txtInductionCheckInductionCarriedOutBy,
    IIF( TblStaffManagementSCRInductionCheckUsers.txtFirstname is null, TblStaffSCRInductionCheckUsers.Firstname,TblStaffManagementSCRInductionCheckUsers.txtFirstname) as txtInductionCheckInductionCarriedOutByFirstname,
	IIF(TblStaffManagementSCRInductionCheckUsers.txtSurname is null, TblStaffSCRInductionCheckUsers.Surname,TblStaffManagementSCRInductionCheckUsers.txtSurname) as txtInductionCheckInductionCarriedOutBySurname,

--Additional

    TblStaffManagementSCRChecks.blnAdditionalCheckRequired as blnAdditionalDisclosureRequirementCheckRequired,
    
    TblStaffManagementSCRAdditionalChecks.TblStaffManagementSCRAdditionalChecksID as intAdditionalDisclousureCheckID,
    TblStaffManagementSCRAdditionalChecks.txtCheckStatus as txtAdditionalDisclousureCheckStatusOfCheck,
    TblStaffManagementSCRAdditionalChecks.txtDisclosureType as txtAdditionalDisclousureCheckDisclosureType,
    TblStaffManagementSCRAdditionalChecks.txtDisclosureNumber as txtAdditionalDisclousureCheckDisclosureNumber,
    TblStaffManagementSCRAdditionalChecks.dtDateOfDisclosure as dtAdditionalDisclousureCheckDateOfDisclosure,
    TblStaffManagementSCRAdditionalChecks.txtCheckedBy as txtAdditionalDisclousureCheckCheckedBy,
    IIF(TblStaffManagementSCRAdditionalChecksUsers.txtFirstname is null,TblStaffSCRAdditionalChecksUsers.Firstname,TblStaffManagementSCRAdditionalChecksUsers.txtFirstname) as txtAdditionalDisclousureCheckCheckedByFirstname,
	IIF(TblStaffManagementSCRAdditionalChecksUsers.txtSurname is null, TblStaffSCRAdditionalChecksUsers.Surname,TblStaffManagementSCRAdditionalChecksUsers.txtSurname) as txtAdditionalDisclousureCheckCheckedBySurname,
    TblStaffManagementSCRAdditionalChecks.txtNotes as txtAdditionalDisclousureCheckNotes,

--Probation

    TblStaffManagementSCRProbation.dtEndDate as dtProbationDetailsEndDate,
    TblStaffManagementSCRProbation.txtNotes as txtProbationDetailsNotes,
	TblStaffManagementSCRProbation.dtDateOfWrittenNotification AS dtSupplyAgencyDateofWrittenNotification,

--SCROriginalPost
    TblStaffManagementSCROriginalPost.txtOriginalPost as txtOrginalPost,
    TblStaffManagementSCROriginalPost.dtStartDate as txtOrginalPostStartDate,

--SCRMedical
    TblstaffmanagementSCRMedicalCheck.txtCheckStatus as txtMedicalCheckStatus,
    TblstaffmanagementSCRMedicalCheck.txtCheckedBy as txtMedicalCheckedBy,
    TblstaffmanagementSCRMedicalCheck.dtDateChecked as DTMedicalDateChecked,
    IIF(TblstaffmanagementSCRMedicalCheckUsers.txtFirstname is null,TblstaffSCRMedicalCheckUsers.Firstname,TblstaffmanagementSCRMedicalCheckUsers.txtFirstname) as txtMedicalCheckedByFirstname,
	IIF(TblstaffmanagementSCRMedicalCheckUsers.txtSurname is null,TblstaffSCRMedicalCheckUsers.Surname,TblstaffmanagementSCRMedicalCheckUsers.txtSurname) as txtMedicalCheckedBySurname,

--SCREmploymentHistory
 TblStaffManagementSCREmploymentHistoryCheck.txtCheckStatus as txtEmploymentCheckStatus,
    TblStaffManagementSCREmploymentHistoryCheck.txtCheckedBy as txtEmploymentCheckedby,
    TblStaffManagementSCREmploymentHistoryCheck.txtcheckcarriedout as txtEmploymentCheckedCarriedOut,
    TblStaffManagementSCREmploymentHistoryCheck.dtDateChecked as dtEmploymentDateChecked,
    IIF(TblStaffManagementSCREmploymentHistoryCheckUsers.txtFirstname is null,TblStaffSCREmploymentHistoryCheckUsers.Firstname,TblStaffManagementSCREmploymentHistoryCheckUsers.txtFirstname) as txtEmploymentCheckedbyFirstname,
	IIF(TblStaffManagementSCREmploymentHistoryCheckUsers.txtSurname is null,TblStaffSCREmploymentHistoryCheckUsers.Surname,TblStaffManagementSCREmploymentHistoryCheckUsers.txtSurname) as txtEmploymentCheckedbySurname


FROM tblStaff

    LEFT OUTER JOIN  TblStaffManagementSCRIdentityDetails on tblStaff.TblStaffID = TblStaffManagementSCRIdentityDetails.intStaffID
    LEFT OUTER JOIN TblStaffManagementSCRIdentityCheck on tblStaff.TblStaffID = TblStaffManagementSCRIdentityCheck.intStaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRIdentityCheckUsers on TblStaffManagementSCRIdentityCheck.txtCheckedBy = TblStaffManagementSCRIdentityCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRIdentityCheckUsers on TblStaffManagementSCRIdentityCheck.txtCheckedBy = TblStaffSCRIdentityCheckUsers.User_Code
    LEFT OUTER JOIN TblStaffManagementSCRChecks on tblStaff.TblStaffID = TblStaffManagementSCRChecks.intStaffID
    LEFT OUTER JOIN TblStaffManagementSCRQualificationCheck on tblStaff.TblStaffID = TblStaffManagementSCRQualificationCheck.intStaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRQualificationCheckUsers ON TblStaffManagementSCRQualificationCheck.txtCheckedBy = TblStaffManagementSCRQualificationCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRQualificationCheckUsers ON TblStaffManagementSCRQualificationCheck.txtCheckedBy = TblStaffSCRQualificationCheckUsers.User_Code
    LEFT OUTER JOIN TblStaffManagementSCRRegistrationCheck on tblStaff.TblStaffID = TblStaffManagementSCRRegistrationCheck.intStaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRRegistrationCheckUsers ON TblStaffManagementSCRRegistrationCheck.txtCheckedBy = TblStaffManagementSCRRegistrationCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRRegistrationCheckUsers ON TblStaffManagementSCRRegistrationCheck.txtCheckedBy = TblStaffSCRRegistrationCheckUsers.User_Code
    LEFT OUTER JOIN TblStaffManagementSCRTeachingCheck on tblStaff.TblStaffID = TblStaffManagementSCRTeachingCheck.intStaffID  
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRTeachingCheckUsers ON TblStaffManagementSCRTeachingCheck.txtCheckedBy = TblStaffManagementSCRTeachingCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRTeachingCheckUsers ON TblStaffManagementSCRTeachingCheck.txtCheckedBy = TblStaffSCRTeachingCheckUsers.User_Code
    LEFT OUTER JOIN TblStaffManagementSCRDisclosureBarringServiceCheck on tblStaff.TblStaffID = TblStaffManagementSCRDisclosureBarringServiceCheck.intStaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRDisclosureBarringServiceCheckRequestedByUsers ON TblStaffManagementSCRDisclosureBarringServiceCheck.txtRequestedBy = TblStaffManagementSCRDisclosureBarringServiceCheckRequestedByUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRDisclosureBarringServiceCheckRequestedByUsers ON TblStaffManagementSCRDisclosureBarringServiceCheck.txtRequestedBy = TblStaffSCRDisclosureBarringServiceCheckRequestedByUsers.User_Code
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRDisclosureBarringServiceCheckUsers ON TblStaffManagementSCRDisclosureBarringServiceCheck.txtCheckedBy = TblStaffManagementSCRDisclosureBarringServiceCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRDisclosureBarringServiceCheckUsers ON TblStaffManagementSCRDisclosureBarringServiceCheck.txtCheckedBy = TblStaffSCRDisclosureBarringServiceCheckUsers.User_Code
    LEFT OUTER JOIN TblStaffManagementSCRPortableDisclosureBarringServiceCheck on tblStaff.TblStaffID = TblStaffManagementSCRPortableDisclosureBarringServiceCheck.intStaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRPortableDisclosureBarringServiceCheckUsers ON TblStaffManagementSCRPortableDisclosureBarringServiceCheck.txtCheckedBy = TblStaffManagementSCRPortableDisclosureBarringServiceCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRPortableDisclosureBarringServiceCheckUsers ON TblStaffManagementSCRPortableDisclosureBarringServiceCheck.txtCheckedBy = TblStaffSCRPortableDisclosureBarringServiceCheckUsers.User_Code
    LEFT OUTER JOIN TblStaffManagementSCRChildrensBarredListCheck on tblStaff.TblStaffID = TblStaffManagementSCRChildrensBarredListCheck.intStaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRChildrensBarredListCheckRequestedByUsers ON TblStaffManagementSCRChildrensBarredListCheck.txtRequestedBy = TblStaffManagementSCRChildrensBarredListCheckRequestedByUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRChildrensBarredListCheckRequestedByUsers ON TblStaffManagementSCRChildrensBarredListCheck.txtRequestedBy = TblStaffSCRChildrensBarredListCheckRequestedByUsers.User_Code
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRChildrensBarredListCheckUsers ON TblStaffManagementSCRChildrensBarredListCheck.txtCheckedBy = TblStaffManagementSCRChildrensBarredListCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRChildrensBarredListCheckUsers ON TblStaffManagementSCRChildrensBarredListCheck.txtCheckedBy = TblStaffSCRChildrensBarredListCheckUsers.User_Code
    LEFT OUTER JOIN TblStaffManagementSCRRightToWorkCheck on tblStaff.TblStaffID = TblStaffManagementSCRRightToWorkCheck.intStaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRRightToWorkCheckUsers ON TblStaffManagementSCRRightToWorkCheck.txtCheckedBy = TblStaffManagementSCRRightToWorkCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRRightToWorkCheckUsers ON TblStaffManagementSCRRightToWorkCheck.txtCheckedBy = TblStaffSCRRightToWorkCheckUsers.User_Code
    LEFT OUTER JOIN TblStaffManagementSCRReferenceCheck on tblStaff.TblStaffID = TblStaffManagementSCRReferenceCheck.intStaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRReferenceCheckUsers ON TblStaffManagementSCRReferenceCheck.txtCheckedBy = TblStaffManagementSCRReferenceCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRReferenceCheckUsers ON TblStaffManagementSCRReferenceCheck.txtCheckedBy = TblStaffSCRReferenceCheckUsers.User_Code
    LEFT OUTER JOIN TblStaffManagementSCRUnderEightsCheck on tblStaff.TblStaffID = TblStaffManagementSCRUnderEightsCheck.intStaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRUnderEightsCheckUsers ON TblStaffManagementSCRUnderEightsCheck.txtCheckedBy = TblStaffManagementSCRUnderEightsCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRUnderEightsCheckUsers ON TblStaffManagementSCRUnderEightsCheck.txtCheckedBy = TblStaffSCRUnderEightsCheckUsers.User_Code
    LEFT OUTER JOIN TblStaffManagementSCRInductionCheck on tblStaff.TblStaffID = TblStaffManagementSCRInductionCheck.intStaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRInductionCheckUsers ON TblStaffManagementSCRInductionCheck.txtInductionCarriedOutBy = TblStaffManagementSCRInductionCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRInductionCheckUsers ON TblStaffManagementSCRInductionCheck.txtInductionCarriedOutBy = TblStaffSCRInductionCheckUsers.User_code
    LEFT OUTER JOIN TblStaffManagementSCRAdditionalChecks on tblStaff.TblStaffID = TblStaffManagementSCRAdditionalChecks.intStaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRAdditionalChecksUsers ON TblStaffManagementSCRAdditionalChecks.txtCheckedBy = TblStaffManagementSCRAdditionalChecksUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCRAdditionalChecksUsers ON TblStaffManagementSCRAdditionalChecks.txtCheckedBy = TblStaffSCRAdditionalChecksUsers.User_Code
    LEFT OUTER JOIN TblStaffManagementSCRProbation on tblStaff.TblStaffID = TblStaffManagementSCRProbation.intStaffID
    LEFT OUTER JOIN TblStaffManagementSCROriginalPost on tblStaff.TblStaffID = TblStaffManagementSCROriginalPost.intStaffID
    LEFT OUTER JOIN TblstaffmanagementSCRMedicalCheck on tblStaff.TblStaffID = TblstaffmanagementSCRMedicalCheck.intstaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblstaffmanagementSCRMedicalCheckUsers ON TblstaffmanagementSCRMedicalCheck.txtCheckedBy = TblstaffmanagementSCRMedicalCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblstaffSCRMedicalCheckUsers ON TblstaffmanagementSCRMedicalCheck.txtCheckedBy = TblstaffSCRMedicalCheckUsers.User_Code
    LEFT OUTER JOIN TblStaffManagementSCREmploymentHistoryCheck on tblStaff.TblStaffID = TblStaffManagementSCREmploymentHistoryCheck.intstaffID
    LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCREmploymentHistoryCheckUsers ON TblStaffManagementSCREmploymentHistoryCheck.txtCheckedBy = TblStaffManagementSCREmploymentHistoryCheckUsers.txtUserCode
    LEFT OUTER JOIN TblStaff TblStaffSCREmploymentHistoryCheckUsers ON TblStaffManagementSCREmploymentHistoryCheck.txtCheckedBy = TblStaffSCREmploymentHistoryCheckUsers.User_Code

    OUTER APPLY (SELECT * 
			 FROM Roles 
			 WHERE Roles.intStaff = tblstaff.TblStaffID ) AS MainRole




WHERE (tblstaff.TblStaffID IN (SELECT ID FROM dbo.SplitCSV(@TblStaffID) AS SplitCSV_1)) OR (@TblStaffID IS NULL)</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="TblStaffID"><DataField>TblStaffID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtStaffFirstname"><DataField>txtStaffFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtStaffTitle"><DataField>txtStaffTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtStaffSurname"><DataField>txtStaffSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtStaffFullname"><DataField>txtStaffFullname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtStaffDOB"><DataField>dtStaffDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtStaffGender"><DataField>txtStaffGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtStaffEnrolmentDate"><DataField>dtStaffEnrolmentDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intStaffSystemStatus"><DataField>intStaffSystemStatus</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intStaffEnrolmentSchoolYear"><DataField>intStaffEnrolmentSchoolYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtEnrolmentTerm"><DataField>txtEnrolmentTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtStaffLeavingDate"><DataField>dtStaffLeavingDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intStaffLEavingSchoolYear"><DataField>intStaffLEavingSchoolYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtStaffLeavingTerm"><DataField>txtStaffLeavingTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnStaffTeachingStaff"><DataField>blnStaffTeachingStaff</DataField><rd:TypeName>System.Int32</rd:TypeName></