<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>08ad6bf4-f066-452a-9ba3-9969555783c1</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Absences"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@dtEndDate"><Value>=Parameters!dtEndDate.Value</Value></QueryParameter><QueryParameter Name="@dtStartDate"><Value>=Parameters!dtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtAbsenceType"><Value>=Parameters!txtAbsenceType.Value</Value></QueryParameter><QueryParameter Name="@intStaff"><Value>=Parameters!intStaff.Value</Value></QueryParameter><QueryParameter Name="@Module"><Value>=Parameters!Module.Value</Value></QueryParameter></QueryParameters><CommandText>WITH Absences
    AS ( SELECT 'Absences' AS txtType , 
			 TblStaffManagementAbsences.TblStaffManagementAbsencesID AS intAbsenceID , 
			 intStaff , 
			 txtStartDate , 
			 txtEndDate , 
			 TblStaffManagementAbsencesObjects.txtName AS txtAbsenceType , 
			 txtNotes,
			 TblStaffManagementAbsences.flWorkingDaysLost
		 FROM
			 TblStaffManagementAbsences INNER JOIN TblStaffManagementAbsencesObjects
			 ON TblStaffManagementAbsences.intCategory
			    = 
			    TblStaffManagementAbsencesObjects.TblStaffManagementAbsencesObjectsID
	    UNION ALL
	    SELECT 'Cover' AS txtType , 
			 TblCoverManagerAbsences.TblCoverManagerAbsencesId AS intAbsenceID , 
			 TblStaff.TblStaffID AS intStaff , 
			 dteStartDateTime , 
			 dteEndDateTime , 
			 TblCoverManagerAbsencesReasons.txtName AS txtAbsenceType , 
			 txtNote,
			 TblCoverManagerAbsences.flWorkingDaysLost
		 FROM
			 TblCoverManagerAbsences INNER JOIN TblStaff
			 ON TblCoverManagerAbsences.txtTeacher
			    = 
			    TblStaff.User_Code
								INNER JOIN TblCoverManagerAbsencesReasons
			 ON TblCoverManagerAbsences.intReason
			    = 
			    TblCoverManagerAbsencesReasons.TblCoverManagerAbsencesReasonsId
	  )
    SELECT 
		 Absences.* , 
		 TblStaff.Title , 
		 TblStaff.Firstname , 
		 TblStaff.Surname , 
		 TblStaff.Initials,
		 
		 
		-- Divisions.txtDivisions , 

		 LEN( Divisions.txtDivisions
		    ) - LEN( REPLACE( Divisions.txtDivisions , ',' , ''
						)
				 ) + 1 AS intHowManyDivisions,
CASE WHEN LEN( Divisions.txtDivisions
		    ) - LEN( REPLACE( Divisions.txtDivisions , ',' , ''
						)
				 )+1 = (SELECT 
Count( [TblSchoolManagementSchoolDivisionsID]) AS DivisionCount
  FROM [TblSchoolManagementSchoolDivisions]) then 'All Divisions' Else Divisions.txtDivisions END AS txtDivisions, 

	      Roles.txtRoles

	 FROM
		 Absences 
		 INNER JOIN 
		 TblStaff
		 ON Absences.intStaff = TblStaff.TblStaffID

				OUTER APPLY( 
						   SELECT SUBSTRING(( 
						   SELECT TOP ( 100
								    )PERCENT ', ' + TblSchoolManagementSchoolDivisions.txtName
							FROM
								TblStaffManagementDivisions INNER JOIN TblSchoolManagementSchoolDivisions
								ON TblStaffManagementDivisions.intDivision
								   = 
								   TblSchoolManagementSchoolDivisions.TblSchoolManagementSchoolDivisionsID
							WHERE TblStaffManagementDivisions.intStaff
								 = 
								 Absences.intStaff
							ORDER BY TblSchoolManagementSchoolDivisions.intOrder
							FOR XML PATH( ''
									  )
										) , 3 , 200000
									    )AS txtDivisions
						 )AS Divisions
    
OUTER APPLY( 
	   SELECT SUBSTRING(( 
	   SELECT TOP ( 100
			 )PERCENT ', ' + txtSchoolRolesName
	   from
    tblstaffmanagementschoolroles
    INNER JOIN
    tblstaffmanagementschoolrolesobjects
    ON tblstaffmanagementschoolroles.intschoolrole = tblstaffmanagementschoolrolesobjectsID

	   WHERE 
	   tblstaffmanagementschoolroles.intStaff =  Absences.intStaff
	   ORDER BY tblstaffmanagementschoolrolesobjects.intOrder
	   FOR XML PATH( ''
				)
				    ) , 3 , 200000
				    )AS txtRoles
    )AS Roles



    WHERE
(txtStartDate &lt; DATEADD(day,1,@dtEndDate) AND  txtEndDate  &gt;= @dtStartDate)
    AND txtAbsenceType IN( @txtAbsenceType )
    AND intStaff IN( @intStaff)
	AND txtType IN  (@Module)</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="txtType"><DataField>txtType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intAbsenceID"><DataField>intAbsenceID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intStaff"><DataField>intStaff</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtStartDate"><DataField>txtStartDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtEndDate"><DataField>txtEndDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtAbsenceType"><DataField>txtAbsenceType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtNotes"><DataField>txtNotes</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="flWorkingDaysLost"><DataField>flWorkingDaysLost</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Title"><DataField>Title</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Initials"><DataField>Initials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intHowManyDivisions"><DataField>intHowManyDivisions</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="txtDivisions"><DataField>txtDivisions</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRoles"><DataField>txtRoles</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Types"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@dtStartDate"><Value>=Parameters!dtStartDate.Value</Value></QueryParameter><QueryParameter Name="@dtEndDate"><Value>=Parameters!dtEndDate.Value</Value></QueryParameter><QueryParameter Name="@Module"><Value>=Parameters!Module.Value</Value></QueryParameter></QueryParameters><CommandText>WITH Absences AS (SELECT        'Absences' AS txtType, TblStaffManagementAbsences.intStaff, TblStaffManagementAbsences.txtStartDate, TblStaffManagementAbsences.txtEndDate, 
                                                                     TblStaffManagementAbsencesObjects.txtName AS txtAbsenceType, TblStaffManagementAbsences.txtNotes
                                            FROM            TblStaffManagementAbsences INNER JOIN
                                                                     TblStaffManagementAbsencesObjects ON TblStaffManagementAbsences.intCategory = TblStaffManagementAbsencesObjects.TblStaffManagementAbsencesObjectsID
                                            UNION ALL
                                            SELECT        'Cover' AS txtType, TblStaff.TblStaffID AS intStaff, TblCoverManagerAbsences.dteStartDateTime, TblCoverManagerAbsences.dteEndDateTime, 
                                                                     TblCoverManagerAbsencesReasons.txtName AS txtAbsenceType, TblCoverManagerAbsences.txtNote
                                            FROM            TblCoverManagerAbsences INNER JOIN
                                                                     TblStaff ON TblCoverManagerAbsences.txtTeacher = TblStaff.User_Code INNER JOIN
                                                                     TblCoverManagerAbsencesReasons ON TblCoverManagerAbsences.intReason = TblCoverManagerAbsencesReasons.TblCoverManagerAbsencesReasonsId)
    SELECT DISTINCT txtAbsenceType
     FROM            Absences AS Absences_1
     WHERE        (txtStartDate &lt;= DATEADD(day, 1, @dtEndDate)) AND (txtEndDate &gt;= @dtStartDate) AND (txtType IN (@Module))
     ORDER BY txtAbsenceType</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="txtAbsenceType"><DataField>txtAbsenceType</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Staff"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@dtStartDate"><Value>=Parameters!dtStartDate.Value</Value></QueryParameter><QueryParameter Name="@dtEndDate"><Value>=Parameters!dtEndDate.Value</Value></QueryParameter><QueryParameter Name="@txtAbsenceType"><Value>=Parameters!txtAbsenceType.Value</Value></QueryParameter><QueryParameter Name="@Module"><Value>=Parameters!Module.Value</Value></QueryParameter></QueryParameters><CommandText>WITH Absences AS (SELECT        'Absences' AS txtType, TblStaffManagementAbsences.intStaff, TblStaffManagementAbsences.txtStartDate, TblStaffManagementAbsences.txtEndDate, 
                                                                     TblStaffManagementAbsencesObjects.txtName AS txtAbsenceType, TblStaffManagementAbsences.txtNotes
                                            FROM            TblStaffManagementAbsences INNER JOIN
                                                                     TblStaffManagementAbsencesObjects ON TblStaffManagementAbsences.intCategory = TblStaffManagementAbsencesObjects.TblStaffManagementAbsencesObjectsID
                                            UNION ALL
                                            SELECT        'Cover' AS txtType, TblStaff.TblStaffID AS intStaff, TblCoverManagerAbsences.dteStartDateTime, TblCoverManagerAbsences.dteEndDateTime, 
                                                                     TblCoverManagerAbsencesReasons.txtName AS txtAbsenceType, TblCoverManagerAbsences.txtNote
                                            FROM            TblCoverManagerAbsences INNER JOIN
                                                                     TblStaff ON TblCoverManagerAbsences.txtTeacher = TblStaff.User_Code INNER JOIN
                                                                     TblCoverManagerAbsencesReasons ON TblCoverManagerAbsences.intReason = TblCoverManagerAbsencesReasons.TblCoverManagerAbsencesReasonsId), StaffDetails AS
    (SELECT DISTINCT Absences_1.intStaff, TblStaff_1.Surname + ', ' + TblStaff_1.Firstname AS txtName
      FROM            Absences AS Absences_1 INNER JOIN
                                TblStaff AS TblStaff_1 ON Absences_1.intStaff = TblStaff_1.TblStaffID
      WHERE        (Absences_1.txtStartDate &lt;= DATEADD(day, 1, @dtEndDate)) AND (Absences_1.txtEndDate &gt;= @dtStartDate) AND (Absences_1.txtAbsenceType IN (@txtAbsenceType)) AND (Absences_1.txtType IN (@Module)))
    SELECT        intStaff, txtName
     FROM            StaffDetails AS StaffDetails_1
     ORDER BY txtName</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="intStaff"><DataField>intStaff</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="OrderParameter"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>select
'txtStartDate' AS Field,
'Start Date' AS Display

UNION
select
'Surname + Firstname' AS Field,
'Surname, Forename' AS Display</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="Field"><DataField>Field</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Display"><DataField>Display</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="School"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtiSAMSServerName
FROM	TbliSAMSManagerSettings</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="txtiSAMSServerName"><DataField>txtiSAMSServerName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="StartOfAcademicYear"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TOP 1 TblSchoolManagementTermDates.txtStartDate
		 FROM	TblSchoolManagementTermDates
		 WHERE	TblSchoolManagementTermDates.intSchoolYear = (
		 SELECT Top(1) intSchoolYear FROM TblSchoolManagementTermDates WHERE txtStartDate &lt;= GETDATE() ORDER BY txtStartDate DESC
		 )
		 ORDER BY TblSchoolManagementTermDates.txtStartDate ASC</CommandText></Query><Fields><Field Name="txtStartDate"><DataField>txtStartDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>3.5cm</Width></TablixColumn><TablixColumn><Width>3.5cm</Width></TablixColumn><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4.5cm</Width></TablixColumn><TablixColumn><Width>8cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Title</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Forename</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Parag