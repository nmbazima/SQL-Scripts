<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>afcb3ec8-8016-45dd-9343-1ca1e6b82d39</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="StaffContactDS"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intStaffID"><Value>=Parameters!intStaffID.Value</Value></QueryParameter><QueryParameter Name="@txtAddressType"><Value>=Parameters!txtAddressType.Value</Value></QueryParameter><QueryParameter Name="@intJustContact"><Value>=Parameters!intJustContact.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT tblstaff.TblStaffID, TblStaffManagementAddresses.TblStaffManagementAddressesID, txtcounty,txtcountry,txtpostcode,txtlabelsalutation,txttown,txtaddress1,txtaddress2,txtaddress3, surname, firstname
FROM tblstaff
LEFT OUTER JOIN TblStaffManagementAddressLink ON tblstaff.tblStaffID = TblStaffManagementAddressLink.intStaffID
LEFT OUTER JOIN TblStaffManagementAddresses ON TblStaffManagementAddressLink.intAddressID = TblStaffManagementAddresses.TblStaffManagementAddressesID
WHERE (TblStaffID IN (@intStaffID)) AND (txtAddressType = @txtAddressType) 
AND (TblStaffManagementAddresses.intJustContact = @intJustContact OR TblStaffManagementAddresses.intJustContact IS NULL)
AND (txtRelationType = 'Self')</CommandText></Query><Fields><Field Name="TblStaffID"><DataField>TblStaffID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="TblStaffManagementAddressesID"><DataField>TblStaffManagementAddressesID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtlabelsalutation"><DataField>txtlabelsalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress1"><DataField>txtaddress1</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress2"><DataField>txtaddress2</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress3"><DataField>txtaddress3</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCounty"><DataField>txtcounty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCountry"><DataField>txtcountry</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPostcode"><DataField>txtpostcode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTown"><DataField>txttown</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="surname"><DataField>surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="firstname"><DataField>firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="AddressTypeDDL"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT        Name AS NameValue, Name AS NameLabel
FROM            TblUsefulLists
WHERE        (ListType = N'AddressType')
ORDER BY NameValue</CommandText></Query><Fields><Field Name="NameValue"><DataField>NameValue</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="NameLabel"><DataField>NameLabel</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="AddressTypeSelect"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT        Name AS NameValue, Name AS NameLabel
FROM            TblUsefulLists
WHERE        (ListType = N'AddressType')
AND Name = 'Home'
ORDER BY NameValue</CommandText></Query><Fields><Field Name="NameValue"><DataField>NameValue</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="NameLabel"><DataField>NameLabel</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="StaffListDDL"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT 
	TblStaff.TblStaffID,
	TblStaff.Fullname, 
	TblStaff.Initials

FROM TblStaff

WHERE TblStaff.SystemStatus = 1

ORDER BY TblStaff.Surname</CommandText></Query><Fields><Field Name="TblStaffID"><DataField>TblStaffID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Fullname"><DataField>Fullname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Initials"><DataField>Initials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="StaffDisplayName"><Value>=Fields!Fullname.Value &amp; " (" &amp; Fields!Initials.Value &amp; ")"</Value></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="list2"><TablixBody><TablixColumns><TablixColumn><Width>2.44125in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>1.85062in</Height><TablixCells><TablixCell><CellContents><Rectangle Name="list2_Contents"><ReportItems><Textbox Name="textbox1"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=trim(Fields!txtlabelsalutation.Value) &amp; chr(13) &amp; chr(10) &amp; trim(Fields!txtAddress1.Value) &amp; iif(trim(Fields!txtAddress2.Value)&lt;&gt;"",chr(13) &amp; chr(10) &amp; trim(Fields!txtAddress2.Value),"") &amp; iif(trim(Fields!txtAddress3.Value)&lt;&gt;"",chr(13) &amp; chr(10) &amp; trim(Fields!txtAddress3.Value),"") &amp; iif(trim(Fields!txtTown.Value)&lt;&gt;"",chr(13) &amp; chr(10) &amp; trim(Fields!txtTown.Value),"") &amp; iif(trim(Fields!txtCounty.Value)&lt;&gt;"",chr(13) &amp; chr(10) &amp; trim(Fields!txtCounty.Value),"") &amp; iif(trim(Fields!txtCountry.Value)&lt;&gt;"",chr(13) &amp; chr(10) &amp; trim(Fields!txtCountry.Value),"") &amp; iif(trim(Fields!txtPostcode.Value)&lt;&gt;"",chr(13) &amp; chr(10) &amp; trim(Fields!txtPostcode.Value),"")</Value><Style><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><FontFamily /><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>textbox1</rd:DefaultName><Top>0.07875in</Top><Left>0.15001cm</Left><Height>1.69312in</Height><Width>2.32313in</Width><Style><FontFamily /><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></ReportItems><KeepTogether>true</KeepTogether><Style /></Rectangle></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><Group Name="TblStaffID_TblStaffManagementAddressesID"><GroupExpressions><GroupExpression>=Fields!TblStaffID.Value</GroupExpression><GroupExpression>=Fields!TblStaffManagementAddressesID.Value</GroupExpression></GroupExpressions><DataElementName>Item</DataElementName></Group><SortExpressions><SortExpression><Value>=Fields!surname.Value</Value></SortExpression><SortExpression><Value>=Fields!firstname.Value</Value></SortExpression><SortExpression><Value>=Fields!TblStaffID.Value</Value></SortExpression></SortExpressions><DataElementName>Item_Collection</DataElementName><DataElementOutput>Output</DataElementOutput><KeepTogether>true</KeepTogether></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>StaffContactDS</DataSetName><Height>1.85062in</Height><Width>2.44125in</Width><Style /></Tablix></ReportItems><Height>4.70057cm</Height><Style /></Body><Width>6.20078cm</Width><Page><PageHeader><Height>0.03937in</Height><PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><Style /></PageHeader><PageHeight>29.5cm</PageHeight><PageWidth>21cm</PageWidth><LeftMargin>0.7cm</LeftMargin><RightMargin>0.5cm</RightMargin><TopMargin>1cm</TopMargin><BottomMargin>0cm</BottomMargin><Columns>3</Columns><ColumnSpacing>0.2cm</ColumnSpacing><Style /></Page></ReportSection></ReportSections><ReportParameters><ReportParameter Name="intStaffID"><DataType>String</DataType><Prompt>Select Staff:</Prompt><ValidValues><DataSetReference><DataSetName>StaffListDDL</DataSetName><ValueField>TblStaffID</ValueField><LabelField>StaffDisplayName</LabelField></DataSetReference></ValidValues><MultiValue>true</MultiValue></ReportParameter><ReportParameter Name="txtAddressType"><DataType>String</DataType><DefaultValue><DataSetReference><DataSetName>AddressTypeSelect</DataSetName><ValueField>NameValue</ValueField></DataSetReference></DefaultValue><Prompt>Select Address Type:</Prompt><ValidValues><DataSetReference><DataSetName>AddressTypeDDL</DataSetName><ValueField>NameValue</ValueField><LabelField>NameLabel</LabelField></DataSetReference></ValidValues></ReportParameter><ReportParameter Name="intJustContact"><DataType>Boolean</DataType><DefaultValue><Values><Value>false</Value></Values></DefaultValue><Prompt>Just Contact</Prompt><ValidValues><ParameterValues><ParameterValue><Value>true</Value><Label>Yes</Label></ParameterValue><ParameterValue><Value>false</Value><Label>No</Label></ParameterValue></ParameterValues></ValidValues></ReportParameter></ReportParameters><Language>en-GB</Language><ConsumeContainerWhitespace>true</ConsumeContainerWhitespace><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>eecb2c22-2421-4586-b8ce-4cd2150f9f98</rd:ReportID></Report>