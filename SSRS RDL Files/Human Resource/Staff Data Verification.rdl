bers><TablixMember /></TablixMembers></TablixRowHierarchy><DataSetName>StaffData</DataSetName><Top>25.4cm</Top><Height>1.7cm</Height><Width>20cm</Width><ZIndex>4</ZIndex><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><KeepTogether>true</KeepTogether><Style><Border><Style>None</Style></Border></Style></Rectangle></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><Group Name="TblStaffID"><GroupExpressions><GroupExpression>=Fields!TblStaffID.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!Surname.Value</Value></SortExpression><SortExpression><Value>=Fields!Firstname.Value</Value></SortExpression><SortExpression><Value>=Fields!TblStaffID.Value</Value></SortExpression></SortExpressions><TablixHeader><Size>0.5cm</Size><CellContents><Textbox Name="ToRepeat"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Firstname.Value + " " + Fields!Surname.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Visibility><Hidden>true</Hidden></Visibility><Style><Border><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixHeader><TablixMembers><TablixMember /></TablixMembers></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>StaffData</DataSetName><Height>27.1cm</Height><Width>20.5cm</Width><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><Height>10.66929in</Height><Style /></Body><Width>8.07087in</Width><Page><PageHeader><Height>1.28cm</Height><PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><ReportItems><Textbox Name="textbox50"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Staff Data Checking Sheet</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Language>en-GB</Language></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Left>0.5cm</Left><Height>1cm</Height><Width>7cm</Width><Style><Border><Style>None</Style><Width>2pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox><Image Name="Image1"><Source>Embedded</Source><Value>iSAMSLine</Value><Sizing>FitProportional</Sizing><Top>1cm</Top><Left>0.5cm</Left><Height>0.26613cm</Height><Width>20cm</Width><ZIndex>1</ZIndex><Style><Border><Style>None</Style></Border></Style></Image><Textbox Name="Textbox325"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=ReportItems!ToRepeat.Value</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Language>en-GB</Language></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox325</rd:DefaultName><Left>7.5cm</Left><Height>1cm</Height><Width>13cm</Width><ZIndex>2</ZIndex><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></ReportItems><Style><Border><Style>None</Style></Border></Style></PageHeader><PageFooter><Height>0.6cm</Height><PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><Style><Border><Style>None</Style></Border></Style></PageFooter><PageHeight>29.7cm</PageHeight><PageWidth>21cm</PageWidth><LeftMargin>0cm</LeftMargin><RightMargin>0cm</RightMargin><TopMargin>0.2cm</TopMargin><BottomMargin>0cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>b1d86c7b-8ace-44a5-bf88-130fedf4e303</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="StaffData"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intCustomField"><Value>=Parameters!intCustomField.Value</Value></QueryParameter><QueryParameter Name="@StaffID"><Value>=Parameters!StaffID.Value</Value></QueryParameter></QueryParameters><CommandText>With CustomFields AS (

	 SELECT 
		*
		FROM
		tblStaffManagementCustomFields
		 WHERE tblStaffManagementCustomFields.tblStaffManagementCustomFieldsID IN (@intCustomField)
	)


SELECT 
user_code,
TblStaff.TblStaffID , 
	  TblStaff.Title , 
	  TblStaff.Firstname , 
	  TblStaff.Surname , 
	  TblStaff.MiddleNames , 
	  TblStaff.NameInitials , 
	  TblStaff.PreName , 
	  TblStaff.Initials , 
	  TblStaff.Sex , 
	  TblStaff.DOB , 
	  TblStaffManagementAddresses.TblStaffManagementAddressesID , 
	  TblStaffManagementAddresses.txtRelationType , 
	  TblStaffManagementAddresses.txtAddressType , 
	  TblStaffManagementAddresses.txtContactsTitle , 
	  TblStaffManagementAddresses.txtContactsForename , 
	  TblStaffManagementAddresses.txtContactsSurname , 
	  TblStaffManagementAddresses.txtEmail1 , 
	  TblStaffManagementAddresses.txtMobile1 , 
	  TblStaffManagementAddresses.txtDayTelephone , 
	  TblStaffManagementAddresses.txtAddress1 , 
	  TblStaffManagementAddresses.txtAddress2 , 
	  TblStaffManagementAddresses.txtAddress3 , 
	  TblStaffManagementAddresses.txtTown , 
	  TblStaffManagementAddresses.txtCounty , 
	  TblStaffManagementAddresses.txtPostcode , 
	TblStaffManagementAddresses.txtSOS, 
	  TblStaffManagementAddressLink.intOrder AS intAddressOrder , 
	  TblStaff.MaritalStatus , 
	  TblStaff.ChildrenInSchool , 
	  TblStaff.EnrolmentDate , 
	  TblStaff.EnrolmentTerm , 
	  TblStaff.intEnrolmentSchoolYear , 
	  TblStaff.TeachingStaff , 
	  TblStaff.PersonalTutor , 
	  TblStaff.SchoolEmailAddress , 
	  TblStaff.PartTime , 
	  TblStaff.txtDFESNo , 
	  TblStaff.CountryofResidence , 
	  TblStaff.Nationality , 
	  TblStaff.Language , 
	  TblStaff.EthnicGroup , 
	  TblStaff.BirthPlace , 
	  TblStaff.BirthCountry , 
	  TblStaff.PartnersFirstname , 
	  TblStaff.txtNationalInsurance , 
	  TblStaffManagementTransportLicensesObjects.txtName AS txtLicenseType , 
	  TblStaffManagementTransportLicenses.txtExpiryDateTime AS txtLicenseExpiryDateTime , 
	  TblStaffManagementTransportLicenses.txtLicenseNumber , 
	  TblStaff.Religion , 
	  TblStaff.BirthCounty , 
	  TblStaffManagementTransportLicenses.TblStaffManagementTransportLicensesID,
	  CustomFields.tblStaffManagementCustomFieldsID AS intCustomFieldId,
	  CustomFields.txtName AS txtCustomFieldName,
	  CustomFields.txtFieldType AS txtCustomFieldType,
	  tblStaffManagementCustomFieldValue.txtValue AS txtCustomFieldValue,
	  TblStaffManagementCustomFieldLink.txtArea AS txtCustomFieldArea,
	  TblStaffManagementCustomFieldLink.txtSection AS txtCustomFieldSection,
	  TblStaffManagementCustomFieldLink.intOrder AS intCustomFieldAreaSectionOrder
  FROM
	  TblStaff
	  LEFT OUTER JOIN TblStaffManagementAddressLink
	  ON TblStaff.TblStaffID = TblStaffManagementAddressLink.intStaffID
	  LEFT OUTER JOIN
	  TblStaffManagementAddresses
	  ON TblStaffManagementAddressLink.intAddressID = TblStaffManagementAddresses.TblStaffManagementAddressesID
	  LEFT OUTER JOIN
	  TblStaffManagementTransportLicenses
	  ON TblStaff.TblStaffID = TblStaffManagementTransportLicenses.intStaff
	 AND TblStaffManagementTransportLicenses.txtExpiryDateTime &gt;= GETDATE () 
	  LEFT OUTER JOIN
	  TblStaffManagementTransportLicensesObjects
	  ON TblStaffManagementTransportLicenses.intCategory = TblStaffManagementTransportLicensesObjects.TblStaffManagementTransportLicensesObjectsID
 
	 LEFT OUTER JOIN
	  CustomFields ON 1 = 1
	  LEFT OUTER JOIN
	  [TblStaffManagementCustomFieldLink] ON CustomFields.tblStaffManagementCustomFieldsID = TblStaffManagementCustomFieldLink.intCustomFieldID
	  LEFT OUTER JOIN
	  tblStaffManagementCustomFieldValue ON CustomFields.tblStaffManagementCustomFieldsID = tblStaffManagementCustomFieldValue.intCustomFieldId 
	  AND TblStaff.User_Code = tblStaffManagementCustomFieldValue.txtUserCode

	  WHERE TblStaff.TblStaffID IN (@StaffID)</CommandText></Query><Fields><Field Name="user_code"><DataField>user_code</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblStaffID"><DataField>TblStaffID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Title"><DataField>Title</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="MiddleNames"><DataField>MiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PreName"><DataField>PreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="NameInitials"><DataField>NameInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DOB"><DataField>DOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Sex"><DataField>Sex</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="MaritalStatus"><DataField>MaritalStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Initials"><DataField>Initials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ChildrenInSchool"><DataField>ChildrenInSchool</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CountryOfResidence"><DataField>CountryofResidence</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Nationality"><DataField>Nationality</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Language"><DataField>Language</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BirthPlace"><DataField>BirthPlace</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BirthCountry"><DataField>BirthCountry</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PartnersFirstname"><DataField>PartnersFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblStaffManagementAddressesID"><DataField>TblStaffManagementAddressesID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRelationType"><DataField>txtRelationType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddressType"><DataField>txtAddressType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtContactsTitle"><DataField>txtContactsTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtContactsForename"><DataField>txtContactsForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtContactsSurname"><DataField>txtContactsSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEmail1"><DataField>txtEmail1</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSOS"><DataField>txtSOS</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCounty"><DataField>txtCounty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDayTelephone"><DataField>txtDayTelephone</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMobile1"><DataField>txtMobile1</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress1"><DataField>txtAddress1</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress2"><DataField>txtAddress2</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress3"><DataField>txtAddress3</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="EnrolmentTerm"><DataField>EnrolmentTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intEnrolmentSchoolYear"><DataField>intEnrolmentSchoolYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtTown"><DataField>txtTown</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPostcode"><DataField>txtPostcode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intAddressOrder"><DataField>intAddressOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="TeachingStaff"><DataField>TeachingStaff</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="EnrolmentDate"><DataField>EnrolmentDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="PersonalTutor"><DataField>PersonalTutor</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="SchoolEmailAddress"><DataField>SchoolEmailAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtNationalInsurance"><DataField>txtNationalInsurance</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PartTime"><DataField>PartTime</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtDFESNo"><DataField>txtDFESNo</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="EthnicGroup"><DataField>EthnicGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLicenseType"><DataField>txtLicenseType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLicenseExpiryDateTime"><DataField>txtLicenseExpiryDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtLicenseNumber"><DataField>txtLicenseNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Religion"><DataField>Religion</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BirthCounty"><DataField>BirthCounty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblStaffManagementTransportLicensesID"><DataField>TblStaffManagementTransportLicensesID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intCustomFieldId"><DataField>intCustomFieldId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtCustomFieldName"><DataField>txtCustomFieldName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCustomFieldType"><DataField>txtCustomFieldType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCustomFieldValue"><DataField>txtCustomFieldValue</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCustomFieldArea"><DataField>txtCustomFieldArea</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCustomFieldSection"><DataField>txtCustomFieldSection</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intCustomFieldAreaSectionOrder"><DataField>intCustomFieldAreaSectionOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="CustomFields"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT
0 AS tblStaffManagementCustomFieldsID,
'None' AS txtCustomFieldName

UNION

SELECT
tblStaffManagementCustomFieldsID,
txtName AS txtCustomFieldName

FROM
tblStaffManagementCustomFields

ORDER BY
tblStaffManagementCustomFieldsID</CommandText></Query><Fields><Field Name="tblStaffManagementCustomFieldsID"><DataField>tblStaffManagementCustomFieldsID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtCustomFieldName"><DataField>txtCustomFieldName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Staff"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@SystemStatus"><Value>=Parameters!SystemStatus.Value</Value></QueryParameter></QueryParameters><CommandText>select 
TblStaffID,
Surname + ', ' + Firstname AS txtStaffName
from
tblstaff


 Where
(SystemStatus &gt;= @SystemStatus)


Order by
Surname,
