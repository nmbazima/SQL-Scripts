in>0.4cm</BottomMargin><ColumnSpacing>1cm</ColumnSpacing><Style /></Page><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>75405534-a980-47b8-9770-ede865c9e5c9</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Main"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@TblStaffID"><Value>=Parameters!TblStaffID.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT
tblstaff.*,
[TblStaffManagementDocuments].*

FROM

[dbo].[TblStaffManagementDocuments]

LEFT OUTER JOIN

[dbo].[TblStaffManagementDocumentsCategoriesLinks]

ON [TblStaffManagementDocuments].TblStaffManagementDocumentsID = [TblStaffManagementDocumentsCategoriesLinks].intDocument

LEFT OUTER JOIN

[dbo].[TblStaffManagementDocumentsCategories]

ON [TblStaffManagementDocumentsCategories].TblStaffManagementDocumentsCategoriesID = [TblStaffManagementDocumentsCategoriesLinks].intCategory

Right Outer JOIN

tblstaff
ON [TblStaffManagementDocuments].intStaff = TblStaffiD
WHERE        (TblStaff.TblStaffID IN
                           (SELECT        ID
                           FROM            dbo.SplitCSV(@TblStaffID) AS SplitCSV_1)) OR
