<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>b1498f53-c31b-4456-a614-483c61533467</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="StartOfAcademicYear"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TOP 1 TblSchoolManagementTermDates.txtStartDate
		 FROM	TblSchoolManagementTermDates
		 WHERE	TblSchoolManagementTermDates.intSchoolYear = (
		 SELECT Top(1) intSchoolYear FROM TblSchoolManagementTermDates WHERE txtStartDate &lt;= GETDATE() ORDER BY txtStartDate DESC
		 )
		 ORDER BY TblSchoolManagementTermDates.txtStartDate ASC</CommandText></Query><Fields><Field Name="txtStartDate"><DataField>txtStartDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields></DataSet><DataSet Name="School"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT txtSchoolName,txtLEANumber, txtDfESNumber
FROM TblSchoolManagementSchoolSetup</CommandText></Query><Fields><Field Name="txtSchoolName"><DataField>txtSchoolName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLEANumber"><DataField>txtLEANumber</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDfESNumber"><DataField>txtDfESNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Staff"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@EnrolmentDate"><Value>=Parameters!EnrolmentDate.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 

	TblStaff.TblStaffID,
	TblStaff.Title,
	TblStaff.Sex,
	TblStaff.Firstname,
	TblStaff.Surname,
	TblStaff.PreName,
	TblStaff.DOB,
	'Staff' AS txtPersonType,
	SelfAddress.txtMobile1
FROM TblStaff

OUTER APPLY(
SELECT Top(1) TblStaffManagementAddresses.txtMobile1
FROM TblStaffManagementAddresses
INNER JOIN TblStaffManagementAddressLink ON TblStaffManagementAddresses.TblStaffManagementAddressesID = TblStaffManagementAddressLink.intAddressID
WHERE TblStaffManagementAddressLink.intStaffID = TblStaff.TblStaffID
AND TblStaffManagementAddresses.txtAddressType = 'Home'
AND TblStaffManagementAddresses.txtRelationType = 'Self'
AND TblStaffManagementAddresses.txtMobile1 IS NOT NULL
) AS SelfAddress
WHERE TblStaff.SystemStatus =  1
AND TblStaff.EnrolmentDate &gt;= @EnrolmentDate</CommandText></Query><Fields><Field Name="TblStaffID"><DataField>TblStaffID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Title"><DataField>Title</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Sex"><DataField>Sex</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PreName"><DataField>PreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DOB"><DataField>DOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtPersonType"><DataField>txtPersonType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMobile1"><DataField>txtMobile1</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix3"><TablixBody><TablixColumns><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Title</Value><Style><FontSize>12pt</FontS