e></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Left>8.32161cm</Left><Height>0.76458cm</Height><Width>11.67838cm</Width><ZIndex>2</ZIndex><Style><Border><Style>None</Style><Width>2pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></ReportItems><Style><Border><Style>None</Style></Border></Style></PageHeader><PageFooter><Height>0.67639cm</Height><PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><ReportItems><Textbox Name="textbox59"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Printed on " + Day(Now()).ToString + " " + MonthName(Month(Now())) + " " + Year(Now()).ToString</Value><Style /></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Top>0.17639cm</Top><Height>0.5cm</Height><Width>16.5cm</Width><Style><Border><Width>2pt</Width></Border><TopBorder><Style>Solid</Style></TopBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox><Textbox Name="textbox58"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Page " &amp; Code.GetPN(Not(ReportItems!textbox2.Value Is Nothing),Globals!PageNumber)</Value><Style /></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Top>0.17639cm</Top><Left>16.5cm</Left><Height>0.5cm</Height><Width>3.49999cm</Width><ZIndex>1</ZIndex><Style><Border><Width>2pt</Width></Border><TopBorder><Style>Solid</Style></TopBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></ReportItems><Style><Border><Style>None</Style></Border></Style></PageFooter><PageHeight>29.7cm</PageHeight><PageWidth>21cm</PageWidth><LeftMargin>0.5cm</LeftMargin><RightMargin>0.5cm</RightMargin><TopMargin>1cm</TopMargin><BottomMargin>0.5cm</BottomMargin><ColumnSpacing>1.27cm</ColumnSpacing><Style /></Page><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>eeea798e-fcc2-4476-904f-5aa06a05b5fd</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Staff"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@TblStaffID"><Value>=Parameters!TblStaffID.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT TblStaff.*,

       ----- Recruitment Check Qualifications ------
	  DENSE_RANK() OVER(PARTITION BY TblStaffManagementSCRQualificationCheck.intStaffID ORDER BY TblStaffManagementSCRQualificationCheck.dtDateChecked,TblStaffManagementSCRQualificationCheck.TblStaffManagementSCRQualificationCheckID ) AS intSCRQualificationRank,
       TblStaffManagementSCRQualificationCheck.TblStaffManagementSCRQualificationCheckID AS intQualificationCheckID,
       TblStaffManagementSCRQualificationCheck.txtCheckStatus AS txtQualificationCheckStatusOfCheck,
       TblStaffManagementSCRQualificationCheck.txtEvidenceSeen AS txtQualificationCheckQualificationEvidenced,
	  TblStaffManagementSCRQualificationCheck.txtNotes AS txtQualificationCheckNotes,
       TblStaffManagementSCRQualificationCheck.dtDateChecked AS dtQualificationCheckDateChecked,
       TblStaffManagementSCRQualificationCheck.txtCheckedBy AS txtQualificationCheckCheckedBy,
       CASE
           WHEN TblStaffManagementSCRQualificationCheckUsers.txtFirstname IS NULL
           THEN TblStaffSCRQualificationCheckUsers.Firstname
           ELSE TblStaffManagementSCRQualificationCheckUsers.txtFirstname
       END AS txtQualificationCheckCheckedByFirstname,
       CASE
           WHEN TblStaffManagementSCRQualificationCheckUsers.txtSurname IS NULL
           THEN TblStaffSCRQualificationCheckUsers.Surname
           ELSE TblStaffManagementSCRQualificationCheckUsers.txtSurname
       END AS txtQualificationCheckCheckedBySurname,

       ----- Courses ------	
       DENSE_RANK() OVER(PARTITION BY TblStaffManagementCourses.intStaff ORDER BY TblStaffManagementCourses.TblStaffManagementCoursesID) AS intCourseRank,
	  TblStaffManagementCourses.TblStaffManagementCoursesID,
       TblStaffManagementCourses.txtName AS txtCourseName,
       TblStaffManagementCourses.txtInstitution AS txtCourseInstitution,
       TblStaffManagementCourses.dtDateTime AS dtCourseDate,
       TblStaffManagementCourses.txtNotes AS txtCourseNotes,
       TblStaffManagementCourses.dtExpiryDateTime,

       ----- Qualifications -----		
       DENSE_RANK() OVER(PARTITION BY TblStaffManagementQualifications.intStaff ORDER BY TblStaffManagementQualifications.TblStaffManagementQualificationsID) AS intQualRank,
       TblStaffManagementQualifications.TblStaffManagementQualificationsID,
       TblStaffManagementQualifications.txtQualifications,
       TblStaffManagementQualifications.txtTitle As txtQualificationsTitle,
       TblStaffManagementQualifications.txtLevel,
       TblStaffManagementQualifications.txtSubjectOne,
       TblStaffManagementQualifications.txtSubjectTwo,
       TblStaffManagementQualifications.dtQualDate,
       TblUniversities.Name AS txtUniversityName
FROM TblStaff
     LEFT OUTER JOIN TblStaffManagementSCRQualificationCheck ON tblStaff.TblStaffID = TblStaffManagementSCRQualificationCheck.intStaffID
     LEFT OUTER JOIN TbliSAMSManagerUsers TblStaffManagementSCRQualificationCheckUsers ON TblStaffManagementSCRQualificationCheck.txtCheckedBy = TblStaffManagementSCRQualificationCheckUsers.txtUserCode
     LEFT OUTER JOIN TblStaff TblStaffSCRQualificationCheckUsers ON TblStaffManagementSCRQualificationCheck.txtCheckedBy = TblStaffSCRQualificationCheckUsers.User_Code
     LEFT OUTER JOIN TblStaffManagementCourses ON TblStaffManagementCourses.intStaff = TblStaff.TblStaffID
     LEFT OUTER JOIN TblStaffManagementQualifications ON TblStaffManagementQualifications.intStaff = TblStaff.TblStaffID
     LEFT OUTER JOIN TblUniversities ON TblStaffManagementQualifications.intUniversity = TblUniversities.UID
	WHERE (TblStaff.TblStaffID IN (SELECT ID FROM dbo.SplitCSV(@TblStaffID) AS SplitCSV_1)) OR (@TblStaffID IS NULL)</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="tblstaffid"><DataField>TblStaffID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="StaffID"><DataField>StaffID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="User_Code"><DataField>User_Code</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblStaffID_Old"><DataField>TblStaffID_Old</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Initials"><DataField>Initials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intPersonID"><DataField>intPersonID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Title"><DataField>Title</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreviousMISStaffID"><DataField>txtPreviousMISStaffID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="MiddleNames"><DataField>MiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PreName"><DataField>PreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DOB"><DataField>DOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="CountryofResidence"><DataField>CountryofResidence</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Fullname"><DataField>Fullname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Nationality"><DataField>Nationality</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Language"><DataField>Language</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name=