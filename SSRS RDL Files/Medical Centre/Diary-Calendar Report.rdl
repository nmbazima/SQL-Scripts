<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>3b8f61bc-0106-4716-a9b8-2bce1ba9da40</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="DiaryCalendarDetails"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter><QueryParameter Name="@PersonIDs"><Value>=Parameters!personIds.Value</Value></QueryParameter><QueryParameter Name="@dtStartDate"><Value>=Parameters!dtStartDate.Value</Value></QueryParameter><QueryParameter Name="@dtEndDate"><Value>=Parameters!dtEndDate.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @DiaryPermissionCheck AS NVARCHAR(MAX);

SET @DiaryPermissionCheck  = (SELECT dbo.f_CheckUserHasActivityPermission(@userCode, 'iSAMS_MEDICALCENTRE', 'Visit', 'Read', 5));

WITH MainTable AS 
    (SELECT * 
     FROM	(SELECT	dbo.f_CanViewMedicalRecord(@userCode, AuditBaseData.intMedicalRecordTypeID, AuditBaseData.intSensitivity) AS 'txtAllowed',
					AuditBaseData.TblMedicalAuditBaseId,
					AuditBaseData.gKey,
					AuditBaseData.intMedicalRecordTypeId,
					AuditBaseData.intPersonId,
					AuditBaseData.bDeleted,
					AuditBaseData.bArchived,
					AuditBaseData.intSensitivity,
					AuditLogData.TblMedicalAuditLogId,
					AuditLogData.intMedicalAuditBaseId,
					AuditLogData.intMedicalAuditActionId,
					AuditLogData.txtSubmitBy,
					AuditLogData.dSubmitDateTime,
					RANK() OVER(PARTITION BY gKey ORDER BY dSubmitDateTime DESC) AS 'intRnk'
			 FROM	TblMedicalAuditBase AuditBaseData
			 JOIN	TblMedicalAuditLog AuditLogData ON AuditBaseData.TblMedicalAuditBaseId = AuditLogData.intMedicalAuditBaseId
			 WHERE	AuditBaseData.intMedicalRecordTypeId = 5) MostRecentRecord
     WHERE  MostRecentRecord.intRnk = 1
			AND MostRecentRecord.intMedicalAuditActionId NOT IN (4,5)
			AND MostRecentRecord.intMedicalRecordTypeId = 5
    )

SELECT  DISTINCT MainTable.TblMedicalAuditBaseID, 
		MainTable.intPersonID, 
		CASE WHEN TblPupilManagementPupils.intPersonID IS NOT NULL THEN 'Pupil' WHEN TblStaff.intPersonID IS NOT NULL THEN 'Staff' END AS 'txtPupilOrStaff', 
		ISNULL(TblPupilManagementPupils.txtForename, TblStaff.Firstname) AS 'txtForename', 
		ISNULL(TblPupilManagementPupils.txtSurname, TblStaff.Surname) AS 'txtSurname', 
		ISNULL(TblPupilManagementPupils.txtMiddleNames, TblStaff.MiddleNames) AS 'txtMiddleNames', 
		ISNULL(TblPupilManagementPupils.txtPreName, TblStaff.PreName) AS 'txtPreName',
		TblPupilManagementPupils.intNCYear, 
		TblPupilManagementPupils.txtForm, 
		TblPupilManagementPupils.txtAcademicHouse, 
		TblPupilManagementPupils.txtBoardingHouse,
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordVisit.txtType AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtType', 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalVisitReason.txtReason AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtReason',
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalVisitLocation.txtName AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtLocation',
		CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordVisit.dArrivedAt ELSE '1986-04-30 08:46' END AS 'dtDateIn',
		CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordVisit.dArrivedAt ELSE '1986-04-30 08:46' END AS 'tTimeIn',
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(ArrivalLocation.txtLocality AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtArrivedFrom',
		CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordVisit.dDepartedAt ELSE '1986-04-30 08:46' END AS  'tTimeOut',
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalVisitLocality.txtLocality AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtDepartedTo',
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalTransportOption.txtName AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtDepartedByTransport',
		MedicationDetails.TblMedicalRecordMedicationID,
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(MedicationDetails.txtMedication AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtMedication', 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(MedicationDetails.txtMedicationType AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtMedicationType', 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(MedicationDetails.bStockItem AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'bStockItem', 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(MedicationDetails.txtDose AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtDose', 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(MedicationDetails.txtMedicationLocation AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtMedicationLocation', 
		CASE WHEN MainTable.txtAllowed = 1 THEN MedicationDetails.dtExpiryDate ELSE '1986-04-30 08:46' END AS 'dtExpiryDate', 
		CASE WHEN MainTable.txtAllowed = 1 THEN MedicationDetails.dtIssueDate ELSE '1986-04-30 08:46' END AS 'dtIssueDate', 
		CASE WHEN MainTable.txtAllowed = 1 THEN MedicationDetails.tIssueTime ELSE '1986-04-30 08:46' END AS 'tIssueTime', 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(MedicationDetails.bMedicationConsent AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'bMedicationConsent', 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(MedicationDetails.txtNotes AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtNotes',
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(CASE WHEN TblMedicalRecordVisit.dFollowUp IS NULL THEN 0 ELSE 1 END AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'bFollowUp',
		CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordVisit.dFollowUp ELSE '1986-04-30 08:46' END AS 'dtFollowUpDate',
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalVisitHours.tStart AS DATETIME) ELSE '1986-04-30 08:46' END AS 'tTimeFrom',
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalVisitHours.tEnd AS DATETIME) ELSE '1986-04-30 08:46' END AS 'tTimeTo',
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(FollowUpDetails.txtType AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtFollowUpNotes',
		(SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
		intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'dtLastUpdatedDate',
		(SELECT TOP 1 txtSubmitBy FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
		intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'txtLastUpdatedBy', 
		ISNULL((SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
		intMedicalAuditActionID = 1), MainTable.dSubmitDateTime) AS 'dtCreationDate', 
		@DiaryPermissionCheck AS 'blnDiaryPermissionCheck'
FROM	MainTable
LEFT OUTER JOIN TblMedicalRecordType ON  MainTable.intMedicalRecordTypeId = TblMedicalRecordType.TblMedicalRecordTypeId  
LEFT OUTER JOIN TblMedicalRecordVisit ON MainTable.TblMedicalAuditBaseId = TblMedicalRecordVisit.intMedicalAuditBaseId
LEFT OUTER JOIN TblPupilManagementPupils ON MainTable.intPersonID = TblPupilManagementPupils.intPersonID
LEFT OUTER JOIN TblStaff ON MainTable.intPersonID = TblStaff.intPersonID
LEFT OUTER JOIN TblMedicalVisitLocation ON TblMedicalRecordVisit.intLocationID = TblMedicalVisitLocation.TblMedicalVisitLocationID
LEFT OUTER JOIN TblMedicalVisitReason ON TblMedicalRecordVisit.intTblMedicalVisitReasonID = TblMedicalVisitReason.TblMedicalVisitReasonID
LEFT OUTER JOIN TblMedicalVisitLocality ON TblMedicalRecordVisit.intTblMedicalVisitDepartToID = TblMedicalVisitLocality.TblMedicalVisitLocalityID
LEFT OUTER JOIN TblMedicalTransportOption ON TblMedicalRecordVisit.intMedicalTransportOptionIDDepart = TblMedicalTransportOption.TblMedicalTransportOptionID
LEFT OUTER JOIN TblMedicalVisitLocality ArrivalLocation ON TblMedicalRecordVisit.intTblMedicalVisitArriveFromID = ArrivalLocation.TblMedicalVisitLocalityID
LEFT OUTER JOIN TblMedicalVisitHours ON TblMedicalVisitHours.TblMedicalVisitHoursID = TblMedicalRecordVisit.intTblMedicalVisitArriveFromID
LEFT OUTER JOIN (SELECT intPersonID, dArrivedAt, txtAction AS 'txtType', gKey, dFollowUp
				 FROM   TblMedicalAuditBase
				 LEFT OUTER JOIN TblMedicalRecordVisit ON TblMedicalAuditBase.TblMedicalAuditBaseId = TblMedicalRecordVisit.intMedicalAuditBaseId) AS FollowUpDetails
	ON MainTable.intPersonID = FollowUpDetails.intPersonID AND TblMedicalRecordVisit.dFollowUp = FollowUpDetails.dFollowUp AND FollowUpDetails.gKey = MainTable.gKey
LEFT OUTER JOIN (SELECT intPersonID, dIssueDate, txtMedication, TblMedicalMedicationType.txtName AS 'txtMedicationType', bStockItem, txtDose, 
						TblMedicalMedicationLocation.txtName AS 'txtMedicationLocation', dExpiryDate AS 'dtExpiryDate', dIssueDate AS 'dtIssueDate', 
						dIssueDate AS 'tIssueTime', bMedicationConsent, txtNotes, TblMedicalRecordMedicationID
				 FROM   TblMedicalAuditBase
				 LEFT OUTER JOIN TblMedicalRecordMedication ON TblMedicalAuditBase.TblMedicalAuditBaseId = TblMedicalRecordMedication.intMedicalAuditBaseId
				 LEFT OUTER JOIN TblMedicalMedicationLocation ON TblMedicalMedicationLocation.TblMedicalMedicationLocationID = TblMedicalRecordMedication.intMedicalMedicationLocationID
				 LEFT OUTER JOIN TblMedicalMedicationType ON TblMedicalMedicationType.TblMedicalMedicationTypeID = TblMedicalRecordMedication.intMedicationTypeID) AS MedicationDetails
	ON MainTable.intPersonID = MedicationDetails.intPersonID AND TblMedicalRecordVisit.dDepartedAt = MedicationDetails.dtIssueDate
WHERE   MainTable.intMedicalRecordTypeID = 5
	   AND (MainTable.intPersonID IN (SELECT ID FROM dbo.SplitCSV(@PersonIDs) AS SplitCSV_1) OR @PersonIDs IS NULL)
	   AND (TblMedicalRecordVisit.dArrivedAt BETWEEN CAST(FLOOR(CAST(@dtStartDate AS FLOAT)) AS DATETIME) AND CAST(FLOOR(CAST(@dtEndDate AS FLOAT)) AS DATETIME))</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="TblMedicalAuditBaseID"><DataField>TblMedicalAuditBaseID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intPersonID"><DataField>intPersonID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtPupilOrStaff"><DataField>txtPupilOrStaff</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtType"><DataField>txtType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtReason"><DataField>txtReason</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLocation"><DataField>txtLocation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtDateIn"><DataField>dtDateIn</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtNotes"><DataField>txtNotes</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="tTimeIn"><DataField>tTimeIn</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dtLastUpdatedDate"><DataField>dtLastUpdatedDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtArrivedFrom"><DataField>txtArrivedFrom</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLastUpdatedBy"><DataField>txtLastUpdatedBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblMedicalRecordMedicationID"><DataField>TblMedicalRecordMedicationID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="tTimeOut"><DataField>tTimeOut</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dtCreationDate"><DataField>dtCreationDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtDepartedTo"><DataField>txtDepartedTo</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDepartedByTransport"><DataField>txtDepartedByTransport</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMedication"><DataField>txtMedication</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMedicationType"><DataField>txtMedicationType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="bStockItem"><DataField>bStockItem</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDose"><DataField>txtDose</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="tIssueTime"><DataField>tIssueTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtMedicationLocation"><DataField>txtMedicationLocation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtExpiryDate"><DataField>dtExpiryDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dtIssueDate"><DataField>dtIssueDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="bMedicationConsent"><DataField>bMedicationConsent</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="bFollowUp"><DataField>bFollowUp</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtFollowUpDate"><DataField>dtFollowUpDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="tTimeFrom"><DataField>tTimeFrom</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="tTimeTo"><DataField>tTimeTo</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtFollowUpNotes"><DataField>txtFollowUpNotes</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnDiaryPermissionCheck"><DataField>blnDiaryPermissionCheck</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT txtExternaliSAMSAddress AS txtiSAMSAddress, txtiSAMSServerName
FROM TbliSAMSManagerSettings</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtiSAMSServerName"><DataField>txtiSAMSServerName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS txtSchoolLogoPath, txtName
FROM TblReportsCustomImages
WHERE TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix2"><TablixBody><TablixColumns><TablixColumn><Width>77.49998cm</Width></TablixColumn><TablixColumn><Width>5.00001cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>1.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox68"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!txtiSAMSServerName.Value, "iSAMSAddress")</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun><TextRun><Value> - Diary-Calendar Report</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox67</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Rectangle Name="Rectangle3"><ReportItems><Image Name="Image17"><Source>External</Source><Value>=IIF(Right(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), 1) = "/", Left(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), Len(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) - 1), First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) &amp; First(Fields!txtSchoolLogoPath.Value, "SchoolLogo")</Value><Sizing>FitProportional</Sizing><Left>1.9cm</Left><Height>1.4cm</Height><Width>3.1cm</Width><Style><Border><Style>None</Style></Border></Style></Image></ReportItems><KeepTogether>true</KeepTogether><Style><Border><Style>None</Style></Border></Style></Rectangle></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox12"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Generated on </Value><Style><FontSize>12pt</FontSize></Style></TextRun><TextRun><Value>=Globals!ExecutionTime</Value><Style><FontSize>12pt</FontSize><Format>dd/MM/yyyy</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox7</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox47"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>You are not authorised to view this data. Please contact your administrator for more information.</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox47</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#8eceec</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox15"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>No Diary Calender entries exist with the criteria you chose.</Value><Style><FontWeight>Bol