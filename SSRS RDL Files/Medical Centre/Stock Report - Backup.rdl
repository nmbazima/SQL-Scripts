pression>=Fields!TblMedicalStockID.Value</GroupExpression><GroupExpression>=Fields!txtStockType.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!TblMedicalStockID.Value</Value></SortExpression><SortExpression><Value>=Fields!txtStockType.Value</Value></SortExpression><SortExpression><Value>=Fields!txtItem.Value</Value></SortExpression><SortExpression><Value>=Fields!txtLocation.Value</Value></SortExpression></SortExpressions></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>StockDetails</DataSetName><Height>2.58521cm</Height><Width>15cm</Width><Visibility><Hidden>=IIF(MAX(Fields!blnStockPermissionCheck.Value) = True, False, True)</Hidden></Visibility><Style><Border><Style>None</Style></Border></Style></Tablix><Tablix Name="Tablix2"><TablixBody><TablixColumns><TablixColumn><Width>15cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.78521cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox14"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!txtiSAMSServerName.Value, "School")</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun><TextRun><Value> - Stock Report</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox13</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Generated on </Value><Style><FontSize>12pt</FontSize></Style></TextRun><TextRun><Value>=Globals!ExecutionTime</Value><Style><FontSize>12pt</FontSize><Format>dd/MM/yyyy</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox47"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>You are not authorised to view this data. Please contact your administrator for more information.</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox47</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#8eceec</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixRowHierarchy><DataSetName>StockDetails</DataSetName><Height>1.98521cm</Height><Width>15cm</Width><ZIndex>1</ZIndex><Visibility><Hidden>=IIF(MAX(Fields!blnStockPermissionCheck.Value) = True OR TRIM(CStr(Fields!blnStockPermissionCheck.Value)) = "", True, False)</Hidden></Visibility><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><Height>1.0178in</Height><Style /></Body><Width>5.90551in</Width><Page><PageHeight>29.7cm</PageHeight><PageWidth>17cm</PageWidth><LeftMargin>1cm</LeftMargin><RightMargin>1cm</RightMargin><TopMargin>1cm</TopMargin><BottomMargin>1cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>Demo</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>3b8f61bc-0106-4716-a9b8-2bce1ba9da40</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="StockDetails"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @StockPermissionCheck AS NVARCHAR(MAX);

SET @StockPermissionCheck  = (SELECT dbo.f_CheckUserHasActivityPermission(@userCode, 'iSAMS_MEDICALCENTRE', 'Stock', 'Read', 5));

SELECT  TblMedicalStockID, TblMedicalRecordType.txtName AS 'txtStockType', ISNULL(TblMedicalInventoryType.txtName, TblMedicalMedicationType.txtName) AS 'txtItem', 
  TblMedicalMedicationLocation.txtName AS 'txtLocation', 
  ISNULL(ISNULL(QuantityDetails.intTotalRecorded, MedQuantityDetails.intTotalRecorded), 0) + (ISNULL(MedQuantityMoveDetails.intQuantityDispensed, 0) * -1) AS 'intTotalRecorded', 
  decQuantity AS 'intQuantityInStock', 
  ISNULL(ISNULL(QuantityDetails.intQuantityDispensed, MedQuantityDetails.intQuantityDispensed), 0) AS 'intQuantityDispensed', TblMedicalStock.intLocationId, 
  @StockPermissionCheck AS 'blnStockPermissionCheck'
FROM    TblMedicalStock
LEFT OUTER JOIN TblMedicalRecordType ON TblMedicalStock.intTypeID = TblMedicalRecordType.TblMedicalRecordTypeID
LEFT OUTER JOIN TblMedicalInventoryType ON TblMedicalStock.intInventoryTypeID = TblMedicalInventoryType.TblMedicalInventoryTypeID
LEFT OUTER JOIN TblMedicalMedicationLocation ON TblMedicalStock.intLocationID = TblMedicalMedicationLocation.TblMedicalMedicationLocationID
LEFT OUTER JOIN (SELECT intInventoryTypeID, intLocationId, SUM(CASE WHEN decQuantity &gt; 0 THEN decQuantity ELSE 0 END) AS 'intTotalRecorded', SUM(CASE WHEN decQuantity &lt; 0 THEN decQuantity 
        ELSE 0 END) AS 'intQuantityDispensed'
    FROM  TblMedicalStockAudit
    GROUP BY intInventoryTypeID, intLocationId) AS QuantityDetails ON TblMedicalStock.intInventoryTypeID = QuantityDetails.intInventoryTypeID
    AND TblMedicalStock.intLocationId = QuantityDetails.intLocationId
LEFT OUTER JOIN (SELECT intMedicationTypeID, intLocationId, SUM(CASE WHEN decQuantity &gt; 0 THEN decQuantity ELSE 0 END) AS 'intTotalRecorded', SUM(CASE WHEN decQuantity &lt; 0 THEN decQuantity 
        ELSE 0 END) AS 'intQuantityDispensed'
    FROM  TblMedicalStockAudit
    GROUP BY intMedicationTypeID, intLocationId) AS MedQuantityDetails ON TblMedicalStock.intMedicationTypeID = MedQuantityDetails.intMedicationTypeID
    AND TblMedicalStock.intLocationId = MedQuantityDetails.intLocationId
LEFT OUTER JOIN (SELECT intMedicationTypeID, intTargetLocationId, SUM(CASE WHEN decQuantity &gt; 0 THEN decQuantity ELSE 0 END) AS 'intTotalRecorded', SUM(CASE WHEN decQuantity &lt; 0 THEN decQuantity 
		ELSE 0 END) AS 'intQuantityDispensed'
	FROM   TblMedicalStockAudit
	WHERE		intTargetLocationId IS NOT NULL
	GROUP BY intMedicationTypeID, intTargetLocationId) AS MedQuantityMoveDetails ON TblMedicalStock.intMedicationTypeID = MedQuantityMoveDetails.intMedicationTypeID
	AND TblMedicalStock.intLocationId = MedQuantityMoveDetails.intTargetLocationId
LEFT OUTER JOIN TblMedicalMedicationType ON TblMedicalStock.intMedicationTypeId = TblMedicalMedicationType.TblMedicalMedicationTypeId</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="TblMedicalStockID"><DataField>TblMedicalStockID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtStockType"><DataField>txtStockType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtItem"><DataField>txtItem</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLocation"><DataField>txtLocation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intTotalRecorded"><DataField>intTotalRecorded</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="intQuantityInStock"><DataField>intQuantityInStock</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="intQuantityDispensed"><DataField>intQuantityDispensed</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="intLocationId"><DataField>intLocationId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="blnStockPermissionCheck"><DataField>blnStockPermissionCheck</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="School"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtiSAMSServerName
FROM	TbliSAMSManagerSettings</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="txtiSAMSServerName"><DataField>txtiSAMSServerName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportParameters><ReportParameter Name="userCode"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>userCode</Prompt><Hidden>true</Hidden></ReportParameter></ReportParameters><Language>=User!Language</Language><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>0c2e8670-d09c-4e28-ba06-4f1c50a45f1e</rd:ReportID></Report>