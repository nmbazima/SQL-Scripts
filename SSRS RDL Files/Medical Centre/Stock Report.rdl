ressions><GroupExpression>=Fields!TblMedicalStockID.Value</GroupExpression><GroupExpression>=Fields!txtStockType.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!TblMedicalStockID.Value</Value></SortExpression><SortExpression><Value>=Fields!txtStockType.Value</Value></SortExpression><SortExpression><Value>=Fields!txtItem.Value</Value></SortExpression><SortExpression><Value>=Fields!txtLocation.Value</Value></SortExpression></SortExpressions></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>StockDetails</DataSetName><Height>3.2cm</Height><Width>15cm</Width><ZIndex>1</ZIndex><Visibility><Hidden>=IIF(MAX(Fields!blnStockPermissionCheck.Value) = True, False, True)</Hidden></Visibility><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><Height>1.25984in</Height><Style /></Body><Width>5.90551in</Width><Page><PageHeight>29.7cm</PageHeight><PageWidth>17cm</PageWidth><LeftMargin>1cm</LeftMargin><RightMargin>1cm</RightMargin><TopMargin>1cm</TopMargin><BottomMargin>1cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page></ReportSection></ReportSections><ReportParameters><ReportParameter Name="userCode"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>User Code:</Prompt><Hidden>true</Hidden></ReportParameter></ReportParameters><Language>=User!Language</Language><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>0c2e8670-d09c-4e28-ba06-4f1c50a45f1e</rd:ReportID></Report>