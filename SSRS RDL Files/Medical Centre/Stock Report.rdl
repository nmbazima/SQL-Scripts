<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>3b8f61bc-0106-4716-a9b8-2bce1ba9da40</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="StockDetails"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @StockPermissionCheck AS NVARCHAR(MAX);

SET @StockPermissionCheck  = (SELECT dbo.f_CheckUserHasActivityPermission(@userCode, 'iSAMS_MEDICALCENTRE', 'Stock', 'Read', 5));

SELECT	TblMedicalStockID, 
		TblMedicalRecordType.txtName AS 'txtStockType', 
		ISNULL(TblMedicalInventoryType.txtName, TblMedicalMedicationType.txtName) AS 'txtItem', 
		TblMedicalMedicationLocation.txtName AS 'txtLocation', 
		ISNULL(ISNULL(QuantityDetails.intTotalRecorded, MedQuantityDetails.intTotalRecorded), 0) + (ISNULL(MedQuantityMoveDetails.intQuantityDispensed, 0) * -1) AS 'intTotalRecorded', 
		TblMedicalStock.decQuantity AS 'intQuantityInStock', 
		ISNULL(ISNULL(QuantityDetails.intQuantityDispensed, MedQuantityDetails.intQuantityDispensed), 0) AS 'intQuantityDispensed', 
		TblMedicalStock.intLocationId, 
		@StockPermissionCheck AS 'blnStockPermissionCheck'
FROM    TblMedicalStock
LEFT OUTER JOIN TblMedicalRecordType ON TblMedicalStock.intTypeID = TblMedicalRecordType.TblMedicalRecordTypeID
LEFT OUTER JOIN TblMedicalInventoryType ON TblMedicalStock.intInventoryTypeID = TblMedicalInventoryType.TblMedicalInventoryTypeID
LEFT OUTER JOIN TblMedicalMedicationLocation ON TblMedicalStock.intLocationID = TblMedicalMedicationLocation.TblMedicalMedicationLocationID
LEFT OUTER JOIN (SELECT intInventoryTypeID, 
						intLocationId, 
						SUM(CASE WHEN decQuantity &gt; 0 THEN decQuantity ELSE 0 END) AS 'intTotalRecorded', 
						SUM(CASE WHEN decQuantity &lt; 0 THEN decQuantity ELSE 0 END) AS 'intQuantityDispensed'
				 FROM	TblMedicalStockAudit
				 GROUP BY intInventoryTypeID, intLocationId) AS QuantityDetails 
	ON TblMedicalStock.intInventoryTypeID = QuantityDetails.intInventoryTypeID AND TblMedicalStock.intLocationId = QuantityDetails.intLocationId
LEFT OUTER JOIN (SELECT intMedicationTypeID, 
						intLocationId, 
						SUM(CASE WHEN decQuantity &gt; 0 THEN decQuantity ELSE 0 END) AS 'intTotalRecorded', 
						SUM(CASE WHEN decQuantity &lt; 0 THEN decQuantity ELSE 0 END) AS 'intQuantityDispensed'
				 FROM	TblMedicalStockAudit
				 GROUP BY intMedicationTypeID, intLocationId) AS MedQuantityDetails 
	ON TblMedicalStock.intMedicationTypeID = MedQuantityDetails.intMedicationTypeID AND TblMedicalStock.intLocationId = MedQuantityDetails.intLocationId
LEFT OUTER JOIN (SELECT intMedicationTypeID, 
						intTargetLocationId, 
						SUM(CASE WHEN decQuantity &gt; 0 THEN decQuantity ELSE 0 END) AS 'intTotalRecorded', 
						SUM(CASE WHEN decQuantity &lt; 0 THEN decQuantity ELSE 0 END) AS 'intQuantityDispensed'
				 FROM	TblMedicalStockAudit
				 WHERE	intTargetLocationId IS NOT NULL
				 GROUP BY intMedicationTypeID, intTargetLocationId) AS MedQuantityMoveDetails 
	ON TblMedicalStock.intMedicationTypeID = MedQuantityMoveDetails.intMedicationTypeID AND TblMedicalStock.intLocationId = MedQuantityMoveDetails.intTargetLocationId
LEFT OUTER JOIN TblMedicalMedicationType ON TblMedicalStock.intMedicationTypeId = TblMedicalMedicationType.TblMedicalMedicationTypeId</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="TblMedicalStockID"><DataField>TblMedicalStockID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtStockType"><DataField>txtStockType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtItem"><DataField>txtItem</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLocation"><DataField>txtLocation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intTotalRecorded"><DataField>intTotalRecorded</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="intQuantityInStock"><DataField>intQuantityInStock</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="intQuantityDispensed"><DataField>intQuantityDispensed</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="intLocationId"><DataField>intLocationId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="blnStockPermissionCheck"><DataField>blnStockPermissionCheck</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT txtExternaliSAMSAddress AS txtiSAMSAddress, txtiSAMSServerName
FROM TbliSAMSManagerSettings</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtiSAMSServerName"><DataField>txtiSAMSServerName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS txtSchoolLogoPath, txtName
FROM TblReportsCustomImages
WHERE TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix2"><TablixBody><TablixColumns><TablixColumn><Width>10cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>1.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox14"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!txtiSAMSServerName.Value, "iSAMSAddress")</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun><TextRun><Value> - Stock Report</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox13</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Rectangle Name="Rectangle9"><ReportItems><Image Name="Image23"><Source>External</Source><Value>=IIF(Right(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), 1) = "/", Left(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), Len(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) - 1), First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) &amp; First(Fields!txtSchoolLogoPath.Value, "SchoolLogo")</Value><Sizing>FitProportional</Sizing><Left>1.9cm</Left><Height>1.4cm</Height><Width>3.1cm</Width><Style><Border><Style>None</Style></Border></Style></Image></ReportItems><KeepTogether>true</KeepTogether><Style><Border><Style>None</Style></Border></Style></Rectangle></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Generated on </Value><Style><FontSize>12pt</FontSize></Style></TextRun><TextRun><Value>=Globals!ExecutionTime</Value><Style><FontSize>12pt</FontSize><Format>dd/MM/yyyy</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox47"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>You are not authorised to view this data. Please contact your administrator for more information.</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox47</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#8eceec</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox15"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>No Stock exists with the criteria you chose.</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Alter your selection to re-search the iSAMS database.</Value><Style><FontSize>8pt</FontSize><FontWeight>Normal</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember><Visibility><Hidden>=IIF(CountRows("StockDetails")&gt;0,false,true)</Hidden></Visibility></TablixMember><TablixMember><Visibility><Hidden>=IIF(CountRows("StockDetails")=0,false,true)</Hidden></Visibility></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>StockDetails</DataSetName><Height>3.2cm</Height><Width>15cm</Width><Visibility><Hidden>=IIF(MAX(Fields!blnStockPermissionCheck.Value) = True OR TRIM(CStr(Fields!blnStockPermissionCheck.Value)) = "", True, False)</Hidden></Visibility><Style><Border><Style>None</Style></Border></Style></Tablix><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>1.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox13"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Para