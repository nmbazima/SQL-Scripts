<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>e169aa97-218c-4f47-95e3-63d4a493c61e</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="VisitLog"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter><QueryParameter Name="@dStartDate"><Value>=Parameters!dStartDate.Value</Value></QueryParameter><QueryParameter Name="@dEndDate"><Value>=Parameters!dEndDate.Value</Value></QueryParameter><QueryParameter Name="@intVisitType"><Value>=Parameters!intVisitType.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @DiaryPermissionCheck AS NVARCHAR(MAX);

SET @DiaryPermissionCheck  = (SELECT dbo.f_CheckUserHasActivityPermission(@userCode, 'iSAMS_MEDICALCENTRE', 'Visit', 'Read', 5));

WITH MainTable AS 
    (SELECT * 
     FROM	(SELECT	dbo.f_CanViewMedicalRecord(@userCode, AuditBaseData.intMedicalRecordTypeID, AuditBaseData.intSensitivity) AS 'txtAllowed',
					AuditBaseData.TblMedicalAuditBaseId,
					AuditBaseData.gKey,
					AuditBaseData.intMedicalRecordTypeId,
					AuditBaseData.intPersonId,
					AuditBaseData.bDeleted,
					AuditBaseData.bArchived,
					AuditBaseData.intSensitivity,
					AuditLogData.TblMedicalAuditLogId,
					AuditLogData.intMedicalAuditBaseId,
					AuditLogData.intMedicalAuditActionId,
					AuditLogData.txtSubmitBy,
					AuditLogData.dSubmitDateTime,
					RANK() OVER(PARTITION BY gKey ORDER BY dSubmitDateTime DESC) AS 'intRnk'
			 FROM	TblMedicalAuditBase AuditBaseData
			 JOIN	TblMedicalAuditLog AuditLogData ON AuditBaseData.TblMedicalAuditBaseId = AuditLogData.intMedicalAuditBaseId
			 WHERE	AuditBaseData.intMedicalRecordTypeId = 5) MostRecentRecord
     WHERE  MostRecentRecord.intRnk = 1
			AND MostRecentRecord.intMedicalAuditActionId NOT IN (4,5)
			AND MostRecentRecord.intMedicalRecordTypeId = 5
    )

SELECT  TblMedicalRecordVisitId, ISNULL(TblPupilManagementPupils.txtSchoolID, TblStaff.TblStaffID) AS 'txtPersonID', ISNULL(TblPupilManagementPupils.txtForename, TblStaff.FirstName) AS 'txtPersonForeName', 
		ISNULL(TblPupilManagementPupils.txtSurname, TblStaff.Surname) AS 'txtPersonSurname', ISNULL(TblPupilManagementPupils.txtPreName, TblStaff.PreName) AS 'txtPersonPreName', 
		TblSchoolManagementYears.txtYearName AS 'Grade', TblPupilManagementPupils.txtForm AS 'Form', ISNULL(TblPupilManagementPupils.txtGender, TblStaff.Sex) AS 'txtPersonGender', 
		CASE WHEN txtAllowed = 1 THEN CAST(TblMedicalVisitReason.txtReason AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtType', 
		intTblMedicalVisitReasonId, 
		CASE WHEN txtAllowed = 1 THEN CAST(TblMedicalRecordVisit.txtType AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtReason', 
		CASE WHEN txtAllowed = 1 THEN dArrivedAt ELSE '1986-04-30 08:46' END AS 'dArrivedAt', 
		dDepartedAt AS 'dDepartedAt', 
		CASE WHEN txtAllowed = 1 THEN CAST(ArrivalLocation.txtLocality AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtArriveFrom', 
		CASE WHEN txtAllowed = 1 THEN CAST(TblMedicalVisitLocality.txtLocality AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtDepartTo', 
		CASE WHEN txtAllowed = 1 THEN CAST(TblMedicalTransportOption.txtName AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtTransport', 
		CASE WHEN txtAllowed = 1 THEN CAST(TblMedicalVisitLocation.txtName AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtLocation', 
		CASE WHEN txtAllowed = 1 THEN dFollowUp ELSE '1986-04-30 08:46' END AS 'dFollowUp', 
		CASE WHEN txtAllowed = 1 THEN CAST(txtAction AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtFollowUpNotes', 
		TblStaff.Title, TblStaff.Firstname, TblStaff.Surname, @DiaryPermissionCheck AS 'blnDiaryPermissionCheck'
FROM	MainTable
LEFT OUTER JOIN TblMedicalRecordType ON  MainTable.intMedicalRecordTypeId = TblMedicalRecordType.TblMedicalRecordTypeId  
LEFT OUTER JOIN TblMedicalRecordVisit ON MainTable.TblMedicalAuditBaseId = TblMedicalRecordVisit.intMedicalAuditBaseId
LEFT OUTER JOIN TblPupilManagementPupils ON MainTable.intPersonID = TblPupilManagementPupils.intPersonID
LEFT OUTER JOIN TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear 
LEFT OUTER JOIN TblStaff ON MainTable.intPersonID = TblStaff.intPersonID
LEFT OUTER JOIN TblMedicalVisitLocation ON TblMedicalRecordVisit.intLocationID = TblMedicalVisitLocation.TblMedicalVisitLocationID
LEFT OUTER JOIN TblMedicalVisitReason ON TblMedicalRecordVisit.intTblMedicalVisitReasonID = TblMedicalVisitReason.TblMedicalVisitReasonID
LEFT OUTER JOIN TblMedicalVisitLocality ON TblMedicalRecordVisit.intTblMedicalVisitDepartToID = TblMedicalVisitLocality.TblMedicalVisitLocalityID
LEFT OUTER JOIN TblMedicalTransportOption ON TblMedicalRecordVisit.intMedicalTransportOptionIDDepart = TblMedicalTransportOption.TblMedicalTransportOptionID
LEFT OUTER JOIN TblMedicalVisitLocality ArrivalLocation ON TblMedicalRecordVisit.intTblMedicalVisitArriveFromID = ArrivalLocation.TblMedicalVisitLocalityID
LEFT OUTER JOIN TblMedicalVisitHours ON TblMedicalVisitHours.TblMedicalVisitHoursID = TblMedicalRecordVisit.intTblMedicalVisitArriveFromID
WHERE   MainTable.intMedicalRecordTypeID = 5
		AND (dArrivedAt BETWEEN CAST(FLOOR(CAST(@dStartDate AS FLOAT)) AS DATETIME) AND DateAdd(DAY, 1, CAST(FLOOR(CAST(@dEndDate AS FLOAT)) AS DATETIME)))	
		AND (intTblMedicalVisitReasonId IN (@intVisitType))</CommandText></Query><Fields><Field Name="TblMedicalRecordVisitId"><DataField>TblMedicalRecordVisitId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtPersonID"><DataField>txtPersonID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPersonForeName"><DataField>txtPersonForeName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPersonSurname"><DataField>txtPersonSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPersonPreName"><DataField>txtPersonPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Grade"><DataField>Grade</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Form"><DataField>Form</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPersonGender"><DataField>txtPersonGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtType"><DataField>txtType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intTblMedicalVisitReasonId"><DataField>intTblMedicalVisitReasonId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtReason"><DataField>txtReason</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dArrivedAt"><DataField>dArrivedAt</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dDepartedAt"><DataField>dDepartedAt</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtArriveFrom"><DataField>txtArriveFrom</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDepartTo"><DataField>txtDepartTo</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTransport"><DataField>txtTransport</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLocation"><DataField>txtLocation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dFollowUp"><DataField>dFollowUp</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtFollowUpNotes"><DataField>txtFollowUpNotes</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Title"><DataField>Title</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnDiaryPermissionCheck"><DataField>blnDiaryPermissionCheck</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="VisitType"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT        TblMedicalVisitReasonId, txtReason
FROM            TblMedicalVisitReason
WHERE        (bDeleted = 0)
ORDER BY txtReason</CommandText></Query><Fields><Field Name="TblMedicalVisitReasonId"><DataField>TblMedicalVisitReasonId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtReason"><DataField>txtReason</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolName"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT        txtiSAMSServerName
FROM            TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSServerName"><DataField>txtiSAMSServerName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>1.3cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>1.6cm</Width></TablixColumn><TablixColumn><Width>1.3cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>1.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="TotalVisits"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountDistinct(Fields!TblMedicalRecordVisitId.Value)</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Visibility><Hidden>true</Hidden></Visibility><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox9"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox9</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox37"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox37</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox40"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox40</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox43"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox43</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox46"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox46</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox49"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox49</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox52"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox52</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox55"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox55</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox58"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox58</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox64"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox64</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox61"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox61</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox67"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox67</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox70"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox70</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox73"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox73</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Student Name</Value><Style><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox3</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>White</BackgroundColor><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextR