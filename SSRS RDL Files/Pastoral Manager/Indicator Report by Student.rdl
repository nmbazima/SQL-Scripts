<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>1292bb5e-2181-487d-a9bc-bd149465f0e9</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Users"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT TbliSAMSManagerUsers.txtUsername
FROM TbliSAMSManagerUsers
WHERE TbliSAMSManagerUsers.txtUserCode = @userCode</CommandText></Query><Fields><Field Name="txtUsername"><DataField>txtUsername</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Indicators"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@dtStartDate"><Value>=Parameters!dtStartDate.Value</Value></QueryParameter><QueryParameter Name="@dtEndDate"><Value>=Parameters!dtEndDate.Value</Value></QueryParameter><QueryParameter Name="@txtTitle"><Value>=Parameters!txtTitle.Value</Value></QueryParameter><QueryParameter Name="@intStatus"><Value>=Parameters!intStatus.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 
Indicator.*,
IndicatorStatus.Name AS txtIndicatorStatus,
DismissalReason.Name AS txtReasonForDismissal,
Pupils.txtSurname,
Pupils.txtForename,
Pupils.txtDOB,
Pupils.txtForm,
Pupils.intNCYear

FROM
[pastoral].[Indicator] AS Indicator
INNER JOIN 
tblPupilManagementPupils AS Pupils ON Indicator.SchoolId = Pupils.txtSchoolID

INNER JOIN [pastoral].[IndicatorStatus] AS IndicatorStatus ON Indicator.IndicatorStatusId = IndicatorStatus.Id

LEFT OUTER JOIN pastoral.ReasonForDismissal AS DismissalReason ON Indicator.ReasonForDismissalId =  DismissalReason.Id

WHERE 
Indicator.RaisedOn Between @dtStartDate and @dtEndDate
AND Indicator.Title IN (@txtTitle)

AND IndicatorStatus.Id IN (@intStatus)

AND Indicator.SchoolId IN (@txtSchoolID)</CommandText></Query><Fields><Field Name="Id"><DataField>Id</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="IndicatorStatusId"><DataField>IndicatorStatusId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="DateRaised"><DataField>DateRaised</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="SchoolId"><DataField>SchoolId</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Usercode"><DataField>Usercode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ModuleId"><DataField>ModuleId</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Title"><DataField>Title</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Details"><DataField>Details</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ReasonForDismissalId"><DataField>ReasonForDismissalId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="RaisedOn"><DataField>RaisedOn</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="EventDetails"><DataField>EventDetails</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtIndicatorStatus"><DataField>txtIndicatorStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtReasonForDismissal"><DataField>txtReasonForDismissal</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDOB"><DataField>txtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="Title"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@dtStartDate"><Value>=Parameters!dtStartDate.Value</Value></QueryParameter><QueryParameter Name="@dtEndDate"><Value>=Parameters!dtEndDate.Value</Value></QueryParameter></QueryParameters><CommandText>Select Distinct
Indicator.Title 
from
[pastoral].[Indicator] AS Indicator
WHERE 
Indicator.RaisedOn Between @dtStartDate and @dtEndDate
Order By
Indicator.Title</CommandText></Query><Fields><Field Name="Title"><DataField>Title</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="IndicatorStatus"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>select 
Id,
Name
 from [pastoral].[IndicatorStatus]

Order By Id</CommandText></Query><Fields><Field Name="Id"><DataField>Id</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Students"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@dtStartDate"><Value>=Parameters!dtStartDate.Value</Value></QueryParameter><QueryParameter Name="@dtEndDate"><Value>=Parameters!dtEndDate.Value</Value></QueryParameter><QueryParameter Name="@txtTitle"><Value>=Parameters!txtTitle.Value</Value></QueryParameter><QueryParameter Name="@intStatus"><Value>=Parameters!intStatus.Value</Value></QueryParameter><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter><QueryParameter Name="@txtForm"><Value>=Parameters!txtForm.Value</Value></QueryParameter></QueryParameters><CommandText>select Distinct
Indicator.SchoolId,
Pupils.txtSurname + ', ' + Pupils.txtForename AS txtPupilName

from
[pastoral].[Indicator] AS Indicator
INNER JOIN 
tblPupilManagementPupils AS Pupils ON Indicator.SchoolId = Pupils.txtSchoolID

INNER JOIN [pastoral].[IndicatorStatus] AS IndicatorStatus ON Indicator.IndicatorStatusId = IndicatorStatus.Id

WHERE 
Indicator.RaisedOn Between @dtStartDate and @dtEndDate
AND Indicator.Title IN (@txtTitle)
AND IndicatorStatus.Id IN (@intStatus)

AND Pupils.intNCYear IN (@intNCYear)
AND Pupils.txtForm in (@txtForm)

Order by
Pupils.txtSurname + ', ' + Pupils.txtForename</CommandText></Query><Fields><Field Name="SchoolId"><DataField>SchoolId</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPupilName"><DataField>txtPupilName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="NcYears"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>Select 
intNCYear,
txtYearName
from TblSchoolManagementYears

Order by
intNCYear</CommandText></Query><Fields><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Forms"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter></QueryParameters><CommandText>Select 
txtForm
From
TblSchoolManagementForms
Where intNCYear IN (@intNCYear)
order by intNCYear</CommandText></Query><Fields><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix2"><TablixBody><TablixColumns><TablixColumn><Width>28.7cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox63"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Indicator Report </Value><Style><FontFamily>arial</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value>=Parameters!dtStartDate.Value</Value><Style><FontFamily>arial</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Format>dd-MMM-yyyy</Format><Color>#373948</Color></Style></TextRun><TextRun><Value> to </Value><Style><FontFamily>arial</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Format>dd-MMM-yyyy</Format><Color>#373948</Color></Style></TextRun><TextRun><Value>=Parameters!dtEndDate.Value</Value><Style><FontFamily>arial</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Format>dd-MMM-yyyy</Format><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox63</rd:DefaultName><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>2.9cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle1"><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>7.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Wi