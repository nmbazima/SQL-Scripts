<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>3b8f61bc-0106-4716-a9b8-2bce1ba9da40</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="LifeEvents"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@LifeEventType"><Value>=Parameters!LifeEventType.Value</Value></QueryParameter><QueryParameter Name="@dtReminderStartDate"><Value>=Parameters!dtReminderStartDate.Value</Value></QueryParameter><QueryParameter Name="@dtReminderEndDate"><Value>=Parameters!dtReminderEndDate.Value</Value></QueryParameter><QueryParameter Name="@txtStartDate"><Value>=Parameters!txtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	--core
		Pupils.intPersonID,
		Pupils.txtSurname,
		Pupils.txtForename,
		Pupils.txtDoB AS dtDoB,
		Pupils.intNCYear,
		Pupils.txtForm,
		TblSchoolManagementYears.txtYearName,
		Pupils.txtAcademicHouse,
		Pupils.txtBoardingHouse,
		-- Life Event
		LifeEvent.Id AS intLifeEventID,
		LifeEvent.OccurredOn AS dtLifeEventDate,
		LifeEvent.Title AS txtLifeEventTitle,
		LifeEventType.Name AS txtLifeEventType,
		LifeEvent.OccurredOn AS dtLifeEventAniversary,
		LifeEvent.Description AS txtLifeEventDescription,
		LifeEventReminder.[RemindFrom] AS dtLifeEventReminderDateFrom,
		LifeEventReminder.[RemindTo] AS dtLifeEventReminderDateTo,
		CASE WHEN LifeEventReminder.Recur = 1 THEN 'Yes' ELSE 'No' END AS txtLifeEventRecurAnnually,
		LifeEventReminder.Recur,
		DATEADD(YEAR,1900 - YEAR(LifeEventReminder.[RemindFrom]),LifeEventReminder.[RemindFrom]) AS '1900LiferEventReminderFrom',
		DATEADD(YEAR,1900 - YEAR(LifeEventReminder.[RemindTo]),LifeEventReminder.[RemindTo]) AS '1900LiferEventReminderTo'
FROM	pastoral.LifeEvent AS LifeEvent
INNER JOIN  TblPupilManagementPupils AS Pupils ON Pupils.txtSchoolID = LifeEvent.SchoolId
LEFT OUTER JOIN pastoral.LifeEventType AS LifeEventType ON LifeEvent.LifeEventTypeId = LifeEventType.Id
LEFT OUTER JOIN pastoral.LifeEventReminder AS LifeEventReminder ON LifeEvent.Id = LifeEventReminder.LifeEventId
LEFT OUTER JOIN TblSchoolManagementYears ON Pupils.IntNCYear = TblSchoolManagementYears.intNCYear
WHERE	LifeEvent.LifeEventTypeId IN (@LifeEventType)
		AND (CASE WHEN DATEPART(MONTH, @dtReminderStartDate) &lt;= DATEPART(MONTH, @dtReminderEndDate) THEN
				CASE WHEN
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, LifeEventReminder.[RemindFrom]) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, LifeEventReminder.[RemindFrom]) AS VARCHAR(2)), 2) &gt;=
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, @dtReminderStartDate) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, @dtReminderStartDate) AS VARCHAR(2)), 2)
						AND
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, LifeEventReminder.[RemindTo]) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, LifeEventReminder.[RemindTo]) AS VARCHAR(2)), 2) &lt;=
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, @dtReminderEndDate) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, @dtReminderEndDate) AS VARCHAR(2)), 2)
					THEN 1 ELSE 0 END
				WHEN DATEPART(MONTH, @dtReminderStartDate) &gt; DATEPART(MONTH, @dtReminderEndDate) THEN 
				CASE WHEN
					('1901-' + RIGHT('0' + CAST(DATEPART(MONTH, LifeEventReminder.[RemindFrom]) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, LifeEventReminder.[RemindFrom]) AS VARCHAR(2)), 2) &gt;=
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, @dtReminderStartDate) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, @dtReminderStartDate) AS VARCHAR(2)), 2)
						AND
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, LifeEventReminder.[RemindTo]) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, LifeEventReminder.[RemindTo]) AS VARCHAR(2)), 2) &lt;=
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, @dtReminderEndDate) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, @dtReminderEndDate) AS VARCHAR(2)), 2)
						) OR
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, LifeEventReminder.[RemindTo]) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, LifeEventReminder.[RemindTo]) AS VARCHAR(2)), 2) &gt;=
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, @dtReminderStartDate) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, @dtReminderStartDate) AS VARCHAR(2)), 2)
				THEN 1 ELSE 0 END
			END = 1
		OR @dtReminderStartDate IS NULL OR @dtReminderEndDate IS NULL)
		AND (CASE WHEN DATEPART(MONTH, @txtStartDate) &lt;= DATEPART(MONTH, @txtEndDate) THEN
				CASE WHEN
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, LifeEvent.OccurredOn) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, LifeEvent.OccurredOn) AS VARCHAR(2)), 2) &gt;=
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, @txtStartDate) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, @txtStartDate) AS VARCHAR(2)), 2)
						AND
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, LifeEvent.OccurredOn) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, LifeEvent.OccurredOn) AS VARCHAR(2)), 2) &lt;=
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, @txtEndDate) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, @txtEndDate) AS VARCHAR(2)), 2)
				THEN 1 ELSE 0 END
			WHEN DATEPART(MONTH, @txtStartDate) &gt; DATEPART(MONTH, @txtEndDate) THEN 
				CASE WHEN
					('1901-' + RIGHT('0' + CAST(DATEPART(MONTH, LifeEvent.OccurredOn) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, LifeEvent.OccurredOn) AS VARCHAR(2)), 2) &gt;=
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, @txtStartDate) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, @txtStartDate) AS VARCHAR(2)), 2)
						AND
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, LifeEvent.OccurredOn) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, LifeEvent.OccurredOn) AS VARCHAR(2)), 2) &lt;=
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, @txtEndDate) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, @txtEndDate) AS VARCHAR(2)), 2)
						) OR
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, LifeEvent.OccurredOn) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, LifeEvent.OccurredOn) AS VARCHAR(2)), 2) &gt;=
					'1900-' + RIGHT('0' + CAST(DATEPART(MONTH, @txtStartDate) AS VARCHAR(2)), 2) + '-' + RIGHT('0' + CAST(DATEPART(DAY, @txtStartDate) AS VARCHAR(2)), 2)
				THEN 1 ELSE 0 END
			END = 1
		OR @txtStartDate IS NULL OR @txtEndDate IS NULL)</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="intPersonID"><DataField>intPersonID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtDoB"><DataField>dtDoB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intLifeEventID"><DataField>intLifeEventID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="dtLifeEventDate"><DataField>dtLifeEventDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtLifeEventTitle"><DataField>txtLifeEventTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLifeEventType"><DataField>txtLifeEventType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtLifeEventAniversary"><DataField>dtLifeEventAniversary</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtLifeEventDescription"><DataField>txtLifeEventDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtLifeEventReminderDateFrom"><DataField>dtLifeEventReminderDateFrom</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dtLifeEventReminderDateTo"><DataField>dtLifeEventReminderDateTo</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtLifeEventRecurAnnually"><DataField>txtLifeEventRecurAnnually</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Recur"><DataField>Recur</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="ID1900LiferEventReminderFrom"><DataField>1900LiferEventReminderFrom</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="ID1900LiferEventReminderTo"><DataField>1900LiferEventReminderTo</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields><Filters><Filter><FilterExpression>=IIF(Fields!txtLifeEventRecurAnnually.Value="Yes",
Switch(
Month(Fields!dtLifeEventAniversary.Value) &gt;= month(Parameters!txtStartDate.Value) AND  
Month(Fields!dtLifeEventAniversary.Value) &lt;= month(Parameters!txtEndDate.Value) 
AND 
Day(Fields!dtLifeEventAniversary.Value) &gt;= Day(Parameters!txtStartDate.Value) AND  
Day(Fields!dtLifeEventAniversary.Value) &lt;= Day(Parameters!txtEndDate.Value), True,

Trim(Parameters!txtStartDate.Value)="", True,
Trim(Parameters!txtEndDate.Value)="", True,
1=1,False),

Switch(
Fields!dtLifeEventAniversary.Value &gt;= (Parameters!txtStartDate.Value) AND  
Fields!dtLifeEventAniversary.Value &lt;= (Parameters!txtEndDate.Value) ,True,

Trim(Parameters!txtStartDate.Value)="" AND Trim(Parameters!txtEndDate.Value)="" , True,
Trim(Parameters!txtEndDate.Value)="" AND Fields!dtLifeEventAniversary.Value &gt;= (Parameters!txtStartDate.Value), True,
Trim(Parameters!txtStartDate.Value)="" AND Fields!dtLifeEventAniversary.Value &lt;= (Parameters!txtEndDate.Value), True,
1=1,False)
)</FilterExpression><Operator>Equal</Operator><FilterValues><FilterValue DataType="Boolean">=True</FilterValue></FilterValues></Filter></Filters></DataSet><DataSet Name="School"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtiSAMSServerName
FROM	TbliSAMSManagerSettings</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="txtiSAMSServerName"><DataField>txtiSAMSServerName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="EventType"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT ID, Name
FROM 
pastoral.LifeEventType
WHERE Deleted = 0
ORDER BY
Name</CommandText></Query><Fields><Field Name="Id"><DataField>ID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>3.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.78521cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox35"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!txtiSAMSServerName.Value, "School")</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun><TextRun><Value> - Life Events</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox35</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>12</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Generated on </Value><Style><FontSize>12pt</FontSize></Style></TextRun><TextRun><Value>=Globals!ExecutionTime</Value><Style><FontSize>12pt</FontSize><Format>d</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox2</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>12</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Name</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#8eceec</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox29"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Year</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox29</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#8eceec</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox31"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Form</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox31</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#8eceec</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox25"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Academic House</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox25</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#8eceec</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox23"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Boarding House</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox23</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#8eceec</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox21"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Event Title</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox21</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#d88bc0</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox15"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Event Type</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox15</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#d88bc0</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox17"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Anniversary</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox17</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#fad182</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox19"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs