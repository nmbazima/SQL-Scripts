<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>5fb7e692-1062-4051-bcb4-48ba1c9e8784</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Concerns"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter><QueryParameter Name="@ConcernCategory"><Value>=Parameters!ConcernCategory.Value</Value></QueryParameter><QueryParameter Name="@Pupils"><Value>=Parameters!Pupils.Value</Value></QueryParameter><QueryParameter Name="@txtStartDate"><Value>=Parameters!txtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	--core
		Pupils.txtSchoolID,
		Pupils.intPersonID,
		Pupils.txtSurname,
		Pupils.txtForename,
		Pupils.txtDoB AS dtDoB,
		Pupils.txtForm,
		Pupils.txtAcademicHouse,
		Pupils.txtBoardingHouse,
		Pupils.txtCountryofResidence,
		Pupils.txtGender,
		Pupils.txtPreName,
		Pupils.txtNationality,
		Pupils.txtLanguage,
		Pupils.txtMiddleNames,
		Pupils.txtBirthCountry,
		TblSchoolManagementYears.txtYearName,
		--Concern
		Concern.Id AS intConcernID,
		ConcernStatus.Name AS txtConcernStatus,
		TblStaff.Firstname AS txtConcernSourceForename,
		TblStaff.Surname AS txtConcernSourceSurname,
		Concern.Location AS txtConcernLocation,
		Concern.RaisedOn AS dtConcernDateTime,
		ConcernType.Name AS txtConcernCategory,
		Areas.txtAreas,
		Concern.Nature AS txtConcernNature,
		Concern.Details AS txtConcernDetails,
		-- students involved
		InvolvedStudents.txtInvolvedStudents,
		-- Concern Documents
		ConcernDocument.Id AS intConcernDocumentID,
		DENSE_RANK() OVER (PARTITION BY ConcernDocument.Id ORDER BY ConcernDocument.Id) AS intDocumentRank,
		ConcernDocument.FileName AS txtConcernDocumentFileName,
		ConcernDocument.FilePath AS txtConcernDocumentFilePath,
		-- action
		ConcernAction.ID AS intActionID,
		DENSE_RANK() OVER (PARTITION BY Concern.Id ORDER BY ConcernAction.Id) AS intConcernActionRank,
		ActionType.Name AS txtActionType,
		ActionStaff.Firstname AS txtActionAssigneeFirstname,
		ActionStaff.Surname AS txtActionAssigneeSurname,
		ConcernAction.DueDate AS dActionDueDate,
		ConcernAction.Description AS txtActionDescription,
		ActionStatus.Name AS txtActionStatus,
		ConcernActionOutcome.Outcome AS txtActionOutcome
FROM	[pastoral].[GetConcerns](@userCode) AS Concern
LEFT OUTER JOIN TblPupilManagementPupils AS Pupils ON Pupils.txtSchoolID = Concern.SchoolID
LEFT OUTER JOIN pastoral.ConcernStatus AS ConcernStatus ON Concern.ConcernStatusId = ConcernStatus.Id
LEFT OUTER JOIN TblStaff ON Concern.SourceId = TblStaff.User_Code
LEFT OUTER JOIN pastoral.ConcernType AS ConcernType ON Concern.TypeId = ConcernType.Id
LEFT OUTER JOIN pastoral.ConcernAction AS ConcernAction ON Concern.Id = ConcernAction.ConcernId
LEFT OUTER JOIN pastoral.ActionType AS ActionType ON ConcernAction.ActionTypeId = ActionType.Id
LEFT OUTER JOIN pastoral.ConcernActionAssignee AS ConcernActionAssignee ON ConcernAction.Id = ConcernActionAssignee.ConcernActionId
LEFT OUTER JOIN TblStaff AS ActionStaff ON ConcernActionAssignee.Usercode = ActionStaff.User_Code
LEFT OUTER JOIN pastoral.ActionStatus AS ActionStatus ON ConcernAction.ActionStatusId = ActionStatus.Id
LEFT OUTER JOIN pastoral.ConcernActionOutcome AS ConcernActionOutcome ON ConcernAction.Id = ConcernActionOutcome.Id
LEFT OUTER JOIN TblSchoolManagementYears ON Pupils.IntNCYear = TblSchoolManagementYears.intNCYear
LEFT OUTER JOIN Pastoral.ConcernDocument AS ConcernDocument ON Concern.Id = ConcernDocument.ConcernId
OUTER APPLY (SELECT STUFF((SELECT ', ' + Area.Name 
			 FROM pastoral.ConcernArea 
			 LEFT OUTER JOIN pastoral.Area AS Area ON ConcernArea.AreaId = Area.Id
			 WHERE Concern.Id = ConcernArea.ConcernId
			 ORDER BY  Area.Name FOR XML PATH('')), 1, 2,'') AS txtAreas
			) AS Areas
OUTER APPLY (SELECT STUFF((SELECT ', ' + TblPupilManagementPupils.txtForename + ' ' + TblPupilManagementPupils.txtSurname + ' (' + StudentRole.Name + ')'
			 FROM pastoral.ConcernStudent
			 LEFT OUTER JOIN TblPupilManagementPupils ON ConcernStudent.SchoolId = TblPupilManagementPupils.txtSchoolID
			 LEFT OUTER JOIN pastoral.ConcernRole AS StudentRole ON ConcernStudent.RoleId = StudentRole.Id
			 WHERE Concern.Id = ConcernStudent.ConcernId
			 ORDER BY   ConcernStudent.Id FOR XML PATH('')), 1, 2,'') AS txtInvolvedStudents
			) AS InvolvedStudents
WHERE	ConcernType.ID IN (@ConcernCategory) 
		AND Concern.SchoolID IN (@Pupils)
		AND CAST(FLOOR(CAST(Concern.RaisedOn AS FLOAT)) AS DATETIME) BETWEEN @txtStartDate AND @txtEndDate</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intPersonID"><DataField>intPersonID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtDoB"><DataField>dtDoB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intConcernID"><DataField>intConcernID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtConcernStatus"><DataField>txtConcernStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernSourceForename"><DataField>txtConcernSourceForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCountryofResidence"><DataField>txtCountryofResidence</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernSourceSurname"><DataField>txtConcernSourceSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernLocation"><DataField>txtConcernLocation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtNationality"><DataField>txtNationality</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtConcernDateTime"><DataField>dtConcernDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtLanguage"><DataField>txtLanguage</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernCategory"><DataField>txtConcernCategory</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAreas"><DataField>txtAreas</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBirthCountry"><DataField>txtBirthCountry</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernNature"><DataField>txtConcernNature</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernDetails"><DataField>txtConcernDetails</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtInvolvedStudents"><DataField>txtInvolvedStudents</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intConcernDocumentID"><DataField>intConcernDocumentID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intConcernActionRank"><DataField>intConcernActionRank</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="intDocumentRank"><DataField>intDocumentRank</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="txtConcernDocumentFileName"><DataField>txtConcernDocumentFileName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intActionID"><DataField>intActionID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtActionType"><DataField>txtActionType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtActionAssigneeFirstname"><DataField>txtActionAssigneeFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtActionOutcome"><DataField>txtActionOutcome</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernDocumentFilePath"><DataField>txtConcernDocumentFilePath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtActionAssigneeSurname"><DataField>txtActionAssigneeSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dActionDueDate"><DataField>dActionDueDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtActionDescription"><DataField>txtActionDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtActionStatus"><DataField>txtActionStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="PupilPictures"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>WITH PupilPictures AS
(
SELECT txtPath AS txtPupilPicturePath, txtSchoolID,
DENSE_RANK() OVER  (PARTITION BY txtSchoolID ORDER BY txtSubmitDateTime DESC) AS intPictureRank 
FROM TblPupilManagementPictures
WHERE TblPupilManagementPictures.txtSubmitDateTime &lt;= GETDATE()
)

SELECT txtSchoolID, txtPupilPicturePath
FROM PupilPictures
WHERE intPictureRank = 1
;</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPupilPicturePath"><DataField>txtPupilPicturePath</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT txtInternaliSAMSAddress
FROM TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtInternaliSAMSAddress"><DataField>txtInternaliSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="ConcernCategory"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT ID,
Name AS ConcernType  from
pastoral.ConcernType 
WHERE	Deleted = 0
ORDER BY
Name</CommandText></Query><Fields><Field Name="ID"><DataField>ID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="ConcernType"><DataField>ConcernType</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Pupils"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter><QueryParameter Name="@ConcernCategory"><Value>=Parameters!ConcernCategory.Value</Value></QueryParameter><QueryParameter Name="@txtStartDate"><Value>=Parameters!txtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	DISTINCT Concern.SchoolID,
		Pupils.txtSurname + ', ' + Pupils.txtForename AS PupilName
FROM	[pastoral].[GetConcerns](@userCode) AS Concern
LEFT OUTER JOIN dbo.TblPupilManagementPupils AS Pupils ON Pupils.txtSchoolID = Concern.SchoolID
LEFT OUTER JOIN pastoral.ConcernType AS ConcernType ON Concern.TypeId = ConcernType.Id
WHERE	ConcernType.ID IN (@ConcernCategory)
		AND Concern.RaisedOn BETWEEN CAST(FLOOR(CAST(@txtStartDate AS FLOAT)) AS DATETIME) AND DATEADD(DAY, 1, CAST(FLOOR(CAST(@txtEndDate AS FLOAT)) AS DATETIME))
ORDER BY Pupils.txtSurname + ', ' + Pupils.txtForename</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="SchoolID"><DataField>SchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PupilName"><DataField>PupilName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>21cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>15.835cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle1"><ReportItems><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtForename.Value</Value><Style><FontFamily>arial</FontFamily><FontSize>24pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontFamily>arial</FontFamily><FontSize>24pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun><TextRun><Value>=Fields!txtSurname.Value</Value><Style><FontFamily>arial</FontFamily><FontSize>24pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontFamily>arial</FontFamily><FontSize>24pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Left>0.75cm</Left><Height>1.3cm</Height><Width>19.5cm</Width><Style><Border><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Image Name="Image1"><Source>Embedded</Source><Value>iSAMSLine</Value><Sizing>FitProportional</Sizing><Top>1.33528cm</Top><Left>0.75cm</Left><Height>0.26613cm</Height><Width>19.5cm</Width><ZIndex>1</ZIndex><Style><Border><Style>None</Style></Border></Style></Image><Rectangle Name="Rectangle5"><ReportItems><Image Name="Image2"><Source>External</Source><Value>=IIF(
Right(First(Fields!txtInternaliSAMSAddress.Value, "iSAMSAddress"),1)="/",
Left(First(Fields!txtInternaliSAMSAddress.Value, "iSAMSAddress"), Len(First(Fields!txtInternaliSAMSAddress.Value, "iSAMSAddress"))-1),
First(Fields!txtInternaliSAMSAddress.Value, "iSAMSAddress")
)  &amp; Lookup(Fields!txtSchoolID.Value,Fields!txtSchoolID.Value,Fields!txtPupilPicturePath.Value,"PupilPictures")</Value><Sizing>FitProportional</Sizing><Top>0.3cm</Top><Left>0.3cm</Left><Height>4.4cm</Height><Width>3.4cm</Width><Style><Border><Style>None</Style></Border></Style></Image></ReportItems><KeepTogether>true</KeepTogether><Top>1.8cm</Top><Left>16.25cm</Left><Height>5cm</Height><Width>4cm</Width><ZIndex>2</ZIndex><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border></Style></Rectangle><Tablix Name="Tablix11"><TablixBody><TablixColumns><TablixColumn><Width>19.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>7.935cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle4"><ReportItems><Tablix Name="Tablix16"><TablixBody><TablixColumns><TablixColumn><Width>3.25cm</Width></TablixColumn><TablixColumn><Width>3.25cm</Width></TablixColumn><TablixColumn><Width>3.25cm</Width></TablixColumn><TablixColumn><Width>3.25cm</Width></TablixColumn><TablixColumn><Width>3.25cm</Width></TablixColumn><TablixColumn><Width>3.25cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.8cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox12"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Concern Details</Value><Style><FontStyle>Normal</FontStyle><FontFamily>arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><TextDecoration>None</TextDecoration><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox9</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#d88bc0</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>6</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox22"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Status:</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox21</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#d88bc0</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ConcernStatus"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtConcernStatus.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox65"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Source:</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox15</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#d88bc0</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox161"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtConcernSourceForename.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun><TextRun><Value>=Fields!txtConcernSourceSurname.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox161</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>3</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Location:</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox4</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#d88bc0</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox77"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtConcernLocation.Value</Value><Style><F