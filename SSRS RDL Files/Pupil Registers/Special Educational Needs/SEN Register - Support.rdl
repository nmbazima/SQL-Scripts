<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>84a9f459-68c6-488a-8d22-023f18338d76</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS 'txtiSAMSAddress'
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT        txtPath + txtFilename AS txtSchoolLogoPath
FROM            TblReportsCustomImages
WHERE        (txtName LIKE '%School Logo%')
ORDER BY dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="YearGroup"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT -100 AS intNCYear,
'No Year' AS txtYearName
UNION ALL
SELECT intNCYear, txtYearName
FROM TblSchoolManagementYears
ORDER BY intNCYear</CommandText></Query><Fields><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Form"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT -100 AS intNCYear,
'No Form' AS txtForm
UNION ALL
SELECT intNCYear, txtForm
FROM TblSchoolManagementForms
ORDER BY intNCYear, txtForm</CommandText></Query><Fields><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="AcademicHouse"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT 
1 AS intOrder,
'No House' AS txtAcademicHouse
UNION ALL
SELECT 
2 AS intOrder,
TblSchoolManagementHouses.txtHouseName AS txtAcademicHouse
FROM TblSchoolManagementHouses
WHERE TblSchoolManagementHouses.txtHouseType = 'Academic'
ORDER BY intOrder, txtAcademicHouse</CommandText></Query><Fields><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="BoardingHouse"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT 
1 AS intOrder,
'No House' AS txtBoardingHouse
UNION ALL
SELECT 
2 AS intOrder,
TblSchoolManagementHouses.txtHouseName AS txtBoardingHouse
FROM TblSchoolManagementHouses
WHERE TblSchoolManagementHouses.txtHouseType = 'Boarding'
ORDER BY intOrder, txtBoardingHouse</CommandText></Query><Fields><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Students"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter><QueryParameter Name="@txtForm"><Value>=Parameters!txtForm.Value</Value></QueryParameter><QueryParameter Name="@txtAcademicHouse"><Value>=Parameters!txtAcademicHouse.Value</Value></QueryParameter><QueryParameter Name="@txtBoardingHouse"><Value>=Parameters!txtBoardingHouse.Value</Value></QueryParameter><QueryParameter Name="@txtAssociation"><Value>=Parameters!txtAssociation.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @registerId AS Integer;
SET @registerId = (SELECT TblPupilRegistersRegisterId FROM TblPupilRegistersRegister WHERE txtReportingKey='$SEN');

WITH SENSupport AS
(
SELECT DISTINCT
    [dbo].[f_PupilRegisters_GetAssociation] (@registerId,SchoolId, GETDATE()) AS txtAssociation,
	SENSupport.SchoolId
FROM [generated_views].[VwPupilRegisters_RecordCollection_$SEN_Register_Support] AS SENSupport
)
SELECT 	
	'No Student' AS txtSchoolID,
	'No Student' AS txtStudentName,
	1 AS intOrder

	UNION ALL
SELECT 
	DISTINCT	
	TblPupilManagementPupils.txtSchoolID,
	TblPupilManagementPupils.txtSurname + ', ' + TblPupilManagementPupils.txtForename AS txtStudentName,
	2 AS intOrder
FROM SENSupport
INNER JOIN TblPupilManagementPupils
	ON SENSupport.SchoolID = TblPupilManagementPupils.txtSchoolID
WHERE 
(CASE WHEN TblPupilManagementPupils.intNCYear IS NULL THEN -100 ELSE TblPupilManagementPupils.intNCYear END IN (@intNCYear))
AND (CASE WHEN NULLIF(TblPupilManagementPupils.txtForm,'') IS NULL THEN 'No Form' ELSE TblPupilManagementPupils.txtForm END IN (@txtForm))
AND (CASE WHEN NULLIF(TblPupilManagementPupils.txtAcademicHouse,'') IS NULL THEN 'No House' ELSE TblPupilManagementPupils.txtAcademicHouse END IN (@txtAcademicHouse))
AND (CASE WHEN NULLIF(TblPupilManagementPupils.txtBoardingHouse,'') IS NULL THEN 'No House' ELSE TblPupilManagementPupils.txtBoardingHouse END IN (@txtBoardingHouse))
AND (CASE WHEN NULLIF(SENSupport.txtAssociation,'') IS NULL THEN 'Unassociated' ELSE SENSupport.txtAssociation END IN (@txtAssociation))

ORDER BY intOrder, txtStudentName</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtStudentName"><DataField>txtStudentName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="SelectedStudents"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@SchoolId"><Value>=Parameters!SchoolId.Value</Value></QueryParameter><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter><QueryParameter Name="@txtForm"><Value>=Parameters!txtForm.Value</Value></QueryParameter><QueryParameter Name="@txtAcademicHouse"><Value>=Parameters!txtAcademicHouse.Value</Value></QueryParameter><QueryParameter Name="@txtBoardingHouse"><Value>=Parameters!txtBoardingHouse.Value</Value></QueryParameter><QueryParameter Name="@txtAssociation"><Value>=Parameters!txtAssociation.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @registerId AS Integer;
SET @registerId = (SELECT TblPupilRegistersRegisterId FROM TblPupilRegistersRegister WHERE txtReportingKey='$SEN');

WITH SENSupport AS
(
SELECT DISTINCT
    [dbo].[f_PupilRegisters_GetAssociation] (@registerId,SchoolId, GETDATE()) AS txtAssociation,
	SENSupport.SchoolId
FROM [generated_views].[VwPupilRegisters_RecordCollection_$SEN_Register_Support] AS SENSupport
)
SELECT 	
	'No Student' AS txtSchoolID,
	'No Student' AS txtStudentName,
	1 AS intOrder

	UNION ALL
SELECT 
	DISTINCT	
	TblPupilManagementPupils.txtSchoolID,
	TblPupilManagementPupils.txtSurname + ', ' + TblPupilManagementPupils.txtForename AS txtStudentName,
	2 AS intOrder
FROM SENSupport
INNER JOIN TblPupilManagementPupils
	ON SENSupport.SchoolID = TblPupilManagementPupils.txtSchoolID
WHERE TblPupilManagementPupils.txtSchoolID IN (SELECT ID FROM dbo.SplitCSV(@SchoolId)) OR @SchoolId IS NULL
AND (CASE WHEN TblPupilManagementPupils.intNCYear IS NULL THEN -100 ELSE TblPupilManagementPupils.intNCYear END IN (@intNCYear))
AND (CASE WHEN NULLIF(TblPupilManagementPupils.txtForm,'') IS NULL THEN 'No Form' ELSE TblPupilManagementPupils.txtForm END IN (@txtForm))
AND (CASE WHEN NULLIF(TblPupilManagementPupils.txtAcademicHouse,'') IS NULL THEN 'No House' ELSE TblPupilManagementPupils.txtAcademicHouse END IN (@txtAcademicHouse))
AND (CASE WHEN NULLIF(TblPupilManagementPupils.txtBoardingHouse,'') IS NULL THEN 'No House' ELSE TblPupilManagementPupils.txtBoardingHouse END IN (@txtBoardingHouse))
AND (CASE WHEN NULLIF(SENSupport.txtAssociation,'') IS NULL THEN 'Unassociated' ELSE SENSupport.txtAssociation END IN (@txtAssociation))

ORDER BY intOrder, txtStudentName</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtStudentName"><DataField>txtStudentName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="SENSupport"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @registerId AS Integer;
SET @registerId = (SELECT TblPupilRegistersRegisterId FROM TblPupilRegistersRegister WHERE txtReportingKey='$SEN');

WITH SENSupport AS
(
SELECT 
    SENSupport.[$SEN_Register_Support_SupportTutor_Display] AS txtSupportTutor,
	SENSupport.[$SEN_Register_Support_SupportRole_Display] AS txtSupportRole,
	SENSupport.[$SEN_Register_Support_SupportArea_Display] AS txtSupportArea,
	SENSupport.[$SEN_Register_Support_Notes_Display] AS txtSupportNotes,
	[dbo].[f_PupilRegisters_GetAssociation] (@registerId,SchoolId, GETDATE()) AS txtAssociation,
	SENSupport.SchoolId
FROM [generated_views].[VwPupilRegisters_RecordCollection_$SEN_Register_Support] AS SENSupport
)
SELECT
	(CASE WHEN NULLIF(SENSupport.txtAssociation,'') IS NULL THEN 'Unassociated' ELSE SENSupport.txtAssociation END) AS txtAssociation,
	SENSupport.txtSupportTutor,
	SENSupport.txtSupportRole,
	SENSupport.txtSupportArea,
	SENSupport.txtSupportNotes,
	TblPupilManagementPupils.txtSchoolID,
	TblPupilManagementPupils.txtForename,
	TblPupilManagementPupils.txtSurname,
	TblPupilManagementPupils.txtPreName,
	TblPupilManagementPupils.intNCYear,
	TblSchoolManagementYears.txtYearName,
TblSchoolManagementYears.txtYearCode,
	TblPupilManagementPupils.txtForm,
	TblPupilManagementPupils.txtAcademicHouse,
	TblSchoolManagementHouses.txtHouseCode AS txtAcademicHouseCode,
	TblPupilManagementPupils.txtBoardingHouse,
	BoardingHouse.txtHouseCode AS txtBoardingHouseCode
FROM  SENSupport
INNER JOIN TblPupilManagementPupils
	ON SENSupport.SchoolId = TblPupilManagementPupils.txtSchoolID
LEFT OUTER JOIN TblSchoolManagementYears
	ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear
LEFT OUTER JOIN TblSchoolManagementHouses 
	ON TblPupilManagementPupils.txtAcademicHouse = TblSchoolManagementHouses.txtHouseName
LEFT OUTER JOIN TblSchoolManagementHouses AS BoardingHouse
	ON TblPupilManagementPupils.txtBoardingHouse = BoardingHouse.txtHouseName
WHERE TblPupilManagementPupils.txtSchoolID IN (@txtSchoolID)</CommandText></Query><Fields><Field Name="txtAssociation"><DataField>txtAssociation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSupportTutor"><DataField>txtSupportTutor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSupportRole"><DataField>txtSupportRole</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSupportArea"><DataField>txtSupportArea</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSupportNotes"><DataField>txtSupportNotes</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouseCode"><DataField>txtAcademicHouseCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouseCode"><DataField>txtBoardingHouseCode</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Register"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT txtName 
FROM TblPupilRegistersRegister 
WHERE txtReportingKey = '$SEN'</CommandText></Query><Fields><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Association"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter><QueryParameter Name="@txtForm"><Value>=Parameters!txtForm.Value</Value></QueryParameter><QueryParameter Name="@txtAcademicHouse"><Value>=Parameters!txtAcademicHouse.Value</Value></QueryParameter><QueryParameter Name="@txtBoardingHouse"><Value>=Parameters!txtBoardingHouse.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @registerId AS Integer;
SET @registerId = (SELECT TblPupilRegistersRegisterId FROM TblPupilRegistersRegister WHERE txtReportingKey='$SEN');

WITH SENSupport AS
(
SELECT DISTINCT
    [dbo].[f_PupilRegisters_GetAssociation] (@registerId,SchoolId, GETDATE()) AS txtAssociation,
	SENSupport.SchoolId
FROM [generated_views].[VwPupilRegisters_RecordCollection_$SEN_Register_Support] AS SENSupport
),

SENRegister AS
(

	SELECT 	
	'On Register' AS txtAssociation

UNION
	SELECT 	
	'Off Register' AS txtAssociation

UNION

SELECT 
	DISTINCT	
(CASE WHEN NULLIF(SENSupport.txtAssociation,'') IS NULL THEN 'Unassociated' ELSE SENSupport.txtAssociation END) AS txtAssociation
FROM SENSupport
INNER JOIN TblPupilManagementPupils
	ON SENSupport.SchoolID = TblPupilManagementPupils.txtSchoolID
WHERE 
(CASE WHEN TblPupilManagementPupils.intNCYear IS NULL THEN -100 ELSE TblPupilManagementPupils.intNCYear END IN (@intNCYear))
AND (CASE WHEN NULLIF(TblPupilManagementPupils.txtForm,'') IS NULL THEN 'No Form' ELSE TblPupilManagementPupils.txtForm END IN (@txtForm))
AND (CASE WHEN NULLIF(TblPupilManagementPupils.txtAcademicHouse,'') IS NULL THEN 'No House' ELSE TblPupilManagementPupils.txtAcademicHouse END IN (@txtAcademicHouse))
AND (CASE WHEN NULLIF(TblPupilManagementPupils.txtBoardingHouse,'') IS NULL THEN 'No House' ELSE TblPupilManagementPupils.txtBoardingHouse END IN (@txtBoardingHouse))

)

SELECT * 
FROM SENRegister
ORDER BY CASE WHEN txtAssociation = 'On Register' THEN 1 WHEN txtAssociation = 'Off Register' THEN 2 ELSE 3 END</CommandText></Query><Fields><Field Name="txtAssociation"><DataField>txtAssociation</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Permissions"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT * FROM [dbo].[f_PupilRegisters_GetSectionsWithReadActivityPermission] (@userCode)</CommandText></Query><Fields><Field Name="SectionId"><DataField>SectionId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="SectionReportingKey"><DataField>SectionReportingKey</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Users"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	TbliSAMSManagerUsers.txtUsername
FROM	TbliSAMSManagerUsers
WHERE	TbliSAMSManagerUsers.txtUserCode = @userCode</CommandText></Query><Fields><Field Name="txtUsername"><DataField>txtUsername</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Disclaimer"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Path"><Value>=Globals!ReportFolder</Value></QueryParameter><QueryParameter Name="@Report"><Value>=Globals!ReportName</Value></QueryParameter></QueryParameters><CommandText>SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
FROM	TblSQLReportingServicesDisclaimerReport
		INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report</CommandText></Query><Fields><Field Name="txtDisclaimerBackgroundColour"><DataField>txtDisclaimerBackgroundColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerBorderColour"><DataField>txtDisclaimerBorderColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerDescription"><DataField>txtDisclaimerDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTextColour"><DataField>txtDisclaimerTextColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTitle"><DataField>txtDisclaimerTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix2"><TablixBody><TablixColumns><TablixColumn><Width>27.7cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>4cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle1"><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>27.7cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>4cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle2"><ReportItems><Tablix Name="Tablix5"><TablixBody><TablixColumns><TablixColumn><Width>27.7cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>4cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle3"><ReportItems><Tablix Name="Tablix6"><TablixBody><TablixColumns><TablixColumn><Width>8.85cm</Width></TablixColumn><TablixColumn><Width>8.85cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Name:</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun><TextRun><Value>=Fields!txtSurname.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun><TextRun><Value>, </Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun><TextRun><Value>=Fields!txtForename.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox2</rd:DefaultName><Style><Border><Color>LightGrey</Color><Style>None</Style></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>4</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="txtAcademicHouseCode3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Academic House:</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun><TextRun><Value>=Fields!txtAcademicHouseCode.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtAcademicHouseCode</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="txtBoardingHouseCode3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Boarding House:</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun><TextRun><Value>=Fields!txtBoardingHouseCode.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtBoardingHouseCode</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="txtForm3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Form:</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun><TextRun><Value>=Fields!txtForm.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtForm</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="txtYearCode3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Year:</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun><TextRun><Value>=Fields!txtYearCode.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtYearCode</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixRowHierarchy><Height>1.4cm</Height><Width>27.7cm</Width><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border></Style></Tablix><Tablix Name="Tablix7"><TablixBody><TablixColumns><TablixColumn><Width>2.83cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>11.87cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox78"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(
IsNothing(
LOOKUP("$SEN_Screening", Fields!SectionReportingKey.Value, Fields!SectionReportingKey.Value, "Permissions")
),
nothing,
