<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>84a9f459-68c6-488a-8d22-023f18338d76</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS 'txtiSAMSAddress'
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtName, txtPath + txtFilename AS txtSchoolLogoPath
FROM	TblReportsCustomImages
ORDER BY dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Register"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Division"><Value>=Parameters!Division.Value</Value></QueryParameter></QueryParameters><CommandText>WITH Screening AS
	(SELECT	SchoolId,
			LTRIM(STUFF((SELECT ', ' + REPLACE(CONVERT(NVARCHAR(15), CAST([$SEN_Screening_Screening_DateOfScreening] AS DATETIME), 106), ' ', '-')
						 FROM [generated_views].[VwPupilRegisters_RecordCollection_$SEN_Screening_Screening] S2 WHERE S1.SchoolId = S2.SchoolId
						 FOR XML PATH('')),1,1,'')) AS 'DateOfScreening',
			LTRIM(STUFF((SELECT ', ' + [$SEN_Screening_Screening_ScreenedBy_Display]
						 FROM [generated_views].[VwPupilRegisters_RecordCollection_$SEN_Screening_Screening] S2 WHERE S1.SchoolId = S2.SchoolId
						 FOR XML PATH('')),1,1,'')) AS 'ScreenedBy'
	 FROM	[generated_views].[VwPupilRegisters_RecordCollection_$SEN_Screening_Screening] S1
	 GROUP BY SchoolId
	)
	,Support AS
	(SELECT	SchoolId,
			LTRIM(STUFF((SELECT ', ' + [$SEN_Register_Support_SupportTutor_Display]
						 FROM [generated_views].[VwPupilRegisters_RecordCollection_$SEN_Register_Support] S2 WHERE S1.SchoolId = S2.SchoolId
						 FOR XML PATH('')),1,1,'')) AS 'SupportTutor'
	 FROM	[generated_views].[VwPupilRegisters_RecordCollection_$SEN_Register_Support] S1
	 GROUP BY SchoolId
	)
	,Register AS
    (SELECT    SchoolId,
            Association,
            [$SEN_Register_Register_RegisterFlag] AS 'RegisterImage',
            [$SEN_Register_Register_RegisterFlag_Display] AS 'RegisterFlag',
            [$SEN_Register_Register_RegisterNotes] AS 'RegisterNotes',
            [$SEN_Lessons_OfferingLessons_OfferingLessons_Display] AS 'OfferingLessons'
    FROM    [generated_views].[VwPupilRegisters_Register_$SEN]
	)
	,Reports AS
	(SELECT	SchoolId,
			LTRIM(STUFF((SELECT ', ' + [$SEN_Reports_Reports_NameOfAssessor_Display]
						 FROM [generated_views].[VwPupilRegisters_RecordCollection_$SEN_Reports_Reports] S2 WHERE S1.SchoolId = S2.SchoolId
						 FOR XML PATH('')),1,1,'')) AS 'AssessorName',
			LTRIM(STUFF((SELECT ', ' + REPLACE(CONVERT(NVARCHAR(15), CAST([$SEN_Reports_Reports_DateOfAssessment] AS DATETIME), 106), ' ', '-')
						 FROM [generated_views].[VwPupilRegisters_RecordCollection_$SEN_Reports_Reports] S2 WHERE S1.SchoolId = S2.SchoolId
						 FOR XML PATH('')),1,1,'')) AS 'AssessmentDate'
	 FROM	[generated_views].[VwPupilRegisters_RecordCollection_$SEN_Reports_Reports] S1
	 GROUP BY SchoolId
	)
	,Requirements AS
	(SELECT	SchoolId,
			LTRIM(STUFF((SELECT ', ' + [$SEN_Requirements_Requirements_Type_Display]
						 FROM [generated_views].[VwPupilRegisters_RecordCollection_$SEN_Requirements_Requirements] S2 WHERE S1.SchoolId = S2.SchoolId
						 FOR XML PATH('')),1,1,'')) AS 'RequirementsType'
	 FROM	[generated_views].[VwPupilRegisters_RecordCollection_$SEN_Requirements_Requirements] S1
	 GROUP BY SchoolId
	)

SELECT	TblPupilManagementPupils.txtSchoolID,
		TblPupilManagementPupils.txtSurname,
		TblPupilManagementPupils.txtForename,
		TblPupilManagementPupils.intNCYear,
		TblPupilManagementPupils.txtForm,
		TblPupilManagementPupils.txtDOB,
		TblSchoolManagementYears.txtYearName,
		TblSchoolManagementYears.txtYearCode,
		TblPupilManagementPupils.txtBoardingHouse,
		TblSchoolManagementHouses.txtHouseCode,
		TblExamManagerCandidateOptions.intExtraTime,
		TblExamManagerCandidateOptions.intProcessor,
		TblExamManagerCandidateOptions.intRest,
		TblExamManagerCandidateOptions.intTranscript,
		TblExamManagerCandidateOptions.intDictionary,
		TblExamManagerCandidateOptions.intPrompter,
		TblExamManagerCandidateOptions.intReader,
		TblExamManagerCandidateOptions.intSeparateInvigilation,
		TblExamManagerCandidateOptions.intScribe,
		TblExamManagerCandidateOptions.intReadAloudOrPen,
		TblExamManagerCandidateOptions.intEnlargedPapers,
		TblSchoolManagementSchoolDivisionsYears.intDivision,
		Screening.DateOfScreening,
		Screening.ScreenedBy,
		Support.SupportTutor,
		Register.Association,
		Register.RegisterImage,
		Register.RegisterFlag,
		Register.RegisterNotes,
		Register.OfferingLessons,
		Reports.AssessorName,
		Reports.AssessmentDate,
		Requirements.RequirementsType
FROM	TblPupilManagementPupils 
LEFT OUTER JOIN Screening ON TblPupilManagementPupils.txtSchoolID = Screening.SchoolId
LEFT OUTER JOIN Support ON TblPupilManagementPupils.txtSchoolID = Support.SchoolId
LEFT OUTER JOIN Register ON TblPupilManagementPupils.txtSchoolID = Register.SchoolId
LEFT OUTER JOIN Reports ON TblPupilManagementPupils.txtSchoolID = Reports.SchoolId
LEFT OUTER JOIN Requirements ON TblPupilManagementPupils.txtSchoolID = Requirements.SchoolId
LEFT OUTER JOIN TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear
LEFT OUTER JOIN TblSchoolManagementHouses ON TblPupilManagementPupils.txtBoardingHouse = TblSchoolManagementHouses.txtHouseName AND TblSchoolManagementHouses.txtHouseType = 'Boarding'
LEFT OUTER JOIN TblSchoolManagementSchoolDivisionsYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementSchoolDivisionsYears.intNCYear
LEFT OUTER JOIN TblExamManagerCandidateOptions ON TblPupilManagementPupils.txtSchoolID = TblExamManagerCandidateOptions.txtSchoolID
WHERE	Register.Association = 'On Register'
		AND TblPupilManagementPupils.intSystemStatus = 1
		AND (ISNULL(TblSchoolManagementSchoolDivisionsYears.intDivision, 0) IN (@Division))</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDOB"><DataField>txtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtHouseCode"><DataField>txtHouseCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Association"><DataField>Association</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intExtraTime"><DataField>intExtraTime</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intProcessor"><DataField>intProcessor</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intRest"><DataField>intRest</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intTranscript"><DataField>intTranscript</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intDictionary"><DataField>intDictionary</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intPrompter"><DataField>intPrompter</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intReader"><DataField>intReader</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intSeparateInvigilation"><DataField>intSeparateInvigilation</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intScribe"><DataField>intScribe</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intReadAloudOrPen"><DataField>intReadAloudOrPen</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intEnlargedPapers"><DataField>intEnlargedPapers</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intDivision"><DataField>intDivision</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="DateOfScreening"><DataField>DateOfScreening</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ScreenedBy"><DataField>ScreenedBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="SupportTutor"><DataField>SupportTutor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="RegisterImage"><DataField>RegisterImage</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="RegisterFlag"><DataField>RegisterFlag</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="RegisterNotes"><DataField>RegisterNotes</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="OfferingLessons"><DataField>OfferingLessons</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="AssessorName"><DataField>AssessorName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="AssessmentDate"><DataField>AssessmentDate</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="RequirementsType"><DataField>RequirementsType</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Permissions"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT * FROM [dbo].[f_PupilRegisters_GetSectionsWithReadActivityPermission] (@userCode)</CommandText></Query><Fields><Field Name="SectionId"><DataField>SectionId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="SectionReportingKey"><DataField>SectionReportingKey</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Disclaimer"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Path"><Value>=Globals!ReportFolder</Value></QueryParameter><QueryParameter Name="@Report"><Value>=Globals!ReportName</Value></QueryParameter></QueryParameters><CommandText>SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
FROM	TblSQLReportingServicesDisclaimerReport
		INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report</CommandText></Query><Fields><Field Name="txtDisclaimerBackgroundColour"><DataField>txtDisclaimerBackgroundColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerBorderColour"><DataField>txtDisclaimerBorderColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerDescription"><DataField>txtDisclaimerDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTextColour"><DataField>txtDisclaimerTextColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTitle"><DataField>txtDisclaimerTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Access"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	RegisterId 
FROM	[dbo].[f_PupilRegisters_GetRegistersWithReadActivityPermission] (@userCode)
WHERE	RegisterId = (SELECT TblPupilRegistersRegisterID FROM TblPupilRegistersRegister WHERE txtReportingKey ='$SEN')</CommandText></Query><Fields><Field Name="RegisterId"><DataField>RegisterId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="Divisions"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblSchoolManagementSchoolDivisionsID,
		txtName,
		intOrder
FROM	TblSchoolManagementSchoolDivisions
ORDER BY intOrder, txtName</CommandText></Query><Fields><Field Name="TblSchoolManagementSchoolDivisionsID"><DataField>TblSchoolManagementSchoolDivisionsID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="RegisterName"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtName
FROM	TblPupilRegistersRegister
WHERE	txtReportingKey = '$SEN'</CommandText></Query><Fields><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="LatestAssessment"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	SchoolId,
		[$SEN_Reports_Reports_DateOfAssessment] AS 'AssessmentDate',
		DENSE_RANK() OVER(PARTITION BY Reports.SchoolId ORDER BY [$SEN_Reports_Reports_DateOfAssessment] DESC) AS 'intAssessmentRank',
		CAST(ROUND(DATEDIFF(DAY, TblPupilManagementPupils.txtDOB, [$SEN_Reports_Reports_DateOfAssessment]) / 365.25, 1, 1) AS DECIMAL(18,1)) AS 'decCAAgeWhenScreened'	
FROM	[generated_views].[VwPupilRegisters_RecordCollection_$SEN_Reports_Reports] Reports
INNER JOIN TblPupilManagementPupils ON Reports.SchoolId = TblPupilManagementPupils.txtSchoolID</CommandText></Query><Fields><Field Name="SchoolId"><DataField>SchoolId</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="AssessmentDate"><DataField>AssessmentDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intAssessmentRank"><DataField>intAssessmentRank</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="decCAAgeWhenScreened"><DataField>decCAAgeWhenScreened</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field></Fields></DataSet><DataSet Name="LatestScreened"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	SchoolId,
		[$SEN_Screening_Screening_DateOfScreening] AS 'AssessmentDate',
		DENSE_RANK() OVER(PARTITION BY Reports.SchoolId ORDER BY [$SEN_Screening_Screening_DateOfScreening] DESC) AS 'intAssessmentRank',
		CAST(ROUND(DATEDIFF(DAY, TblPupilManagementPupils.txtDOB, [$SEN_Screening_Screening_DateOfScreening]) / 365.25, 1, 1) AS DECIMAL(18,1)) AS 'decCAAgeWhenScreened'	
FROM	[generated_views].[VwPupilRegisters_RecordCollection_$SEN_Screening_Screening] Reports
INNER JOIN TblPupilManagementPupils ON Reports.SchoolId = TblPupilManagementPupils.txtSchoolID</CommandText></Query><Fields><Field Name="SchoolId"><DataField>SchoolId</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="AssessmentDate"><DataField>AssessmentDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intAssessmentRank"><DataField>intAssessmentRank</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="decCAAgeWhenScreened"><DataField>decCAAgeWhenScreened</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix4"><TablixBody><TablixColumns><TablixColumn><Width>0.6cm</Width></TablixColumn><TablixColumn><Width>3.45cm</Width></TablixColumn><TablixColumn><Width>1.5cm</Width></TablixColumn><TablixColumn><Width>1.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox176"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontFamily>arial</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox176</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox16"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Student Name</Value><Style><FontFamily>arial</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox16</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox18"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Form</Value><Style><FontFamily>arial</FontFamily><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox18</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox26"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Year</Value><Style><FontFamily>arial</FontFamily><FontWeight>Bold</F