<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>EdGen</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>9bfbf3aa-eedc-4a65-9550-6455e753148b</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Registers"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	TblPupilRegistersRegister.TblPupilRegistersRegisterId, TblPupilRegistersRegister.txtName
FROM f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegistersAccess
INNER JOIN TblPupilRegistersRegister ON RegistersAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId
WHERE	(TblPupilRegistersRegister.bActive = 1)
ORDER BY TblPupilRegistersRegister.txtName</CommandText></Query><Fields><Field Name="TblPupilRegistersRegisterId"><DataField>TblPupilRegistersRegisterId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Students"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter><QueryParameter Name="@intRegister"><Value>=Parameters!intRegister.Value</Value></QueryParameter><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @PupilID AS NVARCHAR(MAX);
SET @PupilID = 	STUFF(
	(SELECT	DISTINCT ',' + txtSchoolID
	 FROM	TblPupilManagementPupils
	 WHERE	intSystemStatus = 1
			AND (CASE WHEN TblPupilManagementPupils.intNCYear IS NULL THEN -100 ELSE TblPupilManagementPupils.intNCYear END IN (@intNCYear))
	 FOR XML PATH('')), 1, 1, ''
	);

WITH SelectedRegisters AS
(
	SELECT	TblPupilRegistersRegisterId, txtName AS txtRegisterName, TblPupilRegistersRegister.txtReportingKey, TblPupilRegistersRegister.txtWorkflow
	FROM	TblPupilRegistersRegister
	WHERE	TblPupilRegistersRegisterId IN (@intRegister)
)
,DateRangedRegister AS
(
	SELECT	SelectedRegisters.txtRegisterName, 
			SelectedRegisters.TblPupilRegistersRegisterId,
			SelectedRegisters.txtReportingKey,
			(CASE WHEN Register.txtSchoolId IS NULL THEN 'No' WHEN Register.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnRegister,
			TblPupilManagementPupils.txtSchoolID,
			SelectedRegisters.txtWorkflow
	FROM	SelectedRegisters
	INNER JOIN TblPupilManagementPupils ON 1 = 1
	OUTER APPLY dbo.f_PupilRegisters_GetLatestScreeningLogsOnRegisterWithRanges(TblPupilManagementPupils.txtSchoolID, SelectedRegisters.TblPupilRegistersRegisterId) AS Register
	WHERE	SelectedRegisters.txtWorkflow = 'RegisterWithRanges'
	AND TblPupilManagementPupils.txtSchoolID IN (SELECT ID FROM  dbo.SplitCSV(@PupilID))
)
,NoneDateRangedRegister AS 
(
	SELECT	SelectedRegisters.txtRegisterName, 
			SelectedRegisters.TblPupilRegistersRegisterId,
			SelectedRegisters.txtReportingKey,
			(CASE WHEN Register.txtSchoolId IS NULL THEN 'No' WHEN Register.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnRegister,
			TblPupilManagementPupils.txtSchoolID,
			SelectedRegisters.txtWorkflow
	FROM	SelectedRegisters
	INNER JOIN TblPupilManagementPupils ON 1 = 1
	OUTER APPLY dbo.f_PupilRegisters_GetLatestScreeningLogs(TblPupilManagementPupils.txtSchoolID, SelectedRegisters.TblPupilRegistersRegisterId) AS Register
	WHERE	SelectedRegisters.txtWorkflow &lt;&gt; 'RegisterWithRanges'
	AND TblPupilManagementPupils.txtSchoolID IN (SELECT ID FROM  dbo.SplitCSV(@PupilID))
)
,Registers AS
(

	SELECT	*
	FROM	DateRangedRegister
		UNION ALL
	SELECT	*
	FROM	NoneDateRangedRegister
)
,Attendance AS 
(
	SELECT	COUNT(DISTINCT Attendance.intRegistrationDateTimeID) AS intRegistrationCount, 
			COUNT(DISTINCT CASE Attendance.txtRegistrationStatisticalStatus WHEN 'Present' THEN Attendance.intRegistrationDateTimeID ELSE NULL END) AS intPresentCount,
			Attendance.txtSchoolID
	FROM	dbo.uf_Registration_AttendanceBetweenDates(@StartDate, DATEADD(DAY, 1, @EndDate), @PupilID) AS Attendance
	WHERE	Attendance.txtRegistrationAMPM IN ('am', 'pm') 
			AND Attendance.intIsIncludedInStatistics = 1
	GROUP BY Attendance.txtSchoolID
)


SELECT	TblPupilManagementPupils.txtSchoolID, 
		TblPupilManagementPupils.txtFullName, 
		TblPupilManagementPupils.txtSurname, 
		TblPupilManagementPupils.txtForename, 
		TblPupilManagementPupils.txtGender, 
		TblPupilManagementPupils.txtEthnicGroup, 
		TblPupilManagementPupils.txtForm,
		TblPupilManagementPupils.intNCYear,
		TblPupilManagementPupils.txtDOB,
		TblSchoolManagementYears.txtYearName,
		TblPupilManagementPupils.txtAcademicHouse,
		TblPupilManagementPupils.txtBoardingHouse,
		TblPupilManagementPupils.txtType AS txtBoardingStatus,
		Registers.txtRegisterName,
		Registers.txtOnRegister,
		Registers.txtWorkflow,
		Attendance.intPresentCount,
		Attendance.intRegistrationCount
FROM	TblPupilManagementPupils
LEFT OUTER JOIN Attendance ON TblPupilManagementPupils.txtSchoolID = Attendance.txtSchoolID
LEFT OUTER JOIN Registers ON TblPupilManagementPupils.txtSchoolID = Registers.txtSchoolID
LEFT OUTER JOIN TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear
WHERE	TblPupilManagementPupils.intSystemStatus = 1
		AND TblPupilManagementPupils.txtSchoolID IN (SELECT ID FROM  dbo.SplitCSV(@PupilID))</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFullName"><DataField>txtFullName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEthnicGroup"><DataField>txtEthnicGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDOB"><DataField>txtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingStatus"><DataField>txtBoardingStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegisterName"><DataField>txtRegisterName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnRegister"><DataField>txtOnRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtWorkflow"><DataField>txtWorkflow</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intPresentCount"><DataField>intPresentCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intRegistrationCount"><DataField>intRegistrationCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS txtiSAMSAddress
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS txtSchoolLogoPath, 
		TblReportsCustomImages.txtName
FROM	TblReportsCustomImages
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="YearGroups"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	-100 AS intNCYear, 'No Year Group' AS txtYearName
	UNION ALL
SELECT	intNCYear, txtYearName
FROM	TblSchoolManagementYears
ORDER BY intNCYear</CommandText></Query><Fields><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Disclaimer"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Path"><Value>=Globals!ReportFolder</Value></QueryParameter><QueryParameter Name="@Report"><Value>=Globals!ReportName</Value></QueryParameter></QueryParameters><CommandText>SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
FROM	TblSQLReportingServicesDisclaimerReport
INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report			  </CommandText></Query><Fields><Field Name="txtDisclaimerBackgroundColour"><DataField>txtDisclaimerBackgroundColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerBorderColour"><DataField>txtDisclaimerBorderColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerDescription"><DataField>txtDisclaimerDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTextColour"><DataField>txtDisclaimerTextColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTitle"><DataField>txtDisclaimerTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Chart Name="Chart2"><ChartCategoryHierarchy><ChartMembers><ChartMember><Group Name="Chart2_CategoryGroup"><GroupExpressions><GroupExpression>=Fields!txtRegisterName.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!txtRegisterName.Value</Value></SortExpression></SortExpressions><Label>=Fields!txtRegisterName.Value</Label></ChartMember></ChartMembers></ChartCategoryHierarchy><ChartSeriesHierarchy><ChartMembers><ChartMember><Group Name="Chart2_SeriesGroup"><GroupExpressions><GroupExpression>=IIF(CStr(Fields(Parameters!GroupBy.Value).Value) = "", "N/A", Fields(Parameters!GroupBy.Value).Value)</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=IIF(Parameters!GroupBy.Value = "txtForm", Fields!intNCYear.Value, Fields(Parameters!GroupBy.Value).Value)</Value></SortExpression><SortExpression><Value>=Fields(Parameters!GroupBy.Value).Value</Value></SortExpression></SortExpressions><Label>=IIF(CStr(Fields(Parameters!GroupBy.Value).Value) = "", "N/A", IIF(Parameters!GroupBy.Value = "intNCYear", Fields!txtYearName.Value, Fields(Parameters!GroupBy.Value).Value))</Label></ChartMember></ChartMembers></ChartSeriesHierarchy><ChartData><ChartSeriesCollection><ChartSeries Name="Series"><ChartDataPoints><ChartDataPoint><ChartDataPointValues><Y>=CountDistinct(IIF(Fields!txtOnRegister.Value = "Yes", Fields!txtSchoolID.Value, Nothing))</Y></ChartDataPointValues><ChartDataLabel><Style><Border><Color>#373948</Color></Border></Style><UseValueAsLabel>true</UseValueAsLabel></ChartDataLabel><Style /><ChartMarker><Style /></ChartMarker><DataElementOutput>Output</DataElementOutput></ChartDataPoint></ChartDataPoints><Style /><ChartEmptyPoints><Style /><ChartMarker><Style /></ChartMarker><ChartDataLabel><Style /></ChartDataLabel></ChartEmptyPoints><ValueAxisName>Primary</ValueAxisName><CategoryAxisName>Primary</CategoryAxisName><ChartSmartLabel><CalloutLineColor>Black</CalloutLineColor><MinMovingDistance>0pt</MinMovingDistance></ChartSmartLabel></ChartSeries></ChartSeriesCollection></ChartData><ChartAreas><ChartArea Name="Default"><ChartCategoryAxes><ChartAxis Name="Primary"><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border><FontFamily>arial</FontFamily><FontSize>12pt</FontSize><Color>#373948</Color></Style><ChartAxisTitle><Caption /><Style><FontSize>9pt</FontSize><Color>#5c5c5c</Color></Style></ChartAxisTitle><Interval>1</Interval><ChartMajorGridLines><Enabled>False</Enabled><Style><Border><Color>Gainsboro</Color></Border></Style></ChartMajorGridLines><ChartMinorGridLines><Style><Border><Color>Gainsboro</Color><Style>Dotted</Style></Border></Style></ChartMinorGridLines><ChartMajorTickMarks><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border></Style></ChartMajorTickMarks><ChartMinorTickMarks><Style><Border><Color>Gainsboro</Color></Border></Style><Length>0.5</Length></ChartMinorTickMarks><CrossAt>NaN</CrossAt><Minimum>NaN</Minimum><Maximum>NaN</Maximum><LabelsAutoFitDisabled>true</LabelsAutoFitDisabled><ChartAxisScaleBreak><Style /></ChartAxisScaleBreak></ChartAxis><ChartAxis Name="Secondary"><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border><FontSize>8pt</FontSize><Color>#5c5c5c</Color></Style><ChartAxisTitle><Caption /><Style><FontSize>9pt</FontSize><Color>#5c5c5c</Color></Style></ChartAxisTitle><ChartMajorGridLines><Enabled>False</Enabled><Style><Border><Color>Gainsboro</Color></Border></Style></ChartMajorGridLines><ChartMinorGridLines><Style><Border><Color>Gainsboro</Color><Style>Dotted</Style></Border></Style></ChartMinorGridLines><ChartMajorTickMarks><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border></Style></ChartMajorTickMarks><ChartMinorTickMarks><Style><Border><Color>Gainsboro</Color></Border></Style><Length>0.5</Length></ChartMinorTickMarks><CrossAt>NaN</CrossAt><Location>Opposite</Location><Minimum>NaN</Minimum><Maximum>NaN</Maximum><ChartAxisScaleBreak><Style /></ChartAxisScaleBreak></ChartAxis></ChartCategoryAxes><ChartValueAxes><ChartAxis Name="Primary"><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border><FontFamily>arial</FontFamily><FontSize>12pt</FontSize><Color>#373948</Color></Style><ChartAxisTitle><Caption>Number of Students</Caption><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></ChartAxisTitle><IntervalType>Number</IntervalType><ChartMajorGridLines><Style><Border><Color>#c1bfc5</Color><Width>0.5pt</Width></Border></Style></ChartMajorGridLines><ChartMinorGridLines><Style><Border><Color>Gainsboro</Color><Style>Dotted</Style></Border></Style></ChartMinorGridLines><ChartMajorTickMarks><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border></Style></ChartMajorTickMarks><ChartMinorTickMarks><Style><Border><Color>Gainsboro</Color></Border></Style><Length>0.5</Length></ChartMinorTickMarks><CrossAt>NaN</CrossAt><Minimum>0</Minimum><Maximum>NaN</Maximum><LabelsAutoFitDisabled>true</LabelsAutoFitDisabled><ChartAxisScaleBreak><Style /></ChartAxisScaleBreak></ChartAxis><ChartAxis Name="Secondary"><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border><FontSize>8pt</FontSize><Color>#5c5c5c</Color></Style><ChartAxisTitle><Caption /><Style><FontSize>9pt</FontSize><Color>#5c5c5c</Color></Style></ChartAxisTitle><ChartMajorGridLines><Style><Border><Color>Gainsboro</Color></Border></Style></ChartMajorGridLines><ChartMinorGridLines><Style><Border><Color>Gainsboro</Color><Style>Dotted</Style></Border></Style></ChartMinorGridLines><ChartMajorTickMarks><Style><Border><Color>Gainsboro</Color><Style>None</Style></Border></Style></ChartMajorTickMarks><ChartMinorTickMarks><Style><Border><Color>Gainsboro</Color></Border></Style><Length>0.5</Length></ChartMinorTickMarks><CrossAt>NaN</CrossAt><Location>Opposite</Location><Minimum>NaN</Minimum><Maximum>NaN</Maximum><ChartAxisScaleBreak><Style /></ChartAxisScaleBreak></ChartAxis></ChartValueAxes><Style><BackgroundColor>#00ffffff</BackgroundColor><BackgroundGradientType>None</BackgroundGradientType></Style></ChartArea></ChartAreas><ChartLegends><ChartLegend Name="Legend1"><Style><BackgroundGradientType>None</BackgroundGradientType><FontSize>12pt</FontSize><Color>#373948</Color></Style><Position>BottomCenter</Position><ChartLegendTitle><Caption /><Style><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Center</TextAlign></Style></ChartLegendTitle><AutoFitTextDisabled>true</AutoFitTextDisabled><HeaderSeparatorColor>Black</HeaderSeparatorColor><ColumnSeparatorColor>Black</ColumnSeparatorColor></ChartLegend></ChartLegends><ChartTitles><ChartTitle Name="Title1"><Caption>Students on Register</Caption><Style><BackgroundGradientType>None</BackgroundGradientType><FontFamily>arial</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>General</TextAlign><VerticalAlign>Top</VerticalAlign><Color>#373948</Color></Style><Position>TopLeft</Position></ChartTitle></ChartTitles><Palette>Custom</Palette><ChartCustomPaletteColors><ChartCustomPaletteColor>#43a4dc</ChartCustomPaletteColor><ChartCustomPaletteColor>#95358b</ChartCustomPaletteColor><ChartCustomPaletteColor>#f39600</ChartCustomPaletteColor><ChartCustomPaletteColor>#4ba73e</ChartCustomPaletteColor><ChartCustomPaletteColor>#e6362c</ChartCustomPaletteColor><ChartCustomPaletteColor>#ffea23</ChartCustomPaletteColor><ChartCustomPaletteColor>#e30f5a</ChartCustomPaletteColor><ChartCustomPaletteColor>#683f91</ChartCustomPaletteColor><ChartCustomPaletteColor>#484a9a</ChartCustomPaletteColor><ChartCustomPaletteColor>#2196f3</ChartCustomPaletteColor><ChartCustomPaletteColor>#26b7d4</ChartCustomPaletteColor><ChartCustomPaletteColor>#009285</ChartCustomPaletteColor><ChartCustomPaletteColor>#92be33</ChartCustomPaletteColor><ChartCustomPaletteColor>#d5d914</ChartCustomPaletteColor><ChartCustomPaletteColor>#fbc200</ChartCustomPaletteColor><ChartCustomPaletteColor>#e84e1f</ChartCustomPaletteColor><ChartCustomPaletteColor>#815847</ChartCustomPaletteColor></ChartCustomPaletteColors><ChartBorderSkin><Style><BackgroundColor>Gray</BackgroundColor><BackgroundGradientType>None</BackgroundGradientType><Color>White</Color></Style></ChartBorderSkin><ChartNoDataMessage Name="NoDataMessage"><Caption>No Data Available</Caption><Style><BackgroundGradientType>None</BackgroundGradientType><FontWeight>Bold</FontWeight><TextAlign>General</TextAlign><VerticalAlign>Top</VerticalAlign></Style></ChartNoDataMessage><DataSetName>Students</DataSetName><Height>14cm</Height><Width>27.7cm</Width><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>White</BackgroundColor><BackgroundGradientType>None</BackgroundGradientType><BackgroundHatchType>None</BackgroundHatchType></Style></Chart><Tablix Name="Tablix2"><TablixCorner><TablixCornerRows><TablixCornerRow><TablixCornerCell><CellContents><Textbox Name="Textbox17"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Students on Register</Value><Style><FontFamily>arial</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox14</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCornerCell></TablixCornerRow><TablixCornerRow><TablixCornerCell><CellContents><Textbox Name="Textbox5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!GroupBy.Label</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox4</rd:DefaultName><Style><Border><Color>#373948</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><RowSpan>2</RowSpan></CellContents></TablixCornerCell></TablixCornerRow><TablixCornerRow><TablixCornerCell /></TablixCornerRow></TablixCornerRows></TablixCorner><TablixBody><TablixColumns><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="txtComponentCode2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountDistinct(IIF(Fields!txtOnRegister.Value = "Yes", Fields!txtSchoolID.Value, Nothing))</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtComponentCode1</rd:De