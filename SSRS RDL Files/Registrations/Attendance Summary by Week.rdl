        <Field Name="txtCode">
          <DataField>txtCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtName">
          <DataField>txtName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TblRegistrationSchoolRegistrationCodesID">
          <DataField>TblRegistrationSchoolRegistrationCodesID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="intOrder">
          <DataField>intOrder</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <CommandText>SELECT        txtCode, txtName, TblRegistrationSchoolRegistrationCodesID, intOrder
FROM            TblRegistrationSchoolRegistrationCodes
ORDER BY intOrder</CommandText>
      </Query>
    </DataSet>
  </DataSets>
