                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Left</TextAlign>
                  </Style>
                </Paragraph>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>=Format(CDate(Parameters!txtStartDate.value),"dd/MM/yyyy")  + " - " + Format(CDate(Parameters!txtEndDate.Value),"dd/MM/yyyy") 
+ IIF(isnothing(Parameters!txtTime.Value),"","   Times: " + Parameters!txtTime.Value)</Value>
                      <Style>
                        <FontSize>9pt</FontSize>
                        <FontWeight>Normal</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Left</TextAlign>
                  </Style>
                </Paragraph>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>=IIF(isNothing(Parameters!intNCYear.Value),"","Years: " &amp; Parameters!intNCYear.Value &amp; "     ") 
&amp; IIF(isNothing(Parameters!txtAcademicHouse.Value),"","Academic Houses: " &amp; Parameters!txtAcademicHouse.Value &amp; "     ") 
&amp; IIF(isNothing(Parameters!txtBoardingHouse.Value),"","Boarding Houses: " &amp; Parameters!txtBoardingHouse.Value &amp; "     ") 
&amp; IIF(isNothing(Parameters!txtForm.Value),"","Forms: " &amp; Parameters!txtForm.Value &amp; "     ")
&amp; IIF(isNothing(Parameters!txtRegistrationGroup.Value),"","Reg. Groups: " &amp; Parameters!txtRegistrationGroup.Value &amp; "     ")</Value>
                      <Style>
                        <FontSize>9pt</FontSize>
                        <FontWeight>Normal</FontWeight>
                      </Style>
                    </TextRun>
                    <TextRun>
                      <Value>=IIF(isNothing(Parameters!intNCYear.Value) AND isNothing(Parameters!txtAcademicHouse.Value) AND isNothing(Parameters!txtBoardingHouse.Value) AND isNothing(Parameters!txtForm.Value) AND isNothing(Parameters!txtRegistrationGroup.Value), "", VBCrlf) &amp;
"Group By: " &amp; 
SWITCH(Parameters!txtGroupBy.Value="txtDateTime","Year",
Parameters!txtGroupBy.Value="txtSurname","Pupil",
Parameters!txtGroupBy.Value="intNCYear","Year",
Parameters!txtGroupBy.Value="txtForm","Form",
Parameters!txtGroupBy.Value="txtAcademicHouse","Academic House",
Parameters!txtGroupBy.Value="txtBoardingHouse","Boarding House",
Parameters!txtGroupBy.Value="txtPresentCode","Year",
Parameters!txtGroupBy.Value="txtCode","Year",
Parameters!txtGroupBy.Value="txtRegistrationGroup","Registration Group",
true,"")</Value>
                      <Style>
                        <FontSize>9pt</FontSize>
                        <FontWeight>Normal</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
