    <DataSet Name="RegistrationCodes">
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <CommandText>WITH DefaultPresentCodes AS
	(SELECT 0 AS 'intPresentFirst', 'Present Codes' AS 'txtCode', '' AS 'txtName', -3 AS 'intOrder'
		UNION ALL
	 SELECT 1, '/', 'Present AM', -2
		UNION ALL
	 SELECT 1,  '\', 'Present PM', -1
	)
	,SchoolPresentCodes AS
	(SELECT	1 AS 'intPresentFirst', txtCode, txtName, intOrder
	 FROM	TblRegistrationSchoolRegistrationPresentCodes
	 WHERE	TblRegistrationSchoolRegistrationPresentCodes.blnActive = 1
	)
	,
	SchoolAuthorisedAbsentCodes AS
	(SELECT	3 AS 'intPresentFirst', txtCode, txtName, intOrder
	 FROM	TblRegistrationSchoolRegistrationCodes
	 WHERE	blnActive =1
			AND blnAuthorised = 1
	)
	,SchoolAuthorisedAbsentCodesWithHeader AS
	(SELECT	TOP 1 2 AS 'intPresentFirst', 'Authorised Absence Codes' AS 'txtCode', '' AS 'txtName', -1 AS 'intOrder'
	 FROM	SchoolAuthorisedAbsentCodes
		UNION ALL
	 SELECT SchoolAuthorisedAbsentCodes.*
	 FROM	SchoolAuthorisedAbsentCodes
	)
	,SchoolUnauthorisedAbsentCodes AS
	(SELECT	5 AS 'intPresentFirst', txtCode, txtName, intOrder
	 FROM	TblRegistrationSchoolRegistrationCodes
	 WHERE	blnActive =1
			AND blnAuthorised = 0
	)
	,SchoolUnauthorisedAbsentCodesWithHeader AS
	(SELECT	TOP 1 4 AS 'intPresentFirst', 'Unauthorised Absence Codes' AS 'txtCode', '' AS 'txtName', -1 AS 'intOrder'
	 FROM	SchoolUnauthorisedAbsentCodes
		UNION ALL
	 SELECT SchoolUnauthorisedAbsentCodes.*
	 FROM	SchoolUnauthorisedAbsentCodes
	)
	,AllRegistrationCodes AS
	(SELECT	DefaultPresentCodes.*
	 FROM	DefaultPresentCodes
		UNION ALL
	 SELECT	SchoolPresentCodes.*
	 FROM	SchoolPresentCodes
		UNION ALL
	 SELECT	SchoolAuthorisedAbsentCodesWithHeader.*
	 FROM	SchoolAuthorisedAbsentCodesWithHeader
		UNION ALL
	 SELECT	SchoolUnauthorisedAbsentCodesWithHeader.*
	 FROM	SchoolUnauthorisedAbsentCodesWithHeader
	)
	,OrderedCodes AS
	(SELECT	txtCode, txtName, ROW_NUMBER() OVER (ORDER BY intPresentFirst, intOrder) AS 'intRowNumber'
	 FROM	AllRegistrationCodes
	)
	,CodesSplitBy5 AS
	(SELECT	txtCode + '   ' + txtName AS 'txtFullCode', (intRowNumber - 1)/ CodesCount.intCountOfCodes AS 'int5'
	 FROM OrderedCodes
	 CROSS APPLY(SELECT( COUNT(*) / 5) + 1 AS intCountOfCodes FROM OrderedCodes) AS CodesCount
	)
	,CombinedCodes AS
	(SELECT	CodesSplitBy5.int5, STUFF((SELECT ';;' + txtFullCode FROM CodesSplitBy5 Codes WHERE Codes.int5 = CodesSplitBy5.int5 FOR XML PATH('')), 1, 2, '') 'txtCombineCodes'
	 FROM	CodesSplitBy5
	 GROUP BY CodesSplitBy5.int5
	)

SELECT	MAX(CASE int5 WHEN 0 THEN txtCombineCodes END) AS 'txtCodes1',
		MAX(CASE int5 WHEN 1 THEN txtCombineCodes END) AS 'txtCodes2',
		MAX(CASE int5 WHEN 2 THEN txtCombineCodes END) AS 'txtCodes3',
		MAX(CASE int5 WHEN 3 THEN txtCombineCodes END) AS 'txtCodes4',
		MAX(CASE int5 WHEN 4 THEN txtCombineCodes END) AS 'txtCodes5'
FROM	CombinedCodes</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="txtCodes1">
          <DataField>txtCodes1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtCodes2">
          <DataField>txtCodes2</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtCodes3">
          <DataField>txtCodes3</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtCodes4">
          <DataField>txtCodes4</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtCodes5">
          <DataField>txtCodes5</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
