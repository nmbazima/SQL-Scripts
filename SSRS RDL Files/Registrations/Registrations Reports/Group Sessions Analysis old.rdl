&amp; IIF(isNothing(Parameters!txtAcademicHouse.Value),"","Academic Houses: " &amp; Parameters!txtAcademicHouse.Value &amp; "     ") 
&amp; IIF(isNothing(Parameters!txtBoardingHouse.Value),"","Boarding Houses: " &amp; Parameters!txtBoardingHouse.Value &amp; "     ") 
&amp; IIF(isNothing(Parameters!txtForm.Value),"","Forms: " &amp; Parameters!txtForm.Value &amp; "     ")
&amp; IIF(isNothing(Parameters!txtRegistrationGroup.Value),"","Reg Groups: " &amp; Parameters!txtRegistrationGroup.Value &amp; "     "),"")</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph><Paragraph><TextRuns><TextRun><Value>="Group By: " &amp; 
SWITCH(
Parameters!txtGroupBy.Value="txtSurname","Pupil",
Parameters!txtGroupBy.Value="intNCYear","Year",
Parameters!txtGroupBy.Value="txtForm","Form",
Parameters!txtGroupBy.Value="txtAcademicHouse","Academic House",
Parameters!txtGroupBy.Value="txtBoardingHouse","Boarding House",
Parameters!txtGroupBy.Value="txtRegistrationGroup","Registration Group",
true,"")</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Left>10.7cm</Left><Height>1.3cm</Height><Width>9.3cm</Width><ZIndex>1</ZIndex><Style><Border><Style>None</Style><Width>2pt</Width></Border><BottomBorder><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></ReportItems><Style /></PageHeader><PageFooter><Height>0.7cm</Height><PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><ReportItems><Textbox Name="textbox84"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Printed on " + Format(Now(),"d MMMM yyyy")</Value><Style /></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Height>0.7cm</Height><Width>16.9cm</Width><Style><Border><Width>2pt</Width></Border><TopBorder><Style>Solid</Style></TopBorder><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>4pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="textbox83"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Page " &amp; Globals!PageNumber</Value><Style /></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Left>16.9cm</Left><Height>0.7cm</Height><Width>3.1cm</Width><ZIndex>1</ZIndex><Style><Border><Width>2pt</Width></Border><TopBorder><Style>Solid</Style></TopBorder><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>4pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></ReportItems><Style /></PageFooter><PageHeight>29.7cm</PageHeight><PageWidth>21cm</PageWidth><InteractiveHeight>29.6cm</InteractiveHeight><LeftMargin>0.5cm</LeftMargin><RightMargin>0.5cm</RightMargin><TopMargin>0.5cm</TopMargin><BottomMargin>0.5cm</BottomMargin><ColumnSpacing>1cm</ColumnSpacing><Style /></Page><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>Demo</DataSourceReference><rd:SecurityType xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">None</rd:SecurityType><rd:DataSourceID xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">772c9ca1-961d-4a29-94df-9e6b84f683fc</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Attendance"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtStartDate"><Value>=Parameters!txtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtForm"><Value>=Parameters!txtForm.Value</Value></QueryParameter><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter><QueryParameter Name="@txtAcademicHouse"><Value>=Parameters!txtAcademicHouse.Value</Value></QueryParameter><QueryParameter Name="@txtTime"><Value>=Parameters!txtTime.Value</Value></QueryParameter><QueryParameter Name="@txtBoardingHouse"><Value>=Parameters!txtBoardingHouse.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationGroup"><Value>=Parameters!txtRegistrationGroup.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@txtAmPm"><Value>=Parameters!txtAmPm.Value</Value></QueryParameter><QueryParameter Name="@txtCustomGroups"><Value>=Parameters!txtCustomGroups.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @PupilID AS nvarchar(max);
SET @PupilID = 	STUFF((	

SELECT DISTINCT ',' + TblPupilManagementPupils.txtSchoolID
FROM TblPupilManagementPupils
CROSS APPLY dbo.uf_Registration_getPupilArchive(TblPupilManagementPupils.txtSchoolID, @txtEndDate) AS PupilArchive
WHERE  (PupilArchive.txtForm IN (SELECT ID FROM dbo.SplitCSV(@txtForm) AS SplitCSV_1) OR @txtForm IS NULL)
AND (PupilArchive.intNCYear IN (SELECT ID FROM dbo.SplitCSV(@intNCYear) AS SplitCSV_1) OR @intNCYear IS NULL)
AND (PupilArchive.txtAcademicHouse IN (SELECT ID FROM dbo.SplitCSV(@txtAcademicHouse) AS SplitCSV_1) OR @txtAcademicHouse IS NULL)
AND (PupilArchive.txtBoardingHouse IN (SELECT ID FROM dbo.SplitCSV(@txtBoardingHouse) AS SplitCSV_1) OR @txtBoardingHouse IS NULL)
AND (PupilArchive.txtSchoolID IN (SELECT ID FROM dbo.SplitCSV(@txtSchoolID) AS SplitCSV_1) OR @txtSchoolID IS NULL)
AND (PupilArchive.txtSchoolID IN (SELECT DISTINCT txtSchoolID FROM TblPupilManagementSelectionsStudents WHERE (ISNULL(intDeleted, 0) &lt;&gt; 1) AND (intSelectionID IN (SELECT ID FROM dbo.SplitCSV(@txtCustomGroups) AS SplitCSV_1))) OR @txtCustomGroups IS NULL)
FOR XML PATH('')), 1, 1, '');



SELECT Attendance.*,
PupilArchive.txtForename, PupilArchive.txtPreName, PupilArchive.txtMiddleNames, PupilArchive.txtSurname, PupilArchive.txtAcademicHouse, 
PupilArchive.txtBoardingHouse, PupilArchive.intNCYear, PupilArchive.txtYearName, PupilArchive.txtYearCode, PupilArchive.txtForm, 
RegistrationTeacher.Initials AS txtRegistrationTeacherSchoolInitials, RegistrationTeacher.Salutation AS txtRegistrationTeacherSchoolSalutation, 
RegistrationSubmitBy.Initials AS txtRegistrationSubmitBySchoolInitials, RegistrationSubmitBy.Salutation AS txtRegistrationSubmitBySchoolSalutation
FROM dbo.uf_Registration_AttendanceBetweenDates(@txtStartDate,@txtEndDate,@PupilID) AS Attendance
CROSS APPLY dbo.uf_Registration_getPupilArchive(Attendance.txtSchoolID, @txtEndDate) AS PupilArchive 
LEFT OUTER JOIN TblStaff AS RegistrationTeacher ON Attendance.txtRegistrationTeacherCode = RegistrationTeacher.User_Code 
LEFT OUTER JOIN TblStaff AS RegistrationSubmitBy ON Attendance.txtRegistrationSubmitBy = RegistrationSubmitBy.User_Code

WHERE  (LEFT(CONVERT(varchar(8), Attendance.dtRegistrationDateTime, 108), 5) IN (SELECT ID FROM dbo.SplitCSV(@txtTime) AS SplitCSV_1) OR @txtTime IS NULL)
AND (Attendance.txtRegistrationGroupName IN (SELECT ID FROM dbo.SplitCSV(@txtRegistrationGroup) AS SplitCSV_1) OR @txtRegistrationGroup IS NULL)
AND (Attendance.txtRegistrationAMPM IN (SELECT ID FROM dbo.SplitCSV(@txtAmPm) AS SplitCSV_1) OR @txtAmPm IS NULL)

OPTION (RECOMPILE)</CommandText><rd:UseGenericDesigner xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">true</rd:UseGenericDesigner></Query><Fields><Field Name="intRegistrationDateTimeID"><DataField>intRegistrationDateTimeID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="dtRegistrationDateTime"><DataField>dtRegistrationDateTime</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.DateTime</rd:TypeName></Field><Field Name="txtRegistrationAMPM"><DataField>txtRegistrationAMPM</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtRegistrationName"><DataField>txtRegistrationName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intRegistrationPupilsID"><DataField>intRegistrationPupilsID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intRegisterID"><DataField>intRegisterID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName x