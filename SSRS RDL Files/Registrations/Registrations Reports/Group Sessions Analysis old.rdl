Parameters!txtGroupBy.Value ="txtSurname",Fields!txtSurname.Value + ", " + IIF(Fields!txtPreName.Value="" or Fields!txtPreName.Value=" ", Fields!txtForename.Value,Fields!txtPreName.Value),
Parameters!txtGroupBy.Value="txtRegistrationGroup",Fields!txtRegistrationGroupType.Value + ": " + 
IIF(Fields!txtRegistrationGroupType.Value="Tutor Group",Fields!txtRegistrationTeacherSchoolSalutation.Value,Fields!txtRegistrationGroupName.Value + " - " + Fields!txtRegistrationTeacherSchoolSalutation.Value),
true,Fields(Parameters!txtGroupBy.Value).Value)</Value><Style><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">textbox16</rd:DefaultName><ZIndex>35</ZIndex><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><BottomBorder><Color>Silver</Color><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="textbox25"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=COUNTDISTINCT(IIF(Fields!intIsIncludedInStatistics.Value=1,Fields!intRegistrationDateTimeID.Value &amp; Fields!txtSchoolID.Value,nothing))</Value><Style><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">textbox25</rd:DefaultName><ZIndex>34</ZIndex><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><BottomBorder><Color>Silver</Color><Style>Solid</Style></BottomBorder><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="textbox27"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=COUNTDISTINCT(IIF(Fields!intIsIncludedInStatistics.Value=1 AND Fields!txtRegistrationStatisticalStatus.Value="Present",Fields!intRegistrationDateTimeID.Value &amp; Fields!txtSchoolID.Value,nothing))</Value><Style><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">textbox27</rd:DefaultName><ZInd