ReportParameter Name="txtEndDate"><DataType>DateTime</DataType><Prompt>txtEndDate</Prompt></ReportParameter><ReportParameter Name="txtTime"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtTime</Prompt></ReportParameter><ReportParameter Name="intNCYear"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>intNCYear</Prompt></ReportParameter><ReportParameter Name="txtAcademicHouse"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtAcademicHouse</Prompt></ReportParameter><ReportParameter Name="txtBoardingHouse"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtBoardingHouse</Prompt></ReportParameter><ReportParameter Name="txtForm"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtForm</Prompt></ReportParameter><ReportParameter Name="txtSchoolID"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtSchoolID</Prompt></ReportParameter><ReportParameter Name="txtGroupBy"><DataType>String</DataType><Prompt>txtGroupBy</Prompt></ReportParameter><ReportParameter Name="txtCustomGroups"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtCustomGroups</Prompt></ReportParameter><ReportParameter Name="txtAmPm"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtAmPm</Prompt></ReportParameter><ReportParameter Name="txtRegistrationGroup"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtRegistrationGroup</Prompt></ReportParameter></ReportParameters><Code>Public FirstFive AS String = "@ - Absent (no code)" + vbnewline
Public SecondFive AS String = ""
Public ThirdFive AS String = ""
Public TourthFive AS String = ""
Public FifthFive AS String = ""
Public SixthFive AS String = ""
Public RecordCount AS Integer = 0
Public PresentCodes AS String = "/ - Present (am - no code)" + vbnewline + "\ - Present (pm - no code)" + vbnewline

Public Function getCodeDescriptions (ByVal singleCode As String, ByVal singleDescription As String)
if RecordCount &lt;4 then
	FirstFive = FirstFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;3 and  RecordCount &lt;8 then
	SecondFive = SecondFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;7 and  RecordCount &lt;13 then
	ThirdFive = ThirdFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;12 and  RecordCount &lt;18 then
	TourthFive = TourthFive + singleCode + " - " + singleDescription + vbnewline	

end if  
if RecordCount &gt;17 and  RecordCount &lt;23 then
	FifthFive = FifthFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;22 and  RecordCount &lt;31 then
	SixthFive = SixthFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
RecordCount = RecordCount + 1
End Function

Public Function getPresentCode (ByVal singlePCode As String, ByVal singlePDescription As String)
	
PresentCodes = PresentCodes + singlePCode +" - " + singlePDescription + vbnewline
 
End Function</Code><Language>en-GB</Language><ConsumeContainerWhitespace>true</ConsumeContainerWhitespace><rd:ReportUnitType xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">Cm</rd:ReportUnitType><rd:ReportID xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">36d3aa52-5785-466c-9dda-a872ad57105f</rd:ReportID></Report>