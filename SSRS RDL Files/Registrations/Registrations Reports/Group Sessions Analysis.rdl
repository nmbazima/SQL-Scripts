e="Textbox315"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Present</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox314</rd:DefaultName><Style><Border><Style>None</Style></Border><BottomBorder><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell><CellContents><Textbox Name="Textbox321"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Late</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox316</rd:DefaultName><Style><Border><Style>None</Style></Border><BottomBorder><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell><CellContents><Textbox Name="Textbox552"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Mins</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox550</rd:DefaultName><Style><Border><Style>None</Style></Border><BottomBorder><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox551"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Auth. Abs</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox550</rd:DefaultName><Style><Border><Style>None</Style></Border><BottomBorder><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell><CellContents><Textbox Name="Textbox322"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>UnAuth. Abs</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox317</rd:DefaultName><Style><Border><Style>None</Style></Border><BottomBorder><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell><CellContents><Textbox Name="Textbox323"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Not Reg.</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox319</rd:DefaultName><Style><Border><Style>None</Style></Border><BottomBorder><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="textbox16"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=SWITCH(
Parameters!txtGroupBy.Value = "intNCYear", "" &amp; Fields!txtYearName.Value, 
Parameters!txtGroupBy.Value = "txtGender", "Gender: " &amp; Fields!txtGender.Value, 
Parameters!txtGroupBy.Value = "txtEthnicGroup", "Ethnic Group: " &amp; Fields!txtEthnicGroup.Value, 
Parameters!txtGroupBy.Value = "txtSen", "SEN: " &amp; Fields!txtSen.Value, 
Parameters!txtGroupBy.Value = "txtSurname", UCASE(Fields!txtSurname.Value) &amp; ", " &amp; Fields!txtForename.Value &amp; IIF(Fields!txtPreName.Value = "" Or Fields!txtPreName.Value = " " Or Fields!txtForename.Value = Fields!txtPreName.Value, "", " (" &amp; Fields!txtPreName.Value &amp; ")"), 
Parameters!txtGroupBy.Value = "txtRegistrationGroup", Fields!txtRegistrationGroupType.Value &amp; ": " &amp; IIF(Fields!txtRegistrationGroupType.Value = "Tutor Group", Fields!txtRegistrationTeacherSchoolSalutation.Value, Fields!txtRegistrationGroupName.Value &amp; " - " &amp; Fields!txtRegistrationTeacherSchoolSalutation.Value), 
True, Fields(Parameters!txtGroupBy.Value).Value
