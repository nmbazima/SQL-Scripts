Left(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), Len(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) - 1),
First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) &amp; Lookup("School Logo", Fields!txtName.Value, Fields!txtSchoolLogoPath.Value, "SchoolLogo")</Value><Sizing>FitProportional</Sizing><Height>1.5cm</Height><Width>4.96cm</Width><Style><Border><Color>#8d8993</Color><Style>None</Style><Width>0.5pt</Width></Border></Style></Image><Textbox Name="Page2HeaderReportDetail"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Group Session Analysis - </Value><Style><FontStyle>Normal</FontStyle><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><TextDecoration>None</TextDecoration><Color>#373948</Color></Style></TextRun><TextRun><Value>="Group By: " &amp; 
SWITCH(
Parameters!txtGroupBy.Value = "txtDateTime", "Year",
Parameters!txtGroupBy.Value = "txtSurname", "Pupil",
Parameters!txtGroupBy.Value = "intNCYear", "Year",
Parameters!txtGroupBy.Value = "txtForm", "Form",
Parameters!txtGroupBy.Value = "txtEthnicGroup", "Ethnicity", 
Parameters!txtGroupBy.Value = "txtAcademicHouse", "Academic House",
Parameters!txtGroupBy.Value = "txtBoardingHouse", "Boarding House",
Parameters!txtGroupBy.Value = "txtPresentCode", "Year",
Parameters!txtGroupBy.Value = "txtCode", "Year",
Parameters!txtGroupBy.Value = "txtGender", "Gender",
Parameters!txtGroupBy.Value = "txtSen", "SEN",
Parameters!txtGroupBy.Value = "txtRegistrationGroup", "Registration Group",
True,""
)</Value><Style><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>=Format(CDate(Parameters!txtStartDate.value), "dd-MMM-yyyy") &amp; " - " &amp; Format(CDate(Parameters!txtEndDate.Value), "dd-MMM-yyyy") &amp; IIF(isnothing(Parameters!txtTime.Value), "", "   Times: " &amp; Parameters!txtTime.Value)</Value><Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value>=
IIF(NOT isNothing(Parameters!intNCYear.Value) OR 
	NOT isNothing(Parameters!txtAcademicHouse.Value) OR 
	NOT isNothing(Parameters!txtBoardingHouse.Value) OR 
	NOT isNothing(Parameters!txtForm.Value) OR 
	NOT isNothing(Parameters!txtSEN.Value) OR 
	NOT isNothing(Parameters!txtGender.Value) OR 
	NOT isNothing(Parameters!txtEthnicity.Value) OR 
	NOT isNothing(Parameters!txtRegistrationGroup.Value) , "; Filtered By:","") &amp; 
RTRIM(
IIF(isNothing(Parameters!intNCYear.Value), "", " Years: " &amp; Parameters!intNCYear.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtAcademicHouse.Value), "", " Academic Houses: " &amp; Parameters!txtAcademicHouse.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtBoardingHouse.Value), "", " Boarding Houses: " &amp; Parameters!txtBoardingHouse.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtForm.Value), "", " Forms: " &amp; Parameters!txtForm.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtSEN.Value), "", " SEN: " &amp; Parameters!txtSEN.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtGender.Value), "", " Gender: " &amp; Parameters!txtGender.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtEthnicity.Value), "", " Ethnicity: " &amp; Parameters!txtEthnicity.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtRegistrationGroup.Value), "", " Reg. Groups: " &amp; Parameters!txtRegistrationGroup.Value &amp; " ")
)</Value><Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Left>4.96cm</Left><Height>1.5cm</Height><Width>23.74cm</Width><ZIndex>1</ZIndex><Style><Border><Color>#8d8993</Color><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign></Style></Textbox></ReportItems><Style /></PageHeader><PageFooter><Height>0.7cm</Height><PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><ReportItems><Textbox Name="FooterPage2Detail"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Reported on </Value><Style><FontSize>9pt</FontSize><Color>#373948</Color></Style></TextRun><TextRun><Value>=Globals!ExecutionTime</Value><Style><FontSize>9pt</FontSize><Format>dd-MMM-yyyy</Format><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Top>0.1cm</Top><Height>0.5cm</Height><Width>7.75cm</Width><Style><Border><Color>#8d8993</Color><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="FooterPageNumber"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Page " &amp; Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value><Style><FontSize>9pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Top>0.1cm</Top><Left>12.6cm</Left><Height>0.5cm</Height><Width>3.5cm</Width><ZIndex>1</ZIndex><Style><Border><Color>#8d8993</Color><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><Pad