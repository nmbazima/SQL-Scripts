<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>772c9ca1-961d-4a29-94df-9e6b84f683fc</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Attendance"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtStartDate"><Value>=Parameters!txtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter><QueryParameter Name="@txtTime"><Value>=Parameters!txtTime.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationGroup"><Value>=Parameters!txtRegistrationGroup.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@txtAmPm"><Value>=Parameters!txtAmPm.Value</Value></QueryParameter></QueryParameters><CommandText>WITH AuditCodes AS 
	(SELECT	'Present' AS 'txtAuditCodeStatus', 
			txtCode AS 'txtAuditCode', 
			txtName AS 'txtAuditCodeName', 
			TblRegistrationSchoolRegistrationPresentCodes.TblRegistrationSchoolRegistrationPresentCodesID AS 'intAuditCodeID', 
			'Present' AS 'txtAuditCodeStatisticalStatus', 
			txtColour
	 FROM  TblRegistrationSchoolRegistrationPresentCodes
		UNION ALL
	 SELECT	'Absent' AS 'txtAuditCodeStatus', 
			txtCode AS 'txtAuditCode', 
			txtName AS 'txtAuditCodeName', 
			TblRegistrationSchoolRegistrationCodes.TblRegistrationSchoolRegistrationCodesID AS 'intAuditCodeID', 
			CASE WHEN TblRegistrationSchoolRegistrationCodes.blnAbsence = 1 THEN 'Absent' ELSE 'Present' END AS 'txtAuditCodeStatisticalStatus', 
			txtColour
	 FROM	TblRegistrationSchoolRegistrationCodes
	)
	,RegisterBetweenSelectedDates AS
	(SELECT	TblRegistrationSchoolRegistrationRegisterID
	 FROM	TblRegistrationSchoolRegistrationRegister
	 INNER JOIN TblRegistrationSchoolRegistrationDateTime ON TblRegistrationSchoolRegistrationRegister.intRegistrationDateTime = TblRegistrationSchoolRegistrationDateTime.TblRegistrationSchoolRegistrationDateTimeID
	 WHERE	TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @txtStartDate AND @txtEndDate
	)
	,AuditedPupilsRegisteres AS
	(SELECT	DISTINCT TblRegistrationSchoolRegistrationPupilsAudit.txtSchoolID, TblRegistrationSchoolRegistrationPupilsAudit.intRegister
	 FROM	TblRegistrationSchoolRegistrationPupilsAudit
	 WHERE	(TblRegistrationSchoolRegistrationPupilsAudit.txtSchoolID IN (SELECT ID FROM dbo.SplitCSV(@txtSchoolID) AS SplitCSV_1) OR @txtSchoolID IS NULL)
			AND TblRegistrationSchoolRegistrationPupilsAudit.intRegister IN (SELECT TblRegistrationSchoolRegistrationRegisterID FROM RegisterBetweenSelectedDates)
	 GROUP BY TblRegistrationSchoolRegistrationPupilsAudit.intRegister, TblRegistrationSchoolRegistrationPupilsAudit.txtSchoolID
	 HAVING	(COUNT(TblRegistrationSchoolRegistrationPupilsAudit.txtSchoolID) &gt; 1)
	)
	,AuditedPupilsDetails AS
	(SELECT	AuditedPupilsRegisteres.txtSchoolID, 
			AuditedPupilsRegisteres.intRegister,
			TblRegistrationSchoolRegistrationDateTime.txtAmPm,
			TblRegistrationSchoolRegistrationDateTime.txtDateTime AS 'dtRegistrationDateTime',
			TblRegistrationSchoolRegistrationPupilsAudit.TblRegistrationSchoolRegistrationPupilsAuditID, 
			TblRegistrationSchoolRegistrationPupilsAudit.blnRegistered AS 'blnAuditRegistered', 
			TblRegistrationSchoolRegistrationPupilsAudit.txtSubmitBy AS 'txtAuditTeacher', 
			TblRegistrationSchoolRegistrationPupilsAudit.txtSubmitDateTime AS 'dtAuditDate', 
			TblRegistrationSchoolRegistrationPupilsAudit.txtReason AS 'txtAuditReason', 
			TblRegistrationSchoolRegistrationPupilsAudit.blnLate AS 'blnAuditLate', 
			CASE WHEN TblRegistrationSchoolRegistrationPupilsAudit.blnRegistered = 1 THEN 'Present' WHEN TblRegistrationSchoolRegistrationPupilsAudit.blnRegistered= 0 THEN 'Absent' ELSE 'Not Registered' END AS 'txtAuditStatus', 
			CASE WHEN TblRegistrationSchoolRegistrationPupilsAudit.blnRegistered = 1 THEN TblRegistrationSchoolRegistrationPupilsAudit.intPresentCode WHEN TblRegistrationSchoolRegistrationPupilsAudit.blnRegistered = 0 THEN TblRegistrationSchoolRegistrationPupilsAudit.intCode ELSE NULL END AS 'intAuditCode'
	 FROM	AuditedPupilsRegisteres
	 INNER JOIN TblRegistrationSchoolRegistrationPupilsAudit ON AuditedPupilsRegisteres.intRegister = TblRegistrationSchoolRegistrationPupilsAudit.intRegister AND AuditedPupilsRegisteres.txtSchoolID = TblRegistrationSchoolRegistrationPupilsAudit.txtSchoolID
	 INNER JOIN TblRegistrationSchoolRegistrationRegister ON AuditedPupilsRegisteres.intRegister = TblRegistrationSchoolRegistrationRegister.TblRegistrationSchoolRegistrationRegisterID
	 INNER JOIN TblRegistrationSchoolRegistrationDateTime ON TblRegistrationSchoolRegistrationRegister.intRegistrationDateTime = TblRegistrationSchoolRegistrationDateTime.TblRegistrationSchoolRegistrationDateTimeID
	)

SELECT	AuditedPupilsDetails.*,
		PupilArchive.txtForename, 
		PupilArchive.txtPreName, 
		PupilArchive.txtMiddleNames, 
		PupilArchive.txtSurname, 
		PupilArchive.txtAcademicHouse, 
		PupilArchive.txtBoardingHouse, 
		PupilArchive.intNCYear, 
		PupilArchive.txtYearName, 
		PupilArchive.txtYearCode, 
		PupilArchive.txtForm, 
		TblPupilManagementPupils.txtGender, 
		TblPupilManagementPupils.txtEthnicGroup,
		CASE WHEN TblSENManagerRegister.intSENRegister = 1 THEN 'Yes' ELSE 'No' END AS 'txtSen',
		TblRegistrationSchoolRegistrationPupilsGroups.txtValue AS 'txtRegistrationGroupName',
		TblRegistrationSchoolRegistrationPupilsGroups.txtValue AS 'txtRegistrationGroup',
		TblRegistrationSchoolRegistrationPupilsGroups.txtObject AS 'txtRegistrationGroupType',
		RegistrationTeacher.Salutation AS 'txtRegistrationTeacherSchoolSalutation',
		CASE WHEN AuditedPupilsDetails.txtAuditStatus = 'Absent' AND AuditCodes.txtAuditCodeStatisticalStatus = 'Present' THEN 'Present' ELSE AuditedPupilsDetails.txtAuditStatus END AS 'txtAuditCodeStatisticalStatus',
		AuditTeacher.Salutation AS 'txtAuditTeacherSchoolSalutation', 
		AuditCodes.txtAuditCode, 
		AuditCodes.txtAuditCodeName, 
		AuditCodes.txtColour
FROM	AuditedPupilsDetails
INNER JOIN TblRegistrationSchoolRegistrationPupilsGroups ON AuditedPupilsDetails.intRegister = TblRegistrationSchoolRegistrationPupilsGroups.intRegister AND AuditedPupilsDetails.txtSchoolID = TblRegistrationSchoolRegistrationPupilsGroups.txtSchoolID
CROSS APPLY dbo.uf_Registration_getPupilArchive(AuditedPupilsDetails.txtSchoolID, @txtEndDate) AS PupilArchive 
INNER JOIN TblPupilManagementPupils ON PupilArchive.txtSchoolID = TblPupilManagementPupils.txtSchoolID
LEFT OUTER JOIN TblStaff AS AuditTeacher ON AuditedPupilsDetails.txtAuditTeacher = AuditTeacher.User_Code 
LEFT OUTER JOIN AuditCodes ON AuditedPupilsDetails.txtAuditStatus = AuditCodes.txtAuditCodeStatus AND AuditedPupilsDetails.intAuditCode = AuditCodes.intAuditCodeID
LEFT OUTER JOIN TblStaff AS RegistrationTeacher ON TblRegistrationSchoolRegistrationPupilsGroups.txtTeacher = RegistrationTeacher.User_Code 
LEFT OUTER JOIN TblSENManagerRegister ON TblPupilManagementPupils.txtSchoolID = TblSENManagerRegister.txtSchoolID
WHERE	(LEFT(CONVERT(VARCHAR(8), AuditedPupilsDetails.dtRegistrationDateTime, 108), 5) IN (SELECT ID FROM dbo.SplitCSV(@txtTime) AS SplitCSV_1) OR @txtTime IS NULL)
		AND (TblRegistrationSchoolRegistrationPupilsGroups.txtValue IN (SELECT ID FROM dbo.SplitCSV(@txtRegistrationGroup) AS SplitCSV_1) OR @txtRegistrationGroup IS NULL)
		AND (AuditedPupilsDetails.txtAmPm IN (SELECT ID FROM dbo.SplitCSV(@txtAmPm) AS SplitCSV_1) OR @txtAmPm IS NULL)

OPTION (RECOMPILE)</CommandText></Query><Fields><Field Name="dtRegistrationDateTime"><DataField>dtRegistrationDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intRegister"><DataField>intRegister</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtAmPm"><DataField>txtAmPm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationGroupType"><DataField>txtRegistrationGroupType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationGroup_1"><DataField>txtRegistrationGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationGroupName"><DataField>txtRegistrationGroupName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolSalutation"><DataField>txtRegistrationTeacherSchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAuditTeacherSchoolSalutation"><DataField>txtAuditTeacherSchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnAuditRegistered"><DataField>blnAuditRegistered</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtAuditTeacher"><DataField>txtAuditTeacher</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtAuditDate"><DataField>dtAuditDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblRegistrationSchoolRegistrationPupilsAuditID"><DataField>TblRegistrationSchoolRegistrationPupilsAuditID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtAuditReason"><DataField>txtAuditReason</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEthnicGroup"><DataField>txtEthnicGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAuditStatus"><DataField>txtAuditStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSen"><DataField>txtSen</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intAuditCode"><DataField>intAuditCode</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtAuditCodeStatisticalStatus"><DataField>txtAuditCodeStatisticalStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAuditCode"><DataField>txtAuditCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAuditCodeName"><DataField>txtAuditCodeName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnAuditLate"><DataField>blnAuditLate</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtRegistrationGroup"><Value>=Fields!txtRegistrationGroupName.Value</Value></Field><Field Name="txtColour"><DataField>txtColour</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="RegistrationCodes"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>WITH DefaultPresentCodes AS
	(SELECT 'Present' AS 'txtPresentFirst', '/' AS 'txtCode', 'Present AM' AS 'txtName', -2 AS 'intOrder', 'cbe3ba' AS 'txtColour'
		UNION ALL
	 SELECT 'Present' AS 'txtPresentFirst',  '\' AS 'txtCode', 'Present PM' AS 'txtName', -1 AS 'intOrder', 'cbe3ba' AS 'txtColour'
	)
	,SchoolPresentCodes AS
	(SELECT	'Present' AS 'txtPresentFirst', txtCode, txtName, intOrder, txtColour
	 FROM	TblRegistrationSchoolRegistrationPresentCodes
	 WHERE	TblRegistrationSchoolRegistrationPresentCodes.blnStatusActive = 1 OR TblRegistrationSchoolRegistrationPresentCodes.blnActive = 1
	)
	,
	SchoolAuthorisedAbsentCodes AS
	(SELECT	'AuthorisedAbsent' AS 'txtPresentFirst', txtCode, txtName, intOrder , txtColour
	 FROM	TblRegistrationSchoolRegistrationCodes
	 WHERE	blnStatistic =1
			AND blnAuthorised = 1
	)
	,SchoolUnauthorisedAbsentCodes AS
	(SELECT	'UnauthorisedAbsent' AS 'txtPresentFirst', txtCode, txtName, intOrder, txtColour
	 FROM	TblRegistrationSchoolRegistrationCodes
	 WHERE	blnStatistic =1
			AND blnAuthorised = 0
	)
	,AllRegistrationCodes AS
	(SELECT	DefaultPresentCodes.*
	 FROM	DefaultPresentCodes
		UNION ALL
	 SELECT	SchoolPresentCodes.*
	 FROM	SchoolPresentCodes
		UNION ALL
	 SELECT	SchoolAuthorisedAbsentCodes.*
	 FROM	SchoolAuthorisedAbsentCodes
		UNION ALL
	 SELECT	SchoolUnauthorisedAbsentCodes.*
	 FROM	SchoolUnauthorisedAbsentCodes
	)

SELECT	AllRegistrationCodes.txtPresentFirst, 
		STUFF((SELECT ';;[B]' + Codes.txtCode + '[/B] ' + Codes.txtName FROM AllRegistrationCodes Codes WHERE Codes.txtPresentFirst = AllRegistrationCodes.txtPresentFirst FOR XML PATH('')), 1, 2, '') AS 'txtCombineCodes'
FROM	AllRegistrationCodes
GROUP BY AllRegistrationCodes.txtPresentFirst</CommandText></Query><Fields><Field Name="txtPresentFirst"><DataField>txtPresentFirst</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCombineCodes"><DataField>txtCombineCodes</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS 'txtiSAMSAddress'
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS 'txtSchoolLogoPath', 
		TblReportsCustomImages.txtName
FROM	TblReportsCustomImages
WHERE	TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Disclaimer"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Path"><Value>=Globals!ReportFolder</Value></QueryParameter><QueryParameter Name="@Report"><Value>=Globals!ReportName</Value></QueryParameter></QueryParameters><CommandText>SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
FROM	TblSQLReportingServicesDisclaimerReport
		INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report</CommandText></Query><Fields><Field Name="txtDisclaimerBackgroundColour"><DataField>txtDisclaimerBackgroundColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerBorderColour"><DataField>txtDisclaimerBorderColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerDescription"><DataField>txtDisclaimerDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTextColour"><DataField>txtDisclaimerTextColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTitle"><DataField>txtDisclaimerTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="list1"><TablixBody><TablixColumns><TablixColumn><Width>28.7cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.9cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle1"><ReportItems><Textbox Name="Disclaimer"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!txtDisclaimerTitle.Value, "Disclaimer")</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun><TextRun><Value>:</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun><TextRun><Value>=First(Fields!txtDisclaimerDescription.Value, "Disclaimer")</Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Height>0.6cm</Height><Width>28.7cm</Width><Style><Border><Color>=First(Fields!txtDisclaimerBorderColour.Value, "Disclaimer")</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>=First(Fields!txtDisclaimerBackgroundColour.Value, "Disclaimer")</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></ReportItems><KeepTogether>true</KeepTogether><Style><Border><Style>None</Style></Border></Style></Rectangle></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>2cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="list1_Contents"><ReportItems><Tablix Name="table2"><TablixBody><TablixColumns><TablixColumn><Width>4.85556cm</Width></TablixColumn><TablixColumn><Width>2.4941cm</Width></TablixColumn><TablixColumn><Width>3.96664cm</Width></TablixColumn><TablixColumn><Width>3.66146cm</Width></TablixColumn><TablixColumn><Width>2.75556cm</Width></TablixColumn><TablixColumn><Width>1.6cm</Width></TablixColumn><TablixColumn><Width>1.4cm</Width></TablixColumn><TablixColumn><Width>4.11112cm</Width></TablixColumn><TablixColumn><Width>3.85556cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox321"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=SWITCH(
Parameters!txtGroupBy.Value = "intNCYear", "" &amp; Fields!txtYearName.Value,
Parameters!txtGroupBy.Value = "txtSurname", "",
Parameters!txtGroupBy.Value = "txtRegistrationGroup", Fields!txtRegistrationGroupType.Value &amp; ": " &amp; IIF(Fields!txtRegistrationGroupType.Value = "Tutor Group", Fields!txtRegistrationTeacherSchoolSalutation.Value, Fields!txtRegistrationGroupName.Value &amp; " - " &amp; Fields!txtRegistrationTeacherSchoolSalutation.Value),
True, Fields(Parameters!txtGroupBy.Value).Value
)</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox314</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Width></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>9</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox327"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Name</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox314</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Width></Border><BottomBorder><Style>Solid</Style></BottomBorder><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox22"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Form</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox22</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Wid