COUNT(Fields!intRegistrationDateTimeID.Value) = 0, "Gainsboro",
COUNT(Fields!intRegistrationDateTimeID.Value) = COUNT(IIF(Fields!txtRegistrationStatisticalStatus.Value = "Not Registered", 1, Nothing)), "#e98e93",
COUNT(IIF(Fields!txtRegistrationStatisticalStatus.Value = "Not Registered", 1, Nothing))&gt;0, "#fad182",
True,"#cbe3ba"
