<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>772c9ca1-961d-4a29-94df-9e6b84f683fc</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Attendance"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtStartDate"><Value>=Parameters!txtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter><QueryParameter Name="@txtTime"><Value>=Parameters!txtTime.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationGroup"><Value>=Parameters!txtRegistrationGroup.Value</Value></QueryParameter><QueryParameter Name="@txtAmPm"><Value>=Parameters!txtAmPm.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter></QueryParameters><CommandText>With AllNotRegistered AS
	(SELECT DISTINCT intRegistrationDateTimeID AS 'ANRintRegistrationDateTimeID', txtRegistrationTeacherCode AS 'ANRtxtRegistrationTeacherCode', txtRegistrationGroupName AS 'ANRtxtRegistrationGroupName'
	 FROM	dbo.uf_Registration_AttendanceBetweenDates(@txtStartDate, @txtEndDate, @txtSchoolID)
	 WHERE	txtRegistrationStatus &lt;&gt; 'Not Registered'
	) 

SELECT	ANRintRegistrationDateTimeID, Attendance.*,
		PupilArchive.txtForename, PupilArchive.txtPreName, PupilArchive.txtMiddleNames, PupilArchive.txtSurname, PupilArchive.txtAcademicHouse, 
		PupilArchive.txtBoardingHouse, PupilArchive.intNCYear, PupilArchive.txtYearName, PupilArchive.txtYearCode, PupilArchive.txtForm, 
		TblPupilManagementPupils.txtGender, TblPupilManagementPupils.txtEthnicGroup,
		CASE WHEN TblSENManagerRegister.intSENRegister = 1 THEN 'Yes' ELSE 'No' END AS txtSen,
		RegistrationTeacher.Initials AS txtRegistrationTeacherSchoolInitials, 
		RegistrationTeacher.Fullname AS txtRegistrationTeacherFullname,
		RegistrationTeacher.Salutation AS txtRegistrationTeacherSchoolSalutation, 
		RegistrationSubmitBy.Initials AS txtRegistrationSubmitBySchoolInitials, 
		RegistrationSubmitBy.Salutation AS txtRegistrationSubmitBySchoolSalutation
FROM	dbo.uf_Registration_AttendanceBetweenDates(@txtStartDate,@txtEndDate,@txtSchoolID) AS Attendance
CROSS APPLY dbo.uf_Registration_getPupilArchive(Attendance.txtSchoolID, @txtEndDate) AS PupilArchive
INNER JOIN TblPupilManagementPupils ON Attendance.txtSchoolID = TblPupilManagementPupils.txtSchoolID
LEFT OUTER JOIN TblStaff AS RegistrationTeacher ON Attendance.txtRegistrationTeacherCode = RegistrationTeacher.User_Code 
LEFT OUTER JOIN TblStaff AS RegistrationSubmitBy ON Attendance.txtRegistrationSubmitBy = RegistrationSubmitBy.User_Code
LEFT OUTER JOIN TblSENManagerRegister ON TblPupilManagementPupils.txtSchoolID = TblSENManagerRegister.txtSchoolID
LEFT OUTER JOIN AllNotRegistered ON Attendance.intRegistrationDateTimeID = ANRintRegistrationDateTimeID AND Attendance.txtRegistrationTeacherCode = ANRtxtRegistrationTeacherCode AND Attendance.txtRegistrationGroupName = ANRtxtRegistrationGroupName
WHERE (LEFT(CONVERT(varchar(8), Attendance.dtRegistrationDateTime, 108), 5) IN (SELECT ID FROM dbo.SplitCSV(@txtTime) AS SplitCSV_1) OR @txtTime IS NULL)
		AND (Attendance.txtRegistrationGroupName IN (SELECT ID FROM dbo.SplitCSV(@txtRegistrationGroup) AS SplitCSV_1) OR @txtRegistrationGroup IS NULL)
		AND (Attendance.txtRegistrationAMPM IN (SELECT ID FROM dbo.SplitCSV(@txtAmPm) AS SplitCSV_1) OR @txtAmPm IS NULL)
		--AND (Attendance.txtregistrationstatus IN (Select ID FROM dbo.SplitCSV--(@txtAttendanceCategory) AS SplitCSV_1) OR (@txtAttendanceCategory)  IS NULL)
		--AND txtRegistrationStatus = 'Not Registered'

OPTION (RECOMPILE)</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="ANRintRegistrationDateTimeID"><DataField>ANRintRegistrationDateTimeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intRegistrationDateTimeID"><DataField>intRegistrationDateTimeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="dtRegistrationDateTime"><DataField>dtRegistrationDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtRegistrationAMPM"><DataField>txtRegistrationAMPM</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationName"><DataField>txtRegistrationName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationPupilsID"><DataField>intRegistrationPupilsID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegisterID"><DataField>intRegisterID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherCode"><DataField>txtRegistrationTeacherCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationGroupID"><DataField>intRegistrationGroupID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationGroupType"><DataField>txtRegistrationGroupType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationGroupSubjectID"><DataField>intRegistrationGroupSubjectID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationSubmitBy"><DataField>txtRegistrationSubmitBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationReason"><DataField>txtRegistrationReason</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intIsLate"><DataField>intIsLate</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtRegistrationStatisticalStatus"><DataField>txtRegistrationStatisticalStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intMinutesLate"><DataField>intMinutesLate</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtCode"><DataField>txtCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationStatus"><DataField>txtRegistrationStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCodeName"><DataField>txtCodeName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intIsIncludedInStatistics"><DataField>intIsIncludedInStatistics</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intIsAuthorisedAbsence"><DataField>intIsAuthorisedAbsence</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="intCodeOrder"><DataField>intCodeOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolInitials"><DataField>txtRegistrationTeacherSchoolInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolSalutation"><DataField>txtRegistrationTeacherSchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySchoolInitials"><DataField>txtRegistrationSubmitBySchoolInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySchoolSalutation"><DataField>txtRegistrationSubmitBySchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEthnicGroup"><DataField>txtEthnicGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherFullname"><DataField>txtRegistrationTeacherFullname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSen"><DataField>txtSen</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationGroupName"><DataField>txtRegistrationGroupName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intCodeID"><DataField>intCodeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationGroup"><Value>=Fields!txtRegistrationGroupName.Value</Value></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS 'txtSchoolLogoPath', 
		TblReportsCustomImages.txtName
FROM	TblReportsCustomImages
WHERE	TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS 'txtiSAMSAddress'
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix2"><TablixBody><TablixColumns><TablixColumn><Width>11.3cm</Width></TablixColumn><TablixColumn><Width>8.7cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>1.57938cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="textbox158"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Missing Registration Report</Value><Style><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>3pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>=Format(CDate(Parameters!txtStartDate.value),"dd/MM/yyyy")  + " - " + Format(CDate(Parameters!txtEndDate.Value),"dd/MM/yyyy") 
+ IIF(isnothing(Parameters!txtTime.Value),"","   Times: " + Parameters!txtTime.Value)</Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>=IIF(isNothing(Parameters!intNCYear.Value),"","Years: " &amp; Parameters!intNCYear.Value &amp; "     ") 
&amp; IIF(isNothing(Parameters!txtAcademicHouse.Value),"","Academic Houses: " &amp; Parameters!txtAcademicHouse.Value &amp; "     ") 
&amp; IIF(isNothing(Parameters!txtBoardingHouse.Value),"","Boarding Houses: " &amp; Parameters!txtBoardingHouse.Value &amp; "     ") 
&amp; IIF(isNothing(Parameters!txtForm.Value),"","Forms: " &amp; Parameters!txtForm.Value &amp; "     ")
&amp; IIF(isNothing(Parameters!txtRegistrationGroup.Value),"","Reg. Groups: " &amp; Parameters!txtRegistrationGroup.Value &amp; "     ")</Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>None</Style><Width>2pt</Width></Border><VerticalAlign>Top</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Rectangle Name="Rectangle2"><ReportItems><Tablix Name="Tablix3"><TablixBody><TablixColumns><TablixColumn><Width>0.7cm</Width></TablixColumn><TablixColumn><Width>3.4cm</Width></TablixColumn><TablixColumn><Width>0.7cm</Width></TablixColumn><TablixColumn><Width>3.9cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox13"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox13</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>Gainsboro</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox15"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>No data for period</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox15</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox19"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox19</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#fad182</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox21"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Some Pupils Not Registered</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox21</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox14"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox14</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#cbe3ba</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox16"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>All Pupils registered</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox16</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox20"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox20</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#e98e93</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox22"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>All Pupils Not Registered</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox22</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox23"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Number of Not Registered Pupils / Total Number of Pupils</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox23</rd:DefaultName><Style><Border><Style>None</Style></Border><BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>4</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell /></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixRowHierarchy><Height>1.5cm</Height><Width>8.7cm</Width><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><KeepTogether>true</KeepTogether><Style><Border><Style>None</Style></Border></Style></Rectangle></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.22627cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle3"><ReportItems><Image Name="Image1"><Source>Embedded</Source><Value>iSAMSLine</Value><Sizing>FitProportional</Sizing><Top>0.1cm</Top><Height>0.12627cm</Height><Width>20cm</Width><Style><Border><Style>None</Style></Border></Style></Image></ReportItems><KeepTogether>true</KeepTogether><Style><Border><Style>None</Style></Border></Style></Rectangle><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow><TablixRow><Height>3.7cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle1"><ReportItems><Tablix Name="Tablix1"><Ta