eWidth>21cm</PageWidth><InteractiveHeight>29.6cm</InteractiveHeight><LeftMargin>0.5cm</LeftMargin><RightMargin>0.5cm</RightMargin><TopMargin>0.5cm</TopMargin><BottomMargin>0.5cm</BottomMargin><ColumnSpacing>1cm</ColumnSpacing><Style /></Page></ReportSection></ReportSections><ReportParameters><ReportParameter Name="txtForm"><DataType>String</DataType><Nullable>true</Nullable><Prompt>txtForm</Prompt></ReportParameter><ReportParameter Name="txtStartDate"><DataType>DateTime</DataType><Prompt>txtStartDate</Prompt></ReportParameter><ReportParameter Name="txtEndDate"><DataType>DateTime</DataType><Prompt>txtEndDate</Prompt></ReportParameter><ReportParameter Name="txtTime"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtTime</Prompt></ReportParameter><ReportParameter Name="txtSchoolID"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtSchoolID</Prompt></ReportParameter><ReportParameter Name="txtAmPm"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtAmPm</Prompt></ReportParameter><ReportParameter Name="txtRegistrationGroup"><DataType>String</DataType><Nullable>true</Nullable><DefaultValue><Values><Value xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtRegistrationGroup</Prompt></ReportParameter><ReportParameter Name="intNCYear"><DataType>String</DataType><Nullable>true</Nullable><Prompt>intNCYear</Prompt></ReportParameter><ReportParameter Name="txtAcademicHouse"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>txtAcademicHouse</Prompt></ReportParameter><ReportParameter Name="txtBoardingHouse"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>txtBoardingHouse</Prompt></ReportParameter></ReportParameters><Code>Public FirstFive AS String = "@ - Absent (no code)" + vbnewline
Public SecondFive AS String = ""
Public ThirdFive AS String = ""
Public TourthFive AS String = ""
Public FifthFive AS String = ""
Public SixthFive AS String = ""
Public RecordCount AS Integer = 0
Public PresentCodes AS String = "/ - Present (am - no code)" + vbnewline + "\ - Present (pm - no code)" + vbnewline

Public Function getCodeDescriptions (ByVal singleCode As String, ByVal singleDescription As String)
if RecordCount &lt;4 then
	FirstFive = FirstFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;3 and  RecordCount &lt;8 then
	SecondFive = SecondFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;7 and  RecordCount &lt;13 then
	ThirdFive = ThirdFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;12 and  RecordCount &lt;18 then
	TourthFive = TourthFive + singleCode + " - " + singleDescription + vbnewline	

end if  
if RecordCount &gt;17 and  RecordCount &lt;23 then
	FifthFive = FifthFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;22 and  RecordCount &lt;31 then
	SixthFive = SixthFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
RecordCount = RecordCount + 1
End Function

Public Function getPresentCode (ByVal singlePCode As String, ByVal singlePDescription As String)
	
PresentCodes = PresentCodes + singlePCode +" - " + singlePDescription + vbnewline
 
End Function</Code><EmbeddedImages><EmbeddedImage Name="iSAMSLine"><MIMEType>image/png</MIMEType><ImageData></ImageData></EmbeddedImage></EmbeddedImages><Language>en-GB</Language><ConsumeContainerWhitespace>true</ConsumeContainerWhitespace><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>36d3aa52-5785-466c-9dda-a872ad57105f</rd:ReportID></Report>