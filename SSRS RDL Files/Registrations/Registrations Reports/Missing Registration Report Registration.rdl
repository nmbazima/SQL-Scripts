<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>772c9ca1-961d-4a29-94df-9e6b84f683fc</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Attendance"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter><QueryParameter Name="@txtStartDate"><Value>=Parameters!txtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtForm"><Value>=Parameters!txtForm.Value</Value></QueryParameter><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter><QueryParameter Name="@txtAcademicHouse"><Value>=Parameters!txtAcademicHouse.Value</Value></QueryParameter><QueryParameter Name="@txtBoardingHouse"><Value>=Parameters!txtBoardingHouse.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@txtCustomGroups"><Value>=Parameters!txtCustomGroups.Value</Value></QueryParameter><QueryParameter Name="@txtTime"><Value>=Parameters!txtTime.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationGroup"><Value>=Parameters!txtRegistrationGroup.Value</Value></QueryParameter><QueryParameter Name="@txtAmPm"><Value>=Parameters!txtAmPm.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @PupilID AS nvarchar(max);
SET @PupilID = 	STUFF((	
 

SELECT DISTINCT ',' + TblRegistrationSchoolRegistrationPupils.txtSchoolID
FROM TblRegistrationSchoolRegistrationPupilsGroups
INNER JOIN TblPupilManagementPupils ON TblRegistrationSchoolRegistrationPupilsGroups.txtSchoolId = TblPupilManagementPupils.txtSchoolID
INNER JOIN TblRegistrationSchoolRegistrationPupils ON TblRegistrationSchoolRegistrationPupilsGroups.txtSchoolId = TblRegistrationSchoolRegistrationPupils.txtSchoolID
AND TblRegistrationSchoolRegistrationPupilsGroups.intRegister = TblRegistrationSchoolRegistrationPupils.intRegister
INNER JOIN TblRegistrationSchoolRegistrationRegister ON TblRegistrationSchoolRegistrationPupils.intRegister = TblRegistrationSchoolRegistrationRegister.TblRegistrationSchoolRegistrationRegisterID
INNER JOIN TblRegistrationSchoolRegistrationDateTime ON TblRegistrationSchoolRegistrationRegister.intRegistrationDateTime = TblRegistrationSchoolRegistrationDateTime.TblRegistrationSchoolRegistrationDateTimeID
CROSS APPLY dbo.uf_Registration_getPupilArchive(TblRegistrationSchoolRegistrationPupils.txtSchoolID, DateAdd(day,1,@txtEndDate)) AS PupilArchive
WHERE TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @txtStartDate AND DATEADD(day, 1, @txtEndDate)

AND (PupilArchive.txtForm IN (SELECT ID FROM dbo.SplitCSV(@txtForm) AS SplitCSV_1) OR @txtForm IS NULL)
AND (PupilArchive.intNCYear IN (SELECT ID FROM dbo.SplitCSV(@intNCYear) AS SplitCSV_1) OR @intNCYear IS NULL)
AND (PupilArchive.txtAcademicHouse IN (SELECT ID FROM dbo.SplitCSV(@txtAcademicHouse) AS SplitCSV_1) OR @txtAcademicHouse IS NULL)
AND (PupilArchive.txtBoardingHouse IN (SELECT ID FROM dbo.SplitCSV(@txtBoardingHouse) AS SplitCSV_1) OR @txtBoardingHouse IS NULL)
AND (PupilArchive.txtSchoolID IN (SELECT ID FROM dbo.SplitCSV(@txtSchoolID) AS SplitCSV_1) OR @txtSchoolID IS NULL)
AND (PupilArchive.txtSchoolID IN (SELECT DISTINCT txtSchoolID FROM TblPupilManagementSelectionsStudents WHERE (ISNULL(intDeleted, 0) &lt;&gt; 1) AND (intSelectionID IN (SELECT ID FROM dbo.SplitCSV(@txtCustomGroups) AS SplitCSV_1))) OR @txtCustomGroups IS NULL)
FOR XML PATH('')), 1, 1, '');




SELECT Attendance.*,
PupilArchive.txtForename, PupilArchive.txtPreName, PupilArchive.txtMiddleNames, PupilArchive.txtSurname, PupilArchive.txtAcademicHouse, 
PupilArchive.txtBoardingHouse, PupilArchive.intNCYear, PupilArchive.txtYearName, PupilArchive.txtYearCode, PupilArchive.txtForm, 
RegistrationTeacher.Initials AS txtRegistrationTeacherSchoolInitials, RegistrationTeacher.Salutation AS txtRegistrationTeacherSchoolSalutation, 
RegistrationTeacher.Title AS txtRegistrationTeacherTitle, RegistrationTeacher.Firstname AS txtRegistrationTeacherFirstname, RegistrationTeacher.Surname AS txtRegistrationTeacherSurname,
RegistrationSubmitBy.Initials AS txtRegistrationSubmitBySchoolInitials, RegistrationSubmitBy.Salutation AS txtRegistrationSubmitBySchoolSalutation,
RegistrationSubmitBy.Title AS txtRegistrationSubmitByTitle, RegistrationSubmitBy.Firstname AS txtRegistrationSubmitByFirstname, RegistrationSubmitBy.Surname AS txtRegistrationSubmitBySurname,
TimetableTeacher.Initials AS txtTimetableTeacherSchoolInitials, TimetableTeacher.Salutation AS txtTimetableTeacherSchoolSalutation, 
TimetableTeacher.Title AS txtTimetableTeacherTitle, TimetableTeacher.Firstname AS txtTimetableTeacherFirstname, TimetableTeacher.Surname AS txtTimetableTeacherSurname,
TimetableTeacher.SchoolEmailAddress AS txtTimetableTeacherEmail, RegistrationTeacher.SchoolEmailAddress AS txtRegistrationTeacherEmail, RegistrationSubmitBy.SchoolEmailAddress AS txtRegistrationSubmitByEmail,
CoverTeacher.Initials AS txtCoverTeacherSchoolInitials, CoverTeacher.Salutation AS txtCoverTeacherSchoolSalutation, CoverTeacher.SchoolEmailAddress AS txtCoverTeacherEmail,
TblSchoolManagementClassrooms.txtName AS txtClassRoomName
FROM dbo.uf_Registration_AttendanceBetweenDates(@txtStartDate, DATEADD(dd,1,@txtEndDate),@PupilID) AS Attendance
CROSS APPLY dbo.uf_Registration_getPupilArchive(Attendance.txtSchoolID,  DATEADD(dd,1,@txtEndDate)) AS PupilArchive 
LEFT OUTER JOIN TblStaff AS RegistrationTeacher ON Attendance.txtRegistrationTeacherCode = RegistrationTeacher.User_Code 
LEFT OUTER JOIN TblStaff AS RegistrationSubmitBy ON Attendance.txtRegistrationSubmitBy = RegistrationSubmitBy.User_Code
LEFT OUTER JOIN TblTimetableManagerDays ON Datepart(weekday,dtRegistrationDateTime) = TblTimetableManagerDays.intDay
LEFT OUTER JOIN TblTimetableManagerPeriods ON (TblTimetableManagerPeriods.txtstarttime = LEFT(CONVERT(varchar(8), Attendance.dtRegistrationDateTime, 108), 5) or '0' + TblTimetableManagerPeriods.txtstarttime = LEFT(CONVERT(varchar(8), Attendance.dtRegistrationDateTime, 108), 5)) and TblTimetableManagerDaysID = TblTimetableManagerPeriods.intDay
LEFT OUTER JOIN TblTimetableManagerSchedule ON TblTimetableManagerPeriods.TblTimetableManagerPeriodsID = TblTimetableManagerSchedule.intPeriod and Attendance.txtRegistrationGroupName = TblTimetableManagerSchedule.txtCode and TblTimetableManagerSchedule.intTimetableID = (select TblTimetableManagerTimetablesID from TblTimetableManagerTimetables where intpublished =1)
LEFT OUTER JOIN TblStaff AS TimetableTeacher ON TblTimetableManagerSchedule.txtTeacher = TimetableTeacher.User_Code 
LEFT OUTER JOIN TblSchoolManagementClassrooms ON TblTimetableManagerSchedule.intRoom = TblSchoolManagementClassroomsID
LEFT OUTER JOIN TblCoverManagerCover AS Cover ON Cover.TblTimetableManagerScheduleID = TblTimetableManagerSchedule.TblTimetableManagerScheduleID AND dtRegistrationDateTime = Cover.dteDate
LEFT OUTER JOIN TblStaff AS CoverTeacher ON Cover.txtCoverTeacher = CoverTeacher.User_Code
WHERE  (LEFT(CONVERT(varchar(8), Attendance.dtRegistrationDateTime, 108), 5) IN (SELECT ID FROM dbo.SplitCSV(@txtTime) AS SplitCSV_1) OR @txtTime IS NULL)
AND (Attendance.txtRegistrationGroupName IN (SELECT ID FROM dbo.SplitCSV(@txtRegistrationGroup) AS SplitCSV_1) OR @txtRegistrationGroup IS NULL)
AND (Attendance.txtRegistrationAMPM IN (SELECT ID FROM dbo.SplitCSV(@txtAmPm) AS SplitCSV_1) OR @txtAmPm IS NULL)


OPTION (RECOMPILE)</CommandText></Query><Fields><Field Name="txtRegistrationGroup"><Value>=Fields!txtRegistrationGroupName.Value</Value></Field><Field Name="intRegistrationDateTimeID"><DataField>intRegistrationDateTimeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="dtRegistrationDateTime"><DataField>dtRegistrationDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtRegistrationAMPM"><DataField>txtRegistrationAMPM</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationName"><DataField>txtRegistrationName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationPupilsID"><DataField>intRegistrationPupilsID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intRegisterID"><DataField>intRegisterID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherCode"><DataField>txtRegistrationTeacherCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationGroupID"><DataField>intRegistrationGroupID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationGroupType"><DataField>txtRegistrationGroupType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationGroupName"><DataField>txtRegistrationGroupName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationGroupSubjectID"><DataField>intRegistrationGroupSubjectID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationSubmitBy"><DataField>txtRegistrationSubmitBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationReason"><DataField>txtRegistrationReason</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intIsLate"><DataField>intIsLate</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="intMinutesLate"><DataField>intMinutesLate</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationStatus"><DataField>txtRegistrationStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationStatisticalStatus"><DataField>txtRegistrationStatisticalStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intCodeID"><DataField>intCodeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtCode"><DataField>txtCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intCodeOrder"><DataField>intCodeOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtCodeName"><DataField>txtCodeName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intIsIncludedInStatistics"><DataField>intIsIncludedInStatistics</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intIsAuthorisedAbsence"><DataField>intIsAuthorisedAbsence</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolInitials"><DataField>txtRegistrationTeacherSchoolInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherTitle"><DataField>txtRegistrationTeacherTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolSalutation"><DataField>txtRegistrationTeacherSchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherFirstname"><DataField>txtRegistrationTeacherFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySchoolInitials"><DataField>txtRegistrationSubmitBySchoolInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSurname"><DataField>txtRegistrationTeacherSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySchoolSalutation"><DataField>txtRegistrationSubmitBySchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTimetableTeacherSchoolInitials"><DataField>txtTimetableTeacherSchoolInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTimetableTeacherSchoolSalutation"><DataField>txtTimetableTeacherSchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitByTitle"><DataField>txtRegistrationSubmitByTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitByFirstname"><DataField>txtRegistrationSubmitByFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySurname"><DataField>txtRegistrationSubmitBySurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTimetableTeacherTitle"><DataField>txtTimetableTeacherTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTimetableTeacherFirstname"><DataField>txtTimetableTeacherFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTimetableTeacherSurname"><DataField>txtTimetableTeacherSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTimetableTeacherEmail"><DataField>txtTimetableTeacherEmail</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherEmail"><DataField>txtRegistrationTeacherEmail</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitByEmail"><DataField>txtRegistrationSubmitByEmail</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCoverTeacherSchoolInitials"><DataField>txtCoverTeacherSchoolInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCoverTeacherSchoolSalutation"><DataField>txtCoverTeacherSchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtClassRoomName"><DataField>txtClassRoomName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCoverTeacherEmail"><DataField>txtCoverTeacherEmail</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS 'txtiSAMSAddress'
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SelectedPupils"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter><QueryParameter Name="@txtForm"><Value>=Parameters!txtForm.Value</Value></QueryParameter><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter><QueryParameter Name="@txtAcademicHouse"><Value>=Parameters!txtAcademicHouse.Value</Value></QueryParameter><QueryParameter Name="@txtBoardingHouse"><Value>=Parameters!txtBoardingHouse.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@txtCustomGroups"><Value>=Parameters!txtCustomGroups.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT DISTINCT TblPupilManagementPupils.txtSchoolID
FROM TblPupilManagementPupils
CROSS APPLY dbo.uf_Registration_getPupilArchive(TblPupilManagementPupils.txtSchoolID, @txtEndDate) AS PupilArchive
WHERE  (PupilArchive.txtForm IN (SELECT ID FROM dbo.SplitCSV(@txtForm) AS SplitCSV_1) OR @txtForm IS NULL)
AND (PupilArchive.intNCYear IN (SELECT ID FROM dbo.SplitCSV(@intNCYear) AS SplitCSV_1) OR @intNCYear IS NULL)
AND (PupilArchive.txtAcademicHouse IN (SELECT ID FROM dbo.SplitCSV(@txtAcademicHouse) AS SplitCSV_1) OR @txtAcademicHouse IS NULL)
AND (PupilArchive.txtBoardingHouse IN (SELECT ID FROM dbo.SplitCSV(@txtBoardingHouse) AS SplitCSV_1) OR @txtBoardingHouse IS NULL)
AND (PupilArchive.txtSchoolID IN (SELECT ID FROM dbo.SplitCSV(@txtSchoolID) AS SplitCSV_1) OR @txtSchoolID IS NULL)
AND (PupilArchive.txtSchoolID IN (SELECT DISTINCT txtSchoolID FROM TblPupilManagementSelectionsStudents WHERE (ISNULL(intDeleted, 0) &lt;&gt; 1) AND (intSelectionID IN (SELECT ID FROM dbo.SplitCSV(@txtCustomGroups) AS SplitCSV_1))) OR @txtCustomGroups IS NULL)</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS 'txtSchoolLogoPath', 
		TblReportsCustomImages.txtName
FROM	TblReportsCustomImages
WHERE	TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix2"><TablixBody><TablixColumns><TablixColumn><Width>20cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>1.8cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle2"><ReportItems><Tablix Name="table2"><TablixBody><TablixColumns><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox42"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!dtRegistrationDateTime.Value</Value><Style><FontFamily>arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox42</rd:DefaultName><Style><Border><Style>None</Style></Border><TopBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></TopBorder><BottomBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell><CellContents><Textbox Name="Textbox43"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Not Yet Registered</Value><Style><FontFamily>arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox43</rd:DefaultName><Style><Border><Style>None</Style></Border><TopBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></TopBorder><BottomBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Total Pupil Count</Value><Style><FontFamily>arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Style>None</Style></Border><TopBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></TopBorder><BottomBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox44"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Teachers Email</Value><Style><FontFamily>arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox44</rd:DefaultName><Style><Border><Style>None</Style></Border><TopBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></TopBorder><BottomBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox45"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Location</Value><Style><FontFamily>arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox45</rd:DefaultName><Style><Border><Style>None</Style></Border><TopBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></TopBorder><BottomBorder><Color>Black</Color><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox29"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(Fields!txtRegistrationGroup.Value &gt;"",Fields!txtRegistrationGroup.Value,"Unknown Group")</Value><Style><FontFamily>arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun><TextRun><Value xml:space="preserve">  </Value><Style><FontFamily>arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox29</rd:DefaultName><Style><Border><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(Fields!txtTimetableTeacherSchoolInitials.Value &gt; "",Fields!txtTimetableTeacherTitle.Value + " " + Left(Fields!txtTimetableTeacherFirstname.Value,1) + " " + Fields!txtTimetableTeacherSurname.Value, Fields!txtRegistrationTeacherTitle.Value + " " + Left(Fields!txtRegistrationTeacherFirstname.Value,1) + " " + Fields!txtRegistrationTeacherSurname.Value)</Value><Style><FontFamily>arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox2</rd:DefaultName><Style><Border><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox30"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=COUNTDISTINCT(IIF(Fields!txtRegistrationStatus.Value = "Not Registered", Fields!txtSchoolID.Value, nothing))</Value><Style><FontFamily>arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox30</rd:DefaultName><Style><Border><Style>None</Style></Border><PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=COUNTDISTINCT(IIF(Fields!intIsIncludedInStatistics.Value=1, Fields!txtSchoolID.Value,nothing))</Value><Style><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox3</rd:DefaultName><Style><Border><Style>None<