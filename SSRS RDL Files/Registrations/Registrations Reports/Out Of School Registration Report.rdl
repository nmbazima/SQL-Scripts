SWITCH(
Parameters!txtGroupBy.Value = "txtDateTime", "Year",
Parameters!txtGroupBy.Value = "txtSurname", "Pupil",
Parameters!txtGroupBy.Value = "intNCYear", "Year",
Parameters!txtGroupBy.Value = "txtForm", "Form",
Parameters!txtGroupBy.Value = "txtEthnicGroup", "Ethnicity", 
Parameters!txtGroupBy.Value = "txtAcademicHouse", "Academic House",
Parameters!txtGroupBy.Value = "txtBoardingHouse", "Boarding House",
Parameters!txtGroupBy.Value = "txtPresentCode", "Year",
Parameters!txtGroupBy.Value = "txtCode", "Year",
