<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>772c9ca1-961d-4a29-94df-9e6b84f683fc</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Attendance"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter><QueryParameter Name="@txtStartDate"><Value>=Parameters!txtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@txtTime"><Value>=Parameters!txtTime.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationGroup"><Value>=Parameters!txtRegistrationGroup.Value</Value></QueryParameter><QueryParameter Name="@txtAmPm"><Value>=Parameters!txtAmPm.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	Attendance.*, 
		HomeAddress.*,
		PupilArchive.txtForename, 
		PupilArchive.txtPreName, 
		PupilArchive.txtMiddleNames, 
		PupilArchive.txtSurname, 
		PupilArchive.txtAcademicHouse, 
		PupilArchive.txtBoardingHouse, 
		PupilArchive.intNCYear, 
		PupilArchive.txtYearName, 
		PupilArchive.txtYearCode, 
		PupilArchive.txtForm, 
		TblPupilManagementPupils.txtGender, 
		TblPupilManagementPupils.txtEthnicGroup,
		CASE WHEN TblSENManagerRegister.intSENRegister = 1 THEN 'Yes' ELSE 'No' END AS 'txtSen',
		RegistrationTeacher.Initials AS 'txtRegistrationTeacherSchoolInitials', 
		RegistrationTeacher.Salutation AS 'txtRegistrationTeacherSchoolSalutation', 
		RegistrationSubmitBy.Initials AS 'txtRegistrationSubmitBySchoolInitials', 
		RegistrationSubmitBy.Salutation AS 'txtRegistrationSubmitBySchoolSalutation',
		TblPupilManagementPupils.txtDOB AS 'dtDOB', 
		TblPupilManagementPupils.txtType AS 'txtPupilType', 
		TblRegistrationSchoolRegistrationCodes.txtColour
FROM	dbo.uf_Registration_AttendanceBetweenDates(@txtStartDate, @txtEndDate, @txtSchoolID) AS Attendance
CROSS APPLY dbo.uf_Registration_getPupilArchive(Attendance.txtSchoolID, @txtEndDate) AS PupilArchive 
INNER JOIN TblPupilManagementPupils ON Attendance.txtSchoolID = TblPupilManagementPupils.txtSchoolID
LEFT OUTER JOIN TblStaff AS RegistrationTeacher ON Attendance.txtRegistrationTeacherCode = RegistrationTeacher.User_Code 
LEFT OUTER JOIN TblStaff AS RegistrationSubmitBy ON Attendance.txtRegistrationSubmitBy = RegistrationSubmitBy.User_Code
LEFT OUTER JOIN TblRegistrationSchoolRegistrationCodes ON Attendance.txtCode = TblRegistrationSchoolRegistrationCodes.txtCode
OUTER APPLY (SELECT	TblPupilManagementAddresses.txtAddress1, TblPupilManagementAddresses.TblPupilManagementAddressesID,
					TblPupilManagementAddresses.txtAddress2, TblPupilManagementAddresses.txtAddress3, TblPupilManagementAddresses.txtTown,
					TblPupilManagementAddresses.txtCounty, TblPupilManagementAddresses.txtPostcode, TblPupilManagementAddresses.txtCountry, 
					TblPupilManagementAddresses.txtDayTelephone, TblPupilManagementAddresses.txtRelationType, TblPupilManagementAddresses.txtLabelSalutation					
			 FROM	TblPupilManagementAddresses 
			 INNER JOIN TblPupilManagementAddressLink ON TblPupilManagementAddresses.TblPupilManagementAddressesID = TblPupilManagementAddressLink.intAddressID
			 WHERE	(TblPupilManagementAddresses.intStudentHome = 1) 
					AND TblPupilManagementAddressLink.txtSchoolID = Attendance.txtSchoolID) AS HomeAddress
LEFT OUTER JOIN TblSENManagerRegister ON TblPupilManagementPupils.txtSchoolID = TblSENManagerRegister.txtSchoolID
WHERE	(LEFT(CONVERT(VARCHAR(8), Attendance.dtRegistrationDateTime, 108), 5) IN (SELECT ID FROM dbo.SplitCSV(@txtTime) AS SplitCSV_1) OR @txtTime IS NULL)
		AND (Attendance.txtRegistrationGroupName IN (SELECT ID FROM dbo.SplitCSV(@txtRegistrationGroup) AS SplitCSV_1) OR @txtRegistrationGroup IS NULL)
		AND (Attendance.txtRegistrationAMPM IN (SELECT ID FROM dbo.SplitCSV(@txtAmPm) AS SplitCSV_1) OR @txtAmPm IS NULL)

OPTION (RECOMPILE)</CommandText></Query><Fields><Field Name="txtRegistrationGroup"><Value>=Fields!txtRegistrationGroupName.Value</Value></Field><Field Name="intRegistrationDateTimeID"><DataField>intRegistrationDateTimeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="dtRegistrationDateTime"><DataField>dtRegistrationDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtRegistrationAMPM"><DataField>txtRegistrationAMPM</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationName"><DataField>txtRegistrationName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationPupilsID"><DataField>intRegistrationPupilsID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intRegisterID"><DataField>intRegisterID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherCode"><DataField>txtRegistrationTeacherCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationGroupID"><DataField>intRegistrationGroupID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationGroupType"><DataField>txtRegistrationGroupType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationGroupName"><DataField>txtRegistrationGroupName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationGroupSubjectID"><DataField>intRegistrationGroupSubjectID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationSubmitBy"><DataField>txtRegistrationSubmitBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationReason"><DataField>txtRegistrationReason</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intIsLate"><DataField>intIsLate</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="intMinutesLate"><DataField>intMinutesLate</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationStatus"><DataField>txtRegistrationStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationStatisticalStatus"><DataField>txtRegistrationStatisticalStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intCodeID"><DataField>intCodeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtCode"><DataField>txtCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intCodeOrder"><DataField>intCodeOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtCodeName"><DataField>txtCodeName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intIsIncludedInStatistics"><DataField>intIsIncludedInStatistics</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intIsAuthorisedAbsence"><DataField>intIsAuthorisedAbsence</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtAddress1"><DataField>txtAddress1</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblPupilManagementAddressesID"><DataField>TblPupilManagementAddressesID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtAddress2"><DataField>txtAddress2</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress3"><DataField>txtAddress3</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCounty"><DataField>txtCounty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPostcode"><DataField>txtPostcode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCountry"><DataField>txtCountry</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDayTelephone"><DataField>txtDayTelephone</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRelationType"><DataField>txtRelationType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLabelSalutation"><DataField>txtLabelSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTown"><DataField>txtTown</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEthnicGroup"><DataField>txtEthnicGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolInitials"><DataField>txtRegistrationTeacherSchoolInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSen"><DataField>txtSen</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolSalutation"><DataField>txtRegistrationTeacherSchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySchoolInitials"><DataField>txtRegistrationSubmitBySchoolInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySchoolSalutation"><DataField>txtRegistrationSubmitBySchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtDOB"><DataField>dtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtPupilType"><DataField>txtPupilType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtColour"><DataField>txtColour</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS 'txtiSAMSAddress'
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS 'txtSchoolLogoPath', 
		TblReportsCustomImages.txtName
FROM	TblReportsCustomImages
WHERE	TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Disclaimer"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Path"><Value>=Globals!ReportFolder</Value></QueryParameter><QueryParameter Name="@Report"><Value>=Globals!ReportName</Value></QueryParameter></QueryParameters><CommandText>SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
FROM	TblSQLReportingServicesDisclaimerReport
		INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report</CommandText></Query><Fields><Field Name="txtDisclaimerBackgroundColour"><DataField>txtDisclaimerBackgroundColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerBorderColour"><DataField>txtDisclaimerBorderColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerDescription"><DataField>txtDisclaimerDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTextColour"><DataField>txtDisclaimerTextColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTitle"><DataField>txtDisclaimerTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SEN"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT SchoolId AS txtSchoolId, 
       OnRegister
FROM f_PupilRegisters_GetSenRegisterStudents();</CommandText></Query><Fields><Field Name="txtSchoolId"><DataField>txtSchoolId</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="OnRegister"><DataField>OnRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="list1"><TablixBody><TablixColumns><TablixColumn><Width>28.7cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.9cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle7"><ReportItems><Textbox Name="Disclaimer2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!txtDisclaimerTitle.Value, "Disclaimer")</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun><TextRun><Value>:</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun><TextRun><Value>=First(Fields!txtDisclaimerDescription.Value, "Disclaimer")</Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Height>0.6cm</Height><Width>28.7cm</Width><Style><Border><Color>=First(Fields!txtDisclaimerBorderColour.Value, "Disclaimer")</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>=First(Fields!txtDisclaimerBackgroundColour.Value, "Disclaimer")</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></ReportItems><KeepTogether>true</KeepTogether><Style><Border><Style>None</Style></Border></Style></Rectangle></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>2.7cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="rectangle3"><ReportItems><Tablix Name="Tablix9"><TablixBody><TablixColumns><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>5.3cm</Width></TablixColumn><TablixColumn><Width>0.5cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>5.2cm</Width></TablixColumn><TablixColumn><Width>0.5cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>5.2cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="txtForename3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Name:</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>txtForename</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BottomBorder><Style>None</Style></BottomBorder><RightBorder><Style>None</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="txtForename4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=UCASE(Fields!txtSurname.Value) &amp; ", " &amp; Fields!txtForename.Value &amp; IIF(Fields!txtPreName.Value = "" Or Fields!txtPreName.Value = " " Or Fields!txtForename.Value = Fields!txtPreName.Value, "", " (" &amp; Fields!txtPreName.Value &amp; ")")</Value><Style><FontSize>9pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtForename</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BottomBorder><Style>None</Style></BottomBorder><LeftBorder><Style>None</Style></LeftBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>7</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox74"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Address:</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox71</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><TopBorder><Style>None</Style></TopBorder><RightBorder><Style>None</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox75"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtLabelSalutation.Value</Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value>=Fields!txtAddress1.Value &amp; IIF(ISNOTHING(Fields!txtAddress2.Value) Or Fields!txtAddress2.Value = "", "", " " &amp; Fields!txtAddress2.Value) &amp; IIF(ISNOTHING(Fields!txtAddress3.Value) Or Fields!txtAddress3.Value = "", "", " " &amp; Fields!txtAddress3.Value) &amp; IIF(ISNOTHING(Fields!txtTown.Value) Or Fields!txtTown.Value = "", "", " " &amp; Fields!txtTown.Value) &amp; IIF(ISNOTHING(Fields!txtCounty.Value) Or Fields!txtCounty.Value = "", "", " " &amp; Fields!txtCounty.Value) &amp; IIF(ISNOTHING(Fields!txtPostcode.Value) Or Fields!txtPostcode.Value = "", "", " " &amp; Fields!txtPostcode.Value) &amp; IIF(ISNOTHING(Fields!txtCountry.Value) Or Fields!txtCountry.Value = "", "", " " &amp; Fields!txtCountry.Value)</Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value>=IIF(ISNOTHING(Fields!txtDayTelephone.Value) Or Fields!txtDayTelephone.Value = "", "", "   Phone: ")</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value>=IIF(ISNOTHING(Fields!txtDayTelephone.Value) Or Fields!txtDayTelephone.Value = "", "", " " &amp; Fields!txtDayTelephone.Value)</Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox71</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><TopBorder><Style>None</Style></TopBorder><LeftBorder><Style>None</Style></LeftBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>7</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.2cm</Height><TablixCells><TablixCell><CellContents><Tex