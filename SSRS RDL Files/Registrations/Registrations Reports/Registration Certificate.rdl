<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>772c9ca1-961d-4a29-94df-9e6b84f683fc</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Attendance"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtStartDate"><Value>=Parameters!txtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter><QueryParameter Name="@txtTime"><Value>=Parameters!txtTime.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationGroup"><Value>=Parameters!txtRegistrationGroup.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@txtAmPm"><Value>=Parameters!txtAmPm.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT Attendance.*, HomeAddress.*,
PupilArchive.txtForename, PupilArchive.txtPreName, PupilArchive.txtMiddleNames, PupilArchive.txtSurname, PupilArchive.txtAcademicHouse, 
PupilArchive.txtBoardingHouse, PupilArchive.intNCYear, PupilArchive.txtYearName, PupilArchive.txtYearCode, PupilArchive.txtForm, 
TblPupilManagementPupils.txtGender, TblPupilManagementPupils.txtEthnicGroup,
CASE WHEN TblSENManagerRegister.intSENRegister = 1 THEN 'Yes' ELSE 'No' END AS txtSen,
RegistrationTeacher.Initials AS txtRegistrationTeacherSchoolInitials, RegistrationTeacher.Salutation AS txtRegistrationTeacherSchoolSalutation, 
RegistrationSubmitBy.Initials AS txtRegistrationSubmitBySchoolInitials, RegistrationSubmitBy.Salutation AS txtRegistrationSubmitBySchoolSalutation,
TblPupilManagementPupils.txtDOB AS dtDOB, TransportType.txtTransportType, PupilArchive.Title AS txtTutorTitle, PupilArchive.Firstname AS txtTutorFirstname, 
PupilArchive.Surname AS txtTutorSurname, TblSanatoriumManagerSurgeries.txtTelephone AS txtSurgeryTelephone, TblSanatoriumManagerSurgeries.txtName aS txtSurgeryName
FROM dbo.uf_Registration_AttendanceBetweenDates(@txtStartDate,@txtEndDate,@txtSchoolID) AS Attendance
CROSS APPLY dbo.uf_Registration_getPupilArchive(Attendance.txtSchoolID, @txtEndDate) AS PupilArchive 
INNER JOIN TblPupilManagementPupils ON Attendance.txtSchoolID = TblPupilManagementPupils.txtSchoolID
LEFT OUTER JOIN TblStaff AS RegistrationTeacher ON Attendance.txtRegistrationTeacherCode = RegistrationTeacher.User_Code 
LEFT OUTER JOIN TblStaff AS RegistrationSubmitBy ON Attendance.txtRegistrationSubmitBy = RegistrationSubmitBy.User_Code
OUTER APPLY (
                         
SELECT  TblPupilManagementAddresses.txtAddress1, TblPupilManagementAddresses.TblPupilManagementAddressesID,
TblPupilManagementAddresses.txtAddress2, TblPupilManagementAddresses.txtAddress3, 
TblPupilManagementAddresses.txtCounty, TblPupilManagementAddresses.txtPostcode, TblPupilManagementAddresses.txtCountry, 
TblPupilManagementAddresses.txtDayTelephone, TblPupilManagementAddresses.txtRelationType, TblPupilManagementAddresses.txtLabelSalutation, 
TblPupilManagementAddresses.txtTown
FROM            TblPupilManagementAddresses 
INNER JOIN TblPupilManagementAddressLink ON TblPupilManagementAddresses.TblPupilManagementAddressesID = TblPupilManagementAddressLink.intAddressID

WHERE        (TblPupilManagementAddresses.intStudentHome = 1)
AND TblPupilManagementAddressLink.txtSchoolID = Attendance.txtSchoolID

) AS HomeAddress
LEFT OUTER JOIN TblSENManagerRegister ON TblPupilManagementPupils.txtSchoolID = TblSENManagerRegister.txtSchoolID

OUTER APPLY (SELECT TOP (1) TblUsefulLists.Name AS txtTransportType
FROM            TblUsefulLists 
INNER JOIN TblPupilManagementTransport ON TblPupilManagementTransport.txtSchoolID = TblPupilManagementTransport.txtSchoolID 
AND TblPupilManagementTransport.intTransportID = TblUsefulLists.TblUsefulListsID
WHERE        (TblUsefulLists.ListType = 'TransportOptions')) AS TransportType
                          
LEFT OUTER JOIN TblPupilManagementHealthDoctors ON Attendance.txtSchoolID = TblPupilManagementHealthDoctors.txtSchoolID
LEFT OUTER JOIN TblSanatoriumManagerSurgeriesDoctors ON TblPupilManagementHealthDoctors.intSurgeriesDoctor = TblSanatoriumManagerSurgeriesDoctors.TblSanatoriumManagerSurgeriesDoctorsID
LEFT OUTER JOIN TblSanatoriumManagerSurgeries ON TblSanatoriumManagerSurgeriesDoctors.intSurgery = TblSanatoriumManagerSurgeries.TblSanatoriumManagerSurgeriesID


WHERE  (LEFT(CONVERT(varchar(8), Attendance.dtRegistrationDateTime, 108), 5) IN (SELECT ID FROM dbo.SplitCSV(@txtTime) AS SplitCSV_1) OR @txtTime IS NULL)
AND (Attendance.txtRegistrationGroupName IN (SELECT ID FROM dbo.SplitCSV(@txtRegistrationGroup) AS SplitCSV_1) OR @txtRegistrationGroup IS NULL)
AND (Attendance.txtRegistrationAMPM IN (SELECT ID FROM dbo.SplitCSV(@txtAmPm) AS SplitCSV_1) OR @txtAmPm IS NULL)

OPTION (RECOMPILE)</CommandText></Query><Fields><Field Name="intRegistrationDateTimeID"><DataField>intRegistrationDateTimeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="dtRegistrationDateTime"><DataField>dtRegistrationDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtRegistrationAMPM"><DataField>txtRegistrationAMPM</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationName"><DataField>txtRegistrationName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationPupilsID"><DataField>intRegistrationPupilsID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegisterID"><DataField>intRegisterID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherCode"><DataField>txtRegistrationTeacherCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationGroupID"><DataField>intRegistrationGroupID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationGroupType"><DataField>txtRegistrationGroupType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationGroupSubjectID"><DataField>intRegistrationGroupSubjectID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationSubmitBy"><DataField>txtRegistrationSubmitBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationReason"><DataField>txtRegistrationReason</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intIsLate"><DataField>intIsLate</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="intMinutesLate"><DataField>intMinutesLate</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationStatisticalStatus"><DataField>txtRegistrationStatisticalStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCode"><DataField>txtCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationStatus"><DataField>txtRegistrationStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCodeName"><DataField>txtCodeName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intIsIncludedInStatistics"><DataField>intIsIncludedInStatistics</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intIsAuthorisedAbsence"><DataField>intIsAuthorisedAbsence</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="intCodeOrder"><DataField>intCodeOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtAddress1"><DataField>txtAddress1</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress2"><DataField>txtAddress2</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress3"><DataField>txtAddress3</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCounty"><DataField>txtCounty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtDOB"><DataField>dtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtPostcode"><DataField>txtPostcode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolInitials"><DataField>txtRegistrationTeacherSchoolInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCountry"><DataField>txtCountry</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolSalutation"><DataField>txtRegistrationTeacherSchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySchoolInitials"><DataField>txtRegistrationSubmitBySchoolInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDayTelephone"><DataField>txtDayTelephone</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRelationType"><DataField>txtRelationType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySchoolSalutation"><DataField>txtRegistrationSubmitBySchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblPupilManagementAddressesID"><DataField>TblPupilManagementAddressesID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLabelSalutation"><DataField>txtLabelSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTown"><DataField>txtTown</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEthnicGroup"><DataField>txtEthnicGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationGroupName"><DataField>txtRegistrationGroupName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSen"><DataField>txtSen</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intCodeID"><DataField>intCodeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtTransportType"><DataField>txtTransportType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTutorTitle"><DataField>txtTutorTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationGroup"><Value>=Fields!txtRegistrationGroupName.Value</Value></Field><Field Name="txtTutorFirstname"><DataField>txtTutorFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTutorSurname"><DataField>txtTutorSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurgeryTelephone"><DataField>txtSurgeryTelephone</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurgeryName"><DataField>txtSurgeryName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="RegistrationCodes"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>WITH DefaultPresentCodes AS
	(SELECT 0 AS 'intPresentFirst', 'Present Codes' AS 'txtCode', '' AS 'txtName', -3 AS 'intOrder'
		UNION ALL
	 SELECT 1, '/', 'Present AM', -2
		UNION ALL
	 SELECT 1,  '\', 'Present PM', -1
	)
	,SchoolPresentCodes AS
	(SELECT	1 AS 'intPresentFirst', txtCode, txtName, intOrder
	 FROM	TblRegistrationSchoolRegistrationPresentCodes
	 WHERE	TblRegistrationSchoolRegistrationPresentCodes.blnActive = 1
	)
	,
	SchoolAuthorisedAbsentCodes AS
	(SELECT	3 AS 'intPresentFirst', txtCode, txtName, intOrder
	 FROM	TblRegistrationSchoolRegistrationCodes
	 WHERE	blnActive =1
			AND blnAuthorised = 1
	)
	,SchoolAuthorisedAbsentCodesWithHeader AS
	(SELECT	TOP 1 2 AS 'intPresentFirst', 'Authorised Absence Codes' AS 'txtCode', '' AS 'txtName', -1 AS 'intOrder'
	 FROM	SchoolAuthorisedAbsentCodes
		UNION ALL
	 SELECT SchoolAuthorisedAbsentCodes.*
	 FROM	SchoolAuthorisedAbsentCodes
	)
	,SchoolUnauthorisedAbsentCodes AS
	(SELECT	5 AS 'intPresentFirst', txtCode, txtName, intOrder
	 FROM	TblRegistrationSchoolRegistrationCodes
	 WHERE	blnActive =1
			AND blnAuthorised = 0
	)
	,SchoolUnauthorisedAbsentCodesWithHeader AS
	(SELECT	TOP 1 4 AS 'intPresentFirst', 'Unauthorised Absence Codes' AS 'txtCode', '' AS 'txtName', -1 AS 'intOrder'
	 FROM	SchoolUnauthorisedAbsentCodes
		UNION ALL
	 SELECT SchoolUnauthorisedAbsentCodes.*
	 FROM	SchoolUnauthorisedAbsentCodes
	)
	,AllRegistrationCodes AS
	(SELECT	DefaultPresentCodes.*
	 FROM	DefaultPresentCodes
		UNION ALL
	 SELECT	SchoolPresentCodes.*
	 FROM	SchoolPresentCodes
		UNION ALL
	 SELECT	SchoolAuthorisedAbsentCodesWithHeader.*
	 FROM	SchoolAuthorisedAbsentCodesWithHeader
		UNION ALL
	 SELECT	SchoolUnauthorisedAbsentCodesWithHeader.*
	 FROM	SchoolUnauthorisedAbsentCodesWithHeader
	)
	,OrderedCodes AS
	(SELECT	txtCode, txtName, ROW_NUMBER() OVER (ORDER BY intPresentFirst, intOrder) AS 'intRowNumber'
	 FROM	AllRegistrationCodes
	)
	,CodesSplitBy4 AS
	(SELECT	txtCode + '   ' + txtName AS 'txtFullCode', (intRowNumber - 1)/ CodesCount.intCountOfCodes AS 'int4'
	 FROM OrderedCodes
	 CROSS APPLY(SELECT( COUNT(*) / 4) + 1 AS intCountOfCodes FROM OrderedCodes) AS CodesCount
	)
	,CombinedCodes AS
	(SELECT	CodesSplitBy4.int4, STUFF((SELECT ';;' + txtFullCode FROM CodesSplitBy4 Codes WHERE Codes.int4 = CodesSplitBy4.int4 FOR XML PATH('')), 1, 2, '') 'txtCombineCodes'
	 FROM	CodesSplitBy4
	 GROUP BY CodesSplitBy4.int4
	)

SELECT	MAX(CASE int4 WHEN 0 THEN txtCombineCodes END) AS 'txtCodes1',
		MAX(CASE int4 WHEN 1 THEN txtCombineCodes END) AS 'txtCodes2',
		MAX(CASE int4 WHEN 2 THEN txtCombineCodes END) AS 'txtCodes3',
		MAX(CASE int4 WHEN 3 THEN txtCombineCodes END) AS 'txtCodes4'
FROM	CombinedCodes</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="txtCodes1"><DataField>txtCodes1</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCodes2"><DataField>txtCodes2</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCodes3"><DataField>txtCodes3</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCodes4"><DataField>txtCodes4</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TbliSAMSManagerSettings.txtExternaliSAMSAddress AS 'txtiSAMSAddress' 
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS 'txtSchoolLogoPath', 
		TblReportsCustomImages.txtName
FROM	TblReportsCustomImages
WHERE	TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="list1"><TablixBody><TablixColumns><TablixColumn><Width>20cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>21.535cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="list1_Contents"><ReportItems><Rectangle Name="rectangle1"><ReportItems><Tablix Name="table7"><TablixBody><TablixColumns><TablixColumn><Width>6.4cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.425cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>= iif(Year(Parameters!txtStartDate.Value) = Year(Parameters!txtEndDate.Value),Year(Parameters!txtStartDate.Value), Year(Parameters!txtStartDate.Value) &amp; " - " &amp; Year(Parameters!txtEndDate.Value))</Value><Style><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>textbox1</rd:DefaultName><ZIndex>1</ZIndex><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><BottomBorder><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>1cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="rectangle2"><ReportItems><Tablix Name="matrix1"><TablixCorner><TablixCornerRows><TablixCornerRow><TablixCornerCell><CellContents><Textbox Name="textbox6"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>w/b</Value><Style><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><ZIndex>4</ZIndex><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><RowSpan>2</RowSpan></CellContents></TablixCornerCell></TablixCornerRow><TablixCornerRow><TablixCornerCell /></TablixCornerRow></TablixCornerRows></TablixCorner><TablixBody><TablixColumns><TablixColumn><Width>0.4cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="txtRegistrationCode"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=SWITCH(Fields!txtRegistrationStatus.Value="Not Registered","-",
Fields!txtRegistrationStatus.Value="Present"  aND Fields!intIsLate.Value=True, "L",
Fields!txtRegistrationStatus.Value="Present" AND Fields!txtCode.Value="" AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00","/",
Fields!txtRegistrationStatus.Value="Present" AND Fields!txtCode.Value="" AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&gt;="12:00","\",
Fields!txtRegistrationStatus.Value="Absent" AND Fields!txtCode.Value="" AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00","\",
Fields!txtRegistrationStatus.Value="Absent" AND Fields!txtCode.Value="" AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&gt;="12:00","/",
true,Fields!txtCode.Value)</Value><Style><FontSize>7pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>=IIF(Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00","Right","Left")</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtRegistrationCode</rd:DefaultName><Style><Border><Color>White</Color><Width>0.5pt</Width></Border><LeftBorder><Style>None</Style></LeftBorder><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember><Group Name="WeekDay"><GroupExpressions><GroupExpression>=Weekday(Fields!dtRegistrationDateTime.Value,FirstDayOfWeek.System)</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Weekday(Fields!dtRegistrationDateTime.Value,FirstDayOfWeek.System)</Value></SortExpression></SortExpressions><TablixHeader><Size>0.4cm</Size><CellContents><Textbox Name="txtDateTime"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtDateTime</rd:DefaultName><ZIndex>3</ZIndex><Style><Border><Color>White</Color></Border><LeftBorder><Style>None</Style></LeftBorder><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixHeader><TablixMembers><TablixMember><Group Name="RegistrationTime"><GroupExpressions><GroupExpression>=Format(Fields!dtRegistrationDateTime.Value,"HH:mm")</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Format(Fields!dtRegistrationDateTime.Value,"HH:mm")</Val