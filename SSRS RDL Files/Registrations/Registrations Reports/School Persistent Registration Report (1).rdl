<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>772c9ca1-961d-4a29-94df-9e6b84f683fc</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Attendance"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter><QueryParameter Name="@txtTime"><Value>=Parameters!txtTime.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationType"><Value>=Parameters!txtRegistrationType.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @Students AS NVARCHAR(MAX);
SET @Students = STUFF((SELECT DISTINCT ',' + txtSchoolID FROM TblPupilManagementPupils WHERE txtSchoolID IN (@txtSchoolID) FOR XML PATH('')), 1, 1, '');
WITH PupilTermYearCal
     AS (SELECT Attendance.txtSchoolID, 
                SUM(CASE
                        WHEN txtRegistrationStatisticalStatus = 'Present'
                        THEN 1
                        ELSE 0
                    END) AS intTotalPresentCount, 
                SUM(CASE
                        WHEN txtRegistrationStatisticalStatus = 'Absent'
                        THEN 1
                        ELSE 0
                    END) AS intTotalAbsentCount, 
					                SUM(CASE
                       WHEN txtRegistrationStatisticalStatus = 'Present' AND intIsLate = 1
                        THEN 1
                        ELSE 0
                    END) AS intTotalLateCount, 
                SUM(1) AS intTotalRegistrationCount
         FROM dbo.uf_Registration_AttendanceBetweenDates(@StartDate, @EndDate, @Students) AS Attendance
        WHERE LEFT(CONVERT(VARCHAR(8), Attendance.dtRegistrationDateTime, 108), 5) IN (@txtTime)
			AND CASE WHEN Attendance.txtRegistrationAMPM IS NULL THEN 'Other' ELSE UPPER(Attendance.txtRegistrationAMPM) END IN (@txtRegistrationType)
			AND ((Attendance.txtRegistrationStatisticalStatus = 'Absent' AND Attendance.txtCode = 'U') OR (Attendance.txtRegistrationStatisticalStatus = 'Present' AND Attendance.intIsLate = 1))
			
         GROUP BY txtSchoolID)
     SELECT 
            PupilTermYearCal.intTotalAbsentCount, 
            PupilTermYearCal.intTotalRegistrationCount, 
			PupilTermYearCal.intTotalLateCount,
            PupilArchive.*, 
            TblPupilManagementPupils.txtGender, 
            TblPupilManagementPupils.txtEthnicGroup,
			SEN.Association AS SENRegister,
			SEN.[$SEN_Register_Register_RegisterFlag_Display],
			PP.Association AS PPRegister,
			LA.Association AS LA,
			FSM.Association AS FSM
			--LFAM.Association AS LFAMRegister
     FROM PupilTermYearCal
          CROSS APPLY dbo.uf_Registration_getPupilArchive(PupilTermYearCal.txtSchoolID, @EndDate) AS PupilArchive
          INNER JOIN TblPupilManagementPupils ON PupilArchive.txtSchoolID = TblPupilManagementPupils.txtSchoolID
		  LEFT OUTER JOIN generated_views.VwPupilRegisters_Register_$SEN AS SEN ON TblPupilManagementPupils.txtSchoolID = SEN.SchoolId
		  LEFT OUTER JOIN generated_views.VwPupilRegisters_Register_$PupilPremium AS PP ON TblPupilManagementPupils.txtSchoolID = PP.SchoolId
		  --LEFT OUTER JOIN generated_views.VwPupilRegisters_Register_$LFAM AS LFAM ON TblPupilManagementPupils.txtSchoolID = LFAM.SchoolId
		  LEFT OUTER JOIN generated_views.VwPupilRegisters_Register_$LookedAfter AS LA ON TblPupilManagementPupils.txtSchoolID = LA.SchoolId
		  LEFT OUTER JOIN generated_views.VwPupilRegisters_Register_$FreeSchoolMeals AS FSM ON TblPupilManagementPupils.txtSchoolID = FSM.SchoolId</CommandText></Query><Fields><Field Name="intTotalAbsentCount"><DataField>intTotalAbsentCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intTotalRegistrationCount"><DataField>intTotalRegistrationCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intTotalLateCount"><DataField>intTotalLateCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtFormTutor"><DataField>txtFormTutor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPastoralTutor"><DataField>txtPastoralTutor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearTutor"><DataField>txtYearTutor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dteSubmitDateTime"><DataField>dteSubmitDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Title"><DataField>Title</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Initials"><DataField>Initials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEthnicGroup"><DataField>txtEthnicGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="SENRegister"><DataField>SENRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="LA"><DataField>LA</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ID_SEN_Register_Register_RegisterFlag_Display"><DataField>$SEN_Register_Register_RegisterFlag_Display</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PPRegister"><DataField>PPRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="FSM"><DataField>FSM</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS 'txtiSAMSAddress'
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS 'txtSchoolLogoPath', 
		TblReportsCustomImages.txtName
FROM	TblReportsCustomImages
WHERE	TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="RegisteredPercentage"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@txtTime"><Value>=Parameters!txtTime.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationType"><Value>=Parameters!txtRegistrationType.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @Students AS NVARCHAR(MAX);
SET @Students = STUFF((SELECT DISTINCT ',' + txtSchoolID FROM TblPupilManagementPupils WHERE txtSchoolID IN (@txtSchoolID) FOR XML PATH('')), 1, 1, '');

WITH AttendanceData AS
	(SELECT	COUNT(DISTINCT CASE WHEN Attendance.txtRegistrationStatisticalStatus &lt;&gt; 'Not Registered' THEN Attendance.intRegistrationPupilsID ELSE NULL END) AS 'intRegistrationsDone',
			COUNT(DISTINCT Attendance.intRegistrationPupilsID) AS intRegistrationCount, 
			COUNT(DISTINCT CASE WHEN Attendance.txtRegistrationStatisticalStatus = 'Present' AND Attendance.intIsLate = 1 THEN Attendance.intRegistrationPupilsID ELSE NULL END) AS intLateCount, 
			COUNT(DISTINCT CASE WHEN Attendance.txtRegistrationStatisticalStatus = 'Present' THEN Attendance.intRegistrationPupilsID ELSE NULL END) AS intPresentCount, 
			COUNT(DISTINCT CASE Attendance.txtRegistrationStatisticalStatus WHEN 'Absent' THEN Attendance.intRegistrationPupilsID ELSE NULL END) AS intAbsentCount, 
			COUNT(DISTINCT CASE WHEN Attendance.txtRegistrationStatisticalStatus = 'Absent' AND Attendance.intIsAuthorisedAbsence = 1 THEN Attendance.intRegistrationPupilsID ELSE NULL END) AS intAuthorisedAbsentCount, 
			COUNT(DISTINCT CASE WHEN Attendance.txtRegistrationStatisticalStatus = 'Absent' AND Attendance.intIsAuthorisedAbsence = 0 THEN Attendance.intRegistrationPupilsID ELSE NULL END) AS intUnAuthorisedAbsentCount, 
			COUNT(DISTINCT CASE Attendance.txtRegistrationStatisticalStatus WHEN 'Not Registered' THEN Attendance.intRegistrationPupilsID ELSE NULL END) AS intNotRegisteredCount, 
			Attendance.txtRegistrationTeacherCode, 
			intRegistrationDateTimeID,
			dtRegistrationDateTime
	 FROM	dbo.uf_Registration_AttendanceBetweenDates(@StartDate, @EndDate, @Students) AS Attendance
	 WHERE	Attendance.intIsIncludedInStatistics = 1
	 	 AND	LEFT(CONVERT(VARCHAR(8), Attendance.dtRegistrationDateTime, 108), 5) IN (@txtTime)
			AND CASE WHEN Attendance.txtRegistrationAMPM IS NULL THEN 'Other' ELSE UPPER(Attendance.txtRegistrationAMPM) END IN (@txtRegistrationType)
			AND ((Attendance.txtRegistrationStatisticalStatus = 'Absent' AND Attendance.txtCode = 'U') OR (Attendance.txtRegistrationStatisticalStatus = 'Present' AND Attendance.intIsLate = 1))
	 GROUP BY Attendance.txtRegistrationTeacherCode, intRegistrationDateTimeID, dtRegistrationDateTime
	)
	,TeacherTotals AS
	(SELECT	AttendanceData.txtRegistrationTeacherCode,
			SUM(CASE WHEN intRegistrationsDone &gt; 0 THEN 1 ELSE 0 END) AS 'intRegistrationUsed',
			COUNT(intRegistrationDateTimeID) AS 'intTotalRegistrations'
	 FROM	AttendanceData
	 GROUP BY AttendanceData.txtRegistrationTeacherCode
	)

SELECT	AttendanceData.*, intRegistrationUsed, intTotalRegistrations
FROM	AttendanceData
LEFT OUTER JOIN TeacherTotals ON AttendanceData.txtRegistrationTeacherCode = TeacherTotals.txtRegistrationTeacherCode</CommandText></Query><Fields><Field Name="intRegistrationsDone"><DataField>intRegistrationsDone</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intRegistrationCount"><DataField>intRegistrationCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intLateCount"><DataField>intLateCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intPresentCount"><DataField>intPresentCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationTeacherCode"><DataField>txtRegistrationTeacherCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intAbsentCount"><DataField>intAbsentCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intAuthorisedAbsentCount"><DataField>intAuthorisedAbsentCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intUnAuthorisedAbsentCount"><DataField>intUnAuthorisedAbsentCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intNotRegisteredCount"><DataField>intNotRegisteredCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intRegistrationDateTimeID"><DataField>intRegistrationDateTimeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="dtRegistrationDateTime"><DataField>dtRegistrationDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intRegistrationUsed"><DataField>intRegistrationUsed</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intTotalRegistrations"><DataField>intTotalRegistrations</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="Disclaimer"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Path"><Value>=Globals!ReportFolder</Value></QueryParameter><QueryParameter Name="@Report"><Value>=Globals!ReportName</Value></QueryParameter></QueryParameters><CommandText>SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
FROM	TblSQLReportingServicesDisclaimerReport
		INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report</CommandText></Query><Fields><Field Name="txtDisclaimerBackgroundColour"><DataField>txtDisclaimerBackgroundColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerBorderColour"><DataField>txtDisclaimerBorderColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerDescription"><DataField>txtDisclaimerDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTextColour"><DataField>txtDisclaimerTextColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTitle"><DataField>txtDisclaimerTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="YearGroup"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@txtTime"><Value>=Parameters!txtTime.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationType"><Value>=Parameters!txtRegistrationType.Value</Value></QueryParameter><QueryParameter Name="@intSystemStatus"><Value>=Parameters!intSystemStatus.Value</Value></QueryParameter></QueryParameters><CommandText>WITH YearGroups AS
(
SELECT DISTINCT PupilArchive.intNCYear

FROM TblRegistrationSchoolRegistrationPupils
CROSS APPLY dbo.uf_Registration_getPupilArchive(TblRegistrationSchoolRegistrationPupils.txtSchoolID, @EndDate) AS PupilArchive 
INNER JOIN TblPupilManagementPupils ON TblRegistrationSchoolRegistrationPupils.txtSchoolID = TblPupilManagementPupils.txtSchoolID
INNER JOIN TblRegistrationSchoolRegistrationRegister ON TblRegistrationSchoolRegistrationPupils.intRegister = TblRegistrationSchoolRegistrationRegister.TblRegistrationSchoolRegistrationRegisterID
INNER JOIN TblRegistrationSchoolRegistrationDateTime ON TblRegistrationSchoolRegistrationRegister.intRegistrationDateTime = TblRegistrationSchoolRegistrationDateTime.TblRegistrationSchoolRegistrationDateTimeID

WHERE TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @StartDate AND DateAdd(day,1,@EndDate)
AND LEFT(CONVERT(varchar(8), TblRegistrationSchoolRegistrationDateTime.txtDateTime, 108), 5) IN (@txtTime)
AND CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 'Other' ELSE UPPER(TblRegistrationSchoolRegistrationDateTime.txtAmPm ) END IN (@txtRegistrationType)
AND TblPupilManagementPupils.intSystemStatus IN(@intSystemStatus)
)

SELECT	CASE WHEN txtYearName IS NULL THEN -100 ELSE TblSchoolManagementYears.intNCYear END AS intNCYear, 
CASE WHEN txtYearName IS NULL THEN 'No Year Group'  ELSE TblSchoolManagementYears.txtYearName END AS txtYearName
FROM	YearGroups
LEFT OUTER JOIN TblSchoolManagementYears ON YearGroups.intNCYear = TblSchoolManagementYears.intNCYear
ORDER BY intNCYear</CommandText></Query><Fields><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Students"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@txtTime"><Value>=Parameters!txtTime.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationType"><Value>=Parameters!txtRegistrationType.Value</Value></QueryParameter><QueryParameter Name="@intSystemStatus"><Value>=Parameters!intSystemStatus.Value</Value></QueryParameter><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter></QueryParameters><CommandText>
SELECT DISTINCT TblRegistrationSchoolRegistrationPupils.txtSchoolID,
TblPupilManagementPupils.txtSurname + ', ' + TblPupilManagementPupils.txtForename  AS txtStudentName

FROM TblRegistrationSchoolRegistrationPupils
CROSS APPLY dbo.uf_Registration_getPupilArchive(TblRegistrationSchoolRegistrationPupils.txtSchoolID, @EndDate) AS PupilArchive 
INNER JOIN TblPupilManagementPupils ON TblRegistrationSchoolRegistrationPupils.txtSchoolID = TblPupilManagementPupils.txtSchoolID
INNER JOIN TblRegistrationSchoolRegistrationRegister ON TblRegistrationSchoolRegistrationPupils.intRegister = TblRegistrationSchoolRegistrationRegister.TblRegistrationSchoolRegistrationRegisterID
INNER JOIN TblRegistrationSchoolRegistrationDateTime ON TblRegistrationSchoolRegistrationRegister.intRegistrationDateTime = TblRegistrationSchoolRegistrationDateTime.TblRegistrationSchoolRegistrationDateTimeID
LEFT OUTER JOIN TblSchoolManagementYears ON PupilArchive.intNCYear = TblSchoolManagementYears.intNCYear
WHERE TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @StartDate AND DateAdd(day,1,@EndDate)
AND LEFT(CONVERT(varchar(8), TblRegistrationSchoolRegistrationDateTime.txtDateTime, 108), 5) IN (@txtTime)
AND CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 'Other' ELSE UPPER(TblRegistrationSchoolRegistrationDateTime.txtAmPm ) END IN (@txtRegistrationType)
AND TblPupilManagementPupils.intSystemStatus IN(@intSystemStatus)
AND (CASE WHEN TblSchoolManagementYears.txtYearName IS NULL THEN -100 ELSE TblSchoolManagementYears.intNCYear END) IN (@intNCYear)

ORDER BY txtStudentName
</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtStudentName"><DataField>txtStudentName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="User"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 
	TbliSAMSManagerUsers.txtUsername,
	TbliSAMSManagerUsers.txtFirstname,
	TbliSAMSManagerUsers.txtSurname,
	TbliSAMSManagerUsers.txtEmailAddress
FROM TbliSAMSManagerUsers
WHERE TbliSAMSManagerUsers.txtUserCode = @userCode</CommandText></Query><Fields><Field Name="txtUsername"><DataField>txtUsername</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFirstname"><DataField>txtFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEmailAddress"><DataField>txtEmailAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="RegistrationTimes"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationType"><Value>=Parameters!txtRegistrationType.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT DISTINCT LEFT(CONVERT(varchar(8), TblRegistrationSchoolRegistrationDateTime.txtDateTime, 108), 5) AS txtTime
FROM TblRegistrationSchoolRegistrationDateTime
WHERE TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @StartDate AND @EndDate
AND CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 'Other' ELSE UPPER(TblRegistrationSchoolRegistrationDateTime.txtAmPm) END IN (@txtRegistrationType)
ORDER BY txtTime</CommandText></Query><Fields><Field Name="txtTime"><DataField>txtTime</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="StartofAcademicYear"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TOP 1 TblSchoolManagementTermDates.txtStartDate
		 FROM	TblSchoolManagementTermDates
		 WHERE	TblSchoolManagementTermDates.intSchoolYear = (
		 SELECT Top(1) intSchoolYear FROM TblSchoolManagementTermDates WHERE txtStartDate &lt;= GETDATE() ORDER BY txtStartDate DESC
		 )
		 ORDER BY TblSchoolManagementTermDates.txtStartDate ASC</CommandText></Query><Fields><Field Name="txtStartDate"><DataField>txtStartDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields></DataSet><DataSet Name="RegistrationTypes"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT DISTINCT CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 'Other' ELSE UPPER(TblRegistrationSchoolRegistrationDateTime.txtAmPm) END AS txtType,
CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 2 ELSE 1 END AS intTypeOrder
FROM TblRegistrationSchoolRegistrationDateTime
WHERE TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @StartDate AND @EndDate
ORDER BY intTypeOrder, txtType</CommandText></Query><Fields><Field Name="txtType"><DataField>txtType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intTypeOrder"><DataField>intTypeOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="SENAccess"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	RegisterId 
FROM	[dbo].[f_PupilRegisters_GetRegistersWithReadActivityPermission] (@userCode)
WHERE	RegisterId = (SELECT TblPupilRegistersRegisterID FROM TblPupilRegistersRegister WHERE txtReportingKey ='$SEN')</CommandText></Query><Fields><Field Name="RegisterId"><DataField>RegisterId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="LACAccess"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	RegisterId 
FROM	[dbo].[f_PupilRegisters_GetRegistersWithReadActivityPermission] (@userCode)
WHERE	RegisterId = (SELECT TblPupilRegistersRegisterID FROM TblPupilRegistersRegister WHERE txtReportingKey ='$LookedAfter')</CommandText></Query><Fields><Field Name="RegisterId"><DataField>RegisterId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="FSMAccess"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	RegisterId 
FROM	[dbo].[f_PupilRegisters_GetRegistersWithReadActivityPermission] (@userCode)
WHERE	RegisterId = (SELECT TblPupilRegistersRegisterID FROM TblPupilRegistersRegister WHERE txtReportingKey ='$FreeSchoolMeals')</CommandText></Query><Fields><Field Name="RegisterId"><DataField>RegisterId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="PPAccess"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	RegisterId 
FROM	[dbo].[f_PupilRegisters_GetRegistersWithReadActivityPermission] (@userCode)
