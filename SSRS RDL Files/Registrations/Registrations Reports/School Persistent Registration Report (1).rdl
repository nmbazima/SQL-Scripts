></ValidValues><MultiValue>true</MultiValue></ReportParameter><ReportParameter Name="intNCYear"><DataType>String</DataType><Prompt>Year Group:</Prompt><ValidValues><DataSetReference><DataSetName>YearGroup</DataSetName><ValueField>intNCYear</ValueField><LabelField>txtYearName</LabelField></DataSetReference></ValidValues><MultiValue>true</MultiValue></ReportParameter><ReportParameter Name="txtSchoolID"><DataType>String</DataType><DefaultValue><DataSetReference><DataSetName>Students</DataSetName><ValueField>txtSchoolID</ValueField></DataSetReference></DefaultValue><Prompt>Student:</Prompt><ValidValues><DataSetReference><DataSetName>Students</DataSetName><ValueField>txtSchoolID</ValueField><LabelField>txtStudentName</LabelField></DataSetReference></ValidValues><MultiValue>true</MultiValue></ReportParameter><ReportParameter Name="GroupBy"><DataType>String</DataType><DefaultValue><Values><Value>intNCYear</Value></Values></DefaultValue><Prompt>Group Students By:</Prompt><ValidValues><ParameterValues><ParameterValue><Value>txtGender</Value><Label>Gender</Label></ParameterValue><ParameterValue><Value>txtEthnicGroup</Value><Label>Ethnic Category</Label></ParameterValue><ParameterValue><Value>intNCYear</Value><Label>Year Group</Label></ParameterValue><ParameterValue><Value>txtForm</Value><Label>Form</Label></ParameterValue><ParameterValue><Value>txtAcademicHouse</Value><Label>Academic House</Label></ParameterValue><ParameterValue><Value>txtBoardingHouse</Value><Label>Boarding House</Label></ParameterValue><ParameterValue><Value>txtBoardingStatus</Value><Label>Boarding Status</Label></ParameterValue><ParameterValue><Value>NoGroup</Value><Label>N/A</Label></ParameterValue></ParameterValues></ValidValues></ReportParameter></ReportParameters><Code>Public FirstFive AS String = "@ - Absent (no code)" + vbnewline
Public SecondFive AS String = ""
Public ThirdFive AS String = ""
Public TourthFive AS String = ""
Public FifthFive AS String = ""
Public SixthFive AS String = ""
Public RecordCount AS Integer = 0
Public PresentCodes AS String = "/ - Present (am - no code)" + vbnewline + "\ - Present (pm - no code)" + vbnewline

Public Function getCodeDescriptions (ByVal singleCode As String, ByVal singleDescription As String)
if RecordCount &lt;4 then
	FirstFive = FirstFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;3 and  RecordCount &lt;8 then
	SecondFive = SecondFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;7 and  RecordCount &lt;13 then
	ThirdFive = ThirdFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;12 and  RecordCount &lt;18 then
	TourthFive = TourthFive + singleCode + " - " + singleDescription + vbnewline	

end if  
if RecordCount &gt;17 and  RecordCount &lt;23 then
	FifthFive = FifthFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;22 and  RecordCount &lt;31 then
	SixthFive = SixthFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
RecordCount = RecordCount + 1
End Function

Public Function getPresentCode (ByVal singlePCode As String, ByVal singlePDescription As String)
	
PresentCodes = PresentCodes + singlePCode +" - " + singlePDescription + vbnewline
 
End Function</Code><EmbeddedImages><EmbeddedImage Name="iSAMSLine"><MIMEType>image/png</MIMEType><ImageData></ImageData></EmbeddedImage></EmbeddedImages><Language>en-GB</Language><ConsumeContainerWhitespace>true</ConsumeContainerWhitespace><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>36d3aa52-5785-466c-9dda-a872ad57105f</rd:ReportID></Report>