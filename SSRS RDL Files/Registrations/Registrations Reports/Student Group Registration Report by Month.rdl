de.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 7 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 8 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 9 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 10 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 11 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 12 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 13 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 14 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 15 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 16 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Field