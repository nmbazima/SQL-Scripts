<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>772c9ca1-961d-4a29-94df-9e6b84f683fc</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Attendance"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtStartDate"><Value>=Parameters!txtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@txtTime"><Value>=Parameters!txtTime.Value</Value></QueryParameter><QueryParameter Name="@txtRegistrationGroup"><Value>=Parameters!txtRegistrationGroup.Value</Value></QueryParameter><QueryParameter Name="@txtAmPm"><Value>=Parameters!txtAmPm.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	Attendance.*,
		PupilArchive.txtForename, 
		PupilArchive.txtPreName, 
		PupilArchive.txtMiddleNames, 
		PupilArchive.txtSurname, 
		PupilArchive.txtAcademicHouse, 
		PupilArchive.txtBoardingHouse, 
		PupilArchive.intNCYear, 
		PupilArchive.txtYearName, 
		PupilArchive.txtYearCode, 
		PupilArchive.txtForm, 
		PupilArchive.Initials AS 'txtTutorInitials',
		TblPupilManagementPupils.txtGender, 
		TblPupilManagementPupils.txtEthnicGroup,
		CASE WHEN TblSENManagerRegister.intSENRegister = 1 THEN 'Yes' ELSE 'No' END AS 'txtSen',
		RegistrationTeacher.Initials AS 'txtRegistrationTeacherSchoolInitials', 
		RegistrationTeacher.Salutation AS 'txtRegistrationTeacherSchoolSalutation', 
		RegistrationSubmitBy.Initials AS 'txtRegistrationSubmitBySchoolInitials', 
		RegistrationSubmitBy.Salutation AS 'txtRegistrationSubmitBySchoolSalutation', 
		TblRegistrationSchoolRegistrationCodes.txtColour,
		DENSE_RANK() OVER(PARTITION BY CASE WHEN txtRegistrationStatus = 'Present' THEN 1 
		WHEN txtRegistrationStatus = 'Absent' AND intIsAuthorisedAbsence = 1 THEN 2
		WHEN txtRegistrationStatus = 'Absent' AND intIsAuthorisedAbsence &lt;&gt; 1 THEN 3 ELSE NULL END ORDER BY Attendance.txtCode) AS 'intCodeNumber'
FROM	dbo.uf_Registration_AttendanceBetweenDates(@txtStartDate, @txtEndDate, @txtSchoolID) AS Attendance
CROSS APPLY dbo.uf_Registration_getPupilArchive(Attendance.txtSchoolID, @txtEndDate) AS PupilArchive 
INNER JOIN TblPupilManagementPupils ON Attendance.txtSchoolID = TblPupilManagementPupils.txtSchoolID
LEFT OUTER JOIN TblStaff AS RegistrationTeacher ON Attendance.txtRegistrationTeacherCode = RegistrationTeacher.User_Code 
LEFT OUTER JOIN TblStaff AS RegistrationSubmitBy ON Attendance.txtRegistrationSubmitBy = RegistrationSubmitBy.User_Code
LEFT OUTER JOIN TblSENManagerRegister ON TblPupilManagementPupils.txtSchoolID = TblSENManagerRegister.txtSchoolID
LEFT OUTER JOIN TblRegistrationSchoolRegistrationCodes ON Attendance.txtCode = TblRegistrationSchoolRegistrationCodes.txtCode
WHERE	(LEFT(CONVERT(VARCHAR(8), Attendance.dtRegistrationDateTime, 108), 5) IN (SELECT ID FROM dbo.SplitCSV(@txtTime) AS SplitCSV_1) OR @txtTime IS NULL)
		AND (Attendance.txtRegistrationGroupName IN (SELECT ID FROM dbo.SplitCSV(@txtRegistrationGroup) AS SplitCSV_1) OR @txtRegistrationGroup IS NULL)
		AND (Attendance.txtRegistrationAMPM IN (SELECT ID FROM dbo.SplitCSV(@txtAmPm) AS SplitCSV_1) OR @txtAmPm IS NULL)

OPTION (RECOMPILE)</CommandText></Query><Fields><Field Name="txtRegistrationGroup"><Value>=Fields!txtRegistrationGroupName.Value</Value></Field><Field Name="intRegistrationDateTimeID"><DataField>intRegistrationDateTimeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="dtRegistrationDateTime"><DataField>dtRegistrationDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtRegistrationAMPM"><DataField>txtRegistrationAMPM</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationName"><DataField>txtRegistrationName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationPupilsID"><DataField>intRegistrationPupilsID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intRegisterID"><DataField>intRegisterID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherCode"><DataField>txtRegistrationTeacherCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationGroupID"><DataField>intRegistrationGroupID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationGroupType"><DataField>txtRegistrationGroupType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationGroupName"><DataField>txtRegistrationGroupName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRegistrationGroupSubjectID"><DataField>intRegistrationGroupSubjectID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationSubmitBy"><DataField>txtRegistrationSubmitBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationReason"><DataField>txtRegistrationReason</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intIsLate"><DataField>intIsLate</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="intMinutesLate"><DataField>intMinutesLate</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtRegistrationStatus"><DataField>txtRegistrationStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationStatisticalStatus"><DataField>txtRegistrationStatisticalStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intCodeID"><DataField>intCodeID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtCode"><DataField>txtCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intCodeOrder"><DataField>intCodeOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtCodeName"><DataField>txtCodeName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intIsIncludedInStatistics"><DataField>intIsIncludedInStatistics</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intIsAuthorisedAbsence"><DataField>intIsAuthorisedAbsence</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTutorInitials"><DataField>txtTutorInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEthnicGroup"><DataField>txtEthnicGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSen"><DataField>txtSen</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolInitials"><DataField>txtRegistrationTeacherSchoolInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolSalutation"><DataField>txtRegistrationTeacherSchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySchoolInitials"><DataField>txtRegistrationSubmitBySchoolInitials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySchoolSalutation"><DataField>txtRegistrationSubmitBySchoolSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtColour"><DataField>txtColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intCodeNumber"><DataField>intCodeNumber</DataField><rd:TypeName>System.Int64</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS 'txtiSAMSAddress'
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS 'txtSchoolLogoPath', 
		TblReportsCustomImages.txtName
FROM	TblReportsCustomImages
WHERE	TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Disclaimer"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Path"><Value>=Globals!ReportFolder</Value></QueryParameter><QueryParameter Name="@Report"><Value>=Globals!ReportName</Value></QueryParameter></QueryParameters><CommandText>SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
FROM	TblSQLReportingServicesDisclaimerReport
		INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report</CommandText></Query><Fields><Field Name="txtDisclaimerBackgroundColour"><DataField>txtDisclaimerBackgroundColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerBorderColour"><DataField>txtDisclaimerBorderColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerDescription"><DataField>txtDisclaimerDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTextColour"><DataField>txtDisclaimerTextColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTitle"><DataField>txtDisclaimerTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="list1"><TablixBody><TablixColumns><TablixColumn><Width>28.7cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.9cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle4"><ReportItems><Textbox Name="Disclaimer"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!txtDisclaimerTitle.Value, "Disclaimer")</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun><TextRun><Value>:</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun><TextRun><Value>=First(Fields!txtDisclaimerDescription.Value, "Disclaimer")</Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Height>0.6cm</Height><Width>28.7cm</Width><Style><Border><Color>=First(Fields!txtDisclaimerBorderColour.Value, "Disclaimer")</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>=First(Fields!txtDisclaimerBackgroundColour.Value, "Disclaimer")</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></ReportItems><KeepTogether>true</KeepTogether><Style><Border><Style>None</Style></Border></Style></Rectangle></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>3.2cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="list1_Contents"><ReportItems><Rectangle Name="Rectangle1"><ReportItems><Tablix Name="StudentData"><TablixCorner><TablixCornerRows><TablixCornerRow><TablixCornerCell><CellContents><Textbox Name="Textbox24"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=MonthName(Month(Fields!dtRegistrationDateTime.Value))</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox24</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>None</Style></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCornerCell></TablixCornerRow><TablixCornerRow><TablixCornerCell><CellContents><Textbox Name="textbox2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=SWITCH(
Parameters!txtGroupBy.Value = "intNCYear", "" &amp; Fields!txtYearName.Value, 
Parameters!txtGroupBy.Value = "txtSen", "SEN: " &amp; Fields!txtSen.Value, 
Parameters!txtGroupBy.Value = "txtSurname", "", 
Parameters!txtGroupBy.Value = "txtRegistrationGroup", Fields!txtRegistrationGroupType.Value &amp; ": " &amp; IIF(Fields!txtRegistrationGroupType.Value = "Tutor Group", Fields!txtRegistrationTeacherSchoolSalutation.Value, Fields!txtRegistrationGroupName.Value &amp; " - " &amp; Fields!txtRegistrationTeacherSchoolSalutation.Value), 
True, Fields(Parameters!txtGroupBy.Value).Value
)</Value><Style><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>textbox1</rd:DefaultName><ZIndex>3</ZIndex><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Width></Border><BottomBorder><Style>Solid</Style></BottomBorder><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCornerCell></TablixCornerRow></TablixCornerRows></TablixCorner><TablixBody><TablixColumns><TablixColumn><Width>0.375cm</Width></TablixColumn><TablixColumn><Width>0.65cm</Width></TablixColumn><TablixColumn><Width>0.65cm</Width></TablixColumn><TablixColumn><Width>0.65cm</Width></TablixColumn><TablixColumn><Width>0.65cm</Width></TablixColumn><TablixColumn><Width>0.65cm</Width></TablixColumn><TablixColumn><Width>0.65cm</Width></TablixColumn><TablixColumn><Width>0.65cm</Width></TablixColumn><TablixColumn><Width>0.65cm</Width></TablixColumn><TablixColumn><Width>0.65cm</Width></TablixColumn><TablixColumn><Width>0.65cm</Width></TablixColumn><TablixColumn><Width>0.65cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="txtRegistrationCode2"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=SWITCH(Fields!txtRegistrationStatus.Value="Not Registered","",
Fields!txtRegistrationStatus.Value="Present" AND Fields!txtCode.Value="" AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00","/",
Fields!txtRegistrationStatus.Value="Present" AND Fields!txtCode.Value="" AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&gt;="12:00","\",
Fields!txtRegistrationStatus.Value="Absent" AND Fields!txtCode.Value="" AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00","\",
Fields!txtRegistrationStatus.Value="Absent" AND Fields!txtCode.Value="" AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&gt;="12:00","/",
true,Fields!txtCode.Value)</Value><Style><FontSize>8pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtRegistrationCode</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>=SWITCH(
isNothing(Fields!intRegistrationDateTimeID.Value), "Gainsboro",
Fields!txtColour.Value &lt;&gt;"", "#" &amp; Fields!txtColour.Value,
Fields!txtRegistrationStatisticalStatus.Value = "Present" AND Fields!intIsLate.Value = True, "#fad182",
Fields!txtRegistrationStatisticalStatus.Value = "Present" AND Fields!intIsAuthorisedAbsence.Value = True, "#8eceec",
Fields!txtRegistrationStatisticalStatus.Value = "Present", "#cbe3ba",
Fields!txtRegistrationStatisticalStatus.Value = "Absent" , "#d88bc0",
True,"Transparent"
)</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell><TablixCell><CellContents><Textbox Name="textbox285"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountDistinct(IIF(Fields!intIsIncludedInStatistics.Value = 1, Cstr(Fields!intRegistrationDateTimeID.Value) + Cstr(Fields!txtSchoolID.Value), Nothing))</Value><Style><FontSize>6pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><ZIndex>21</ZIndex><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><TopBorder><Style>Solid</Style><Width>0.5pt</Width></TopBorder><BottomBorder><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><LeftBorder><Style>Solid</Style><Width>0.5pt</Width></LeftBorder><RightBorder><Style>Solid</Style><Width>0.5pt</Width></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell><TablixCell><CellContents><Textbox Name="textbox286"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountDistinct(IIF(Fields!intIsIncludedInStatistics.Value = 1 And Fields!txtRegistrationStatisticalStatus.Value = "Present" And Format(Fields!dtRegistrationDateTime.Value, "HH:mm") &lt; "12:00", Cstr(Fields!intRegistrationDateTimeID.Value) + Cstr(Fields!txtSchoolID.Value), Nothing))</Value><Style><FontSize>6pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><ZIndex>20</ZIndex><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><TopBorder><Style>Solid</Style><Width>0.5pt</Width></TopBorder><BottomBorder><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><LeftBorder><Style>Solid</Style><Width>0.5pt</Width></LeftBorder><RightBorder><Style>Solid</Style><Width>0.5pt</Width></RightBorder><BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell><TablixCell><CellContents><Textbox Name="textbox287"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountDistinct(IIF(Fields!intIsIncludedInStatistics.Value = 1 And Fields!txtRegistrationStatisticalStatus.Value = "Present" And Format(Fields!dtRegistrationDateTime.Value, "HH:mm") &gt;= "12:00", Cstr(Fields!intRegistrationDateTimeID.Value) + Cstr(Fields!txtSchoolID.Value), Nothing))</Value><Style><FontSize>6pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><ZIndex>19</ZIndex><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><TopBorder><Style>Solid</Style><Width>0.5pt</Width></TopBorder><BottomBorder><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><LeftBorder><Style>Solid</Style><Width>0.5pt</Width></LeftBorder><RightBorder><Style>Solid</Style><Width>0.5pt</Width></RightBorder><BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell><TablixCell><CellContents><Textbox Name="textbox288"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountDistinct(IIF(Fields!intIsIncludedInStatistics.Value = 1 And Fields!txtRegistrationStatisticalStatus.Value = "Present" And Fields!intIsLate.Value = True, Cstr(Fields!intRegistrationDateTimeID.Value) + Cstr(Fields!txtSchoolID.Value), Nothing))</Value><Style><FontSize>6pt</FontSize><Color>#37394