aphs><Paragraph><TextRuns><TextRun><Value>=IIF(ReportItems!Textbox110.Value = "Present Codes", "&lt;B&gt;/&lt;/B&gt; Present AM &lt;B&gt;\&lt;/B&gt; Present PM&amp;nbsp;", "") &amp; Max(IIF(Fields!intCodeNumber.Value = 1 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 2 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 3 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 4 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 5 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 6 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 7 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 8 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber.Value = 9 And TRIM(Fields!txtCode.Value) &lt;&gt; "", "&amp;nbsp;&lt;B&gt;" &amp; Fields!txtCode.Value &amp; "&lt;/B&gt; " &amp; Fields!txtCodeName.Value, Nothing)) &amp; Max(IIF(Fields!intCodeNumber