Fields!txtRegistrationStatus.Value = "Absent" AND Fields!intIsAuthorisedAbsence.Value = 0, "Unauthorised Absence Codes"
)</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=SWITCH(Fields!txtRegistrationStatus.Value = "Present", 1, Fields!txtRegistrationStatus.Value = "Absent" And Fields!intIsAuthorisedAbsence.Value = True, 2, Fields!txtRegistrationStatus.Value = "Absent" And Fields!intIsAuthorisedAbsence.Value = 0, 3)</Value></SortExpression></SortExpressions><Visibility><Hidden>=IIF(TRIM(SWITCH(Fields!txtRegistrationStatus.Value = "Present", "Present Codes", Fields!txtRegistrationStatus.Value = "Absent" And Fields!intIsAuthorisedAbsence.Value = True, "Authorised Absence Codes", Fields!txtRegistrationStatus.Value = "Absent" And Fields!intIsAuthorisedAbsence.Value = 0, "Unauthorised Absence Codes")) = "", True, False)</Hidden></Visibility></TablixMember></TablixMembers></TablixRowHierarchy><Height>1.3cm</Height><Width>28.7cm</Width><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><KeepTogether>true</KeepTogether><ZIndex>1</ZIndex><Style><Border><Style>None</Style></Border></Style></Rectangle></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><Visibility><Hidden>=IIF(CountRows("Disclaimer") = 0, True, False)</Hidden></Visibility><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><Group Name="GroupBy"><GroupExpressions><GroupExpression>
                        =SWITCH(Parameters!txtGroupBy.Value ="txtSurname","No Grouping",
                        Parameters!txtGroupBy.Value ="txtRegistrationGroup",Fields!txtRegistrationGroupName.Value,
                        true,Fields(Parameters!txtGroupBy.Value).Value)
                      </GroupExpression></GroupExpressions><PageBreak><BreakLocation>Between</BreakLocation></PageBreak></Group><SortExpressions><SortExpression><Value>=IIF(Parameters!txtGroupBy.Value="txtForm",Fields!intNCYear.Value,1=1)</Value></SortExpression><SortExpression><Value>
                        =SWITCH(Parameters!txtGroupBy.Value ="txtSurname", Fields!txtSurname.Value + IIF(Fields!txtPreName.Value ="" or Fields!txtPreName.Value=" ",Fields!txtForename.Value , Fields!txtPreName.Value),
                        Parameters!txtGroupBy.Value ="txtRegistrationGroup",Fields!txtRegistrationGroupType.Value + Fields!txtRegistrationGroupName.Value,
                        true,Fields(Parameters!txtGroupBy.Value).Value)
                      </Value></SortExpression></SortExpressions><DataElementOutput>Output</DataElementOutput><KeepTogether>true</KeepTogether></TablixMember><TablixMember><KeepWithGroup>Before</KeepWithGroup></TablixMember><TablixMember><Visibility><Hidden>=iif(Parameters!intShowCodes.Value=1,false,true)</Hidden></Visibility><KeepWithGroup>Before</KeepWithGroup></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>Attendance</DataSetName><Filters><Filter><FilterExpression>
                  =IIF(Parameters!txtAttendanceCategory.Value="Late",
                  IIF(Fields!intIsIncludedInStatistics.Value = 1 and Fields!txtRegistrationStatisticalStatus.Value= "Present" and Fields!intIsLate.Value = True,true,false),

                  IIF(instr(Parameters!txtAttendanceCategory.Value,"Late")=0,
                  IIF(Fields!intIsIncludedInStatistics.Value = 1 AND instr(Parameters!txtAttendanceCategory.Value,Fields!txtRegistrationStatisticalStatus.Value)&gt;0,true,false)
                  ,
                  IIF(Parameters!txtAttendanceCategory.Value&lt;&gt;"Late" and instr(Parameters!txtAttendanceCategory.Value,"Late")&gt;0,
                  IIF(Fields!intIsIncludedInStatistics.Value = 1
                  AND (instr(Parameters!txtAttendanceCategory.Value,Fields!txtRegistrationStatisticalStatus.Value)&gt;0
                  or (Fields!txtRegistrationStatisticalStatus.Value = "Present" and Fields!intIsLate.Value = True)),true,false),false
                  )))
                </FilterExpression><Operator>Equal</Operator><FilterValues><FilterValue>=true</FilterValue></FilterValues></Filter></Filters><Height>5.7cm</Height><Width>28.7cm</Width><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><Height>5.7cm</Height><Style /></Body><Width>28.7cm</Width><Page><PageHeader><Height>1.8cm</Height><PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><ReportItems><Image Name="SchoolLogoPage2"><Source>External</Source><Value>
                =IIF(Right(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), 1) = "/",
                Left(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), Len(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) - 1),
                First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) &amp; Lookup("School Logo", Fields!txtName.Value, Fields!txtSchoolLogoPath.Value, "SchoolLogo")
              </Value><Sizing>FitProportional</Sizing><Height>1.5cm</Height><Width>4.96cm</Width><Style><Border><Color>#8d8993</Color><Style>None</Style><Width>0.5pt</Width></Border></Style></Image><Textbox Name="Page2HeaderReportDetail"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Student Group Registration Status - </Value><Style><FontStyle>Normal</FontStyle><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><TextDecoration>None</TextDecoration><Color>#373948</Color></Style></TextRun><TextRun><Value>="Group By: " &amp;
SWITCH(
Parameters!txtGroupBy.Value = "txtDateTime", "Year",
Parameters!txtGroupBy.Value = "txtSurname", "Pupil",
Parameters!txtGroupBy.Value = "intNCYear", "Year",
Parameters!txtGroupBy.Value = "txtForm", "Form",
Parameters!txtGroupBy.Value = "txtEthnicGroup", "Ethnicity", 
Parameters!txtGroupBy.Value = "txtAcademicHouse", "Academic House",
Parameters!txtGroupBy.Value = "txtBoardingHouse", "Boarding House",
Parameters!txtGroupBy.Value = "txtPresentCode", "Year",
Parameters!txtGroupBy.Value = "txtCode", "Year",
Parameters!txtGroupBy.Value = "txtGender", "Gender",
Parameters!txtGroupBy.Value = "txtSen", "SEN",
Parameters!txtGroupBy.Value = "txtRegistrationGroup", "Registration Group",
True,""
)</Value><Style><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>=Format(CDate(Parameters!txtStartDate.value), "dd-MMM-yyyy") &amp; " - " &amp; Format(CDate(Parameters!txtEndDate.Value), "dd-MMM-yyyy") &amp; IIF(isnothing(Parameters!txtTime.Value), "", "  Times: " &amp; Parameters!txtTime.Value)</Value><Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value>=
IIF(NOT isNothing(Parameters!intNCYear.Value) OR 
	NOT isNothing(Parameters!txtAcademicHouse.Value) OR 
	NOT isNothing(Parameters!txtBoardingHouse.Value) OR 
	NOT isNothing(Parameters!txtForm.Value) OR 
	NOT isNothing(Parameters!txtSEN.Value) OR 
	NOT isNothing(Parameters!txtGender.Value) OR 
	NOT isNothing(Parameters!txtEthnicity.Value) OR 
	NOT isNothing(Parameters!txtRegistrationGroup.Value) , "; Filtered By:","") &amp; 
RTRIM(
IIF(isNothing(Parameters!intNCYear.Value), "", " Years: " &amp; Parameters!intNCYear.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtAcademicHouse.Value), "", " Academic Houses: " &amp; Parameters!txtAcademicHouse.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtBoardingHouse.Value), "", " Boarding Houses: " &amp; Parameters!txtBoardingHouse.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtForm.Value), "", " Forms: " &amp; Parameters!txtForm.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtSEN.Value), "", " SEN: " &amp; Parameters!txtSEN.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtGender.Value), "", " Gender: " &amp; Parameters!txtGender.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtEthnicity.Value), "", " Ethnicity: " &amp; Parameters!txtEthnicity.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtRegistrationGroup.Value), "", " Reg. Groups: " &amp; Parameters!txtRegistrationGroup.Value &amp; " ")
)</Value><Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Left>4.96cm</Left><Height>1.5cm</Height><Width>23.74cm</Width><ZIndex>1</ZIndex><Style><Border><Color>#8d8993</Color><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign></Style></Textbox></ReportItems><Style /></PageHeader><PageFooter><Height>0.7cm</Height><PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><ReportItems><Textbox Name="FooterPage2Detail"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Reported on </Value><Style><FontSize>9pt</FontSize><Color>#373948</Color></Style></TextRun><TextRun><Value>=Globals!ExecutionTime</Value><Style><FontSize>9pt</FontSize><Format>dd-MMM-yyyy</Format><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Top>0.1cm</Top><Height>0.5cm</Height><Width>7.75cm</Width><Style><Border><Color>#8d8993</Color><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="FooterPageNumber"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Page " &amp; Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value><Style><FontSize>9pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Top>0.1cm</Top><Left>12.6cm</Left><Height>0.5cm</Height><Width>3.5cm</Width><ZIndex>1</ZIndex><Style><Border><Color>#8d8993</Color><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><Pad