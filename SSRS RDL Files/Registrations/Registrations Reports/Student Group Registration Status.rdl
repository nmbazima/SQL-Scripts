isNothing(Fields!intRegistrationDateTimeID.Value), "Gainsboro",
Fields!txtColour.Value &lt;&gt;"","#"+Fields!txtColour.Value,
Fields!txtRegistrationStatisticalStatus.Value = "Present" AND Fields!intIsLate.Value = True, "#fad182",
Fields!txtRegistrationStatisticalStatus.Value = "Present" AND Fields!intIsAuthorisedAbsence.Value = True, "#8eceec",
Fields!txtRegistrationStatisticalStatus.Value = "Present", "#cbe3ba",
Fields!txtRegistrationStatisticalStatus.Value = "Absent" , "#d88bc0",
True,"Transparent"
)</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="txtReason"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtRegistrationReason.Value</Value><Style><FontSize>9pt</FontSize><FontWeight>Normal</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>txtReason</rd:DefaultName><ZIndex>4</ZIndex><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Width></Border><BottomBorder><Style>Solid</Style><Width>0.5pt</Width></BottomBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="textbox41"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>
