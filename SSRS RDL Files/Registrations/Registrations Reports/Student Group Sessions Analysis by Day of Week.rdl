COUNTDISTINCT(
IIF(Parameters!txtAttendanceCategory.Value="Late",
IIF(Fields!intIsIncludedInStatistics.Value=1 and Fields!txtRegistrationStatisticalStatus.Value = "Present" 
and Fields!intIsLate.Value = True AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00"
,Fields!intRegistrationDateTimeID.Value &amp; Fields!txtSchoolID.Value,nothing),

IIF(instr(Parameters!txtAttendanceCategory.Value,"Late")=0,
	IIF(Fields!intIsIncludedInStatistics.Value=1 AND instr(Parameters!txtAttendanceCategory.Value,Fields!txtRegistrationStatisticalStatus.Value)&gt;0
	AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00"
	,Fields!intRegistrationDateTimeID.Value &amp; Fields!txtSchoolID.Value,nothing)
	,
IIF(Parameters!txtAttendanceCategory.Value&lt;&gt;"Late" and instr(Parameters!txtAttendanceCategory.Value,"Late")&gt;0,
	IIF(Fields!intIsIncludedInStatistics.Value=1
	AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00"
	AND (instr(Parameters!txtAttendanceCategory.Value,Fields!txtRegistrationStatisticalStatus.Value)&gt;0 
		or (Fields!txtRegistrationStatisticalStatus.Value = "Present" and Fields!intIsLate.Value = True)),Fields!intRegistrationDateTimeID.Value &amp; Fields!txtSchoolID.Value,nothing),nothing
	
	))))

,

IIF(CountDistinct(IIF(Fields!intIsIncludedInStatistics.Value=1 AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00",Cstr(Fields!intRegistrationDateTimeID.Value) + Cstr(Fields!txtSchoolID.Value),nothing))=0,0,
Round(
COUNTDISTINCT(
IIF(Parameters!txtAttendanceCategory.Value="Late",
IIF(Fields!intIsIncludedInStatistics.Value=1 and Fields!txtRegistrationStatisticalStatus.Value = "Present" 
and Fields!intIsLate.Value = True AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00"
,Fields!intRegistrationDateTimeID.Value &amp; Fields!txtSchoolID.Value,nothing),

IIF(instr(Parameters!txtAttendanceCategory.Value,"Late")=0,
	IIF(Fields!intIsIncludedInStatistics.Value=1 AND instr(Parameters!txtAttendanceCategory.Value,Fields!txtRegistrationStatisticalStatus.Value)&gt;0
	AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00"
	,Fields!intRegistrationDateTimeID.Value &amp; Fields!txtSchoolID.Value,nothing)
	,
IIF(Parameters!txtAttendanceCategory.Value&lt;&gt;"Late" and instr(Parameters!txtAttendanceCategory.Value,"Late")&gt;0,
	IIF(Fields!intIsIncludedInStatistics.Value=1
	AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00"
	AND (instr(Parameters!txtAttendanceCategory.Value,Fields!txtRegistrationStatisticalStatus.Value)&gt;0 
		or (Fields!txtRegistrationStatisticalStatus.Value = "Present" and Fields!intIsLate.Value = True)),Fields!intRegistrationDateTimeID.Value &amp; Fields!txtSchoolID.Value,nothing),nothing
	
	))))
	
	/ 
COUNTDISTINCT(IIF(Fields!intIsIncludedInStatistics.Value=1 AND Format(Fields!dtRegistrationDateTime.Value,"HH:mm")&lt;"12:00",
Fields!intRegistrationDateTimeID.Value &amp; Fields!txtSchoolID.Value,nothing)) * 100,1,System.MidpointRounding.AwayFromZero))

)</Value><Style><FontSize>9pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtRegistrationCode</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Width></Border><BottomBorder><Style>Solid</Style></BottomBorder><LeftBorder><Style>Solid</Style></LeftBorder><RightBorder><Style>Solid</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>1pt</PaddingLeft><PaddingRight>1pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell><TablixCell><CellContents><Textbox Name="txtRegistrationCode12"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(Parameters!intShowCounts.Value=1,

