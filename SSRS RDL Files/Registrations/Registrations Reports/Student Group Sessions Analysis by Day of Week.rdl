 xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></Values></DefaultValue><AllowBlank>true</AllowBlank><Prompt>txtRegistrationGroup</Prompt></ReportParameter><ReportParameter Name="intNCYear"><DataType>String</DataType><Nullable>true</Nullable><Prompt>intNCYear</Prompt></ReportParameter><ReportParameter Name="txtAcademicHouse"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>txtAcademicHouse</Prompt></ReportParameter><ReportParameter Name="txtBoardingHouse"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>txtBoardingHouse</Prompt></ReportParameter><ReportParameter Name="txtForm"><DataType>String</DataType><Nullable>true</Nullable><Prompt>txtForm</Prompt></ReportParameter><ReportParameter Name="txtAttendanceCategory"><DataType>String</DataType><Prompt>txtAttendanceCategory</Prompt></ReportParameter><ReportParameter Name="intShowCounts"><DataType>Integer</DataType><Prompt>intShowCounts</Prompt></ReportParameter><ReportParameter Name="txtSEN"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>txtSEN</Prompt></ReportParameter><ReportParameter Name="txtGender"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>txtGender</Prompt></ReportParameter><ReportParameter Name="txtEthnicity"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>txtEthnicity</Prompt></ReportParameter><ReportParameter Name="userCode"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>userCode</Prompt></ReportParameter></ReportParameters><Code>Public FirstFive AS String = "@ - Absent (no code)" + vbnewline
Public SecondFive AS String = ""
Public ThirdFive AS String = ""
Public TourthFive AS String = ""
Public FifthFive AS String = ""
Public SixthFive AS String = ""
Public RecordCount AS Integer = 0
Public PresentCodes AS String = "/ - Present (am - no code)" + vbnewline + "\ - Present (pm - no code)" + vbnewline

Public Function getCodeDescriptions (ByVal singleCode As String, ByVal singleDescription As String)
if RecordCount &lt;4 then
	FirstFive = FirstFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;3 and  RecordCount &lt;8 then
	SecondFive = SecondFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;7 and  RecordCount &lt;13 then
	ThirdFive = ThirdFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;12 and  RecordCount &lt;18 then
	TourthFive = TourthFive + singleCode + " - " + singleDescription + vbnewline	

end if  
if RecordCount &gt;17 and  RecordCount &lt;23 then
	FifthFive = FifthFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;22 and  RecordCount &lt;31 then
	SixthFive = SixthFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
RecordCount = RecordCount + 1
End Function

Public Function getPresentCode (ByVal singlePCode As String, ByVal singlePDescription As String)
	
PresentCodes = PresentCodes + singlePCode +" - " + singlePDescription + vbnewline
 
End Function</Code><EmbeddedImages><EmbeddedImage Name="iSAMSLine"><MIMEType>image/png</MIMEType><ImageData></ImageData></EmbeddedImage></EmbeddedImages><Language>en-GB</Language><ConsumeContainerWhitespace>true</ConsumeContainerWhitespace><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>36d3aa52-5785-466c-9dda-a872ad57105f</rd:ReportID></Report>