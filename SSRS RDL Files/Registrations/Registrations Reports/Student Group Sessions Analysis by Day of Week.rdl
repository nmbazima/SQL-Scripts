Parameters!txtGroupBy.Value ="txtRegistrationGroup",Fields!txtRegistrationGroupName.Value,
true,Fields(Parameters!txtGroupBy.Value).Value)</GroupExpression></GroupExpressions><PageBreak><BreakLocation>Between</BreakLocation><ResetPageNumber>true</ResetPageNumber></PageBreak></Group><SortExpressions><SortExpression><Value>=IIF(Parameters!txtGroupBy.Value="txtForm",Fields!intNCYear.Value,1=1)</Value></SortExpression><SortExpression><Value>=SWITCH(Parameters!txtGroupBy.Value ="txtSurname", Fields!txtSurname.Value + IIF(Fields!txtPreName.Value ="" or Fields!txtPreName.Value=" ",Fields!txtForename.Value , Fields!txtPreName.Value),
Parameters!txtGroupBy.Value ="txtRegistrationGroup",Fields!txtRegistrationGroupType.Value &amp; Fields!txtRegistrationGroupName.Value,
true,Fields(Parameters!txtGroupBy.Value).Value)</Value></SortExpression></SortExpressions><TablixMembers><TablixMember /></TablixMembers><DataElementOutput>Output</DataElementOutput><KeepTogether>true</KeepTogether></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>Attendance</DataSetName><Height>3.4cm</Height><Width>28.7cm</Width><Style><Language>en-GB</Language></Style></Tablix></ReportItems><Height>3.4cm</Height><Style /></Body><Width>28.7cm</Width><Page><PageHeader><Height>1.8cm</Height><PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><ReportItems><Image Name="SchoolLogoPage2"><Source>External</Source><Value>=IIF(Right(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), 1) = "/",
Left(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), Len(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) - 1),
First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) &amp; Lookup("School Logo", Fields!txtName.Value, Fields!txtSchoolLogoPath.Value, "SchoolLogo")</Value><Sizing>FitProportional</Sizing><Height>1.5cm</Height><Width>4.96cm</Width><Style><Border><Color>#8d8993</Color><Style>None</Style><Width>0.5pt</Width></Border></Style></Image><Textbox Name="Page2HeaderReportDetail"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Student Group Analysis by Day of Week </Value><Style><FontStyle>Normal</FontStyle><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><TextDecoration>None</TextDecoration><Color>#373948</Color></Style></TextRun><TextRun><Value>="Group By: " &amp;
SWITCH(
Parameters!txtGroupBy.Value = "txtDateTime", "Year",
Parameters!txtGroupBy.Value = "txtSurname", "Pupil",
Parameters!txtGroupBy.Value = "intNCYear", "Year",
Parameters!txtGroupBy.Value = "txtForm", "Form",
Parameters!txtGroupBy.Value = "txtEthnicGroup", "Ethnicity", 
Parameters!txtGroupBy.Value = "txtAcademicHouse", "Academic House",
Parameters!txtGroupBy.Value = "txtBoardingHouse", "Boarding House",
Parameters!txtGroupBy.Value = "txtPresentCode", "Year",
Parameters!txtGroupBy.Value = "txtCode", "Year",
Parameters!txtGroupBy.Value = "txtGender", "Gender",
Parameters!txtGroupBy.Value = "txtSen", "SEN",
Parameters!txtGroupBy.Value = "txtRegistrationGroup", "Registration Group",
True,""
)</Value><Style><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>=Format(CDate(Parameters!txtStartDate.value), "dd-MMM-yyyy") &amp; " - " &amp; Format(CDate(Parameters!txtEndDate.Value), "dd-MMM-yyyy") &amp; IIF(isnothing(Parameters!txtTime.Value), "", "  Times: " &amp; Parameters!txtTime.Value)</Value><Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value>; </Value><Style><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun><TextRun><Value>=IIF(Parameters!intShowCounts.Value = 1, "Number of", "Percentage of")</Value><Style><FontStyle>Normal</FontStyle><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><TextDecoration>None</TextDecoration><Color>#373948</Color></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontStyle>Normal</FontStyle><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><TextDecoration>None</TextDecoration><Color>#373948</Color></Style></TextRun><TextRun><Value>=Replace(Parameters!txtAttendanceCategory.Value, ",", ", ")</Value><Style><FontStyle>Normal</FontStyle><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><TextDecoration>None</TextDecoration><Color>#373948</Color></Style></TextRun><TextRun><Value>=
IIF(NOT isNothing(Parameters!intNCYear.Value) OR 
	NOT isNothing(Parameters!txtAcademicHouse.Value) OR 
	NOT isNothing(Parameters!txtBoardingHouse.Value) OR 
	NOT isNothing(Parameters!txtForm.Value) OR 
	NOT isNothing(Parameters!txtSEN.Value) OR 
	NOT isNothing(Parameters!txtGender.Value) OR 
	NOT isNothing(Parameters!txtEthnicity.Value) OR 
	NOT isNothing(Parameters!txtRegistrationGroup.Value) , "; Filtered By:","") &amp; 
RTRIM(
IIF(isNothing(Parameters!intNCYear.Value), "", " Years: " &amp; Parameters!intNCYear.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtAcademicHouse.Value), "", " Academic Houses: " &amp; Parameters!txtAcademicHouse.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtBoardingHouse.Value), "", " Boarding Houses: " &amp; Parameters!txtBoardingHouse.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtForm.Value), "", " Forms: " &amp; Parameters!txtForm.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtSEN.Value), "", " SEN: " &amp; Parameters!txtSEN.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtGender.Value), "", " Gender: " &amp; Parameters!txtGender.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtEthnicity.Value), "", " Ethnicity: " &amp; Parameters!txtEthnicity.Value &amp; " ") &amp; 
IIF(isNothing(Parameters!txtRegistrationGroup.Value), "", " Reg. Groups: " &amp; Parameters!txtRegistrationGroup.Value &amp; " ")
