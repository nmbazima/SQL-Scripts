Round(CountDistinct(IIF(Fields!intIsIncludedInStatistics.Value=1 AND Fields!txtRegistrationStatisticalStatus.Value="Present" AND Fields!intIsLate.Value=true,Cstr(Fields!intRegistrationDateTimeID.Value) + Cstr(Fields!txtSchoolID.Value),nothing))/
CountDistinct(IIF(Fields!intIsIncludedInStatistics.Value=1,Cstr(Fields!intRegistrationDateTimeID.Value) + Cstr(Fields!txtSchoolID.Value),nothing)) *100,1,System.MidpointRounding.AwayFromZero))</Value><Style><FontSize>9pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtRegistrationCode</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Width></Border><BottomBorder><Style>Solid</Style></BottomBorder><LeftBorder><Style>None</Style></LeftBorder><RightBorder><Style>None</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell><TablixCell><CellContents><Textbox Name="txtRegistrationCode22"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=CountDistinct(IIF(Fields!intIsIncludedInStatistics.Value=1 AND Fields!txtRegistrationStatisticalStatus.Value="Absent" 
AND Fields!intIsAuthorisedAbsence.Value = true,
Cstr(Fields!intRegistrationDateTimeID.Value) + Cstr(Fields!txtSchoolID.Value),nothing))</Value><Style><FontSize>9pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtRegistrationCode</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>None</Style><Width>0.5pt</Width></Border><BottomBorder><Style>Solid</Style></BottomBorder><LeftBorder><Style>None</Style></LeftBorder><RightBorder><Style>None</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell><TablixCell><CellContents><Textbox Name="txtRegistrationCode23"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(CountDistinct(IIF(Fields!intIsIncludedInStatistics.Value=1,Cstr(Fields!intRegistrationDateTimeID.Value) + Cstr(Fields!txtSchoolID.Value),nothing))=0,0,
Round(CountDistinct(IIF(Fields!intIsIncludedInStatistics.Value=1 AND Fields!txtRegistrationStatisticalStatus.Value="Absent" AND Fields!intIsAuthorisedAbsence.Value = true
,Cstr(Fields!intRegistrationDateTimeID.Value) + Cstr(Fields!txtSchoolID.Value),nothing))/
CountDistinct(IIF(Fields!intIsIncludedInStatistics.Value=1,Cstr(Fields!intRegistrationDateTimeID.Value) + Cstr(Fields!txtSchoolID.Value),nothing)) * 100,1,System.MidpointRounding.AwayFromZero)
