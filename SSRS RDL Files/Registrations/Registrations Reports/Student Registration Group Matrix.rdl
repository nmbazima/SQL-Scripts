                        <VerticalAlign>Bottom</VerticalAlign>
                        <PaddingLeft>1pt</PaddingLeft>
                        <PaddingRight>1pt</PaddingRight>
                      </Style>
                      <ZIndex>3</ZIndex>
                      <Value>=Fields!txtRegistrationGroupName.Value + ": " + 
IIF(Fields!txtRegistrationGroupName.Value="Tutor Group",Fields!txtRegistrationTutorGroupTutor.Value,
Fields!txtRegistrationGroup.Value + " - " + Fields!RegistrationTeacherTitle.Value + " " + Left(Fields!RegistrationTeacherFirstname.Value,1) + " " + Fields!RegistrationTeacherSurname.Value)</Value>
