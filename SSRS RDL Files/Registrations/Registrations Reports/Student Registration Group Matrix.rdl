                            <PaddingTop>1pt</PaddingTop>
                            <PaddingBottom>1pt</PaddingBottom>
                          </Style>
                          <ZIndex>1</ZIndex>
                          <Value>=Fields!txtSurname.Value + ", " + IIF(Fields!txtPreName.Value="" or Fields!txtPreName.Value=" ", Fields!txtForename.Value,Fields!txtPreName.Value)</Value>
                        </Textbox>
                      </ReportItems>
