                              <Value>=IIF(SUM(IIF(Fields!txtCountIntoStatistics.Value="Yes" AND Fields!txtRegistaredAsStatistics.Value="Present" and Fields!blnLate.Value="True",1,0))&gt;0,Round((SUM(IIF(Fields!txtCountIntoStatistics.Value="Yes" AND Fields!txtRegistaredAsStatistics.Value="Present" and Fields!blnLate.Value="True",1,0))/SUM(IIF(Fields!txtCountIntoStatistics.Value="Yes",1,0))) * 100,1),"0")</Value>
                            </Textbox>
                          </ReportItems>
                        </TableCell>
