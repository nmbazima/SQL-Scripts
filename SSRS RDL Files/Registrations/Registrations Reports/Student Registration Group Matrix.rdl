                              <PaddingTop>1pt</PaddingTop>
                              <PaddingBottom>1pt</PaddingBottom>
                            </Style>
                            <Value>=IIF(Fields!txtRegistrationCode.Value="Not Registered","",IIF(Fields!txtRegistrationCode.Value="8",IIF(Fields!txtTime.Value&lt;"12:00","/","\"),IIF(Fields!txtRegistrationCode.Value="5",IIF(Fields!txtTime.Value&lt;"12:00","\","/"),Fields!txtRegistrationCode.Value)))</Value>
                          </Textbox>
                        </ReportItems>
                      </MatrixCell>
