  <LeftMargin>0.5cm</LeftMargin>
  <PageHeader>
    <PrintOnFirstPage>true</PrintOnFirstPage>
    <ReportItems>
      <Textbox Name="textbox31">
        <Top>0.6cm</Top>
        <Width>18.7cm</Width>
        <Style>
          <BorderStyle>
            <Bottom>Solid</Bottom>
          </BorderStyle>
          <BorderWidth>
            <Default>2pt</Default>
          </BorderWidth>
          <FontSize>12pt</FontSize>
          <FontWeight>700</FontWeight>
          <TextAlign>Left</TextAlign>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
          <PaddingTop>2pt</PaddingTop>
          <PaddingBottom>2pt</PaddingBottom>
          <Language>en-GB</Language>
        </Style>
        <ZIndex>3</ZIndex>
        <Height>0.6cm</Height>
        <Value>=Format(CDate(Parameters!txtStartDate.value),"dd/MM/yyyy")  + " - " + Format(CDate(Parameters!txtEndDate.Value),"dd/MM/yyyy") + IIF(isnothing(Parameters!txtTime.Value),"",": " + Parameters!txtTime.Value)</Value>
      </Textbox>
      <Textbox Name="textbox80">
        <Top>0.8cm</Top>
        <Style>
          <BorderStyle>
            <Bottom>Solid</Bottom>
          </BorderStyle>
          <BorderWidth>
            <Default>2pt</Default>
          </BorderWidth>
          <FontSize>8pt</FontSize>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
        <ZIndex>2</ZIndex>
        <Left>18.7cm</Left>
        <Height>0.4cm</Height>
        <Value>=ReportItems!textbox1.Value</Value>
      </Textbox>
      <Textbox Name="textbox81">
        <Top>0.4cm</Top>
        <Style>
          <FontSize>8pt</FontSize>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
        </Style>
        <ZIndex>1</ZIndex>
        <Left>18.7cm</Left>
        <Height>0.4cm</Height>
        <Value>=IIF(isNothing(Parameters!txtSchoolID.Value),IIF(isNothing(Parameters!intNCYear.Value),"","Years: " &amp; Parameters!intNCYear.Value &amp; "     ") 
&amp; IIF(isNothing(Parameters!txtAcademicHouse.Value),"","Academic Houses: " &amp; Parameters!txtAcademicHouse.Value &amp; "     ") 
&amp; IIF(isNothing(Parameters!txtBoardingHouse.Value),"","Boarding Houses: " &amp; Parameters!txtBoardingHouse.Value &amp; "     ") 
&amp; IIF(isNothing(Parameters!txtForm.Value),"","Forms: " &amp; Parameters!txtForm.Value &amp; "     ")
&amp; IIF(isNothing(Parameters!txtRegistrationGroup.Value),"","Reg Groups: " &amp; Parameters!txtRegistrationGroup.Value &amp; "     "),"")</Value>
      </Textbox>
      <Textbox Name="textbox127">
        <Width>18.7cm</Width>
        <Style>
          <BorderWidth>
            <Default>2pt</Default>
          </BorderWidth>
          <FontSize>12pt</FontSize>
          <FontWeight>700</FontWeight>
          <TextAlign>Left</TextAlign>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
          <PaddingTop>1pt</PaddingTop>
          <PaddingBottom>1pt</PaddingBottom>
          <Language>en-GB</Language>
        </Style>
        <Height>0.6cm</Height>
        <Value>="Student Registration Group Matrix"</Value>
      </Textbox>
    </ReportItems>
    <Height>1.4cm</Height>
    <PrintOnLastPage>true</PrintOnLastPage>
  </PageHeader>
  <BottomMargin>0.5cm</BottomMargin>
