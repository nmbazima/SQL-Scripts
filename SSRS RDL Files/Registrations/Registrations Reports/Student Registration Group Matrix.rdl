                            <Style>
                              <Color>=IIF(Fields!txtCountIntoStatistics.Value="Yes","Black","DarkGray")</Color>
                              <BackgroundColor>=IIF(isNothing(Fields!txtDateTime.Value),"Gainsboro",IIF(Fields!blnLate.Value="True" AND Fields!txtRegistaredAsStatistics.Value="Present","Khaki",IIF(Fields!txtRegistaredAsStatistics.Value="Absent" and Fields!txtCountIntoStatistics.Value="Yes","LightCoral","White")))</BackgroundColor>
                              <BorderColor>
                                <Default>Silver</Default>
                              </BorderColor>
                              <BorderStyle>
                                <Left>None</Left>
                                <Right>None</Right>
