                              </Style>
                              <CanGrow>true</CanGrow>
                              <Value>=IIF(SUM(IIF(Fields!txtRegistrationStatus.Value="Not Registered",1,0))&gt;0,Round((SUM(IIF(Fields!txtRegistrationStatus.Value="Not Registered",1,0))/SUM(IIF(Fields!txtCountIntoStatistics.Value="Yes",1,0))) * 100,1),"0")</Value>
