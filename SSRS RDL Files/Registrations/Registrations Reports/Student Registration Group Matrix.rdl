          <DataField>txtTimeAsAMPM</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtYearCode">
          <DataField>txtYearCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RegistrationTeacherTitle">
          <DataField>RegistrationTeacherTitle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RegistrationTeacherFirstname">
          <DataField>RegistrationTeacherFirstname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RegistrationTeacherSurname">
          <DataField>RegistrationTeacherSurname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RegistrationTeacherID">
          <DataField>RegistrationTeacherID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="intPresentCodeID">
          <DataField>intPresentCodeID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="intCodeID">
          <DataField>intCodeID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <CommandText>SELECT        TblRegistrationSchoolRegistrationDateTime.TblRegistrationSchoolRegistrationDateTimeID, TblRegistrationSchoolRegistrationDateTime.txtDateTime, 
                         TblRegistrationSchoolRegistrationPupils.txtSubmitBy, TblRegistrationSchoolRegistrationPupils.txtSchoolID, TblPupilsArchive.txtSurname, 
                         TblPupilsArchive.txtPreName, TblPupilManagementPupils.txtDOB, TblPupilsArchive.txtForename, TblPupilsArchive.txtForm, TblPupilsArchive.intNCYear, 
                         TblPupilsArchive.txtAcademicHouse, TblPupilsArchive.txtBoardingHouse, TblRegistrationSchoolRegistrationPupils.blnRegistered, TblPupilsArchive.txtYearName, 
                         LEFT(CONVERT(varchar(8), TblRegistrationSchoolRegistrationDateTime.txtDateTime, 108), 5) AS txtTime, TblRegistrationSchoolRegistrationPupils.txtReason, 
                         TblRegistrationSchoolRegistrationPupils.blnLate, TblRegistrationSchoolRegistrationPupils.intMinutesLate, TblRegistrationSchoolRegistrationPupils.txtSubmitBy, 
                         TblRegistrationOutOfSchoolPupils.txtSchoolID AS OOStxtSchoolID, CASE WHEN TblRegistrationOutOfSchoolPupils.txtSchoolID IS NOT NULL AND 
                         (TblRegistrationSchoolRegistrationPupils.blnRegistered &lt;&gt; 1) THEN 'Absent' ELSE CASE WHEN (TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL 
                         AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 0) THEN 'Absent' WHEN (TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) AND 
                         TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL THEN 'Present' ELSE 'Not Registered' END END AS txtRegistrationStatus, 
                         CASE WHEN TblRegistrationOutOfSchoolPupils.txtSchoolID IS NOT NULL AND (TblRegistrationSchoolRegistrationPupils.blnRegistered &lt;&gt; 1 OR
                         TblRegistrationSchoolRegistrationPupils.blnRegistered IS NULL) THEN CASE WHEN TblRegistrationOutOfSchoolPupils.intCode IS NOT NULL 
                         THEN OOSCodes.txtCode ELSE '5' END ELSE CASE WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NOT NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL) 
                         THEN TblRegistrationSchoolRegistrationCodes.txtCode WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL) 
                         THEN '5' WHEN (TblRegistrationSchoolRegistrationPupils.intPresentCode IS NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN '8' WHEN (TblRegistrationSchoolRegistrationPupils.intPresentCode IS NOT NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN TblRegistrationSchoolRegistrationPresentCodes.txtCode ELSE 'Not Registered' END END AS txtRegistrationCode, 
                         CASE WHEN TblRegistrationOutOfSchoolPupils.txtSchoolID IS NOT NULL AND (TblRegistrationSchoolRegistrationPupils.blnRegistered &lt;&gt; 1 OR
                         TblRegistrationSchoolRegistrationPupils.blnRegistered IS NULL) THEN CASE WHEN TblRegistrationOutOfSchoolPupils.intCode IS NOT NULL 
                         THEN OOSCodes.txtName ELSE '' END ELSE CASE WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NOT NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL) 
                         THEN TblRegistrationSchoolRegistrationCodes.txtName WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL) 
                         THEN '' WHEN (TblRegistrationSchoolRegistrationPupils.intPresentCode IS NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN '' WHEN (TblRegistrationSchoolRegistrationPupils.intPresentCode IS NOT NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN TblRegistrationSchoolRegistrationPresentCodes.txtName ELSE 'Not Registered' END END AS txtRegistrationCodeName, 
                         TblPupilManagementPupils.intSystemStatus, CASE WHEN TblRegistrationOutOfSchoolPupils.txtSchoolID IS NOT NULL AND 
                         (TblRegistrationSchoolRegistrationPupils.blnRegistered &lt;&gt; 1 OR
                         TblRegistrationSchoolRegistrationPupils.blnRegistered IS NULL) 
                         THEN (CASE WHEN OOSCodes.blnStatistic = 1 THEN 'Yes' WHEN OOSCodes.blnStatistic = 0 THEN 'No' ELSE 'Yes' END) 
                         ELSE (CASE WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NOT NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND 
                         TblRegistrationSchoolRegistrationCodes.blnStatistic = 1) THEN 'Yes' WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NOT NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND TblRegistrationSchoolRegistrationCodes.blnStatistic = 0) 
                         THEN 'No' WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND 
                         TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL) THEN 'Yes' WHEN (TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN 'Yes' ELSE 'Yes' END) END AS txtCountIntoStatistics, CASE WHEN TblRegistrationOutOfSchoolPupils.txtSchoolID IS NOT NULL AND 
                         (TblRegistrationSchoolRegistrationPupils.blnRegistered &lt;&gt; 1 OR
                         TblRegistrationSchoolRegistrationPupils.blnRegistered IS NULL) 
                         THEN (CASE WHEN OOSCodes.blnAbsence = 1 THEN 'Absent' WHEN OOSCodes.blnAbsence = 0 THEN 'Present' ELSE 'Absent' END) 
                         ELSE (CASE WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NOT NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND 
                         TblRegistrationSchoolRegistrationCodes.blnAbsence = 1) THEN 'Absent' WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NOT NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND TblRegistrationSchoolRegistrationCodes.blnAbsence = 0) 
                         THEN 'Present' WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND 
                         TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL) THEN 'Absent' WHEN (TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN 'Present' ELSE 'Not Registered' END) END AS txtRegistaredAsStatistics, CASE WHEN TblRegistrationOutOfSchoolPupils.txtSchoolID IS NOT NULL AND 
                         (TblRegistrationSchoolRegistrationPupils.blnRegistered &lt;&gt; 1 OR
                         TblRegistrationSchoolRegistrationPupils.blnRegistered IS NULL) 
                         THEN (CASE WHEN OOSCodes.blnAuthorised = 1 THEN 'Authorised' WHEN OOSCodes.blnAuthorised = 0 THEN 'UnAuthorised' ELSE 'UnAuthorised' END) 
                         ELSE (CASE WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NOT NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND 
                         TblRegistrationSchoolRegistrationCodes.blnAuthorised = 1) THEN 'Authorised' WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NOT NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND TblRegistrationSchoolRegistrationCodes.blnAuthorised = 0) 
                         THEN 'UnAuthorised' WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND 
                         TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL) THEN 'UnAuthorised' WHEN (TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN 'Present' ELSE 'Not Registered' END) END AS txtAuthorisedAbsence, CASE WHEN TblRegistrationOutOfSchoolPupils.txtSchoolID IS NOT NULL AND 
                         (TblRegistrationSchoolRegistrationPupils.blnRegistered &lt;&gt; 1 OR
                         TblRegistrationSchoolRegistrationPupils.blnRegistered IS NULL) THEN CASE WHEN TblRegistrationOutOfSchoolPupils.intCode IS NOT NULL 
                         THEN OOSCodes.intOrder ELSE 0 END ELSE CASE WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NOT NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0) 
                         THEN TblRegistrationSchoolRegistrationCodes.intOrder WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL) 
                         THEN 0 WHEN (TblRegistrationSchoolRegistrationPupils.intPresentCode IS NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN 0 WHEN (TblRegistrationSchoolRegistrationPupils.intPresentCode IS NOT NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN TblRegistrationSchoolRegistrationPresentCodes.intOrder ELSE 1000 END END AS intCodeOrder, DATEPART(wk, 
                         TblRegistrationSchoolRegistrationDateTime.txtDateTime) AS intRegistrationWeek, TblRegistrationSchoolRegistrationDateTime.txtDateTime - (DATEPART(DW, 
                         TblRegistrationSchoolRegistrationDateTime.txtDateTime) - 1) AS txtWeekStart, (CASE WHEN (TblPupilManagementPupils.intSystemStatus = 1 AND 
                         (TblRegistrationSchoolRegistrationDateTime.txtDateTime &gt;= TblPupilManagementPupils.txtEnrolmentDate OR
                         TblPupilManagementPupils.txtEnrolmentDate IS NULL) AND (TblRegistrationSchoolRegistrationDateTime.txtDateTime &lt;= DATEADD(day, 1, 
                         TblPupilManagementPupils.txtLeavingDate) OR
                         TblPupilManagementPupils.txtLeavingDate IS NULL)) THEN 'Yes' WHEN (TblPupilManagementPupils.intSystemStatus = - 1 AND 
                         (TblRegistrationSchoolRegistrationDateTime.txtDateTime &gt;= TblPupilManagementPupils.txtEnrolmentDate OR
                         TblPupilManagementPupils.txtEnrolmentDate IS NULL) AND TblRegistrationSchoolRegistrationDateTime.txtDateTime &lt;= DATEADD(day, 1, 
                         TblPupilManagementPupils.txtLeavingDate)) THEN 'Yes' ELSE 'No' END) AS txtIsOnRoll, 
                         TblPupilsArchive.txtMiddleNames, TblPupilsArchive.Title, TblPupilsArchive.Firstname, TblPupilsArchive.Surname, 
                         TblPupilsArchive.Initials, TblRegistrationSchoolRegistrationDateTime.txtAmPm, 
                         TblRegistrationSchoolRegistrationPupilsGroups.txtValue AS txtRegistrationGroup, 
                         TblRegistrationSchoolRegistrationPupilsGroups.txtObject AS txtRegistrationGroupName, 
                         (CASE WHEN TblRegistrationSchoolRegistrationPupilsGroups.txtObject = 'Tutor Group' THEN
                             (SELECT        Title + ' ' + LEFT(Firstname, 1) + ' ' + Surname AS txtRegistrationTutorGroupTutor
                               FROM            TblStaff AS RegistrationGroupTutor
                               WHERE        TblRegistrationSchoolRegistrationPupilsGroups.txtValue = RegistrationGroupTutor.User_Code) ELSE '' END) AS txtRegistrationTutorGroupTutor, 
                               (CASE WHEN (DATEPART(HOUR, 
                         TblRegistrationSchoolRegistrationDateTime.txtDateTime)) &lt; 12 THEN 'AM' ELSE 'PM' END) AS txtTimeAsAMPM, TblPupilsArchive.txtYearCode, 
                         RegistrationTeacher.Title AS RegistrationTeacherTitle, RegistrationTeacher.Firstname AS RegistrationTeacherFirstname, 
                         RegistrationTeacher.Surname AS RegistrationTeacherSurname, TblRegistrationSchoolRegistrationPupilsGroups.txtTeacher AS RegistrationTeacherID, 
                         (CASE WHEN TblRegistrationOutOfSchoolPupils.txtSchoolID IS NOT NULL AND (TblRegistrationSchoolRegistrationPupils.blnRegistered &lt;&gt; 1 OR
                         TblRegistrationSchoolRegistrationPupils.blnRegistered IS NULL) THEN CASE WHEN TblRegistrationOutOfSchoolPupils.intCode IS NOT NULL 
                         THEN - 5 ELSE - 5 END ELSE CASE WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NOT NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0) THEN - 5 WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL) 
                         THEN - 5 WHEN (TblRegistrationSchoolRegistrationPupils.intPresentCode IS NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN - 5 WHEN (TblRegistrationSchoolRegistrationPupils.intPresentCode IS NOT NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN TblRegistrationSchoolRegistrationPupils.intPresentCode ELSE - 5 END END) AS intPresentCodeID, 
                         (CASE WHEN TblRegistrationOutOfSchoolPupils.txtSchoolID IS NOT NULL AND (TblRegistrationSchoolRegistrationPupils.blnRegistered &lt;&gt; 1 OR
                         TblRegistrationSchoolRegistrationPupils.blnRegistered IS NULL) THEN CASE WHEN TblRegistrationOutOfSchoolPupils.intCode IS NOT NULL 
                         THEN TblRegistrationOutOfSchoolPupils.intCode ELSE - 5 END ELSE CASE WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NOT NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0) 
                         THEN TblRegistrationSchoolRegistrationPupils.intCode WHEN (TblRegistrationSchoolRegistrationPupils.intCode IS NULL AND 
                         TblRegistrationSchoolRegistrationPupils.blnRegistered = 0 AND TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL) 
                         THEN - 5 WHEN (TblRegistrationSchoolRegistrationPupils.intPresentCode IS NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN - 5 WHEN (TblRegistrationSchoolRegistrationPupils.intPresentCode IS NOT NULL AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 1) 
                         THEN - 5 ELSE - 5 END END) AS intCodeID
FROM            TblRegistrationSchoolRegistrationRegister INNER JOIN
                         TblRegistrationSchoolRegistrationDateTime ON 
                         TblRegistrationSchoolRegistrationRegister.intRegistrationDateTime = TblRegistrationSchoolRegistrationDateTime.TblRegistrationSchoolRegistrationDateTimeID AND
                          TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @txtStartDate AND @txtEndDate INNER JOIN
                         TblRegistrationSchoolRegistrationPupils ON 
                         TblRegistrationSchoolRegistrationPupils.intRegister = TblRegistrationSchoolRegistrationRegister.TblRegistrationSchoolRegistrationRegisterID INNER JOIN
                         TblPupilManagementPupils ON TblRegistrationSchoolRegistrationPupils.txtSchoolID = TblPupilManagementPupils.txtSchoolID CROSS 
                         APPLY dbo.uf_Registration_getPupilArchive(TblRegistrationSchoolRegistrationPupils.txtSchoolID, @txtEndDate) AS TblPupilsArchive LEFT OUTER JOIN
                         TblRegistrationOutOfSchoolPupils ON TblRegistrationOutOfSchoolPupils.txtSchoolID = TblPupilManagementPupils.txtSchoolID AND 
                         TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN TblRegistrationOutOfSchoolPupils.txtStartDateTime AND 
                         TblRegistrationOutOfSchoolPupils.txtEndDateTime LEFT OUTER JOIN
                         TblRegistrationSchoolRegistrationCodes ON 
                         TblRegistrationSchoolRegistrationPupils.intCode = TblRegistrationSchoolRegistrationCodes.TblRegistrationSchoolRegistrationCodesID LEFT OUTER JOIN
                         TblRegistrationSchoolRegistrationPresentCodes ON 
                         TblRegistrationSchoolRegistrationPupils.intPresentCode = TblRegistrationSchoolRegistrationPresentCodes.TblRegistrationSchoolRegistrationPresentCodesID LEFT OUTER
                          JOIN
                         TblRegistrationSchoolRegistrationCodes AS OOSCodes ON 
                         TblRegistrationOutOfSchoolPupils.intCode = OOSCodes.TblRegistrationSchoolRegistrationCodesID 
                          LEFT OUTER JOIN
TblRegistrationSchoolRegistrationPupilsGroups ON TblRegistrationSchoolRegistrationPupils.txtSchoolID = TblRegistrationSchoolRegistrationPupilsGroups.txtSchoolId AND 
TblRegistrationSchoolRegistrationPupilsGroups.intRegister = TblRegistrationSchoolRegistrationRegister.TblRegistrationSchoolRegistrationRegisterID LEFT OUTER JOIN
TblStaff AS RegistrationTeacher ON TblRegistrationSchoolRegistrationPupilsGroups.txtTeacher = RegistrationTeacher.User_Code
WHERE        (TblPupilManagementPupils.txtSchoolID = TblPupilsArchive.txtSchoolID) AND (TblPupilsArchive.txtForm IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtForm) AS SplitCSV_1) OR
                         @txtForm IS NULL) AND (TblPupilsArchive.intNCYear IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@intNCYear) AS SplitCSV_1) OR
                         @intNCYear IS NULL) AND (TblPupilsArchive.txtAcademicHouse IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtAcademicHouse) AS SplitCSV_1) OR
                         @txtAcademicHouse IS NULL) AND (TblPupilsArchive.txtBoardingHouse IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtBoardingHouse) AS SplitCSV_1) OR
                         @txtBoardingHouse IS NULL) AND (LEFT(CONVERT(varchar(8), TblRegistrationSchoolRegistrationDateTime.txtDateTime, 108), 5) IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtTime) AS SplitCSV_1) OR
                         @txtTime IS NULL) AND (TblPupilManagementPupils.txtSchoolID IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtSchoolID) AS SplitCSV_1) OR
                         @txtSchoolID IS NULL) 
                         AND (TblRegistrationSchoolRegistrationPupilsGroups.txtValue IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtRegistrationGroup) AS SplitCSV_1) OR
                         @txtRegistrationGroup IS NULL)
                         
                         AND (TblPupilManagementPupils.txtSchoolID IN
                             (SELECT DISTINCT txtSchoolID
                               FROM            TblPupilManagementSelectionsStudents
                               WHERE        (ISNULL(intDeleted, 0) &lt;&gt; 1) AND (intSelectionID IN
                                                             (SELECT        ID
                                                               FROM            dbo.SplitCSV(@txtCustomGroups) AS SplitCSV_1))) OR
                         @txtCustomGroups IS NULL) AND ((CASE WHEN (TblPupilManagementPupils.intSystemStatus = 1 AND 
                         (TblRegistrationSchoolRegistrationDateTime.txtDateTime &gt;= TblPupilManagementPupils.txtEnrolmentDate OR
                         TblPupilManagementPupils.txtEnrolmentDate IS NULL) AND (TblRegistrationSchoolRegistrationDateTime.txtDateTime &lt;= DATEADD(day, 1, 
                         TblPupilManagementPupils.txtLeavingDate) OR
                         TblPupilManagementPupils.txtLeavingDate IS NULL)) THEN 'Yes' WHEN (TblPupilManagementPupils.intSystemStatus = - 1 AND 
                         (TblRegistrationSchoolRegistrationDateTime.txtDateTime &gt;= TblPupilManagementPupils.txtEnrolmentDate OR
                         TblPupilManagementPupils.txtEnrolmentDate IS NULL) AND TblRegistrationSchoolRegistrationDateTime.txtDateTime &lt;= DATEADD(day, 1, 
                         TblPupilManagementPupils.txtLeavingDate)) THEN 'Yes' ELSE 'No' END) = 'Yes') AND (TblRegistrationSchoolRegistrationDateTime.txtAmPm IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtAmPm) AS SplitCSV_1) OR
                         @txtAmPm IS NULL)</CommandText>
        <QueryParameters>
          <QueryParameter Name="@txtStartDate">
            <Value>=Parameters!txtStartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtEndDate">
            <Value>=Parameters!txtEndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtForm">
            <Value>=Parameters!txtForm.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@intNCYear">
            <Value>=Parameters!intNCYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtAcademicHouse">
            <Value>=Parameters!txtAcademicHouse.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtBoardingHouse">
            <Value>=Parameters!txtBoardingHouse.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtTime">
            <Value>=Parameters!txtTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtSchoolID">
            <Value>=Parameters!txtSchoolID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtRegistrationGroup">
            <Value>=Parameters!txtRegistrationGroup.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtCustomGroups">
            <Value>=Parameters!txtCustomGroups.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtAmPm">
            <Value>=Parameters!txtAmPm.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
    </DataSet>
  </DataSets>
  <Code>Public FirstFive AS String = "@ - Absent (no code)" + vbnewline
Public SecondFive AS String = ""
Public ThirdFive AS String = ""
Public TourthFive AS String = ""
Public FifthFive AS String = ""
Public SixthFive AS String = ""
Public RecordCount AS Integer = 0
Public PresentCodes AS String = "/ - Present (am - no code)" + vbnewline + "\ - Present (pm - no code)" + vbnewline

Public Function getCodeDescriptions (ByVal singleCode As String, ByVal singleDescription As String)
if RecordCount &lt;4 then
	FirstFive = FirstFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;3 and  RecordCount &lt;8 then
	SecondFive = SecondFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;7 and  RecordCount &lt;13 then
	ThirdFive = ThirdFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;12 and  RecordCount &lt;18 then
	TourthFive = TourthFive + singleCode + " - " + singleDescription + vbnewline	

end if  
if RecordCount &gt;17 and  RecordCount &lt;23 then
	FifthFive = FifthFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
if RecordCount &gt;22 and  RecordCount &lt;31 then
	SixthFive = SixthFive + singleCode + " - " + singleDescription + vbnewline	
	
end if  
RecordCount = RecordCount + 1
End Function

Public Function getPresentCode (ByVal singlePCode As String, ByVal singlePDescription As String)
	
PresentCodes = PresentCodes + singlePCode +" - " + singlePDescription + vbnewline
 
End Function</Code>
