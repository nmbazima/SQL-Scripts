        <Field Name="txtRowNumber">
          <DataField>txtRowNumber</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <CommandText>SELECT        txtCode, txtName, TblRegistrationSchoolRegistrationPresentCodesID AS intID, intOrder, 'Present' AS txtType, ROW_NUMBER() OVER (ORDER BY intORDER)  AS txtRowNumber
FROM            TblRegistrationSchoolRegistrationPresentCodes

UNION ALL
SELECT        txtCode, txtName, TblRegistrationSchoolRegistrationCodesID AS intID, intOrder, 'Absent'AS txtType,
ROW_NUMBER() OVER (ORDER BY intORDER) AS txtRowNumber
FROM            TblRegistrationSchoolRegistrationCodes
WHERE blnActive =1</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
