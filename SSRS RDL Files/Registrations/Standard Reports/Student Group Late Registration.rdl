<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="iSAMS">
      <DataSourceReference>iSAMS</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>100ed8fb-e4a2-4b82-96f2-9bf7e7bae13d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Attendance">
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@txtSchoolID">
            <Value>=Parameters!txtSchoolID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtTime">
            <Value>=Parameters!txtTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtRegistrationType">
            <Value>=Parameters!txtRegistrationType.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtLateCode">
            <Value>=Parameters!txtLateCode.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Students AS NVARCHAR(MAX);
SET @Students = STUFF((SELECT DISTINCT ',' + txtSchoolID FROM TblPupilManagementPupils WHERE txtSchoolID IN (@txtSchoolID) FOR XML PATH('')), 1, 1, '');

WITH SessionsCount AS
	(SELECT	Attendance.txtSchoolID, COUNT(DISTINCT Attendance.intRegistrationDateTimeID) AS 'intSessionCount'
	 FROM	dbo.uf_Registration_AttendanceBetweenDates(@StartDate, DATEADD(DAY, 1, @EndDate), @Students) AS Attendance
	 WHERE	LEFT(CONVERT(VARCHAR(8), Attendance.dtRegistrationDateTime, 108), 5) IN (@txtTime)
			AND CASE WHEN Attendance.txtRegistrationAMPM IS NULL THEN 'Other' ELSE UPPER(Attendance.txtRegistrationAMPM) END IN (@txtRegistrationType)
			AND ((Attendance.txtRegistrationStatisticalStatus = 'Absent' AND Attendance.txtCode = 'U') OR (Attendance.txtRegistrationStatisticalStatus = 'Present' AND Attendance.intIsLate = 1))
			AND (CASE WHEN Attendance.txtRegistrationStatisticalStatus = 'Present' AND Attendance.intIsLate = 1 THEN 'L' ELSE 'U' END) IN (@txtLateCode)
	 GROUP BY Attendance.txtSchoolID
	 --HAVING COUNT(DISTINCT Attendance.intRegistrationDateTimeID) &lt; @Sessions
	)

SELECT	SessionsCount.*,
		PupilArchive.txtForename, 
		PupilArchive.txtPreName, 
		PupilArchive.txtMiddleNames, 
		PupilArchive.txtSurname, 
		PupilArchive.txtAcademicHouse, 
		PupilArchive.txtBoardingHouse, 
		PupilArchive.intNCYear, 
		PupilArchive.txtYearName, 
		PupilArchive.txtYearCode, 
		PupilArchive.txtForm, 
		PupilArchive.Initials AS 'txtTutorInitials',
		TblPupilManagementPupils.txtGender, 
		TblPupilManagementPupils.txtEthnicGroup
FROM	SessionsCount
CROSS APPLY dbo.uf_Registration_getPupilArchive(SessionsCount.txtSchoolID, @EndDate) AS PupilArchive 
INNER JOIN TblPupilManagementPupils ON SessionsCount.txtSchoolID = TblPupilManagementPupils.txtSchoolID</CommandText>
      </Query>
      <Fields>
        <Field Name="txtSchoolID">
          <DataField>txtSchoolID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtForename">
          <DataField>txtForename</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtSurname">
          <DataField>txtSurname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtMiddleNames">
          <DataField>txtMiddleNames</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtPreName">
          <DataField>txtPreName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtForm">
          <DataField>txtForm</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtGender">
          <DataField>txtGender</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtEthnicGroup">
          <DataField>txtEthnicGroup</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtAcademicHouse">
          <DataField>txtAcademicHouse</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtBoardingHouse">
          <DataField>txtBoardingHouse</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="intNCYear">
          <DataField>intNCYear</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="txtYearName">
          <DataField>txtYearName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtYearCode">
          <DataField>txtYearCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtTutorInitials">
          <DataField>txtTutorInitials</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="intSessionCount">
          <DataField>intSessionCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NoGroup">
          <Value>NoGroup</Value>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="iSAMSAddress">
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <CommandText>SELECT txtExternaliSAMSAddress AS txtiSAMSAddress
FROM TbliSAMSManagerSettings</CommandText>
      </Query>
      <Fields>
        <Field Name="txtiSAMSAddress">
          <DataField>txtiSAMSAddress</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="SchoolLogo">
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <CommandText>SELECT TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS txtSchoolLogoPath, txtName
FROM TblReportsCustomImages
WHERE TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="txtSchoolLogoPath">
          <DataField>txtSchoolLogoPath</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtName">
          <DataField>txtName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Disclaimer">
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Path">
            <Value>=Globals!ReportFolder</Value>
          </QueryParameter>
          <QueryParameter Name="@Report">
            <Value>=Globals!ReportName</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
		TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
FROM	TblSQLReportingServicesDisclaimerReport
		INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
		AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report</CommandText>
      </Query>
      <Fields>
        <Field Name="txtDisclaimerBackgroundColour">
          <DataField>txtDisclaimerBackgroundColour</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtDisclaimerBorderColour">
          <DataField>txtDisclaimerBorderColour</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtDisclaimerDescription">
          <DataField>txtDisclaimerDescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtDisclaimerTextColour">
          <DataField>txtDisclaimerTextColour</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtDisclaimerTitle">
          <DataField>txtDisclaimerTitle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="YearGroups">
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtTime">
            <Value>=Parameters!txtTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtRegistrationType">
            <Value>=Parameters!txtRegistrationType.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@intSystemStatus">
            <Value>=Parameters!intSystemStatus.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH YearGroups AS
(
SELECT DISTINCT PupilArchive.intNCYear

FROM TblRegistrationSchoolRegistrationPupils
CROSS APPLY dbo.uf_Registration_getPupilArchive(TblRegistrationSchoolRegistrationPupils.txtSchoolID, @EndDate) AS PupilArchive 
INNER JOIN TblPupilManagementPupils ON TblRegistrationSchoolRegistrationPupils.txtSchoolID = TblPupilManagementPupils.txtSchoolID
INNER JOIN TblRegistrationSchoolRegistrationRegister ON TblRegistrationSchoolRegistrationPupils.intRegister = TblRegistrationSchoolRegistrationRegister.TblRegistrationSchoolRegistrationRegisterID
INNER JOIN TblRegistrationSchoolRegistrationDateTime ON TblRegistrationSchoolRegistrationRegister.intRegistrationDateTime = TblRegistrationSchoolRegistrationDateTime.TblRegistrationSchoolRegistrationDateTimeID

WHERE TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @StartDate AND DateAdd(day,1,@EndDate)
AND LEFT(CONVERT(varchar(8), TblRegistrationSchoolRegistrationDateTime.txtDateTime, 108), 5) IN (@txtTime)
AND CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 'Other' ELSE UPPER(TblRegistrationSchoolRegistrationDateTime.txtAmPm ) END IN (@txtRegistrationType)
AND TblPupilManagementPupils.intSystemStatus IN(@intSystemStatus)
)

SELECT	CASE WHEN txtYearName IS NULL THEN -100 ELSE TblSchoolManagementYears.intNCYear END AS intNCYear, 
CASE WHEN txtYearName IS NULL THEN 'No Year Group'  ELSE TblSchoolManagementYears.txtYearName END AS txtYearName
FROM	YearGroups
LEFT OUTER JOIN TblSchoolManagementYears ON YearGroups.intNCYear = TblSchoolManagementYears.intNCYear
ORDER BY intNCYear
</CommandText>
      </Query>
      <Fields>
        <Field Name="intNCYear">
          <DataField>intNCYear</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="txtYearName">
          <DataField>txtYearName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Students">
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtTime">
            <Value>=Parameters!txtTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@intNCYear">
            <Value>=Parameters!intNCYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtRegistrationType">
            <Value>=Parameters!txtRegistrationType.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@intSystemStatus">
            <Value>=Parameters!intSystemStatus.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
SELECT DISTINCT TblRegistrationSchoolRegistrationPupils.txtSchoolID,
TblPupilManagementPupils.txtSurname + ', ' + TblPupilManagementPupils.txtForename  AS txtStudentName

FROM TblRegistrationSchoolRegistrationPupils
CROSS APPLY dbo.uf_Registration_getPupilArchive(TblRegistrationSchoolRegistrationPupils.txtSchoolID, @EndDate) AS PupilArchive 
INNER JOIN TblPupilManagementPupils ON TblRegistrationSchoolRegistrationPupils.txtSchoolID = TblPupilManagementPupils.txtSchoolID
INNER JOIN TblRegistrationSchoolRegistrationRegister ON TblRegistrationSchoolRegistrationPupils.intRegister = TblRegistrationSchoolRegistrationRegister.TblRegistrationSchoolRegistrationRegisterID
INNER JOIN TblRegistrationSchoolRegistrationDateTime ON TblRegistrationSchoolRegistrationRegister.intRegistrationDateTime = TblRegistrationSchoolRegistrationDateTime.TblRegistrationSchoolRegistrationDateTimeID
LEFT OUTER JOIN TblSchoolManagementYears ON PupilArchive.intNCYear = TblSchoolManagementYears.intNCYear
WHERE TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @StartDate AND DateAdd(day,1,@EndDate)
AND LEFT(CONVERT(varchar(8), TblRegistrationSchoolRegistrationDateTime.txtDateTime, 108), 5) IN (@txtTime)
AND CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 'Other' ELSE UPPER(TblRegistrationSchoolRegistrationDateTime.txtAmPm ) END IN (@txtRegistrationType)
AND TblPupilManagementPupils.intSystemStatus IN(@intSystemStatus)
AND (CASE WHEN TblSchoolManagementYears.txtYearName IS NULL THEN -100 ELSE TblSchoolManagementYears.intNCYear END) IN (@intNCYear)

ORDER BY txtStudentName

</CommandText>
      </Query>
      <Fields>
        <Field Name="txtSchoolID">
          <DataField>txtSchoolID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtStudentName">
          <DataField>txtStudentName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="User">
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@userCode">
            <Value>=Parameters!userCode.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
	TbliSAMSManagerUsers.txtUsername,
	TbliSAMSManagerUsers.txtFirstname,
	TbliSAMSManagerUsers.txtSurname,
	TbliSAMSManagerUsers.txtEmailAddress
FROM TbliSAMSManagerUsers
WHERE TbliSAMSManagerUsers.txtUserCode = @userCode</CommandText>
      </Query>
      <Fields>
        <Field Name="txtUsername">
          <DataField>txtUsername</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtFirstname">
          <DataField>txtFirstname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtSurname">
          <DataField>txtSurname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtEmailAddress">
          <DataField>txtEmailAddress</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RegistrationTypes">
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 'Other' ELSE UPPER(TblRegistrationSchoolRegistrationDateTime.txtAmPm) END AS txtType,
CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 2 ELSE 1 END AS intTypeOrder
FROM TblRegistrationSchoolRegistrationDateTime
WHERE TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @StartDate AND @EndDate
ORDER BY intTypeOrder, txtType</CommandText>
      </Query>
      <Fields>
        <Field Name="txtType">
          <DataField>txtType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="intTypeOrder">
          <DataField>intTypeOrder</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RegistrationTimes">
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtRegistrationType">
            <Value>=Parameters!txtRegistrationType.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT LEFT(CONVERT(varchar(8), TblRegistrationSchoolRegistrationDateTime.txtDateTime, 108), 5) AS txtTime
FROM TblRegistrationSchoolRegistrationDateTime
WHERE TblRegistrationSchoolRegistrationDateTime.txtDateTime BETWEEN @StartDate AND @EndDate
AND CASE WHEN TblRegistrationSchoolRegistrationDateTime.txtAmPm IS NULL THEN 'Other' ELSE UPPER(TblRegistrationSchoolRegistrationDateTime.txtAmPm) END IN (@txtRegistrationType)
ORDER BY txtTime</CommandText>
      </Query>
      <Fields>
        <Field Name="txtTime">
          <DataField>txtTime</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="StartOfAcademicYear">
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <CommandText>SELECT	TOP 1 TblSchoolManagementTermDates.txtStartDate
		 FROM	TblSchoolManagementTermDates
		 WHERE	TblSchoolManagementTermDates.intSchoolYear = (
		 SELECT Top(1) intSchoolYear FROM TblSchoolManagementTermDates WHERE txtStartDate &lt;= GETDATE() ORDER BY txtStartDate DESC
		 )
		 ORDER BY TblSchoolManagementTermDates.txtStartDate ASC</CommandText>
      </Query>
      <Fields>
        <Field Name="txtStartDate">
          <DataField>txtStartDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
