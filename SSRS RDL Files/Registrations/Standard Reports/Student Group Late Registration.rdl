  <ReportParameters>
    <ReportParameter Name="StartDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>StartOfAcademicYear</DataSetName>
          <ValueField>txtStartDate</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Registration From:</Prompt>
    </ReportParameter>
    <ReportParameter Name="EndDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=Today()</Value>
        </Values>
      </DefaultValue>
      <Prompt>Registration To:</Prompt>
    </ReportParameter>
    <ReportParameter Name="txtRegistrationType">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>AM</Value>
          <Value>PM</Value>
        </Values>
      </DefaultValue>
      <Prompt>Registration Type:</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>RegistrationTypes</DataSetName>
          <ValueField>txtType</ValueField>
          <LabelField>txtType</LabelField>
        </DataSetReference>
      </ValidValues>
      <MultiValue>true</MultiValue>
    </ReportParameter>
    <ReportParameter Name="txtTime">
      <DataType>String</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>RegistrationTimes</DataSetName>
          <ValueField>txtTime</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Registration Time:</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>RegistrationTimes</DataSetName>
          <ValueField>txtTime</ValueField>
          <LabelField>txtTime</LabelField>
        </DataSetReference>
      </ValidValues>
      <MultiValue>true</MultiValue>
    </ReportParameter>
    <ReportParameter Name="txtLateCode">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>L</Value>
          <Value>U</Value>
        </Values>
      </DefaultValue>
      <Prompt>Late Code:</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>L</Value>
            <Label>L - Late (Before Registers Closed)</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>U</Value>
            <Label>U - Late (After Registers Closed)</Label>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
      <MultiValue>true</MultiValue>
    </ReportParameter>
    <ReportParameter Name="userCode">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>Test</Value>
        </Values>
      </DefaultValue>
      <Prompt>user Code</Prompt>
      <Hidden>true</Hidden>
    </ReportParameter>
    <ReportParameter Name="intSystemStatus">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>1</Value>
          <Value>-1</Value>
        </Values>
      </DefaultValue>
      <Prompt>System Status:</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>1</Value>
            <Label>Current</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>-1</Value>
            <Label>Leaver</Label>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
      <MultiValue>true</MultiValue>
    </ReportParameter>
    <ReportParameter Name="intNCYear">
      <DataType>String</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>YearGroups</DataSetName>
          <ValueField>intNCYear</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Year Group:</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>YearGroups</DataSetName>
          <ValueField>intNCYear</ValueField>
          <LabelField>txtYearName</LabelField>
        </DataSetReference>
      </ValidValues>
      <MultiValue>true</MultiValue>
    </ReportParameter>
    <ReportParameter Name="txtSchoolID">
      <DataType>String</DataType>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>Students</DataSetName>
          <ValueField>txtSchoolID</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>Student:</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>Students</DataSetName>
          <ValueField>txtSchoolID</ValueField>
          <LabelField>txtStudentName</LabelField>
        </DataSetReference>
      </ValidValues>
      <MultiValue>true</MultiValue>
    </ReportParameter>
    <ReportParameter Name="ValuRange">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>MoreThan</Value>
        </Values>
      </DefaultValue>
      <Prompt>Valu Range:</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>LessThan</Value>
            <Label>Less than</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>Exactly</Value>
            <Label>Exactly</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>MoreThan</Value>
            <Label>More than</Label>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="Sessions">
      <DataType>Integer</DataType>
      <Prompt>Sessions:</Prompt>
    </ReportParameter>
    <ReportParameter Name="GroupBy">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>intNCYear</Value>
        </Values>
      </DefaultValue>
      <Prompt>Group Students By:</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>txtGender</Value>
            <Label>Gender</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>txtEthnicGroup</Value>
            <Label>Ethnic Category</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>intNCYear</Value>
            <Label>Year Group</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>txtForm</Value>
            <Label>Form</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>txtAcademicHouse</Value>
            <Label>Academic House</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>txtBoardingHouse</Value>
            <Label>Boarding House</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>txtBoardingStatus</Value>
            <Label>Boarding Status</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>NoGroup</Value>
            <Label>N/A</Label>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
