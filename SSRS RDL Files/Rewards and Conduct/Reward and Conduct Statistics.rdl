<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>Demo</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>8d92afbf-cd90-407f-a943-6f76159c04a2</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Main"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtSubmitBy"><Value>=Parameters!txtSubmitBy.Value</Value></QueryParameter><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter><QueryParameter Name="@txtForm"><Value>=Parameters!txtForm.Value</Value></QueryParameter><QueryParameter Name="@txtAcademicHouse"><Value>=Parameters!txtAcademicHouse.Value</Value></QueryParameter><QueryParameter Name="@txtBoardingHouse"><Value>=Parameters!txtBoardingHouse.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@TblRewardsManagerRewardTypesID"><Value>=Parameters!TblRewardsManagerRewardTypesID.Value</Value></QueryParameter><QueryParameter Name="@txtStartDate"><Value>=Parameters!txtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter><QueryParameter Name="@intSubject"><Value>=Parameters!intSubject.Value</Value></QueryParameter><QueryParameter Name="@intDepartment"><Value>=Parameters!intDepartment.Value</Value></QueryParameter><QueryParameter Name="@TblRewardsManagerRewardTypesCategoriesID"><Value>=Parameters!TblRewardsManagerRewardTypesCategoriesID.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT        TblPupilManagementPupils.txtForename, TblPupilManagementPupils.txtSurname, TblPupilManagementPupils.txtMiddleNames, 
                         TblPupilManagementPupils.txtBoardingHouse, TblPupilManagementPupils.txtForm, TblPupilManagementPupils.intNCYear, TblPupilManagementPupils.txtTutor, 
                         TblSchoolManagementYears.txtYearCode, TblStaff.LabelSalutation, TblRewardsManagerRewardTypesCategories.intValue, 
                         TblRewardsManagerRewardTypesCategories.intActive, TblRewardsManagerRewards.txtSubmitDateTime, TblRewardsManagerRewards.txtSubmitBy, 
                         TblPupilManagementPupils.txtAcademicHouse, TblRewardsManagerRewardTypes.TblRewardsManagerRewardTypesID, TblStaff.Firstname, TblStaff.Title, 
                         TblStaff.Surname, TblPupilManagementPupils.txtPreName, TblRewardsManagerRewardTypes.txtName, AwardingTeacher.Title AS ATTitle, 
                         AwardingTeacher.Firstname AS ATFirstname, AwardingTeacher.Surname AS ATSurname, TblPupilManagementPupils.txtSchoolID, 
                         CASE WHEN TblRewardsManagerRewardTypesCategories.intValue IS NULL OR
                         TblRewardsManagerRewardTypesCategories.intValue = '' THEN 0 ELSE TblRewardsManagerRewardTypesCategories.intValue END AS RewardValue, 
                         TblPupilManagementPupils.txtDOB, TblPupilManagementPupils.intSystemStatus, TblRewardsManagerRewardTypes.intPositive, 
                         TblRewardsManagerRewardTypes.intOrder, TblRewardsManagerRewards.txtDate, TblTeachingManagerSubjects.txtSubjectName, 
                         TblTeachingManagerSubjectDepartments.txtDepartmentName, TblRewardsManagerRewards.intDepartment, TblRewardsManagerRewards.intSubject
FROM            TblRewardsManagerRewards LEFT JOIN
                         TblRewardsManagerRewardTypesCategories ON 
                         TblRewardsManagerRewardTypesCategories.TblRewardsManagerRewardTypesCategoriesID = TblRewardsManagerRewards.intCategory INNER JOIN
                         TblRewardsManagerRewardTypes ON 
                         TblRewardsManagerRewards.intType = TblRewardsManagerRewardTypes.TblRewardsManagerRewardTypesID INNER JOIN
                         TblPupilManagementPupils ON TblPupilManagementPupils.txtSchoolID = TblRewardsManagerRewards.txtSchoolID LEFT OUTER JOIN
                         TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear LEFT OUTER JOIN
                         TblStaff ON TblPupilManagementPupils.txtTutor = TblStaff.User_Code LEFT OUTER JOIN
                         TblStaff AS AwardingTeacher ON TblRewardsManagerRewards.txtSubmitBy = AwardingTeacher.User_Code LEFT OUTER JOIN
                         TblSchoolManagementHouses ON TblPupilManagementPupils.txtAcademicHouse = TblSchoolManagementHouses.txtHouseName LEFT OUTER JOIN
                         TblTeachingManagerSubjects ON TblRewardsManagerRewards.intSubject = TblTeachingManagerSubjects.TblTeachingManagerSubjectsID LEFT OUTER JOIN
                         TblTeachingManagerSubjectDepartments ON 
                         TblRewardsManagerRewards.intDepartment = TblTeachingManagerSubjectDepartments.TblTeachingManagerSubjectDepartmentsID
WHERE        (TblRewardsManagerRewards.intAuthorised = 1) AND (TblPupilManagementPupils.intSystemStatus = 1) AND (TblRewardsManagerRewards.txtSubmitBy IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtSubmitBy) AS SplitCSV_1) OR
                         @txtSubmitBy IS NULL) AND (TblPupilManagementPupils.intNCYear IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@intNCYear) AS SplitCSV_1) OR
                         @intNCYear IS NULL) AND (TblPupilManagementPupils.txtForm IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtForm) AS SplitCSV_1) OR
                         @txtForm IS NULL) AND (TblPupilManagementPupils.txtAcademicHouse IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtAcademicHouse) AS SplitCSV_1) OR
                         @txtAcademicHouse IS NULL) AND (TblPupilManagementPupils.txtBoardingHouse IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtBoardingHouse) AS SplitCSV_1) OR
                         @txtBoardingHouse IS NULL) AND (TblRewardsManagerRewards.txtSchoolID IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtSchoolID) AS SplitCSV_1) OR
                         @txtSchoolID IS NULL) AND (TblRewardsManagerRewardTypes.TblRewardsManagerRewardTypesID IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@TblRewardsManagerRewardTypesID) AS SplitCSV_1) OR
                         @TblRewardsManagerRewardTypesID IS NULL) AND (TblRewardsManagerRewards.txtDate BETWEEN @txtStartDate AND @txtEndDate) AND 
                         (TblRewardsManagerRewards.intSubject IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@intSubject) AS SplitCSV_1) OR
                         @intSubject IS NULL) AND (TblRewardsManagerRewards.intDepartment IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@intDepartment) AS SplitCSV_1) OR
                         @intDepartment IS NULL) AND (TblRewardsManagerRewardTypesCategories.TblRewardsManagerRewardTypesCategoriesID IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@TblRewardsManagerRewardTypesCategoriesID) AS SplitCSV_1) OR
                         @TblRewardsManagerRewardTypesCategoriesID IS NULL)</CommandText></Query><Fields><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtTutor"><DataField>txtTutor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="labelsalutation"><DataField>LabelSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intValue"><DataField>intValue</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intActive"><DataField>intActive</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSubmitDateTime"><DataField>txtSubmitDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtSubmitBy"><DataField>txtSubmitBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblRewardsManagerRewardTypesID"><DataField>TblRewardsManagerRewardTypesID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Title"><DataField>Title</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ATTitle"><DataField>ATTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ATFirstname"><DataField>ATFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ATSurname"><DataField>ATSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="RewardValue"><DataField>RewardValue</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtDOB"><DataField>txtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intSystemStatus"><DataField>intSystemStatus</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intPositive"><DataField>intPositive</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtDate"><DataField>txtDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtSubjectName"><DataField>txtSubjectName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDepartmentName"><DataField>txtDepartmentName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intDepartment"><DataField>intDepartment</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intSubject"><DataField>intSubject</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="list1"><TablixBody><TablixColumns><TablixColumn><Width>19.6cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>2.3cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="list1_Contents"><ReportItems><Tablix Name="matrix1"><TablixCorner><TablixCornerRows><TablixCornerRow><TablixCornerCell><CellContents><Textbox Name="textbox25"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(Parameters!txtGroupBy.Value.ToString = "txtDate"  ,(Format(Fields(Parameters!txtGroupBy.Value).value,"dd/MM/yyyy") ),IIF(Parameters!txtGroupBy.Value = "txtSubmitBy",Fields!ATSurname.Value + ", " + Fields!ATFirstname.Value,IIF(Parameters!txtGroupBy.Value = "txtSurname" or Parameters!txtGroupBy.Value = "intNCYear","Year " &amp; Fields!intNCYear.Value,
IIF(Parameters!txtGroupBy.Value.ToString = "intDepartment",Fields!txtDepartmentName.Value,IIF(Parameters!txtGroupBy.Value.ToString = "intSubject",Fields!txtSubjectName.Value,
Fields(Parameters!txtGroupBy.Value).value)))))</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><ZIndex>3</ZIndex><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><LeftBorder><Style>None</Style></LeftBorder><RightBorder><Style>None</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCornerCell><TablixCornerCell><CellContents><Textbox Name="textbox42"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>House</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>textbox42</rd:DefaultName><ZIndex>2</ZIndex><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><LeftBorder><Style>None</Style></LeftBorder><RightBorder><Style>None</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCornerCell><TablixCornerCell><CellContents><Textbox Name="textbox27"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Form</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>textbox27</rd:DefaultName><ZIndex>1</ZIndex><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><LeftBorder><Style>None</Style></LeftBorder><RightBorder><Style>None</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCornerCell><TablixCornerCell><CellContents><Textbox Name="textbox43"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Year</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>textbox43</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><LeftBorder><Style>None</Style></LeftBorder><RightBorder><Style>None</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCornerCell></TablixCornerRow></TablixCornerRows></TablixCorner><TablixBody><TablixColumns><TablixColumn><Width>2.4cm</Width></TablixColumn><TablixColumn><Width>2.4cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="textbox38"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=COUNT(IIF(Fields!RewardValue.Value&gt;0,1,0)) &amp; "[" &amp; IIF(ISNothing(Fields!RewardValue.Value),0,SUM(Fields!RewardValue.Value)) &amp; "]"</Value><Style /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>textbox38</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell><TablixCell><CellContents><Textbox Name="textbox28"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=COUNT(IIF(Fields!RewardValue.Value&gt;0,1,0)) &amp; "[" &amp; IIF(ISNothing(Fields!RewardValue.Value),0,SUM(Fields!RewardValue.Value)) &amp; "]"</Value><Style /></Tex