xtAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell><TablixCell><CellContents><Textbox Name="Textbox5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox5</rd:DefaultName><Style><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="textbox19"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=COUNT(IIF(Fields!RewardValue.Value&gt;0,1,0))/ReportItems!PupilCount.Value</Value><Style><Format>0.00;(0.00)</Format></Style></TextRun><TextRun><Value>[</Value><Style /></TextRun><TextRun><Value>=IIF(ISNothing(Fields!RewardValue.Value),0,SUM(Fields!RewardValue.Value))/ReportItems!PupilCount.Value</Value><Style><Format>0.00</Format></Style></TextRun><TextRun><Value>]</Value><Style /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell><TablixCell><CellContents><Textbox Name="textbox22"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=COUNT(IIF(Fields!RewardValue.Value&gt;0,1,0))/ReportItems!PupilCount.Value</Value><Style><Format>0.00;(0.00)</Format></Style></TextRun><TextRun><Value>[</Value><Style /></TextRun><TextRun><Value>=IIF(ISNothing(Fields!RewardValue.Value),0,SUM(Fields!RewardValue.Value))/ReportItems!PupilCount.Value</Value><Style><Format>0.00</Format></Style></TextRun><TextRun><Value>]</Value><Style /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell><TablixCell><CellContents><Textbox Name="Textbox6"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox6</rd:DefaultName><Style><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents><DataElementOutput>Output</DataElementOutput></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember><Group Name="TblRewardsManagerRewardTypesID"><GroupExpressions><GroupExpression>=Fields!TblRewardsManagerRewardTypesID.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!intOrder.Value</Value></SortExpression></SortExpressions><TablixHeader><Size>0.6cm</Size><CellContents><Textbox Name="TblRewardsManagerRewardTypesID"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtName.Value</Value><Style><FontSize>=SWITCH(Len(Fields!txtName.Value)&gt;15,"6pt",
