        <Field Name="TblPupilManagementHealthConditionsID">
          <DataField>TblPupilManagementHealthConditionsID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="txtType">
          <DataField>txtType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtExplanation">
          <DataField>txtExplanation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtTreatment">
          <DataField>txtTreatment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtOnset">
          <DataField>txtOnset</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtAction">
          <DataField>txtAction</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtFutherInfo">
          <DataField>txtFutherInfo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtYearName">
          <DataField>txtYearName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <CommandText>SELECT        TblPupilManagementPupils.txtSchoolID, TblPupilManagementPupils.txtPreName, TblPupilManagementPupils.txtDOB, TblPupilManagementPupils.txtForename, 
                         TblPupilManagementPupils.txtAcademicHouse, TblPupilManagementPupils.txtSurname, 
                         TblPupilManagementHealthConditions.TblPupilManagementHealthConditionsID, TblPupilManagementHealthConditions.txtType, 
                         TblPupilManagementHealthConditions.txtExplanation, TblPupilManagementHealthConditions.txtTreatment, TblPupilManagementHealthConditions.txtOnset, 
                         TblPupilManagementHealthConditions.txtAction, TblPupilManagementHealthConditions.txtFutherInfo, TblSchoolManagementYears.txtYearName
FROM            TblPupilManagementHealthConditions INNER JOIN
                         TblPupilManagementPupils ON TblPupilManagementHealthConditions.txtSchoolID = TblPupilManagementPupils.txtSchoolID LEFT OUTER JOIN
                         TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear
WHERE        (TblPupilManagementPupils.txtSchoolID IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtSchoolID) AS SplitCSV_3)) AND (TblPupilManagementHealthConditions.txtType IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtType) AS SplitCSV_1)) OR
                         (TblPupilManagementPupils.txtSchoolID IN
                             (SELECT        ID
                               FROM            dbo.SplitCSV(@txtSchoolID) AS SplitCSV_2)) AND (@txtType IS NULL)
ORDER BY TblPupilManagementPupils.txtSurname, TblPupilManagementPupils.txtForename, TblPupilManagementPupils.txtSchoolID, 
                         TblPupilManagementHealthConditions.txtSubmitDateTime DESC</CommandText>
        <QueryParameters>
          <QueryParameter Name="@txtSchoolID">
            <Value>=Parameters!txtSchoolID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtType">
            <Value>=Parameters!txtType.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
