        </Field>
        <Field Name="txtSurname">
          <DataField>txtSurname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TblPupilManagementHealthDiaryID">
          <DataField>TblPupilManagementHealthDiaryID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="txtType">
          <DataField>txtType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtDate">
          <DataField>txtDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="txtTime">
          <DataField>txtTime</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtProblem">
          <DataField>txtProblem</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtAction">
          <DataField>txtAction</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="txtUsername">
          <DataField>txtUsername</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <CommandText>SELECT 
pupils.txtSchoolID,
pupils.txtForename,
pupils.txtSurname,
diary.TblPupilManagementHealthDiaryID,
diary.txtType,
diary.txtDate,
diary.txtTime,
diary.txtProblem,
diary.txtAction,
users.txtUsername 
FROM TblPupilManagementHealthDiary diary
INNER JOIN TblPupilManagementPupils pupils ON diary.txtSchoolID = pupils.txtSchoolID
LEFT OUTER JOIN TbliSAMSManagerUsers users ON diary.txtSubmitBy = users.txtUserCode

WHERE pupils.txtSchoolID IN (SELECT ID FROM SplitCSV(@txtSchoolID)) and
blnDeleted &lt;&gt; 1
AND ((diary.txtDate BETWEEN @StartDate AND @EndDate) OR (@StartDate is NULL AND @EndDate is NULL))

ORDER BY diary.txtDate, diary.txtTime, pupils.txtSchoolID</CommandText>
        <QueryParameters>
          <QueryParameter Name="@txtSchoolID">
            <Value>=Parameters!txtSchoolID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
