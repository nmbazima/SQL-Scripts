        </Field>
        <Field Name="AdditionalReason">
          <DataField>AdditionalReason</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AdditionalSubmitBy">
          <DataField>AdditionalSubmitBy</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <CommandText>SELECT        
pupils.txtSchoolID,
pupils.txtPreName,
pupils.txtSurname,
types.txtName,
vaccinations.TblPupilManagementHealthVaccinationsID,
vaccinations.txtFirstDate,
vaccinations.txtBoosterDate,
vaccinations.txtNotes,
users1.txtUsername,
additional.intVaccination,
additional.txtDate As AdditionalDate,
additional.txtNotes As AdditionalNotes,
additional.txtBoosterDate As AdditionalBooster,
additional.txtReason As AdditionalReason,
users2.txtUsername As AdditionalSubmitBy

FROM TblPupilManagementHealthVaccinations vaccinations
INNER JOIN TblPupilManagementPupils pupils ON vaccinations.txtSchoolID = pupils.txtSchoolID
INNER JOIN TblPupilManagementHealthVaccinationsTypes types ON vaccinations.intType = types.TblPupilManagementHealthVaccinationsTypesID 
LEFT OUTER JOIN TblPupilManagementHealthVaccinationsAdditional additional ON vaccinations.TblPupilManagementHealthVaccinationsID = additional.intVaccination
LEFT OUTER JOIN TbliSAMSManagerUsers users1 ON vaccinations.txtSubmitBy = users1.txtUserCode  
LEFT OUTER JOIN TbliSAMSManagerUsers users2 ON additional.txtSubmitBy = users2.txtUserCode

WHERE pupils.txtSchoolID IN ( SELECT ID FROM dbo.SplitCSV( @txtSchoolID ) )

ORDER BY pupils.txtSurname, pupils.txtForename, pupils.txtSchoolID, vaccinations.txtFirstDate, vaccinations.TblPupilManagementHealthVaccinationsID, additional.txtDate, additional.intVaccination</CommandText>
        <QueryParameters>
          <QueryParameter Name="@txtSchoolID">
            <Value>=Parameters!txtSchoolID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
  </DataSets>
