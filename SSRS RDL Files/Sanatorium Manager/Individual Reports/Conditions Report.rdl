      </Fields>
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <CommandText>SELECT
pupils.txtSchoolID,    
pupils.txtPreName,
pupils.txtSurname,
pupils.txtDOB,
pupils.txtGender,
staff.FirstName,
staff.Surname,
years.txtYearName,
pupils.txtForm,
pupils.txtBoardingHouse,
conditions.TblPupilManagementHealthConditionsID,
conditions.txtType,
conditions.txtExplanation,
conditions.txtTreatment,
conditions.txtOnset,
conditions.txtAction,
conditions.txtFutherInfo,
users.txtUsername,
conditions.txtSubmitDateTime

FROM TblPupilManagementHealthConditions conditions 
INNER JOIN TblPupilManagementPupils pupils ON conditions.txtSchoolID = pupils.txtSchoolID 
LEFT OUTER JOIN TblSchoolManagementYears years ON pupils.intNCYear = years.intNCYear 
LEFT OUTER JOIN TbliSAMSManagerUsers users ON conditions.txtSubmitBy = users.txtUsercode
LEFT OUTER JOIN TblStaff staff ON pupils.txtTutor = staff.User_Code

WHERE conditions.TblPupilManagementHealthConditionsID IN (
  SELECT ID FROM dbo.SplitCSV(@TblPupilManagementHealthConditionsID) AS SplitCSV_1
)

ORDER BY conditions.txtSubmitDateTime DESC</CommandText>
        <QueryParameters>
          <QueryParameter Name="@TblPupilManagementHealthConditionsID">
            <Value>=Parameters!TblPupilManagementHealthConditionsID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
    </DataSet>
