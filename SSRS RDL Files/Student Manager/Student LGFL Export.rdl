<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>b1498f53-c31b-4456-a614-483c61533467</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="StartOfAcademicYear"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TOP 1 TblSchoolManagementTermDates.txtStartDate
		 FROM	TblSchoolManagementTermDates
		 WHERE	TblSchoolManagementTermDates.intSchoolYear = (
		 SELECT Top(1) intSchoolYear FROM TblSchoolManagementTermDates WHERE txtStartDate &lt;= GETDATE() ORDER BY txtStartDate DESC
		 )
		 ORDER BY TblSchoolManagementTermDates.txtStartDate ASC</CommandText></Query><Fields><Field Name="txtStartDate"><DataField>txtStartDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields></DataSet><DataSet Name="School"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT txtSchoolName,txtLEANumber, txtDfESNumber
FROM TblSchoolManagementSchoolSetup</CommandText></Query><Fields><Field Name="txtSchoolName"><DataField>txtSchoolName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLEANumber"><DataField>txtLEANumber</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDfESNumber"><DataField>txtDfESNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Students"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@EnrolmentDate"><Value>=Parameters!EnrolmentDate.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 

	TblPupilManagementPupils.txtSchoolID,
TblPupilManagementPupils.txtTitle,
	TblPupilManagementPupils.txtGender,
	TblPupilManagementPupils.txtForename,
	TblPupilManagementPupils.txtSurname,
	TblPupilManagementPupils.txtPreName,
	TblPupilManagementPupils.txtDOB,
	TblPupilManagementPupils.txtUPN,
	'Pupil' AS txtPersonType,
	TblSchoolManagementYears.txtYearName,
	TblPupilManagementPupils.txtForm,
	TblPupilManagementPupils.txtMobileNumber
FROM TblPupilManagementPupils
LEFT OUTER JOIN TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear
WHERE TblPupilManagementPupils.intSystemStatus =  1
AND TblPupilManagementPupils.txtEnrolmentDate &gt;= @EnrolmentDate</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTitle"><DataField>txtTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDOB"><DataField>txtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtUPN"><DataField>txtUPN</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPersonType"><DataField>txtPersonType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMobileNumber"><DataField>txtMobileNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix3"><TablixBody><TablixColumns><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></Ta