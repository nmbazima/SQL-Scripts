<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>1d8d44f5-f5fa-4648-9fb5-f50bd72882e9</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="YearGroup"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	-100 AS intNCYear, 'No Year Group' AS txtYearName
	UNION ALL
SELECT	intNCYear, txtYearName
FROM	TblSchoolManagementYears

ORDER BY intNCYear</CommandText></Query><Fields><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Student"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter></QueryParameters><CommandText>	SELECT		DISTINCT
		TblPupilManagementPupils.txtSchoolID, 
		TblPupilManagementPupils.txtSurname + ', ' + TblPupilManagementPupils.txtForename AS txtStudentName
	 FROM	TblPupilManagementPupils
	 WHERE	intSystemStatus = 1
	 AND (CASE WHEN TblPupilManagementPupils.intNCYear IS NULL THEN -100 ELSE TblPupilManagementPupils.intNCYear END IN (@intNCYear))
ORDER BY txtStudentName</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtStudentName"><DataField>txtStudentName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Result"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@ResultYear"><Value>=Parameters!ResultYear.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 
    TblTrackingManagerDataAspectResults.txtSchoolID AS SchoolId,
    SUBSTRING(TblTrackingManagerDataAspect.txtName, 1, 3) AS Stage,
    TblTrackingManagerDataAspectResults.txtLocale AS Locale,
    TblTrackingManagerDataAspectResults.intYear AS [Year],
    TblTrackingManagerDataAspect.txtCode AS [Subject],
    TblTrackingManagerDataAspectResults.txtMethod AS Method,
    TblTrackingManagerDataAspectResults.txtComponent AS Component,
    TblTrackingManagerDataAspectResults.txtResultStatus AS ResultStatus,
    TblTrackingManagerDataAspectResults.txtResultQualifier AS ResultQualifier,
    TblTrackingManagerDataAspectResults.txtresult AS Result,
    TblTrackingManagerDataAspectResults.dtaResultDate AS ResultDate,
	TblPupilManagementPupils.txtSurname,
	TblPupilManagementPupils.txtPreName,
	TblPupilManagementPupils.txtForename,
	TblPupilManagementPupils.intNCYear,
TblPupilManagementPupils.txtForm,
	TblSchoolManagementYears.txtYearName,
	TblPupilManagementPupils.txtMiddleNames,
	TblPupilManagementPupils.txtDOB,
	TblPupilManagementPupils.txtGender,
	TblTrackingManagerDataAspectResults.TblTrackingManagerDataAspectResultsId

FROM 
    TblTrackingManagerDataAspectResults
    
INNER JOIN 
    TblTrackingManagerDataAspect ON 
    TblTrackingManagerDataAspect.TblTrackingManagerDataAspectId = TblTrackingManagerDataAspectResults.intAspect

INNER JOIN 
    TblTrackingManagerData ON 
    TblTrackingManagerData.TblTrackingManagerDataId = TblTrackingManagerDataAspect.intData 


INNER JOIN TblPupilManagementPupils ON TblTrackingManagerDataAspectResults.txtSchoolID = TblPupilManagementPupils.txtSchoolID
LEFT OUTER JOIN TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear
WHERE 
    TblTrackingManagerData.blnImported = 1
	AND TblTrackingManagerData.txtType IN ('Stage Assessments','CTF Import')
	AND  TblTrackingManagerDataAspect.txtCode IN ('PHO')
	

	AND TblTrackingManagerDataAspectResults.txtSchoolID IN(@txtSchoolID)
	AND TblTrackingManagerDataAspectResults.intYear IN (@ResultYear)</CommandText></Query><Fields><Field Name="SchoolId"><DataField>SchoolId</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Stage"><DataField>Stage</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Locale"><DataField>Locale</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Year"><DataField>Year</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Subject"><DataField>Subject</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Method"><DataField>Method</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Component"><DataField>Component</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ResultStatus"><DataField>ResultStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ResultQualifier"><DataField>ResultQualifier</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Result"><DataField>Result</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ResultDate"><DataField>ResultDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDOB"><DataField>txtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblTrackingManagerDataAspectResultsId"><DataField>TblTrackingManagerDataAspectResultsId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT txtExternaliSAMSAddress AS txtiSAMSAddress
FROM TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT        txtPath + txtFilename AS txtSchoolLogoPath, txtName 
FROM            TblReportsCustomImages
WHERE        (txtName LIKE '%School Logo%')
ORDER BY dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="User"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 
	TbliSAMSManagerUsers.txtUsername,
	TbliSAMSManagerUsers.txtFirstname,
	TbliSAMSManagerUsers.txtSurname,
	TbliSAMSManagerUsers.txtEmailAddress
FROM TbliSAMSManagerUsers
WHERE TbliSAMSManagerUsers.txtUserCode = @userCode</CommandText></Query><Fields><Field Name="txtUsername"><DataField>txtUsername</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFirstname"><DataField>txtFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEmailAddress"><DataField>txtEmailAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Disclaimer"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Path"><Value>=Globals!ReportFolder</Value></QueryParameter><QueryParameter Name="@Report"><Value>=Globals!ReportName</Value></QueryParameter></QueryParameters><CommandText>
				  SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
				  FROM	TblSQLReportingServicesDisclaimerReport
				  INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
				  WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
				  AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
				  AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report
			  </CommandText></Query><Fields><Field Name="txtDisclaimerBackgroundColour"><DataField>txtDisclaimerBackgroundColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerBorderColour"><DataField>txtDisclaimerBorderColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerDescription"><DataField>txtDisclaimerDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTextColour"><DataField>txtDisclaimerTextColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTitle"><DataField>txtDisclaimerTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="ResultYear"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 
    DISTINCT
    TblTrackingManagerDataAspectResults.intYear AS [Year]


FROM 
    TblTrackingManagerDataAspectResults
    
INNER JOIN 
    TblTrackingManagerDataAspect ON 
    TblTrackingManagerDataAspect.TblTrackingManagerDataAspectId = TblTrackingManagerDataAspectResults.intAspect

INNER JOIN 
    TblTrackingManagerData ON 
    TblTrackingManagerData.TblTrackingManagerDataId = TblTrackingManagerDataAspect.intData 
	CROSS APPLY uf_Registration_getPupilArchive(TblTrackingManagerDataAspectResults.txtSchoolID,TblTrackingManagerDataAspectResults.dtaResultDate) AS PupilArchive

INNER JOIN TblPupilManagementPupils ON TblTrackingManagerDataAspectResults.txtSchoolID = TblPupilManagementPupils.txtSchoolID
WHERE 
    TblTrackingManagerData.blnImported = 1
	AND TblTrackingManagerData.txtType IN ('Stage Assessments','CTF Import')

	AND TblTrackingManagerDataAspectResults.txtSchoolID IN(@txtSchoolID)

	ORDER BY [Year] DESC</CommandText></Query><Fields><Field Name="Year"><DataField>Year</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolSetup"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT * FROM TblSchoolManagementSchoolSetup</CommandText></Query><Fields><Field Name="TblSchoolManagementSchoolSetupId"><DataField>TblSchoolManagementSchoolSetupId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSchoolName"><DataField>txtSchoolName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLEANumber"><DataField>txtLEANumber</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDfESNumber"><DataField>txtDfESNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLEAName"><DataField>txtLEAName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLEACountry"><DataField>txtLEACountry</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtUPNStartCounter"><DataField>txtUPNStartCounter</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSchoolType"><DataField>txtSchoolType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtIntakeType"><DataField>txtIntakeType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGovernance"><DataField>txtGovernance</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFunding"><DataField>txtFunding</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingType"><DataField>txtBoardingType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGenderMakeup"><DataField>txtGenderMakeup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMaleTerm"><DataField>txtMaleTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPluralMaleTerm"><DataField>txtPluralMaleTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFemaleTerm"><DataField>txtFemaleTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPluralFemaleTerm"><DataField>txtPluralFemaleTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSingleTerm"><DataField>txtSingleTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPluralTerm"><DataField>txtPluralTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSingleTeacherTerm"><DataField>txtSingleTeacherTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPluralTeacherTerm"><DataField>txtPluralTeacherTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnUseForms"><DataField>blnUseForms</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="blnAllowMultipleFormYears"><DataField>blnAllowMultipleFormYears</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtSingleFormTerm"><DataField>txtSingleFormTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPluralFormTerm"><DataField>txtPluralFormTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnUseYears"><DataField>blnUseYears</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtSingleYearTerm"><DataField>txtSingleYearTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPluralYearTerm"><DataField>txtPluralYearTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnUseTutors"><DataField>blnUseTutors</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtSingleTutorTerm"><DataField>txtSingleTutorTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPluralTutorTerm"><DataField>txtPluralTutorTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnUseCustomGroups"><DataField>blnUseCustomGroups</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtSingleCustomGroupTerm"><DataField>txtSingleCustomGroupTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPluralCustomGroupTerm"><DataField>txtPluralCustomGroupTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPrimaryHouseObject"><DataField>txtPrimaryHouseObject</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnUseAcademicHouses"><DataField>blnUseAcademicHouses</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtSingleAcademicHouseTerm"><DataField>txtSingleAcademicHouseTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPluralAcademicHouseTerm"><DataField>txtPluralAcademicHouseTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnUseBoardingHouses"><DataField>blnUseBoardingHouses</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtSingleBoardingHouseTerm"><DataField>txtSingleBoardingHouseTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPluralBoardingHouseTerm"><DataField>txtPluralBoardingHouseTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnUseYearBlocks"><DataField>blnUseYearBlocks</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtSingleYearBlockTerm"><DataField>txtSingleYearBlockTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPluralYearBlockTerm"><DataField>txtPluralYearBlockTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSingleHouseTerm"><DataField>txtSingleHouseTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPluralHouseTerm"><DataField>txtPluralHouseTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSubmitBy"><DataField>txtSubmitBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dteSubmitDateTime"><DataField>dteSubmitDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtSubmitDateTime"><DataField>txtSubmitDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="blnUseDfeWorkforceCensus"><DataField>blnUseDfeWorkforceCensus</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="blnUseDfePupilCensus"><DataField>blnUseDfePupilCensus</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtISCAnnualCensus"><DataField>txtISCAnnualCensus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intMainlySENPupils"><DataField>intMainlySENPupils</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intSection41Approved"><DataField>intSection41Approved</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtEstablishmentURN"><DataField>txtEstablishmentURN</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>19cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>10.5cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle1"><ReportItems><Image Name="Image14"><Source>External</Source><Value>=IIF(Right(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), 1) = "/", Left(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), Len(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) - 1), First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) &amp; First(Fields!txtSchoolLogoPath.Value, "SchoolLogo")</Value><Sizing>FitProportional</Sizing><Top>0.25cm</Top><Height>1.5cm</Height><Width>4.94cm</Width><Style><Border><Color>#c1bfc5</Color><Style>None</Style></Border></Style></Image><Textbox Name="Textbox4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Phonics Check</Value><Style><FontFamily>arial</FontFamily><FontSize>22pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>=Parameters!ResultYear.Value</Value><Style><FontFamily>arial</FontFamily><FontSize>18pt</FontSize><FontWeight>Bold</FontWeight><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Left>4.94cm</Left><Height>2cm</Height><Width>14.06cm</Width><ZIndex>1</ZIndex><Style><Border><Color>#c1bfc5</Color><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="Disclaimer2"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!txtDisclaimerTitle.Value, "Disclaimer")</Value><Style><FontWeight>Bold</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun><TextRun><Value>:</Value><Style><FontWeight>Bold</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun><TextRun><Value xml:space="preserve"> </Value><Style><FontWeight>Normal</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun><TextRun><Value>=First(Fields!txtDisclaimerDescription.Value, "Disclaimer")</Value><Style><FontWeight>Normal</FontWeight><Color>=First(Fields!txtDisclaimerTextColour.Value, "Disclaimer")</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Top>2.5cm</Top><Height>0.9cm</Height><Width>19cm</Width><ZIndex>2</ZIndex><Visibility><Hidden>=IIF(CountRows("Disclaimer") = 0, True, False)</Hidden></Visibility><Style><Border><Color>=First(Fields!txtDisclaimerBorderColour.Value, "Dis