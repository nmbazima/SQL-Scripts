<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>3b8f61bc-0106-4716-a9b8-2bce1ba9da40</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Concerns"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter><QueryParameter Name="@ConcernCategory"><Value>=Parameters!ConcernCategory.Value</Value></QueryParameter><QueryParameter Name="@txtStartDate"><Value>=Parameters!txtStartDate.Value</Value></QueryParameter><QueryParameter Name="@txtEndDate"><Value>=Parameters!txtEndDate.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	--core
		Pupils.txtSchoolID,
		Pupils.intPersonID,
		Pupils.txtSurname,
		Pupils.txtForename,
		Pupils.txtDoB AS dtDoB,
		Pupils.txtForm,
		Pupils.txtAcademicHouse,
		Pupils.txtBoardingHouse,
		TblSchoolManagementYears.txtYearName,
		--Concern
		Concern.Id AS intConcernID,
		ConcernStatus.Name AS txtConcernStatus,
		TblStaff.Firstname AS txtConcernSourceForename,
		TblStaff.Surname AS txtConcernSourceSurname,
		Concern.Location AS txtConcernLocation,
		Concern.RaisedOn AS dtConcernDateTime,
		ConcernType.Name AS txtConcernCategory,
		Areas.txtAreas,
		Concern.Nature AS txtConcernNature,
		Concern.Details AS txtConcernDetails,
		-- students invloved
		InvolvedStudents.txtInvolvedStudents,
		-- Concern Documents
		ConcernDocument.Id AS intConcernDocumentID,
		ConcernDocument.FileName AS txtConcernDocumentFileName,
		ConcernDocument.FilePath AS txtConcernDocumentFilePath,
		-- action
		ConcernAction.ID AS ActionID,
		DENSE_RANK() OVER (PARTITION BY Concern.Id ORDER BY ConcernAction.Id) AS intConcernActionRank,
		ActionType.Name AS txtActionType,
		ActionStaff.Firstname AS txtActionAssigneeFirstname,
		ActionStaff.Surname AS txtActionAssigneeSurname,
		ConcernAction.DueDate AS dActionDueDate,
		ConcernAction.Description AS txtActionDescription,
		ActionStatus.Name AS txtActionStatus,
		ConcernActionOutcome.Outcome AS txtActionOutcome,
		ActionStatus.IsOpen AS blnActionIsOpen,
		CASE WHEN ActionStatus.IsOpen = 1 THEN 1 ELSE 0 END AS intOutstandingAction
FROM	[pastoral].[GetConcerns](@userCode) AS Concern
LEFT OUTER JOIN TblPupilManagementPupils AS Pupils ON Pupils.txtSchoolID = Concern.SchoolID
LEFT OUTER JOIN pastoral.ConcernStatus AS ConcernStatus ON Concern.ConcernStatusId = ConcernStatus.Id
LEFT OUTER JOIN TblStaff ON Concern.SourceId = TblStaff.User_Code
LEFT OUTER JOIN pastoral.ConcernType AS ConcernType ON Concern.TypeId = ConcernType.Id
LEFT OUTER JOIN pastoral.ConcernAction AS ConcernAction ON Concern.Id = ConcernAction.ConcernId
LEFT OUTER JOIN pastoral.ActionType AS ActionType ON ConcernAction.ActionTypeId = ActionType.Id
LEFT OUTER JOIN pastoral.ConcernActionAssignee AS ConcernActionAssignee ON ConcernAction.Id = ConcernActionAssignee.ConcernActionId
LEFT OUTER JOIN TblStaff AS ActionStaff ON ConcernActionAssignee.Usercode = ActionStaff.User_Code
LEFT OUTER JOIN pastoral.ActionStatus AS ActionStatus ON ConcernAction.ActionStatusId = ActionStatus.Id
LEFT OUTER JOIN pastoral.ConcernActionOutcome AS ConcernActionOutcome ON ConcernAction.Id = ConcernActionOutcome.Id
LEFT OUTER JOIN TblSchoolManagementYears ON Pupils.IntNCYear = TblSchoolManagementYears.intNCYear
LEFT OUTER JOIN Pastoral.ConcernDocument AS ConcernDocument ON Concern.Id = ConcernDocument.ConcernId
OUTER APPLY (SELECT STUFF((SELECT ', ' + Area.Name 
			 FROM pastoral.ConcernArea 
			 LEFT OUTER JOIN pastoral.Area AS Area ON ConcernArea.AreaId = Area.Id
			 WHERE Concern.Id = ConcernArea.ConcernId
			 ORDER BY  Area.Name FOR XML PATH('')), 1, 2,'') AS txtAreas
			) AS Areas
OUTER APPLY (SELECT STUFF((SELECT ', ' + TblPupilManagementPupils.txtForename + ' ' + TblPupilManagementPupils.txtSurname + ' (' + StudentRole.Name + ')'
			 FROM pastoral.ConcernStudent
			 LEFT OUTER JOIN TblPupilManagementPupils ON ConcernStudent.SchoolId = TblPupilManagementPupils.txtSchoolID
			 LEFT OUTER JOIN pastoral.ConcernRole AS StudentRole ON ConcernStudent.RoleId = StudentRole.Id
			 WHERE Concern.Id = ConcernStudent.ConcernId
			 ORDER BY   ConcernStudent.Id FOR XML PATH('')), 1, 2,'') AS txtInvolvedStudents
			) AS InvolvedStudents
WHERE	ConcernType.ID IN (@ConcernCategory)
		AND CAST(FLOOR(CAST(Concern.RaisedOn AS FLOAT)) AS DATETIME) BETWEEN @txtStartDate AND @txtEndDate</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intPersonID"><DataField>intPersonID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtDoB"><DataField>dtDoB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intConcernID"><DataField>intConcernID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtConcernStatus"><DataField>txtConcernStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernSourceForename"><DataField>txtConcernSourceForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernSourceSurname"><DataField>txtConcernSourceSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernLocation"><DataField>txtConcernLocation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtConcernDateTime"><DataField>dtConcernDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtConcernCategory"><DataField>txtConcernCategory</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAreas"><DataField>txtAreas</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernNature"><DataField>txtConcernNature</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernDetails"><DataField>txtConcernDetails</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtInvolvedStudents"><DataField>txtInvolvedStudents</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intConcernDocumentID"><DataField>intConcernDocumentID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtConcernDocumentFileName"><DataField>txtConcernDocumentFileName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConcernDocumentFilePath"><DataField>txtConcernDocumentFilePath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ActionID"><DataField>ActionID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intConcernActionRank"><DataField>intConcernActionRank</DataField><rd:TypeName>System.Int64</rd:TypeName></Field><Field Name="txtActionType"><DataField>txtActionType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtActionAssigneeFirstname"><DataField>txtActionAssigneeFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtActionAssigneeSurname"><DataField>txtActionAssigneeSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dActionDueDate"><DataField>dActionDueDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtActionDescription"><DataField>txtActionDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtActionStatus"><DataField>txtActionStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtActionOutcome"><DataField>txtActionOutcome</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnActionIsOpen"><DataField>blnActionIsOpen</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="intOutstandingAction"><DataField>intOutstandingAction</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="School"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtiSAMSServerName
FROM	TbliSAMSManagerSettings</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="txtiSAMSServerName"><DataField>txtiSAMSServerName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="ConcernCategory"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT ID,
Name AS ConcernType FROM
pastoral.ConcernType
WHERE Deleted = 0
ORDER BY
Name</CommandText></Query><Fields><Field Name="ID"><DataField>ID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="ConcernType"><DataField>ConcernType</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>3.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>11cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.78521cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox35"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!txtiSAMSServerName.Value, "School")</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun><TextRun><Value> - Concerns </Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox35</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>13</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><Ta