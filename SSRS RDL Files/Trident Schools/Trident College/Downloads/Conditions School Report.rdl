<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>3b8f61bc-0106-4716-a9b8-2bce1ba9da40</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="ConditionsDetails"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter><QueryParameter Name="@intCondition"><Value>=Parameters!intCondition.Value</Value></QueryParameter><QueryParameter Name="@dtStartDate"><Value>=Parameters!dtStartDate.Value</Value></QueryParameter><QueryParameter Name="@dtEndDate"><Value>=Parameters!dtEndDate.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @ConditionsPermissionCheck AS NVARCHAR(MAX);

SET @ConditionsPermissionCheck  = (SELECT dbo.f_CheckUserHasActivityPermission(@userCode, 'iSAMS_MEDICALCENTRE', 'Condition', 'Read', 5));

WITH MainTable AS 
    (SELECT * 
     FROM	(SELECT	dbo.f_CanViewMedicalRecord(@userCode, AuditBaseData.intMedicalRecordTypeID, AuditBaseData.intSensitivity) AS 'txtAllowed',
					AuditBaseData.TblMedicalAuditBaseId,
					AuditBaseData.gKey,
					AuditBaseData.intMedicalRecordTypeId,
					AuditBaseData.intPersonId,
					AuditBaseData.bDeleted,
					AuditBaseData.bArchived,
					AuditBaseData.intSensitivity,
					AuditLogData.TblMedicalAuditLogId,
					AuditLogData.intMedicalAuditBaseId,
					AuditLogData.intMedicalAuditActionId,
					AuditLogData.txtSubmitBy,
					AuditLogData.dSubmitDateTime,
					RANK() OVER(PARTITION BY gKey ORDER BY dSubmitDateTime DESC) AS 'intRnk'
			 FROM	TblMedicalAuditBase AuditBaseData
			 JOIN	TblMedicalAuditLog AuditLogData ON AuditBaseData.TblMedicalAuditBaseId = AuditLogData.intMedicalAuditBaseId
			 WHERE	AuditBaseData.intMedicalRecordTypeId = 2) MostRecentRecord
     WHERE  MostRecentRecord.intRnk = 1
			AND MostRecentRecord.intMedicalAuditActionId NOT IN (4,5)
			AND MostRecentRecord.intMedicalRecordTypeId = 2
    )

SELECT  MainTable.TblMedicalAuditBaseID, 
		MainTable.intPersonID, 
		CASE WHEN TblPupilManagementPupils.intPersonID IS NOT NULL THEN 'Pupil' WHEN TblStaff.intPersonID IS NOT NULL THEN 'Staff' END AS 'txtPupilOrStaff', 
		ISNULL(TblPupilManagementPupils.txtForename, TblStaff.Firstname) AS 'txtForename', 
		ISNULL(TblPupilManagementPupils.txtSurname, TblStaff.Surname) AS 'txtSurname', 
		ISNULL(TblPupilManagementPupils.txtMiddleNames, TblStaff.MiddleNames) AS 'txtMiddleNames', 
		TblPupilManagementPupils.intNCYear, 
		TblPupilManagementPupils.txtForm, 
		TblPupilManagementPupils.txtAcademicHouse, 
		TblPupilManagementPupils.txtBoardingHouse, 
		TblMedicalConditionGroup.txtGroup AS 'txtConditionType', 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordCondition.txtType AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtCondition', 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalConditionSeverity.txtSeverity AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtSeverity',
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordCondition.txtTrigger AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtTrigger',
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordCondition.txtTreatment AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtTreatment',
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordCondition.txtFurtherInfo AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtFurtherInfo',
		TblMedicalRecordCondition.dEntered AS 'dtDateOfEntry', 
		TblMedicalRecordCondition.dReviewed AS 'dtReviewedDate', 
		(SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
		intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'dtLastUpdatedDate',
		(SELECT TOP 1 txtSubmitBy FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
		intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'txtLastUpdatedBy', 
		ISNULL((SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
		intMedicalAuditActionID = 1), MainTable.dSubmitDateTime) AS 'dtCreationDate', 
		@ConditionsPermissionCheck AS 'blnConditionsPermissionCheck'
FROM	MainTable
LEFT OUTER JOIN TblMedicalRecordType ON  MainTable.intMedicalRecordTypeId = TblMedicalRecordType.TblMedicalRecordTypeId  
LEFT OUTER JOIN TblMedicalRecordCondition ON MainTable.TblMedicalAuditBaseId = TblMedicalRecordCondition.intMedicalAuditBaseId
LEFT OUTER JOIN TblPupilManagementPupils ON MainTable.intPersonID = TblPupilManagementPupils.intPersonID
LEFT OUTER JOIN TblStaff ON MainTable.intPersonID = TblStaff.intPersonID
LEFT OUTER JOIN TblMedicalConditionSeverity ON TblMedicalRecordCondition.intMedicalConditionSeverityID = TblMedicalConditionSeverity.TblMedicalConditionSeverityID
LEFT OUTER JOIN TblMedicalConditionGroup ON TblMedicalRecordCondition.intMedicalConditionGroupId = TblMedicalConditionGroup.TblMedicalConditionGroupId
WHERE   MainTable.intMedicalRecordTypeID = 2
		AND (TblMedicalRecordCondition.intMedicalConditionGroupId IN (@intCondition))
		AND (TblMedicalRecordCondition.dEntered BETWEEN CAST(FLOOR(CAST(@dtStartDate AS FLOAT)) AS DATETIME) AND CAST(FLOOR(CAST(@dtEndDate AS FLOAT)) AS DATETIME))</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="TblMedicalAuditBaseID"><DataField>TblMedicalAuditBaseID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intPersonID"><DataField>intPersonID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtPupilOrStaff"><DataField>txtPupilOrStaff</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConditionType"><DataField>txtConditionType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCondition"><DataField>txtCondition</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSeverity"><DataField>txtSeverity</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTrigger"><DataField>txtTrigger</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTreatment"><DataField>txtTreatment</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFurtherInfo"><DataField>txtFurtherInfo</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtDateOfEntry"><DataField>dtDateOfEntry</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dtReviewedDate"><DataField>dtReviewedDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dtLastUpdatedDate"><DataField>dtLastUpdatedDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtLastUpdatedBy"><DataField>txtLastUpdatedBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtCreationDate"><DataField>dtCreationDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="blnConditionsPermissionCheck"><DataField>blnConditionsPermissionCheck</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT txtExternaliSAMSAddress AS txtiSAMSAddress, txtiSAMSServerName
FROM TbliSAMSManagerSettings</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtiSAMSServerName"><DataField>txtiSAMSServerName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="ConditionGroups"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT  DISTINCT TblMedicalConditionGroupID, bDeleted, txtGroup + CASE WHEN bDeleted = 1 THEN ' **Deleted' ELSE '' END AS 'txtGroup'
FROM	TblMedicalConditionGroup
--WHERE	bDeleted = 0
ORDER BY bDeleted, txtGroup + CASE WHEN bDeleted = 1 THEN ' **Deleted' ELSE '' END</CommandText></Query><Fields><Field Name="TblMedicalConditionGroupID"><DataField>TblMedicalConditionGroupID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="bDeleted"><DataField>bDeleted</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtGroup"><DataField>txtGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS txtSchoolLogoPath, txtName
FROM TblReportsCustomImages
WHERE TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix2"><TablixBody><TablixColumns><TablixColumn><Width>37.5cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>1.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox36"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!txtiSAMSServerName.Value, "iSAMSAddress")</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun><TextRun><Value> - Conditions Report</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox35</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Rectangle Name="Rectangle2"><ReportItems><Image Name="Image16"><Source>External</Source><Value>=IIF(Right(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), 1) = "/", Left(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), Len(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) - 1), First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) &amp; First(Fields!txtSchoolLogoPath.Value, "SchoolLogo")</Value><Sizing>FitProportional</Sizing><Left>1.9cm</Left><Height>1.4cm</Height><Width>3.1cm</Width><Style><Border><Style>None</Style></Border></Style></Image></ReportItems><KeepTogether>true</KeepTogether><Style><Border><Style>None</Style></Border></Style></Rectangle></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox4"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Generated on </Value><Style><FontSize>12pt</FontSize></Style></TextRun><TextRun><Value>=Globals!ExecutionTime</Value><Style><FontSize>12pt</FontSize><Format>dd/MM/yyyy</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox2</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox47"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>You are not authorised to view this data. Please contact your administrator for more information.</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox47</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#8eceec</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox10"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>No Conditions exist with the criteria you chose.</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Alter your selection to re-search the iSAMS database.</Value><Style><FontSize>8pt</FontSize><FontWeight>Normal</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember><Visibility><Hidden>=IIF(CountRows("ConditionsDetails")&gt;0,false,true)</Hidden></Visibility></TablixMember><TablixMember><Visibility><Hidden>=IIF(CountRows("ConditionsDetails")=0,false,true)</Hidden></Visibility></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>ConditionsDetails</DataSetName><Height>3.2cm</Height><Width>42.5cm</Width><Visibility><Hidden>=IIF(MAX(Fields!blnConditionsPermissionCheck.Value) = True OR TRIM(CStr(Fields!blnConditionsPermissionCheck.Value)) = "", True, False)</Hidden></Visibility><Style><Border><Style>None</Style></Border></Style></Tablix><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><T