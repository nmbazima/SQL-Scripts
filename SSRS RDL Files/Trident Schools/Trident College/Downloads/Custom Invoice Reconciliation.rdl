<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>cd8883fd-5673-4ff8-adb1-f6d8f671e8d6</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="PostInvoice"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intCycleId"><Value>=Parameters!intCycleId.Value</Value></QueryParameter></QueryParameters><CommandText>/*
Select * from 
VwPostInvoiceCharges
Where
TblFeeBillingCycleID =  @intCycleId
*/

With PostInvoiceCharges AS 

(SELECT          
'Bill Payer' AS txtPayeeType,          
TblFeeBillingCycle.TblFeeBillingCycleID,        
TblFeeBillingCycle.txtName AS txtCycleName,         
        
TblFeeBillingInvoiceAuditCycle.txtName AS txtInvoiceCycleName,          
TblFeeBillingInvoiceAuditCycle.dStartDate AS dtInvoiceCycleStartDate,           
TblFeeBillingInvoiceAuditCycle.dDueDate AS dtInvoiceCycleDueDate,           
TblFeeBillingInvoiceAuditCycle.intSchoolYear,          
          
TblFeeBillingInvoiceRun.TblFeeBillingInvoiceRunId AS intInvoiceRunID,           
TblFeeBillingInvoiceRun.txtName AS txtInvoiceRunName,        
TblFeeBillingInvoiceRun.dCompileDateTime AS dtInvoiceRunCompleteDateTime,           
TblFeeBillingInvoiceRun.dDueDate AS dtInvoiceRunDueDate,           
TblFeeBillingInvoiceRun.dSubmitDateTime AS dtInvoiceRunSubmitDateTime,      
          
TblFeeBillingInvoice.TblFeeBillingInvoiceID AS intInvoiceID,          
TblFeeBillingInvoice.dSubmitDateTime AS dtInvoiceDateTime,           
TblFeeBillingInvoice.intInvoiceNumber,           
TblFeeBillingInvoice.mBalanceBroughtForward,          
TblFeeBillingInvoice.txtBillingNotes AS txtInvoiceNote,          
          
TblFeeBillingInvoiceItem.TblFeeBillingInvoiceItemID AS intInvoiceItemID,           
TblFeeBillingInvoiceItem.intOrder AS intInvoiceItemOrder,          
TblFeeBillingInvoiceItem.ChargeCode AS txtInvoiceItemChargeCode,           
TblFeeBillingInvoiceItem.intChargeType AS intInvoiceItemChargeType,          
TblFeeBillingChargeType.txtDescription AS txtChargeTypeDescription,           
TblFeeBillingInvoiceItem.txtNominalAccount AS txtInvoiceItemNominalAccount,          
TblFeeBillingInvoiceItem.txtDescription AS txtInvoiceItemDescription,          
TblFeeBillingInvoiceItem.txtVatCode AS txtInvoiceItemVATCode,           
TblFeeBillingVATCode.decPercentage AS decInvoiceItemVATPercentage,           
TblFeeBillingInvoiceItem.intCount AS intInvoiceItemCount,           
TblFeeBillingInvoiceItem.mAmount AS mInvoiceItemAmount,           
TblFeeBillingInvoiceItem.mVATAmount AS mInvoiceItemVATAmount,          
TblFeeBillingInvoiceItem.mTotalAmount AS mInvoiceItemTotalAmount,          
TblFeeBillingInvoiceItem.txtNominalAccount,        
TblFeeBillingInvoiceItem.txtCostCentre,         
TblFeeBillingInvoiceItem.txtDepartment,         
        
ISNULL(cast(TblFeeBillingInvoiceItem.txtCostCentre as nvarchar(max)),'') + '-' + ISNULL(cast(TblFeeBillingInvoiceItem.txtDepartment as nvarchar(max)),'') AS txtBICode,        
        
TblFeeBillingNominalAccount.txtName AS txtNominalAccountName,        
TblFeeBillingNominalAccount.txtType,        
        
TblFeeBillingCharge.bBilledInAdvance,        
TblFeeBillingCharge.txtExtraDescription,         
 TblFeeBillingCharge.txtDescription as txtChargeDescription,          
  
TblFeeBillingInvoiceAuditPupil.txtExistingSchoolID AS txtSchoolID,           
TblFeeBillingInvoiceAuditPupil.txtAccountCode AS txtPupilAccountCode,          
TblFeeBillingInvoiceAuditPupil.txtForename,          
TblFeeBillingInvoiceAuditPupil.txtMiddleNames,          
TblFeeBillingInvoiceAuditPupil.txtSurname,          
TblFeeBillingInvoiceAuditPupil.txtFullName,          
TblFeeBillingInvoiceAuditPupil.txtGender,           
TblFeeBillingInvoiceAuditPupil.txtDOB AS dtDOB,           
TblFeeBillingInvoiceAuditPupil.txtForm,           
TblFeeBillingInvoiceAuditPupil.intNCYear,          
TblSchoolManagementYears.txtYearName,          
TblSchoolManagementYears.txtYearCode,         
TblFeeBillingInvoiceAuditPupil.txtTutor AS txtPastoralTutorUserCode,          
TblFeeBillingInvoiceAuditPupil.txtAcademicHouse,           
TblFeeBillingInvoiceAuditPupil.txtBoardingHouse,          
          
TblFeeBillingInvoiceAuditContact.TblFeeBillingInvoiceAuditContactID AS intContactID,          
TblFeeBillingInvoiceAuditContact.txtAccountCode AS txtContactAccountCode,          
TblFeeBillingInvoiceAuditContact.txtAddressType,           
TblFeeBillingInvoiceAuditContact.txtRelationType,          
TblFeeBillingInvoiceAuditContact.txtLetterSalutation,           
TblFeeBillingInvoiceAuditContact.txtLabelSalutation,          
TblFeeBillingInvoiceAuditContact.txtFirstPersonEmailAddress,           
TblFeeBillingInvoiceAuditContact.txtSecondPersonEmailAddress,           
TblFeeBillingInvoiceAuditContact.txtAddress1,           
TblFeeBillingInvoiceAuditContact.txtAddress2,           
TblFeeBillingInvoiceAuditContact.txtAddress3,           
TblFeeBillingInvoiceAuditContact.txtTown,           
TblFeeBillingInvoiceAuditContact.txtCountry,           
TblFeeBillingInvoiceAuditContact.txtPostcode,           
TblFeeBillingInvoiceAuditContact.txtCounty,          
'' AS [CopyBillText]                          
                 
FROM                      
TblFeeBillingInvoiceRun           
INNER JOIN TblFeeBillingInvoice ON TblFeeBillingInvoiceRun.TblFeeBillingInvoiceRunId = TblFeeBillingInvoice.intInvoiceRun           
INNER JOIN TblFeeBillingInvoiceItem ON TblFeeBillingInvoice.TblFeeBillingInvoiceID = TblFeeBillingInvoiceItem.intInvoiceID          
INNER JOIN TblFeeBillingInvoiceAuditPupil ON TblFeeBillingInvoiceItem.intAuditPupilID = TblFeeBillingInvoiceAuditPupil.TblFeeBillingInvoiceAuditPupilId           
INNER JOIN TblFeeBillingInvoiceAuditContact ON TblFeeBillingInvoice.intContactAuditID = TblFeeBillingInvoiceAuditContact.TblFeeBillingInvoiceAuditContactID           
INNER JOIN TblFeeBillingInvoiceAuditCycle ON TblFeeBillingInvoiceRun.intAuditCycleId = TblFeeBillingInvoiceAuditCycle.TblFeeBillingInvoiceAuditCycleId           
LEFT OUTER JOIN TblSchoolManagementYears ON TblFeeBillingInvoiceAuditPupil.intNCYear = TblSchoolManagementYears.intNCYear          
LEFT OUTER JOIN TblFeeBillingVATCode ON TblFeeBillingInvoiceItem.txtVatCode = TblFeeBillingVATCode.txtVATCode           
LEFT OUTER JOIN TblFeeBillingChargeType ON TblFeeBillingInvoiceItem.intChargeType = TblFeeBillingChargeType.TblFeeBillingChargeTypeID           
        
LEFT OUTER JOIN TblFeeBillingNominalAccount ON TblFeeBillingInvoiceItem.txtNominalAccount = TblFeeBillingNominalAccount.Code        
AND TblFeeBillingInvoiceItem.txtCostCentre = TblFeeBillingNominalAccount.txtCostCentre        
AND TblFeeBillingInvoiceItem.txtDepartment = TblFeeBillingNominalAccount.txtDepartment        
    
LEFT OUTER JOIN TblFeeBillingCharge ON TblFeeBillingInvoiceItem.ChargeCode = TblFeeBillingCharge.ChargeCode     
        
LEFT OUTER JOIN TblFeeBillingCycle ON TblFeeBillingInvoiceAuditCycle.intOriginalCycleId = TblFeeBillingCycle.TblFeeBillingCycleID )

SELECT 
* 
FROM	  PostInvoiceCharges

WHERE        
TblFeeBillingCycleID =  @intCycleId</CommandText></Query><Fields><Field Name="txtPayeeType"><DataField>txtPayeeType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblFeeBillingCycleID"><DataField>TblFeeBillingCycleID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtCycleName"><DataField>txtCycleName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSchoolId"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtInvoiceCycleName"><DataField>txtInvoiceCycleName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtInvoiceCycleStartDate"><DataField>dtInvoiceCycleStartDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtInvoiceCycleDueDate"><DataField>dtInvoiceCycleDueDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intSchoolYear"><DataField>intSchoolYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intInvoiceRunID"><DataField>intInvoiceRunID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtNominalAccount"><DataField>txtNominalAccount</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtInvoiceRunName"><DataField>txtInvoiceRunName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtInvoiceRunCompleteDateTime"><DataField>dtInvoiceRunCompleteDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtDepartment"><DataField>txtDepartment</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtInvoiceRunDueDate"><DataField>dtInvoiceRunDueDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dtInvoiceRunSubmitDateTime"><DataField>dtInvoiceRunSubmitDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intInvoiceID"><DataField>intInvoiceID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtType"><DataField>txtType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtInvoiceDateTime"><DataField>dtInvoiceDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intInvoiceNumber"><DataField>intInvoiceNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtExtraDescription"><DataField>txtExtraDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="mBalanceBroughtForward"><DataField>mBalanceBroughtForward</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="bBilledInAdvance"><DataField>bBilledInAdvance</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtInvoiceNote"><DataField>txtInvoiceNote</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intInvoiceItemID"><DataField>intInvoiceItemID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intInvoiceItemOrder"><DataField>intInvoiceItemOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtInvoiceItemChargeCode"><DataField>txtInvoiceItemChargeCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intInvoiceItemChargeType"><DataField>intInvoiceItemChargeType</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtChargeTypeDescription"><DataField>txtChargeTypeDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtInvoiceItemNominalAccount"><DataField>txtInvoiceItemNominalAccount</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtInvoiceItemDescription"><DataField>txtInvoiceItemDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtInvoiceItemVATCode"><DataField>txtInvoiceItemVATCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="decInvoiceItemVATPercentage"><DataField>decInvoiceItemVATPercentage</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="intInvoiceItemCount"><DataField>intInvoiceItemCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="mInvoiceItemAmount"><DataField>mInvoiceItemAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="mInvoiceItemVATAmount"><DataField>mInvoiceItemVATAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="txtChargeDescription"><DataField>txtChargeDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="mInvoiceItemTotalAmount"><DataField>mInvoiceItemTotalAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="txtCostCentre"><DataField>txtCostCentre</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBICode"><DataField>txtBICode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtNominalAccountName"><DataField>txtNominalAccountName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPupilAccountCode"><DataField>txtPupilAccountCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFullName"><DataField>txtFullName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtDOB"><DataField>dtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPastoralTutorUserCode"><DataField>txtPastoralTutorUserCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intContactID"><DataField>intContactID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtContactAccountCode"><DataField>txtContactAccountCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddressType"><DataField>txtAddressType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRelationType"><DataField>txtRelationType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLetterSalutation"><DataField>txtLetterSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLabelSalutation"><DataField>txtLabelSalutation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFirstPersonEmailAddress"><DataField>txtFirstPersonEmailAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSecondPersonEmailAddress"><DataField>txtSecondPersonEmailAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress1"><DataField>txtAddress1</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress2"><DataField>txtAddress2</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAddress3"><DataField>txtAddress3</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTown"><DataField>txtTown</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCountry"><DataField>txtCountry</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPostcode"><DataField>txtPostcode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCounty"><DataField>txtCounty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CopyBillText"><DataField>CopyBillText</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="CycleRun"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT        TblFeeBillingCycleID, txtName
FROM            TblFeeBillingCycle
ORDER BY dStartDate DESC</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="TblFeeBillingCycleID"><DataField>TblFeeBillingCycleID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="PreInvoice"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intCycleId"><Value>=Parameters!intCycleId.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @MyTempTable TABLE
	(txtType NVARCHAR(20),
	 intID INTEGER,
	 txtAccountCode NVARCHAR(50),
	 txtSchoolID NVARCHAR(50),
	 txtSageCode NVARCHAR(50),
	 ChargeCode NVARCHAR(50),
	 txtDescription NVARCHAR(200),
	 mAmount DECIMAL(18,2),
	 percentageAmount DECIMAL(18,2),
	 txtChargeType NVARCHAR(50),
	 txtNominalAccount NVARCHAR(50),
	 bBilledInAdvance BIT  
	)

INSERT INTO @MyTempTable
EXEC	   usp_cust_GetTransactionsByCycle @intCycleId;

WITH Temp AS
	(SELECT	TblPupilManagementAddresses.TblPupilManagementAddressesID, Charges.*, TblPupilManagementPupils.txtForename, 
			TblPupilManagementPupils.txtSurname, TblFeeBillingCharge.txtDepartment, txtYearName, TblPupilManagementPupils.txtType 
			AS 'txtPupilType', TblFeeBillingCharge.txtExtraDescription, TblFeeBillingAccountCode.txtAccountCode AS 
			'txtBillingAccountCode', Splitbilling.intPercentage, Splitbilling.mFixedAmount
	 FROM	@MyTempTable AS Charges
	 INNER JOIN TblPupilManagementPupils ON Charges.txtSchoolID = TblPupilManagementPupils.txtSchoolID
	 LEFT OUTER JOIN TblFeeBillingCharge ON Charges.ChargeCode = TblFeeBillingCharge.ChargeCode
	 LEFT OUTER JOIN TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear
	 INNER JOIN TblPupilManagementAddressLink ON TblPupilManagementAddressLink.txtSchoolID = TblPupilManagementPupils.txtSchoolID
	 INNER JOIN TblPupilManagementAddresses ON TblPupilManagementAddresses.TblPupilManagementAddressesID = TblPupilManagementAddressLink.intAddressID
			AND (TblPupilManagementAddresses.intBillingMailMerge = 1 OR TblPupilManagementAddresses.intMailMergeAll = 1)
	 LEFT OUTER JOIN TblFeeBillingAccountCode ON TblFeeBillingAccountCode.intAddressID = TblPupilManagementAddresses.TblPupilManagementAddressesID
	 OUTER APPLY (SELECT	TblFeeBillingSplitBillingRule.txtSchoolID, TblFeeBillingSplitBillingRule.intContactAddressID,
							TblFeeBillingSplitBillingRule.intChargeType, TblFeeBillingChargeType.txtName, 
							TblFeeBillingSplitBillingRule.intPercentage, TblFeeBillingSplitBillingRule.mFixedAmount
				  FROM		TblFeeBillingSplitBillingRule
				  INNER JOIN TblFeeBillingChargeType ON TblFeeBillingSplitBillingRule.intChargeType = TblFeeBillingChargeType.TblFeeBillingChargeTypeID
				  WHERE		Charges.txtSchoolID = TblFeeBillingSplitBillingRule.txtSchoolID 
							AND TblFeeBillingChargeType.txtName = Charges.txtChargeType 
							AND TblFeeBillingSplitBillingRule.intContactAddressID = TblPupilManagementAddresses.TblPupilManagementAddressesID
							AND (TblFeeBillingSplitBillingRule.intCycleID = -1 
							OR TblFeeBillingSplitBillingRule.intCycleID = @intCycleId)) AS Splitbilling

	)
	,TempPup AS 
	(SELECT DISTINCT txtSchoolID, txtChargeType, ChargeCode, 
	MAX(ISNULL(intPercentage,0)) AS 'TotalPercentage'
	 FROM	Temp
	 GROUP BY txtSchoolID, txtChargeType, ChargeCode
	)

SELECT	Temp.*, 
CASE WHEN intPercentage IS NOT NULL THEN intPercentage ELSE 100 - ISNULL(TotalPercentage,0) END AS 'CalculatedPercentage'
FROM	Temp 
LEFT OUTER JOIN TempPup ON Temp.txtSchoolID = TempPup.txtSchoolID AND Temp.txtChargeType = TempPup.txtChargeType
		AND Temp.ChargeCode = TempPup.ChargeCode</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="TblPupilManagementAddressesID"><DataField>TblPupilManagementAddressesID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtType"><DataField>txtType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intID"><DataField>intID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtAccountCode"><DataField>txtAccountCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSageCode"><DataField>txtSageCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ChargeCode"><DataField>ChargeCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDescription"><DataField>txtDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="mAmount"><DataField>mAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="percentageAmount"><DataField>percentageAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="txtChargeType"><DataField>txtChargeType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtNominalAccount"><DataField>txtNominalAccount</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="bBilledInAdvance"><DataField>bBilledInAdvance</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDepartment"><DataField>txtDepartment</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPupilType"><DataField>txtPupilType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtExtraDescription"><DataField>txtExtraDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBillingAccountCode"><DataField>txtBillingAccountCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intPercentage"><DataField>intPercentage</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="mFixedAmount"><DataField>mFixedAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="CalculatedPercentage"><DataField>CalculatedPercentage</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="Currency"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT txtiSAMSCurrencySymbol, 
txtiSAMSCurrencyCode, 
intiSAMSCurrencyPlaces 
FROM TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSCurrencySymbol"><DataField>txtiSAMSCurrencySymbol</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtiSAMSCurrencyCode"><DataField>txtiSAMSCurrencyCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intiSAMSCurrencyPlaces"><DataField>intiSAMSCurrencyPlaces</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="Users"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT TbliSAMSManagerUsers.txtUsername
