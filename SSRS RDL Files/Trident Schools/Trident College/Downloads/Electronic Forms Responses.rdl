<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>910fdbb0-1012-4ba9-acac-a46d2437642e</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="FormResponses"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intResponse"><Value>=Parameters!intResponse.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT
--user
TbliSAMSManagerUsers.intPersonID,
TbliSAMSManagerUsers.txtSurname,
TbliSAMSManagerUsers.txtFirstname AS txtForename,

--parent portal form

TblParentPortalFeaturesInteractiveForm.TblParentPortalFeaturesInteractiveFormId, 
TblParentPortalFeaturesInteractiveForm.txtName AS txtFormName,
TblParentPortalFeaturesInteractiveForm.txtDescription AS txtFormDescription,

TblParentPortalFeaturesInteractiveFormItems.TblParentPortalFeaturesInteractiveFormItemsId, 
TblParentPortalFeaturesInteractiveFormItems.intOrder AS intFormItemOrder,
TblParentPortalFeaturesInteractiveFormItems.txtName AS txtFormItemName,
TblParentPortalFeaturesInteractiveFormItems.txtDescription AS txtFormItemDescription,
TblParentPortalFeaturesInteractiveFormItems.txtType AS txtFormItemType,

TblParentPortalFeaturesInteractiveFormResponse.intResponse AS intFormResponse,
TblParentPortalFeaturesInteractiveFormResponse.TblParentPortalFeaturesInteractiveFormResponseId,
TblParentPortalFeaturesInteractiveFormResponse.txtValue AS txtResponseValue,
TblParentPortalFeaturesInteractiveFormResponseDetails.dteSubmitDateTime AS dtResponseDateTime



FROM TblParentPortalFeaturesInteractiveFormResponse
LEFT OUTER JOIN TbliSAMSManagerUsers ON TblParentPortalFeaturesInteractiveFormResponse.txtSubmitBy = TbliSAMSManagerUsers.txtUserCode
LEFT OUTER JOIN TblParentPortalFeaturesInteractiveFormResponseDetails ON TblParentPortalFeaturesInteractiveFormResponse.intResponse = TblParentPortalFeaturesInteractiveFormResponseDetails.TblParentPortalFeaturesInteractiveFormResponseDetailsId
LEFT OUTER JOIN TblParentPortalFeaturesInteractiveFormItems ON TblParentPortalFeaturesInteractiveFormResponse.intFormItem = TblParentPortalFeaturesInteractiveFormItems.TblParentPortalFeaturesInteractiveFormItemsId 
AND TblParentPortalFeaturesInteractiveFormResponseDetails.intForm = TblParentPortalFeaturesInteractiveFormItems.intForm
LEFT OUTER JOIN  TblParentPortalFeaturesInteractiveForm ON TblParentPortalFeaturesInteractiveFormResponseDetails.intForm = TblParentPortalFeaturesInteractiveForm.TblParentPortalFeaturesInteractiveFormID 
WHERE TblParentPortalFeaturesInteractiveFormResponse.intResponse IN (SELECT ID FROM dbo.SplitCSV(@intResponse) AS SplitCSV_1) OR @intResponse IS NULL</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="intPersonID"><DataField>intPersonID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblParentPortalFeaturesInteractiveFormId"><DataField>TblParentPortalFeaturesInteractiveFormId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtFormName"><DataField>txtFormName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFormDescription"><DataField>txtFormDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblParentPortalFeaturesInteractiveFormItemsId"><DataField>TblParentPortalFeaturesInteractiveFormItemsId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intFormItemOrder"><DataField>intFormItemOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtFormItemName"><DataField>txtFormItemName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFormItemDescription"><DataField>txtFormItemDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtFormItemType"><DataField>txtFormItemType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intFormResponse"><DataField>intFormResponse</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="TblParentPortalFeaturesInteractiveFormResponseId"><DataField>TblParentPortalFeaturesInteractiveFormResponseId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtResponseValue"><DataField>txtResponseValue</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtResponseDateTime"><DataField>dtResponseDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields></DataSet><DataSet Name="Pupils"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT        txtSchoolID, txtSurname, txtForename
FROM            TblPupilManagementPupils</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Form Name</Value><Style><FontWeight>Bold</FontWeight><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox3"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Form Description</Value><Style><FontWeight>Bold</FontWeight><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox3</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox5"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Completed</Value><Style><FontWeight>Bold</FontWeight><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox5</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox12"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Completed by</Value><Style><FontFamily>Arial</FontFamily><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox12</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox10"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Replace(IIF(Fields!txtFormItemType.Value="radio",Replace(Fields!txtFormItemName.Value,"@","/"), Fields!txtFormItemName.Value),"&amp;#39;","'")</Value><Style><FontWeight>Bold</FontWeight><FontFamily>Segoe UI</FontFamily></Style></TextRun><TextRun><Value>=IIF(Len(Fields!txtFormItemDescription.Value)&lt;3,"","- " + Replace(Fields!txtFormItemDescription.Value,"&amp;#39;","'"))</Value><Style><FontWeight>Bold</FontWeight><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox10</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="txtFormName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Replace(Fields!txtFormName.Value,"&amp;#39;","'")</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>txtFormName</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="txtFormDescription"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Replace(Fields!txtFormDescription.Value,"&amp;#39;","'")</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>txtFormDescription</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="dtResponseDateTime"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!dtResponseDateTime.Value</Value><Style><Format>dd/MM/yyyy</Format><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>dtResponseDateTime</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox13"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtSurname.Value</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun><TextRun><Value>, </Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun><TextRun><Value>=Fields!txtForename.Value</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox13</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox11"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=SWITCH(Fields!txtFormItemType.Value="pupil",Lookup(Fields!txtResponseValue.Value,Fields!txtSchoolID.Value, Fields!txtForename.Value + " " + Fields!txtSurname.Value, "Pupils"),
Fields!txtFormItemType.Value="check" and Fields!txtFormItemName.Value = Fields!txtResponseValue.Value,"True",
Fields!txtFormItemType.Value="check" and Fields!txtFormItemName.Value &lt;&gt; Fields!txtResponseValue.Value,"False",
true,Fields!txtResponseValue.Value)</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox11</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember><Group Name="TblParentPortalFeaturesInteractiveFormItemsId"><GroupExpressions><GroupExpression>=Fields!TblParentPortalFeaturesInteractiveFormItemsId.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!intFormItemOrder.Value</Value></SortExpression></SortExpressions></TablixMember></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><Group Name="FormID_ResponseID"><GroupExpressions><GroupExpression>=Fields!TblParentPortalFeaturesInteractiveFormId.Value</GroupExpression><GroupExpression>=Fields!intFormResponse.Value</GroupExpression></GroupExpressions></Group><SortExpressions><SortExpression><Value>=Fields!txtFormName.Value</Value></SortExpression><SortExpression><Value>=Fields!dtResponseDateTime.Value</Value></SortExpression></SortExpressions></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>FormResponses</DataSetName><Height>1.2cm</Height><Width>12.5cm</Width><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><Height>0.47244in</Height><Style /></Body><Width>4.92126in</Width><Page><PageHeight>29.7cm</PageHeight><PageWidth>21cm</PageWidth><LeftMargin>0.5cm</LeftMargin><RightMargin>0.5cm</RightMargin><TopMargin>0.5cm</TopMargin><BottomMargin>0.5cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page></ReportSection></ReportSections><ReportParameters><ReportParameter Name="intResponse"><DataType>String</DataType><Prompt>Response:</Prompt></ReportParameter></ReportParameters><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>7fd2a4b4-cf93-4efe-a1ae-91541e647851</rd:ReportID></Report>