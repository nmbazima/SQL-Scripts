<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>5c6229dc-f13f-4a67-8211-1df35e0dd410</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Gradebooks"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter><QueryParameter Name="@Live"><Value>=Parameters!Live.Value</Value></QueryParameter><QueryParameter Name="@CycleId"><Value>=Parameters!CycleId.Value</Value></QueryParameter><QueryParameter Name="@TagId"><Value>=Parameters!TagId.Value</Value></QueryParameter></QueryParameters><CommandText>
DECLARE @adminUser BIT = 0;

SELECT
    TOP (1) @adminUser = TbliSAMSManagerModuleSecurity.intFull
FROM TbliSAMSManagerModules
INNER JOIN TbliSAMSManagerModuleSecurity ON TbliSAMSManagerModules.TbliSAMSManagerModulesID = TbliSAMSManagerModuleSecurity.intModuleID
INNER JOIN TbliSAMSManagerUsers ON TbliSAMSManagerModuleSecurity.txtSecurityID = TbliSAMSManagerUsers.txtSecurityID
WHERE TbliSAMSManagerModules.txtModuleID = 'iSAMS_GRADEBOOKS'
AND TbliSAMSManagerUsers.txtUserCode = @userCode;




WITH GradebooksAccess AS
(
SELECT DISTINCT ModelId as GradebookID
FROM tracking.Model
INNER JOIN tracking.[User] ON [User].ModelId = Model.Id
WHERE isNull(Model.Deleted, 0) = 0 
	AND ([User].UserCode = @userCode or @adminUser = 1)
)

SELECT DISTINCT
[tracking].[Model].ID AS GradebookID,
[tracking].[Model].Name AS GradebookName

FROM [tracking].[Model]
INNER JOIN GradebooksAccess ON [tracking].[Model].Id = GradebooksAccess.GradebookID
LEFT OUTER JOIN [tracking].[AspectLink] ON [tracking].[Model].[Id] = [tracking].[AspectLink].[ModelId]
LEFT OUTER JOIN [tracking].[Aspect] ON [tracking].[AspectLink].[AspectId] = [tracking].[Aspect].[Id]
LEFT OUTER JOIN [tag].[Tag] ON [tracking].[Model].Id = [tag].[Tag].EntityId AND [tag].[Tag].EntityTypeId = 2
LEFT OUTER JOIN TblTeachingManagerSets ON [tracking].[Model].ClassId = TblTeachingManagerSets.tblTeachingManagerSetsID
LEFT OUTER JOIN curriculum.CourseSchedule ON TblTeachingManagerSets.intCourseSchedule = curriculum.CourseSchedule.Id
LEFT OUTER JOIN curriculum.Course ON curriculum.CourseSchedule.Course = curriculum.Course.Id
LEFT OUTER JOIN [curriculum].[Cycle] ON [curriculum].Course.[Cycle] = [curriculum].[Cycle].[Id]
WHERE [tracking].[Aspect].Type IN ('Assessment','Calculation')
AND ISNULL([tracking].[Model].Deleted,0) &lt;&gt; 1
AND isNull([tracking].[Model].Archived,0) IN (@Live)
AND (isNull([curriculum].[Cycle].[Id],-100) = @CycleId)
AND (CONCAT([tag].[Tag].CategoryId,'_',[tag].[Tag].CategoryEntityId) IN (@TagId) OR  '-100_-100' IN (@TagId))
ORDER BY [tracking].[Model].Name</CommandText></Query><Fields><Field Name="GradebookID"><DataField>GradebookID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="GradebookName"><DataField>GradebookName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="AssessmentElements"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Live"><Value>=Parameters!Live.Value</Value></QueryParameter><QueryParameter Name="@GradebookID"><Value>=Parameters!GradebookID.Value</Value></QueryParameter></QueryParameters><CommandText>WITH  MyCTE
AS
(
        -- anchor
    SELECT  Id, [Name], ParentId,1 AS [Level], 
                 CAST(([Name]) AS VARCHAR(MAX)) AS Hierarchy
    FROM    tracking.[AspectLinkGrouping]
    WHERE   ParentId IS NULL

    UNION ALL
        --recursive member
    SELECT  t2.id, t2.[Name], t2.ParentID,M.[level] + 1 AS [Level],
                 CAST((M.Hierarchy + ' &gt; ' + t2.Name) AS VARCHAR(MAX)) AS Hierarchy
    FROM    tracking.[AspectLinkGrouping] AS t2
            JOIN MyCTE AS M ON t2.ParentId = M.Id   
)

SELECT DISTINCT
	CASE WHEN MyCTE.Hierarchy IS NULL THEN [tracking].[Aspect].Name ELSE MyCTE.Hierarchy + ' &gt; ' + [tracking].[Aspect].Name END AS ElementName
FROM [tracking].[Model]

LEFT OUTER JOIN [tracking].[AspectLink] ON [tracking].[Model].[Id] = [tracking].[AspectLink].[ModelId] AND ISNULL([tracking].[AspectLink].Deleted,0) &lt;&gt; 1
LEFT OUTER JOIN [tracking].[Aspect] ON [tracking].[AspectLink].[AspectId] = [tracking].[Aspect].[Id]
LEFT OUTER JOIN MyCTE ON [tracking].[AspectLink].[AspectLinkGroupingId] = MyCTE.[Id]
WHERE  [tracking].[Aspect].Type IN ('Assessment','Calculation')

AND isNull([tracking].[Model].Archived,0) IN (@Live)
AND [tracking].[Model].ID IN (@GradebookID)
ORDER BY ElementName</CommandText></Query><Fields><Field Name="ElementName"><DataField>ElementName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="GradebookData"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter><QueryParameter Name="@ElementName"><Value>=Parameters!ElementName.Value</Value></QueryParameter><QueryParameter Name="@intRegister"><Value>=Parameters!intRegister.Value</Value></QueryParameter><QueryParameter Name="@Live"><Value>=Parameters!Live.Value</Value></QueryParameter><QueryParameter Name="@GradebookID"><Value>=Parameters!GradebookID.Value</Value></QueryParameter><QueryParameter Name="@CategoryId"><Value>=Parameters!CategoryId.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @adminUser BIT = 0;

SELECT
    TOP (1) @adminUser = TbliSAMSManagerModuleSecurity.intFull
FROM TbliSAMSManagerModules
INNER JOIN TbliSAMSManagerModuleSecurity ON TbliSAMSManagerModules.TbliSAMSManagerModulesID = TbliSAMSManagerModuleSecurity.intModuleID
INNER JOIN TbliSAMSManagerUsers ON TbliSAMSManagerModuleSecurity.txtSecurityID = TbliSAMSManagerUsers.txtSecurityID
WHERE TbliSAMSManagerModules.txtModuleID = 'iSAMS_GRADEBOOKS'
AND TbliSAMSManagerUsers.txtUserCode = @userCode;

WITH GradebookElements AS
(
	SELECT 
	'Group' AS Type,
	[Id],
	[ParentId],
	[Name],
	[Order]
	FROM tracking.[AspectLinkGrouping]
	WHERE ModelId IN (@GradebookID)

	UNION ALL


	SELECT
	'Element' AS Type,
	[tracking].[Aspect].Id,
	[tracking].[AspectLink].[AspectLinkGroupingId] AS [ParentId],
	[tracking].[Aspect].Name,
	[tracking].[AspectLink].[Order]
	FROM [tracking].[Aspect]
	INNER JOIN [tracking].[AspectLink] ON [tracking].[AspectLink].[AspectId] = [tracking].[Aspect].[Id] AND ISNULL([tracking].[AspectLink].Deleted,0) &lt;&gt; 1
	WHERE ModelId IN (@GradebookID) 
	AND [tracking].[Aspect].Type IN ('Assessment','Calculation')
),


HierarchyCTE AS (
  SELECT *,
    CAST([Order] AS REAL) ElementOrderInHierarchy,
    1 level,
	CAST(([Name]) AS VARCHAR(MAX)) AS ElementNameWithHierarchy
  FROM GradebookElements
  WHERE ParentId IS NULL
  UNION ALL
  SELECT t2.*,
    HierarchyCTE.ElementOrderInHierarchy + (CAST( t2.[Order] AS REAL) / POWER(10, HierarchyCTE.level)) ElementOrderInHierarchy,
    HierarchyCTE.level + 1 level,
	CAST((HierarchyCTE.ElementNameWithHierarchy + ' &gt; ' + t2.Name) AS VARCHAR(MAX)) AS ElementNameWithHierarchy
	FROM    GradebookElements AS t2
            JOIN HierarchyCTE ON t2.ParentId = HierarchyCTE.Id  

),
 GradebooksAccess AS
(
SELECT DISTINCT ModelId as GradebookID
FROM tracking.Model
INNER JOIN tracking.[User] ON [User].ModelId = Model.Id
WHERE isNull(Model.Deleted, 0) = 0 
	AND ([User].UserCode = @userCode or @adminUser = 1)
),

 SelectedRegisters AS
(
	SELECT	TblPupilRegistersRegisterId, txtName AS txtRegisterName, TblPupilRegistersRegister.txtReportingKey, TblPupilRegistersRegister.txtWorkflow, txtCode AS txtRegisterCode
	FROM	TblPupilRegistersRegister
	WHERE	TblPupilRegistersRegisterId IN (@intRegister)
)
,DateRangedRegister AS
(
	SELECT	SelectedRegisters.txtRegisterName, 
	SelectedRegisters.txtRegisterCode,
			SelectedRegisters.TblPupilRegistersRegisterId,
			SelectedRegisters.txtReportingKey,
			(CASE WHEN Register.txtSchoolId IS NULL THEN 'No' WHEN Register.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnRegister,
			TblPupilManagementPupils.txtSchoolID,
			SelectedRegisters.txtWorkflow
	FROM	SelectedRegisters
	INNER JOIN TblPupilManagementPupils ON 1 = 1
	OUTER APPLY dbo.f_PupilRegisters_GetLatestScreeningLogsWithRanges(TblPupilManagementPupils.txtSchoolID, SelectedRegisters.TblPupilRegistersRegisterId) AS Register
	WHERE	SelectedRegisters.txtWorkflow = 'RegisterWithRanges'
)
,NoneDateRangedRegister AS 
(
	SELECT	SelectedRegisters.txtRegisterName, 
	SelectedRegisters.txtRegisterCode,
			SelectedRegisters.TblPupilRegistersRegisterId,
			SelectedRegisters.txtReportingKey,
			(CASE WHEN Register.txtSchoolId IS NULL THEN 'No' WHEN Register.bOnRegister = 0 THEN 'No' ELSE 'Yes' END) AS txtOnRegister,
			TblPupilManagementPupils.txtSchoolID,
			SelectedRegisters.txtWorkflow
	FROM	SelectedRegisters
	INNER JOIN TblPupilManagementPupils ON 1 = 1
	OUTER APPLY dbo.f_PupilRegisters_GetLatestScreeningLogs(TblPupilManagementPupils.txtSchoolID, SelectedRegisters.TblPupilRegistersRegisterId) AS Register
	WHERE	SelectedRegisters.txtWorkflow &lt;&gt; 'RegisterWithRanges'
)
,Registers AS
(
	SELECT	*
	FROM	DateRangedRegister
		UNION ALL
	SELECT	*
	FROM	NoneDateRangedRegister
),


GradebookData AS (
SELECT 
[tracking].[Model].ID AS GradebookID,
[tracking].[Model].Name AS GradebookName,
[tracking].[AspectLink].Deleted AS ElementDeleted,
[tracking].[AspectLink].[Order] AS ElementOrder,
[tracking].[Aspect].id AS ElementId,
[tracking].[Aspect].Name AS ElementName,
[tracking].[Aspect].Type AS ElementType,
HierarchyCTE.ElementNameWithHierarchy,
HierarchyCTE.ElementOrderInHierarchy,
[tracking].[Aspect].GradesetId AS ElementGradesetId,


[tracking].[Assessment].SchoolId AS txtSchoolId,
[tracking].[Assessment].Absent AS ElementEntryAbsent,
[tracking].[Assessment].Value  AS ElementValueTransposed

FROM [tracking].[Model]
INNER JOIN GradebooksAccess ON [tracking].[Model].Id = GradebooksAccess.GradebookID
LEFT OUTER JOIN [tracking].[AspectLink] ON [tracking].[Model].[Id] = [tracking].[AspectLink].[ModelId]
LEFT OUTER JOIN [tracking].[Aspect] ON [tracking].[AspectLink].[AspectId] = [tracking].[Aspect].[Id] AND ISNULL([tracking].[AspectLink].Deleted,0) &lt;&gt; 1
LEFT OUTER JOIN [tracking].[Assessment] ON [tracking].[Aspect].id = [tracking].[Assessment].[AspectId]
LEFT OUTER JOIN HierarchyCTE ON [tracking].Aspect.Id = HierarchyCTE.[Id] AND HierarchyCTE.Type = 'Element'
WHERE
HierarchyCTE.ElementNameWithHierarchy IN (@ElementName)
AND  [tracking].[Aspect].Type IN ('Assessment')
AND isNull([tracking].[Model].Archived,0) IN (@Live)
AND [tracking].[Model].ID IN (@GradebookID)

UNION ALL

SELECT 
[tracking].[Model].ID AS GradebookID,
[tracking].[Model].Name AS GradebookName,
[tracking].[AspectLink].Deleted AS ElementDeleted,
[tracking].[AspectLink].[Order] AS ElementOrder,
[tracking].[Aspect].id AS ElementId,
[tracking].[Aspect].Name AS ElementName,
[tracking].[Aspect].Type AS ElementType,
HierarchyCTE.ElementNameWithHierarchy,
HierarchyCTE.ElementOrderInHierarchy,
[tracking].[Aspect].GradesetId AS ElementGradesetId,


[tracking].[CalculationValue].SchoolId AS txtSchoolId,
NULL AS ElementEntryAbsent,
[tracking].[CalculationValue].Value  AS ElementValueTransposed

FROM [tracking].[Model]
INNER JOIN GradebooksAccess ON [tracking].[Model].Id = GradebooksAccess.GradebookID
LEFT OUTER JOIN [tracking].[AspectLink] ON [tracking].[Model].[Id] = [tracking].[AspectLink].[ModelId]
LEFT OUTER JOIN [tracking].[Aspect] ON [tracking].[AspectLink].[AspectId] = [tracking].[Aspect].[Id] AND ISNULL([tracking].[AspectLink].Deleted,0) &lt;&gt; 1
LEFT OUTER JOIN [tracking].[CalculationValue] ON [tracking].[Aspect].[id] = [tracking].[CalculationValue].[AspectId]
LEFT OUTER JOIN HierarchyCTE ON [tracking].Aspect.Id = HierarchyCTE.[Id] AND HierarchyCTE.Type = 'Element'
WHERE
HierarchyCTE.ElementNameWithHierarchy IN (@ElementName)
AND  [tracking].[Aspect].Type IN ('Calculation')
AND isNull([tracking].[Model].Archived,0) IN (@Live)
AND [tracking].[Model].ID IN (@GradebookID)
)


SELECT 
GradebookData.GradebookID,
GradebookData.GradebookName,
GradebookData.txtSchoolId AS SchoolId,
PotentialGradeset.Description AS PotentialGradesetItemValue,
PotentialGradeset.Value AS PotentialGradesetItemTransposed,
PotentialGradeset.[Order] AS PotentialGradesetItemOrder,
GradebookData.ElementName,
GradebookData.ElementId,
GradebookData.ElementType,
GradebookData.ElementOrder,
GradebookData.ElementNameWithHierarchy,
GradebookData.ElementOrderInHierarchy,
CASE WHEN GradebookData.ElementType = 'Calculation' THEN GradebookData.ElementValueTransposed ELSE [tracking].[GradesetValue].Description END AS ElementValue,
GradebookData.ElementEntryAbsent,
GradebookData.ElementValueTransposed,
[tracking].[GradesetValue].[Order] AS ElementValueOrder,

TblPupilManagementPupils.txtForename,
TblPupilManagementPupils.txtSurname,
TblPupilManagementPupils.txtGender, 
TblPupilManagementPupils.intSystemStatus,
TblPupilManagementPupils.txtEthnicGroup, 
TblPupilManagementPupils.txtForm,
TblPupilManagementPupils.intNCYear,
TblPupilManagementPupils.txtDOB,
TblSchoolManagementYears.txtYearName,
TblPupilManagementPupils.txtAcademicHouse,
TblPupilManagementPupils.txtBoardingHouse,
TblPupilManagementPupils.txtType AS txtBoardingStatus,
Registers.txtRegisterName,
Registers.txtRegisterCode,
Registers.txtOnRegister,
Registers.txtWorkflow,
CONCAT([tag].[Tag].CategoryId,'_',[tag].[Tag].CategoryEntityId) AS TagCategory,
[Tag].CategoryId
FROM GradebookData
INNER JOIN TblPupilManagementPupils ON GradebookData.txtSchoolId = TblPupilManagementPupils.txtSchoolID
LEFT OUTER JOIN TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear
LEFT OUTER JOIN Registers ON TblPupilManagementPupils.txtSchoolID = Registers.txtSchoolID

LEFT OUTER JOIN [tracking].[Gradeset] ON GradebookData.ElementGradesetId = [tracking].[Gradeset].Id
LEFT OUTER JOIN [tracking].[GradesetValue] ON [tracking].[Gradeset].Id = [tracking].[GradesetValue].GradesetId AND [tracking].[GradesetValue].Value = GradebookData.ElementValueTransposed
LEFT OUTER JOIN [tag].[Tag] ON GradebookData.GradebookID = [tag].[Tag].EntityId AND [tag].[Tag].EntityTypeId = 2 AND [Tag].CategoryId = @CategoryId
--LEFT OUTER JOIN TblTeachingManagerSubjects ON [tag].[Tag].CategoryEntityId = TblTeachingManagerSubjects.TblTeachingManagerSubjectsID AND [tag].[Tag].CategoryId = 5

LEFT OUTER JOIN [tracking].[GradesetValue] AS PotentialGradeset ON GradebookData.ElementGradesetId = PotentialGradeset.GradesetId </CommandText></Query><Fields><Field Name="GradebookID"><DataField>GradebookID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="GradebookName"><DataField>GradebookName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="SchoolId"><DataField>SchoolId</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PotentialGradesetItemValue"><DataField>PotentialGradesetItemValue</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PotentialGradesetItemTransposed"><DataField>PotentialGradesetItemTransposed</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PotentialGradesetItemOrder"><DataField>PotentialGradesetItemOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="ElementName"><DataField>ElementName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ElementType"><DataField>ElementType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ElementId"><DataField>ElementId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="ElementOrder"><DataField>ElementOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="ElementNameWithHierarchy"><DataField>ElementNameWithHierarchy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ElementOrderInHierarchy"><DataField>ElementOrderInHierarchy</DataField><rd:TypeName>System.Single</rd:TypeName></Field><Field Name="ElementValue"><DataField>ElementValue</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ElementEntryAbsent"><DataField>ElementEntryAbsent</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field><Field Name="ElementValueTransposed"><DataField>ElementValueTransposed</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtEthnicGroup"><DataField>txtEthnicGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ElementValueOrder"><DataField>ElementValueOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intSystemStatus"><DataField>intSystemStatus</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDOB"><DataField>txtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingStatus"><DataField>txtBoardingStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegisterName"><DataField>txtRegisterName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtOnRegister"><DataField>txtOnRegister</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtRegisterCode"><DataField>txtRegisterCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtWorkflow"><DataField>txtWorkflow</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TagCategory"><DataField>TagCategory</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="NoGroup"><Value>NoGroup</Value></Field><Field Name="CategoryId"><DataField>CategoryId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="Registers"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT -100 AS TblPupilRegistersRegisterId, 'N/A' As txtName, 0 as intType
UNION ALL
SELECT	TblPupilRegistersRegister.TblPupilRegistersRegisterId, TblPupilRegistersRegister.txtName, 1 as intType
FROM f_PupilRegisters_GetRegistersWithReadActivityPermission(@userCode) AS RegistersAccess
INNER JOIN TblPupilRegistersRegister ON RegistersAccess.RegisterId = TblPupilRegistersRegister.TblPupilRegistersRegisterId
WHERE	(TblPupilRegistersRegister.bActive = 1)

ORDER BY intType,	 txtName</CommandText></Query><Fields><Field Name="TblPupilRegistersRegisterId"><DataField>TblPupilRegistersRegisterId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intType"><DataField>intType</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="Disclaimer"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Path"><Value>=Globals!ReportFolder</Value></QueryParameter><QueryParameter Name="@Report"><Value>=Globals!ReportName</Value></QueryParameter></QueryParameters><CommandText>
				  SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
				  FROM	TblSQLReportingServicesDisclaimerReport
				  INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
				  WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
				  AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
				  AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report
			  </CommandText></Query><Fields><Field Name="txtDisclaimerBackgroundColour"><DataField>txtDisclaimerBackgroundColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerBorderColour"><DataField>txtDisclaimerBorderColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerDescription"><DataField>txtDisclaimerDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTextColour"><DataField>txtDisclaimerTextColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTitle"><DataField>txtDisclaimerTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS txtSchoolLogoPath, 
		TblReportsCustomImages.txtName
FROM	TblReportsCustomImages
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS txtiSAMSAddress
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="CurriculumCycle"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>WITH  GradebooksAccess AS
(
SELECT DISTINCT ModelId AS GradebookID
FROM tracking.[User]
WHERE UserCode = @userCode
AND Exception = 1
)

SELECT 'N/A' AS CycleName,
-100 AS CycleId,
1 AS StartYear,
1 As TypeOrder


UNION ALL

SELECT DISTINCT 
[curriculum].[Cycle].Name AS CycleName,
[curriculum].[Cycle].Id AS CycleId,
[curriculum].[Cycle].StartYear,
2 AS Typerder
FROM [tracking].[Model]
INNER JOIN GradebooksAccess ON [tracking].[Model].Id = GradebooksAccess.GradebookID
INNER JOIN TblTeachingManagerSets ON [tracking].[Model].ClassId = TblTeachingManagerSets.tblTeachingManagerSetsID
INNER JOIN curriculum.CourseSchedule ON TblTeachingManagerSets.intCourseSchedule = curriculum.CourseSchedule.Id
INNER JOIN curriculum.Course ON curriculum.CourseSchedule.Course = curriculum.Course.Id
INNER JOIN [curriculum].[Cycle] ON [curriculum].Course.[Cycle] = [curriculum].[Cycle].[Id]

WHERE [curriculum].[Cycle].Id IS NOT NULL
ORDER BY TypeOrder ASC, StartYear DESC , CycleName ASC</CommandText></Query><Fields><Field Name="CycleName"><DataField>CycleName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CycleId"><DataField>CycleId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="StartYear"><DataField>StartYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="TypeOrder"><DataField>TypeOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="TagCategories"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT -100 AS [Id],
'N/A' AS [Name],
0 AS OrderType

UNION ALL

SELECT 
[Id],[Name], 1 AS OrderType
FROM [tag].[Category]
ORDER BY OrderType, [Id]</CommandText></Query><Fields><Field Name="Id"><DataField>Id</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="OrderType"><DataField>OrderType</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="Tags"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@CategoryId"><Value>=Parameters!CategoryId.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 
CONCAT('-100_',-100) AS Id,
'N/A' AS Name
WHERE -100 = @CategoryId

UNION ALL

SELECT 
CONCAT('0_',Id) AS Id,
Name
FROM tag.CustomTag
WHERE 0 = @CategoryId

UNION ALL

SELECT 
CONCAT('1_',TblTeachingManagerSubjectDepartmentsID) AS Id,
txtDepartmentName AS Name
FROM TblTeachingManagerSubjectDepartments
WHERE TblTeachingManagerSubjectDepartments.blnActive = 1
AND 1 = @CategoryId

UNION ALL

SELECT 
CONCAT('2_',TblTeachingManagerSetsId) AS Id,
txtName AS Name
FROM TblTeachingManagerSets
WHERE TblTeachingManagerSets.blnActive = 1
AND 2 = @CategoryId

UNION ALL

SELECT 
CONCAT('3_',intTagId) AS Id,
txtForm AS Name
FROM TblSchoolManagementForms
WHERE 3 = @CategoryId

UNION ALL

SELECT 
CONCAT('4_',TblSchoolManagementHousesId) AS Id,
txtHouseName AS Name
FROM TblSchoolManagementHouses
WHERE 4 = @CategoryId
AND txtHouseType = 'Academic'

UNION ALL

SELECT 
CONCAT('5_',TblTeachingManagerSubjectsId) AS Id,
txtSubjectName AS Name
FROM TblTeachingManagerSubjects
WHERE TblTeachingManagerSubjects.blnActive = 1
AND 5 = @CategoryId

UNION ALL

SELECT 
CONCAT('6_',TblSchoolManagementHousesId) AS Id,
txtHouseName AS Name
FROM TblSchoolManagementHouses
WHERE 6 = @CategoryId
AND txtHouseType = 'Boarding'

UNION ALL

SELECT 
CONCAT('7_',intNCYear) AS Id,
txtYearName AS Name
FROM TblSchoolManagementYears
WHERE 7 = @CategoryId


UNION ALL

SELECT DISTINCT
CONCAT('8_',TblStaffId) AS Id,
CONCAT(Firstname,' ', Surname) AS Name
FROM TblPupilManagementPupils
INNER JOIN TblStaff ON TblPupilManagementPupils.txtTutor = TblStaff.User_Code
WHERE 8 = @CategoryId
--AND TblStaff.SystemStatus = 1


UNION ALL
--Personal Tutor is Form Tutor
SELECT DISTINCT
CONCAT('9_',TblStaffId) AS Id,
CONCAT(Firstname,' ', Surname) AS Name
FROM TblSchoolManagementForms
INNER JOIN TblStaff ON TblSchoolManagementForms.txtFormTutor = TblStaff.User_Code
WHERE 9 = @CategoryId
--AND TblStaff.SystemStatus = 1

UNION ALL

SELECT DISTINCT
CONCAT('10_',TblStaffId) AS Id,
CONCAT(Firstname,' ', Surname) AS Name
FROM TblSchoolManagementYears
INNER JOIN TblStaff ON TblSchoolManagementYears.txtYearTutor = TblStaff.User_Code
WHERE 10 = @CategoryId
--AND TblStaff.SystemStatus = 1

ORDER BY Name</CommandText></Query><Fields><Field Name="Id"><DataField>Id</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix3"><TablixCorner><TablixCornerRows><TablixCornerRow><TablixCornerCell><CellContents><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=SWITCH(CStr(Fields(Parameters!GroupDataBy.Value).Value) = "NoGroup", "Group",  
