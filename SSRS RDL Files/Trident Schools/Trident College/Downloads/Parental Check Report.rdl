<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>3b8f61bc-0106-4716-a9b8-2bce1ba9da40</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="ParentalCheckDetails"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter><QueryParameter Name="@PersonIDs"><Value>=Parameters!personIds.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @VaccinationPermissionCheck AS NVARCHAR(MAX), @HistoryPermissionCheck AS NVARCHAR(MAX), @ConsentPermissionCheck AS NVARCHAR(MAX), @ConditionsPermissionCheck AS NVARCHAR(MAX), @MedicationPermissionCheck AS NVARCHAR(MAX);

SET @VaccinationPermissionCheck  = (SELECT dbo.f_CheckUserHasActivityPermission(@userCode, 'iSAMS_MEDICALCENTRE', 'Vaccination', 'Read', 5));
SET @HistoryPermissionCheck  = (SELECT dbo.f_CheckUserHasActivityPermission(@userCode, 'iSAMS_MEDICALCENTRE', 'Note', 'Read', 5));
SET @ConsentPermissionCheck  = (SELECT dbo.f_CheckUserHasActivityPermission(@userCode, 'iSAMS_MEDICALCENTRE', 'Consent', 'Read', 5));
SET @ConditionsPermissionCheck  = (SELECT dbo.f_CheckUserHasActivityPermission(@userCode, 'iSAMS_MEDICALCENTRE', 'Condition', 'Read', 5));
SET @MedicationPermissionCheck  = (SELECT dbo.f_CheckUserHasActivityPermission(@userCode, 'iSAMS_MEDICALCENTRE', 'Medication', 'Read', 5));

WITH MainTable AS 
    (SELECT * 
     FROM	(SELECT	dbo.f_CanViewMedicalRecord(@userCode, AuditBaseData.intMedicalRecordTypeID, AuditBaseData.intSensitivity) AS 'txtAllowed',
					AuditBaseData.TblMedicalAuditBaseId,
					AuditBaseData.gKey,
					AuditBaseData.intMedicalRecordTypeId,
					AuditBaseData.intPersonId,
					AuditBaseData.bDeleted,
					AuditBaseData.bArchived,
					AuditBaseData.intSensitivity,
					AuditLogData.TblMedicalAuditLogId,
					AuditLogData.intMedicalAuditBaseId,
					AuditLogData.intMedicalAuditActionId,
					AuditLogData.txtSubmitBy,
					AuditLogData.dSubmitDateTime,
					RANK() OVER(PARTITION BY gKey ORDER BY dSubmitDateTime DESC) AS 'intRnk'
			 FROM	TblMedicalAuditBase AuditBaseData
			 JOIN	TblMedicalAuditLog AuditLogData ON AuditBaseData.TblMedicalAuditBaseId = AuditLogData.intMedicalAuditBaseId
			 WHERE	AuditBaseData.intMedicalRecordTypeId IN (6, 10, 7, 11, 2)) MostRecentRecord
     WHERE  MostRecentRecord.intRnk = 1
			AND MostRecentRecord.intMedicalAuditActionId NOT IN (4,5)
			AND MostRecentRecord.intMedicalRecordTypeId IN (6, 10, 7, 11, 2)
    )
    ,MedicalCentreDetails AS
    (SELECT MainTable.TblMedicalAuditBaseID, 
			MainTable.intPersonID, 
			CASE WHEN TblPupilManagementPupils.intPersonID IS NOT NULL THEN 'Pupil' WHEN TblStaff.intPersonID IS NOT NULL THEN 'Staff' END AS 'txtPupilOrStaff', 
			ISNULL(TblPupilManagementPupils.txtForename, TblStaff.Firstname) AS 'txtForename', 
			ISNULL(TblPupilManagementPupils.txtSurname, TblStaff.Surname) AS 'txtSurname', 
			ISNULL(TblPupilManagementPupils.txtMiddleNames, TblStaff.MiddleNames) AS 'txtMiddleNames', 
			TblPupilManagementPupils.intNCYear, 
			TblPupilManagementPupils.txtForm, 
			TblPupilManagementPupils.txtAcademicHouse, 
			TblPupilManagementPupils.txtBoardingHouse, 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalNoteType.txtType AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtType', 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordNote.txtNote AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtNote', 
			CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordNote.dReviewDate ELSE '1986-04-30 08:46' END AS 'dtReviewDate', 
			(SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'dtLastUpdatedDate',
			(SELECT TOP 1 txtSubmitBy FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'txtLastUpdatedBy', 
			ISNULL((SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID = 1), MainTable.dSubmitDateTime) AS 'dtCreationDate', 
			'Medical Centre' AS 'txtRecordType'
     FROM	MainTable
     LEFT OUTER JOIN TblMedicalRecordType ON  MainTable.intMedicalRecordTypeId = TblMedicalRecordType.TblMedicalRecordTypeId
     LEFT OUTER JOIN TblMedicalRecordNote ON MainTable.TblMedicalAuditBaseId = TblMedicalRecordNote.intMedicalAuditBaseId
     LEFT OUTER JOIN TblPupilManagementPupils ON MainTable.intPersonID = TblPupilManagementPupils.intPersonID
     LEFT OUTER JOIN TblStaff ON MainTable.intPersonID = TblStaff.intPersonID
     LEFT OUTER JOIN TblMedicalNoteType ON TblMedicalRecordNote.intMedicalNoteTypeID = TblMedicalNoteType.TblMedicalNoteTypeID
     WHERE  MainTable.intMedicalRecordTypeID = 6
			AND (MainTable.intPersonID IN (SELECT ID FROM dbo.SplitCSV(@PersonIDs) AS SplitCSV_1) OR @PersonIDs IS NULL)
    )
    ,MedicationDetails AS
    (SELECT MainTable.TblMedicalAuditBaseID, 
			MainTable.intPersonID, 
			CASE WHEN TblPupilManagementPupils.intPersonID IS NOT NULL THEN 'Pupil' WHEN TblStaff.intPersonID IS NOT NULL THEN 'Staff' END AS 'txtPupilOrStaff', 
			ISNULL(TblPupilManagementPupils.txtForename, TblStaff.Firstname) AS 'txtForename', 
			ISNULL(TblPupilManagementPupils.txtSurname, TblStaff.Surname) AS 'txtSurname', 
			ISNULL(TblPupilManagementPupils.txtMiddleNames, TblStaff.MiddleNames) AS 'txtMiddleNames', 
			TblPupilManagementPupils.intNCYear, 
			TblPupilManagementPupils.txtForm, 
			TblPupilManagementPupils.txtAcademicHouse, 
			TblPupilManagementPupils.txtBoardingHouse, 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalMedicationType.txtName AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtMedicationType', 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalMedicationType.bStockItem AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'bStockItem', 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordMedication.txtDose AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtDose', 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalMedicationLocation.txtName AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtLocation', 
			CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordMedication.dExpiryDate ELSE '1986-04-30 08:46' END AS 'dtExpiryDate', 
			CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordMedication.dIssueDate ELSE '1986-04-30 08:46' END AS 'dtIssueDate', 
			CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordMedication.dIssueDate ELSE '1986-04-30 08:46' END AS 'tIssueTime', 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordMedication.bMedicationConsent AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'bMedicationConsent', 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordMedication.txtNotes AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtNotes', 
			(SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'dtLastUpdatedDate',
			(SELECT TOP 1 txtSubmitBy FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'txtLastUpdatedBy', 
			ISNULL((SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID = 1), MainTable.dSubmitDateTime) AS 'dtCreationDate', 
			'Medication' AS 'txtRecordType'
     FROM	MainTable
     LEFT OUTER JOIN TblMedicalRecordType ON  MainTable.intMedicalRecordTypeId = TblMedicalRecordType.TblMedicalRecordTypeId
     LEFT OUTER JOIN TblMedicalRecordMedication ON MainTable.TblMedicalAuditBaseId = TblMedicalRecordMedication.intMedicalAuditBaseId
     LEFT OUTER JOIN TblPupilManagementPupils ON MainTable.intPersonID = TblPupilManagementPupils.intPersonID
     LEFT OUTER JOIN TblStaff ON MainTable.intPersonID = TblStaff.intPersonID
     LEFT OUTER JOIN TblMedicalMedicationType ON TblMedicalRecordMedication.intMedicationTypeID = TblMedicalMedicationType.TblMedicalMedicationTypeID
     LEFT OUTER JOIN TblMedicalMedicationLocation ON TblMedicalRecordMedication.intMedicalMedicationLocationID = TblMedicalMedicationLocation.TblMedicalMedicationLocationID
     WHERE  MainTable.intMedicalRecordTypeID = 10
			AND (MainTable.intPersonID IN (SELECT ID FROM dbo.SplitCSV(@PersonIDs) AS SplitCSV_1) OR @PersonIDs IS NULL)
    )
    ,ParentalConsentDetails AS
    (SELECT MainTable.TblMedicalAuditBaseID, 
			MainTable.intPersonID, 
			CASE WHEN TblPupilManagementPupils.intPersonID IS NOT NULL THEN 'Pupil' WHEN TblStaff.intPersonID IS NOT NULL THEN 'Staff' END AS 'txtPupilOrStaff', 
			ISNULL(TblPupilManagementPupils.txtForename, TblStaff.Firstname) AS 'txtForename', 
			ISNULL(TblPupilManagementPupils.txtSurname, TblStaff.Surname) AS 'txtSurname', 
			ISNULL(TblPupilManagementPupils.txtMiddleNames, TblStaff.MiddleNames) AS 'txtMiddleNames', 
			TblPupilManagementPupils.intNCYear, 
			TblPupilManagementPupils.txtForm, 
			TblPupilManagementPupils.txtAcademicHouse, 
			TblPupilManagementPupils.txtBoardingHouse, 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalConsentType.txtName AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtType', 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordConsent.bConsentAnswer AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtConsentGiven', 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordConsent.txtConsentAnswerReason AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtNotes', 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordConsent.bShowToParents AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'bShowToParents',
			CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordConsent.dReceivedDate ELSE '1986-04-30 08:46' END AS 'dtReceivedDate',
			CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordConsent.dReviewDate ELSE '1986-04-30 08:46' END AS 'dtReviewDate',
			(SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'dtLastUpdatedDate',
			(SELECT TOP 1 txtSubmitBy FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'txtLastUpdatedBy', 
			ISNULL((SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID = 1), MainTable.dSubmitDateTime) AS 'dtCreationDate', 
			'Parental Consent' AS 'txtRecordType'
     FROM	MainTable
     LEFT OUTER JOIN TblMedicalRecordType ON  MainTable.intMedicalRecordTypeId = TblMedicalRecordType.TblMedicalRecordTypeId
     LEFT OUTER JOIN TblMedicalRecordConsent ON MainTable.TblMedicalAuditBaseId = TblMedicalRecordConsent.intMedicalAuditBaseId
     LEFT OUTER JOIN TblPupilManagementPupils ON MainTable.intPersonID = TblPupilManagementPupils.intPersonID
     LEFT OUTER JOIN TblStaff ON MainTable.intPersonID = TblStaff.intPersonID
     LEFT OUTER JOIN TblMedicalConsentType ON TblMedicalRecordConsent.intMedicalConsentTypeID = TblMedicalConsentType.TblMedicalConsentTypeID
     WHERE  MainTable.intMedicalRecordTypeID = 7
			AND (MainTable.intPersonID IN (SELECT ID FROM dbo.SplitCSV(@PersonIDs) AS SplitCSV_1) OR @PersonIDs IS NULL)
    )
    ,VaccinationDetails AS
    (SELECT	MainTable.TblMedicalAuditBaseID, 
			MainTable.intPersonID, 
			CASE WHEN TblPupilManagementPupils.intPersonID IS NOT NULL THEN 'Pupil' WHEN TblStaff.intPersonID IS NOT NULL THEN 'Staff' END AS 'txtPupilOrStaff', 
			ISNULL(TblPupilManagementPupils.txtForename, TblStaff.Firstname) AS 'txtForename', 
			ISNULL(TblPupilManagementPupils.txtSurname, TblStaff.Surname) AS 'txtSurname', 
			ISNULL(TblPupilManagementPupils.txtMiddleNames, TblStaff.MiddleNames) AS 'txtMiddleNames', 
			TblPupilManagementPupils.intNCYear, 
			TblPupilManagementPupils.txtForm, 
			TblPupilManagementPupils.txtAcademicHouse, 
			TblPupilManagementPupils.txtBoardingHouse, 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalVaccinationType.txtName AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtType', 
			CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordVaccination.dGiven ELSE '1986-04-30 08:46' END AS 'dtDateGiven', 
			CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordVaccination.dDue ELSE '1986-04-30 08:46' END AS 'dtDueDate', 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordVaccination.intNumber AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'intNumberOfVaccinations',
			(SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'dtLastUpdatedDate',
			(SELECT TOP 1 txtSubmitBy FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'txtLastUpdatedBy', 
			ISNULL((SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID = 1), MainTable.dSubmitDateTime) AS 'dtCreationDate',
			'Vaccination' AS 'txtRecordType'
     FROM	MainTable
     LEFT OUTER JOIN TblMedicalRecordType ON  MainTable.intMedicalRecordTypeId = TblMedicalRecordType.TblMedicalRecordTypeId
     LEFT OUTER JOIN TblMedicalRecordVaccination ON MainTable.TblMedicalAuditBaseId = TblMedicalRecordVaccination.intMedicalAuditBaseId
     LEFT OUTER JOIN TblPupilManagementPupils ON MainTable.intPersonID = TblPupilManagementPupils.intPersonID
     LEFT OUTER JOIN TblStaff ON MainTable.intPersonID = TblStaff.intPersonID
     LEFT OUTER JOIN TblMedicalVaccinationType ON TblMedicalRecordVaccination.intMedicalVaccinationTypeID = TblMedicalVaccinationType.TblMedicalVaccinationTypeID
     WHERE  MainTable.intMedicalRecordTypeID = 11
			AND (MainTable.intPersonID IN (SELECT ID FROM dbo.SplitCSV(@PersonIDs) AS SplitCSV_1) OR @PersonIDs IS NULL)
    )
    ,ConditionDetails AS
    (SELECT MainTable.TblMedicalAuditBaseID, 
			MainTable.intPersonID,
			CASE WHEN TblPupilManagementPupils.intPersonID IS NOT NULL THEN 'Pupil' WHEN TblStaff.intPersonID IS NOT NULL THEN 'Staff' END AS 'txtPupilOrStaff', 
			ISNULL(TblPupilManagementPupils.txtForename, TblStaff.Firstname) AS 'txtForename', 
			ISNULL(TblPupilManagementPupils.txtSurname, TblStaff.Surname) AS 'txtSurname', 
			ISNULL(TblPupilManagementPupils.txtMiddleNames, TblStaff.MiddleNames) AS 'txtMiddleNames', 
			TblPupilManagementPupils.intNCYear, 
			TblPupilManagementPupils.txtForm, 
			TblPupilManagementPupils.txtAcademicHouse, 
			TblPupilManagementPupils.txtBoardingHouse, 
			TblMedicalConditionGroup.txtGroup AS 'txtConditionType', 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordCondition.txtType AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtCondition', 
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalConditionSeverity.txtSeverity AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtSeverity',
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordCondition.txtTrigger AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtTrigger',
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordCondition.txtTreatment AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtTreatment',
			CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordCondition.txtFurtherInfo AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtFurtherInfo',
			TblMedicalRecordCondition.dEntered AS 'dtDateOfEntry', 
			TblMedicalRecordCondition.dReviewed AS 'dtReviewedDate', 
			(SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'dtLastUpdatedDate',
			(SELECT TOP 1 txtSubmitBy FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'txtLastUpdatedBy', 
			ISNULL((SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
			intMedicalAuditActionID = 1), MainTable.dSubmitDateTime) AS 'dtCreationDate', 
			'Conditions' AS 'txtRecordType'
     FROM	MainTable
     LEFT OUTER JOIN TblMedicalRecordType ON  MainTable.intMedicalRecordTypeId = TblMedicalRecordType.TblMedicalRecordTypeId  
     LEFT OUTER JOIN TblMedicalRecordCondition ON MainTable.TblMedicalAuditBaseId = TblMedicalRecordCondition.intMedicalAuditBaseId
     LEFT OUTER JOIN TblPupilManagementPupils ON MainTable.intPersonID = TblPupilManagementPupils.intPersonID
     LEFT OUTER JOIN TblStaff ON MainTable.intPersonID = TblStaff.intPersonID
     LEFT OUTER JOIN TblMedicalConditionSeverity ON TblMedicalRecordCondition.intMedicalConditionSeverityID = TblMedicalConditionSeverity.TblMedicalConditionSeverityID
     LEFT OUTER JOIN TblMedicalConditionGroup ON TblMedicalRecordCondition.intMedicalConditionGroupId = TblMedicalConditionGroup.TblMedicalConditionGroupId
     WHERE  MainTable.intMedicalRecordTypeID = 2
			AND (MainTable.intPersonID IN (SELECT ID FROM dbo.SplitCSV(@PersonIDs) AS SplitCSV_1) OR @PersonIDs IS NULL)
    )
    ,BeginingDataTable AS
    (SELECT	TblPupilManagementPupils.intPersonID, 
			'Pupil' AS 'txtPupilOrStaff', 
			TblPupilManagementPupils.txtForename, 
			TblPupilManagementPupils.txtSurname, 
			TblPupilManagementPupils.txtMiddleNames, 
			TblPupilManagementPupils.intNCYear, 
			TblPupilManagementPupils.txtForm, 
			TblPupilManagementPupils.txtAcademicHouse, 
			TblPupilManagementPupils.txtBoardingHouse, 
			TblMedicalAuditBase.TblMedicalAuditBaseID
     FROM	TblPupilManagementPupils
	 INNER JOIN TblMedicalAuditBase ON TblMedicalAuditBase.intPersonID = TblPupilManagementPupils.intPersonID
	 WHERE	(TblPupilManagementPupils.intPersonID IN (SELECT ID FROM dbo.SplitCSV(@PersonIDs) AS SplitCSV_1) OR @PersonIDs IS NULL)
	   UNION ALL
     SELECT TblStaff.intPersonID, 
			'Staff' AS 'txtPupilOrStaff', 
			TblStaff.Firstname AS 'txtForename', 
			TblStaff.Surname AS 'txtSurname', 
			TblStaff.MiddleNames AS 'txtMiddleNames', 
			NULL AS 'intNCYear', 
			NULL AS 'txtForm', 
			NULL AS 'txtAcademicHouse', 
			NULL AS 'txtBoardingHouse', 
			TblMedicalAuditBase.TblMedicalAuditBaseID
	 FROM	TblStaff
	 INNER JOIN TblMedicalAuditBase ON TblMedicalAuditBase.intPersonID = TblStaff.intPersonID
	 WHERE	(TblStaff.intPersonID IN (SELECT ID FROM dbo.SplitCSV(@PersonIDs) AS SplitCSV_1) OR @PersonIDs IS NULL)
    )

SELECT	BeginingDataTable.*, 
		ISNULL(ISNULL(ISNULL(ISNULL(CAST(MedicalCentreDetails.txtRecordType AS NVARCHAR(MAX)), CAST(MedicationDetails.txtRecordType AS NVARCHAR(MAX))), CAST(ParentalConsentDetails.txtRecordType AS NVARCHAR(MAX))), CAST(VaccinationDetails.txtRecordType AS NVARCHAR(MAX))), CAST(ConditionDetails.txtRecordType AS NVARCHAR(MAX))) AS 'txtRecordType',
		MedicalCentreDetails.txtType AS 'txtMedicalCentreType', 
		MedicalCentreDetails.txtNote AS 'txtMedicalCentreNote', 
		MedicalCentreDetails.dtReviewDate AS 'dtMedicalCentreReviewDate',
		MedicationDetails.txtMedicationType, 
		MedicationDetails.bStockItem, 
		MedicationDetails.txtDose, 
		MedicationDetails.txtLocation AS 'txtMedicationLocation',
		MedicationDetails.dtExpiryDate AS 'dtMedicationExpiryDate',
		MedicationDetails.dtIssueDate AS 'dtMedicationIssueDate', 
		MedicationDetails.bMedicationConsent,
		MedicationDetails.txtNotes AS 'txtMedicationNotes',
		ParentalConsentDetails.txtType AS 'txtParentalConsentType', 
		ParentalConsentDetails.txtConsentGiven, 
		ParentalConsentDetails.bShowToParents, 
		ParentalConsentDetails.dtReceivedDate AS 'dtParentalConsentReceivedDate', 
		ParentalConsentDetails.dtReviewDate AS 'dtParentalConsentReviewDate', 
		VaccinationDetails.txtType AS 'txtVaccinationType',
		VaccinationDetails.dtDateGiven AS 'dtVaccinationDateGiven',
		VaccinationDetails.dtDueDate AS 'dtVaccinationDueDate',
		VaccinationDetails.intNumberOfVaccinations,
		ConditionDetails.txtConditionType, 
		ConditionDetails.txtCondition, 
		ConditionDetails.txtSeverity, 
		ConditionDetails.txtTrigger, 
		ConditionDetails.txtTreatment, 
		ConditionDetails.txtFurtherInfo,
		ConditionDetails.dtDateOfEntry AS 'dtCondtionDateOfEntry', 
		ConditionDetails.dtReviewedDate AS 'dtConditionReviewDate',
		ISNULL(ISNULL(ISNULL(ISNULL(MedicalCentreDetails.dtLastUpdatedDate, MedicationDetails.dtLastUpdatedDate), ParentalConsentDetails.dtLastUpdatedDate), VaccinationDetails.dtLastUpdatedDate), ConditionDetails.dtLastUpdatedDate) AS 'dtLastUpdatedDate',
		ISNULL(ISNULL(ISNULL(ISNULL(MedicalCentreDetails.txtLastUpdatedBy, MedicationDetails.txtLastUpdatedBy), ParentalConsentDetails.txtLastUpdatedBy), VaccinationDetails.txtLastUpdatedBy), ConditionDetails.txtLastUpdatedBy) AS 'txtLastUpdatedBy',
		ISNULL(ISNULL(ISNULL(ISNULL(MedicalCentreDetails.dtCreationDate, MedicationDetails.dtCreationDate), ParentalConsentDetails.dtCreationDate), 
		VaccinationDetails.dtCreationDate), ConditionDetails.dtCreationDate) AS 'dtCreationDate',
		@VaccinationPermissionCheck AS 'blnVaccinationPermissionCheck', 
		@HistoryPermissionCheck AS 'blnHistoryPermissionCheck', 
		@ConsentPermissionCheck AS 'blnConsentPermissionCheck',
		@ConditionsPermissionCheck AS 'blnConditionsPermissionCheck', 
		@MedicationPermissionCheck AS 'blnMedicationPermissionCheck'
FROM	BeginingDataTable
LEFT OUTER JOIN MedicalCentreDetails ON BeginingDataTable.intPersonID = MedicalCentreDetails.intPersonID AND BeginingDataTable.TblMedicalAuditBaseID = MedicalCentreDetails.TblMedicalAuditBaseID
LEFT OUTER JOIN MedicationDetails ON BeginingDataTable.intPersonID = MedicationDetails.intPersonID AND BeginingDataTable.TblMedicalAuditBaseID = MedicationDetails.TblMedicalAuditBaseID
LEFT OUTER JOIN ParentalConsentDetails ON BeginingDataTable.intPersonID = ParentalConsentDetails.intPersonID AND BeginingDataTable.TblMedicalAuditBaseID = ParentalConsentDetails.TblMedicalAuditBaseID
LEFT OUTER JOIN VaccinationDetails ON BeginingDataTable.intPersonID = VaccinationDetails.intPersonID AND BeginingDataTable.TblMedicalAuditBaseID = VaccinationDetails.TblMedicalAuditBaseID
LEFT OUTER JOIN ConditionDetails ON BeginingDataTable.intPersonID = ConditionDetails.intPersonID AND BeginingDataTable.TblMedicalAuditBaseID = ConditionDetails.TblMedicalAuditBaseID
