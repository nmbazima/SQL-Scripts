<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>3b8f61bc-0106-4716-a9b8-2bce1ba9da40</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="ConsentDetails"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter><QueryParameter Name="@PersonIDs"><Value>=Parameters!personIds.Value</Value></QueryParameter></QueryParameters><CommandText>DECLARE @ConsentPermissionCheck AS NVARCHAR(MAX);

SET @ConsentPermissionCheck  = (SELECT dbo.f_CheckUserHasActivityPermission(@userCode, 'iSAMS_MEDICALCENTRE', 'Consent', 'Read', 5));

WITH MainTable AS 
    (SELECT * 
     FROM	(SELECT	dbo.f_CanViewMedicalRecord(@userCode, AuditBaseData.intMedicalRecordTypeID, AuditBaseData.intSensitivity) AS 'txtAllowed',
					AuditBaseData.TblMedicalAuditBaseId,
					AuditBaseData.gKey,
					AuditBaseData.intMedicalRecordTypeId,
					AuditBaseData.intPersonId,
					AuditBaseData.bDeleted,
					AuditBaseData.bArchived,
					AuditBaseData.intSensitivity,
					AuditLogData.TblMedicalAuditLogId,
					AuditLogData.intMedicalAuditBaseId,
					AuditLogData.intMedicalAuditActionId,
					AuditLogData.txtSubmitBy,
					AuditLogData.dSubmitDateTime,
					RANK() OVER(PARTITION BY gKey ORDER BY dSubmitDateTime DESC) AS 'intRnk'
			 FROM	TblMedicalAuditBase AuditBaseData
			 JOIN	TblMedicalAuditLog AuditLogData ON AuditBaseData.TblMedicalAuditBaseId = AuditLogData.intMedicalAuditBaseId
			 WHERE	AuditBaseData.intMedicalRecordTypeId = 7) MostRecentRecord
     WHERE  MostRecentRecord.intRnk = 1
			AND MostRecentRecord.intMedicalAuditActionId NOT IN (4,5)
			AND MostRecentRecord.intMedicalRecordTypeId = 7
    )

SELECT  MainTable.TblMedicalAuditBaseID, 
		MainTable.intPersonID, 
		CASE WHEN TblPupilManagementPupils.intPersonID IS NOT NULL THEN 'Pupil' WHEN TblStaff.intPersonID IS NOT NULL THEN 'Staff' END AS 'txtPupilOrStaff', 
		ISNULL(TblPupilManagementPupils.txtForename, TblStaff.Firstname) AS 'txtForename', 
		ISNULL(TblPupilManagementPupils.txtSurname, TblStaff.Surname) AS 'txtSurname', 
		ISNULL(TblPupilManagementPupils.txtMiddleNames, TblStaff.MiddleNames) AS 'txtMiddleNames', 
		TblPupilManagementPupils.intNCYear, 
		TblPupilManagementPupils.txtForm, 
		TblPupilManagementPupils.txtAcademicHouse, 
		TblPupilManagementPupils.txtBoardingHouse, 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalConsentType.txtName AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtType', 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordConsent.bConsentAnswer AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtConsentGiven', 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordConsent.txtConsentAnswerReason AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'txtNotes', 
		CASE WHEN MainTable.txtAllowed = 1 THEN CAST(TblMedicalRecordConsent.bShowToParents AS NVARCHAR(MAX)) ELSE 'Sensitive data' END AS 'bShowToParents',
		CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordConsent.dReceivedDate ELSE '1986-04-30 08:46' END AS 'dtReceivedDate',
		CASE WHEN MainTable.txtAllowed = 1 THEN TblMedicalRecordConsent.dReviewDate ELSE '1986-04-30 08:46' END AS 'dtReviewDate',
		(SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
		intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'dtLastUpdatedDate',
		(SELECT TOP 1 txtSubmitBy FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
		intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime DESC) AS 'txtLastUpdatedBy', 
		ISNULL((SELECT TOP 1 dSubmitDateTime FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = MainTable.TblMedicalAuditBaseID AND 
		intMedicalAuditActionID = 1), MainTable.dSubmitDateTime) AS 'dtCreationDate', 
		@ConsentPermissionCheck AS 'blnConsentPermissionCheck'
FROM	MainTable
LEFT OUTER JOIN TblMedicalRecordType ON  MainTable.intMedicalRecordTypeId = TblMedicalRecordType.TblMedicalRecordTypeId
LEFT OUTER JOIN TblMedicalRecordConsent ON MainTable.TblMedicalAuditBaseId = TblMedicalRecordConsent.intMedicalAuditBaseId
LEFT OUTER JOIN TblPupilManagementPupils ON MainTable.intPersonID = TblPupilManagementPupils.intPersonID
LEFT OUTER JOIN TblStaff ON MainTable.intPersonID = TblStaff.intPersonID
LEFT OUTER JOIN TblMedicalConsentType ON TblMedicalRecordConsent.intMedicalConsentTypeID = TblMedicalConsentType.TblMedicalConsentTypeID
WHERE   MainTable.intMedicalRecordTypeID = 7
		AND (MainTable.intPersonID IN (SELECT ID FROM dbo.SplitCSV(@PersonIDs) AS SplitCSV_1) OR @PersonIDs IS NULL)</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="TblMedicalAuditBaseID"><DataField>TblMedicalAuditBaseID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intPersonID"><DataField>intPersonID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtPupilOrStaff"><DataField>txtPupilOrStaff</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtType"><DataField>txtType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtConsentGiven"><DataField>txtConsentGiven</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="bShowToParents"><DataField>bShowToParents</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtReceivedDate"><DataField>dtReceivedDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtNotes"><DataField>txtNotes</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtLastUpdatedDate"><DataField>dtLastUpdatedDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dtReviewDate"><DataField>dtReviewDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtLastUpdatedBy"><DataField>txtLastUpdatedBy</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtCreationDate"><DataField>dtCreationDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="blnConsentPermissionCheck"><DataField>blnConsentPermissionCheck</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT txtExternaliSAMSAddress AS txtiSAMSAddress, txtiSAMSServerName
FROM TbliSAMSManagerSettings</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtiSAMSServerName"><DataField>txtiSAMSServerName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT TblReportsCustomImages.txtPath + TblReportsCustomImages.txtFileName AS txtSchoolLogoPath, txtName
FROM TblReportsCustomImages
WHERE TblReportsCustomImages.txtName LIKE '%School Logo%'
ORDER BY TblReportsCustomImages.dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix2"><TablixBody><TablixColumns><TablixColumn><Width>32.5cm</Width></TablixColumn><TablixColumn><Width>5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>1.4cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox32"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!txtiSAMSServerName.Value, "iSAMSAddress")</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun><TextRun><Value> - Parental Consent Report</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox30</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Rectangle Name="Rectangle8"><ReportItems><Image Name="Image22"><Source>External</Source><Value>=IIF(Right(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), 1) = "/", Left(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress"), Len(First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) - 1), First(Fields!txtiSAMSAddress.Value, "iSAMSAddress")) &amp; First(Fields!txtSchoolLogoPath.Value, "SchoolLogo")</Value><Sizing>FitProportional</Sizing><Left>1.9cm</Left><Height>1.4cm</Height><Width>3.1cm</Width><Style><Border><Style>None</Style></Border></Style></Image></ReportItems><KeepTogether>true</KeepTogether><Style><Border><Style>None</Style></Border></Style></Rectangle></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox7"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Generated on </Value><Style><FontSize>12pt</FontSize></Style></TextRun><TextRun><Value>=Globals!ExecutionTime</Value><Style><FontSize>12pt</FontSize><Format>dd/MM/yyyy</Format></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox3</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox47"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>You are not authorised to view this data. Please contact your administrator for more information.</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox47</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#8eceec</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow><TablixRow><Height>0.6cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox14"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>No Parental Consent entries exist with the criteria you chose.</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Alter your selection to re-search the iSAMS database.</Value><Style><FontSize>8pt</FontSize><FontWeight>Normal</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell><TablixCell /></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember><Visibility><Hidden>=IIF(CountRows("ConsentDetails")&gt;0,false,true)</Hidden></Visibility></TablixMember><TablixMember><Visibility><Hidden>=IIF(CountRows("ConsentDetails")=0,false,true)</Hidden></Visibility></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>ConsentDetails</DataSetName><Height>3.2cm</Height><Width>37.5cm</Width><Visibility><Hidden>=IIF(MAX(Fields!blnConsentPermissionCheck.Value) = True OR TRIM(CStr(Fields!blnConsentPermissionCheck.Value)) = "", True, False)</Hidden></Visibility><Style><Border><Style>None</Style></Border></Style></Tablix><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColumn><TablixColumn><Width>2.5cm</Width></TablixColu