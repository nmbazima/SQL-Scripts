<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>a4c1dae1-4095-4919-a9c3-81c2eff89f40</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="PastoralFlagStudent"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter><QueryParameter Name="@intPastoralFlagType"><Value>=Parameters!intPastoralFlagType.Value</Value></QueryParameter></QueryParameters><CommandText>
SELECT 
	TblPupilManagementPupils.txtSchoolID,
	TblPupilManagementPupils.txtForename,
	TblPupilManagementPupils.txtSurname,
	TblPupilManagementPupils.txtPreName,
	TblPupilManagementPupils.intNCYear,
	TblSchoolManagementYears.txtYearName,
	TblSchoolManagementYears.txtYearCode,
	TblPupilManagementPupils.txtForm,
	TblPupilManagementPupils.txtAcademicHouse,
	TblSchoolManagementHouses.txtHouseCode AS txtAcademicHouseCode,
	TblPupilManagementPupils.txtBoardingHouse,
	BoardingHouse.txtHouseCode AS txtBoardingHouseCode,
	pastoral.FlagType.Name AS txtPastoralFlagType,
	pastoral.Flag.Notes AS txtPastoralFlagNotes
FROM TblPupilManagementPupils
INNER JOIN pastoral.Flag ON TblPupilManagementPupils.txtSchoolID = pastoral.Flag.SchoolId
INNER JOIN pastoral.FlagType ON pastoral.Flag.FlagTypeId = pastoral.FlagType.Id
LEFT OUTER JOIN TblSchoolManagementYears
	ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear
LEFT OUTER JOIN TblSchoolManagementHouses 
	ON TblPupilManagementPupils.txtAcademicHouse = TblSchoolManagementHouses.txtHouseName
LEFT OUTER JOIN TblSchoolManagementHouses AS BoardingHouse
	ON TblPupilManagementPupils.txtBoardingHouse = BoardingHouse.txtHouseName
WHERE TblPupilManagementPupils.txtSchoolID IN (@txtSchoolID)
AND pastoral.FlagType.Id IN (@intPastoralFlagType)</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtAcademicHouseCode"><DataField>txtAcademicHouseCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouseCode"><DataField>txtBoardingHouseCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPastoralFlagType"><DataField>txtPastoralFlagType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPastoralFlagNotes"><DataField>txtPastoralFlagNotes</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Disclaimer"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@Path"><Value>=Globals!ReportFolder</Value></QueryParameter><QueryParameter Name="@Report"><Value>=Globals!ReportName</Value></QueryParameter></QueryParameters><CommandText>
				  SELECT	TblSQLReportingServicesDisclaimer.txtDisclaimerBackgroundColour,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerBorderColour,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerDescription,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerTextColour,
				  TblSQLReportingServicesDisclaimer.txtDisclaimerTitle
				  FROM	TblSQLReportingServicesDisclaimerReport
				  INNER JOIN TblSQLReportingServicesDisclaimer ON TblSQLReportingServicesDisclaimerReport.SQLReportingServicesDisclaimerId = TblSQLReportingServicesDisclaimer.TblSQLReportingServicesDisclaimerID
				  WHERE	TblSQLReportingServicesDisclaimerReport.bitEnabled = 1
				  AND TblSQLReportingServicesDisclaimer.bitEnabled = 1
				  AND TblSQLReportingServicesDisclaimerReport.txtReportPath = @Path + '/' + @Report
			  </CommandText></Query><Fields><Field Name="txtDisclaimerBackgroundColour"><DataField>txtDisclaimerBackgroundColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerBorderColour"><DataField>txtDisclaimerBorderColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerDescription"><DataField>txtDisclaimerDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTextColour"><DataField>txtDisclaimerTextColour</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDisclaimerTitle"><DataField>txtDisclaimerTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Students"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter><QueryParameter Name="@txtForm"><Value>=Parameters!txtForm.Value</Value></QueryParameter><QueryParameter Name="@txtAcademicHouse"><Value>=Parameters!txtAcademicHouse.Value</Value></QueryParameter><QueryParameter Name="@txtBoardingHouse"><Value>=Parameters!txtBoardingHouse.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 	
	'No Student' AS txtSchoolID,
	'No Student' AS txtStudentName,
	1 AS intOrder

UNION ALL

SELECT 
	DISTINCT	
	TblPupilManagementPupils.txtSchoolID,
	TblPupilManagementPupils.txtSurname + ', ' + TblPupilManagementPupils.txtForename AS txtStudentName,
	2 AS intOrder
FROM  TblPupilManagementPupils
INNER JOIN pastoral.Flag ON TblPupilManagementPupils.txtSchoolID = pastoral.Flag.SchoolId

WHERE (CASE WHEN TblPupilManagementPupils.intNCYear IS NULL THEN -100 ELSE TblPupilManagementPupils.intNCYear END IN (@intNCYear))
AND (CASE WHEN NULLIF(TblPupilManagementPupils.txtForm,'') IS NULL THEN 'No Form' ELSE TblPupilManagementPupils.txtForm END IN (@txtForm))
AND (CASE WHEN NULLIF(TblPupilManagementPupils.txtAcademicHouse,'') IS NULL THEN 'No House' ELSE TblPupilManagementPupils.txtAcademicHouse END IN (@txtAcademicHouse))
AND (CASE WHEN NULLIF(TblPupilManagementPupils.txtBoardingHouse,'') IS NULL THEN 'No House' ELSE TblPupilManagementPupils.txtBoardingHouse END IN (@txtBoardingHouse))
AND TblPupilManagementPupils.intSystemStatus = 1
ORDER BY intOrder, txtStudentName</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtStudentName"><DataField>txtStudentName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="YearGroup"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT -100 AS intNCYear,
'No Year' AS txtYearName
UNION ALL
SELECT intNCYear, txtYearName
FROM TblSchoolManagementYears
ORDER BY intNCYear</CommandText></Query><Fields><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Form"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT -100 AS intNCYear,
'No Form' AS txtForm
UNION ALL
SELECT intNCYear, txtForm
FROM TblSchoolManagementForms
ORDER BY intNCYear, txtForm</CommandText></Query><Fields><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="AcademicHouse"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT 
1 AS intOrder,
'No House' AS txtAcademicHouse
UNION ALL
SELECT 
2 AS intOrder,
TblSchoolManagementHouses.txtHouseName AS txtAcademicHouse
FROM TblSchoolManagementHouses
WHERE TblSchoolManagementHouses.txtHouseType = 'Academic'
ORDER BY intOrder, txtAcademicHouse</CommandText></Query><Fields><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="BoardingHouse"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT 
1 AS intOrder,
'No House' AS txtBoardingHouse
UNION ALL
SELECT 
2 AS intOrder,
TblSchoolManagementHouses.txtHouseName AS txtBoardingHouse
FROM TblSchoolManagementHouses
WHERE TblSchoolManagementHouses.txtHouseType = 'Boarding'
ORDER BY intOrder, txtBoardingHouse</CommandText></Query><Fields><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="User"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	TbliSAMSManagerUsers.txtUsername
FROM	TbliSAMSManagerUsers
WHERE	TbliSAMSManagerUsers.txtUserCode = @userCode</CommandText></Query><Fields><Field Name="txtUsername"><DataField>txtUsername</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT        txtPath + txtFilename AS txtSchoolLogoPath, txtName 
FROM            TblReportsCustomImages
WHERE        (txtName LIKE '%School Logo%')
ORDER BY dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtName"><DataField>txtName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS 'txtiSAMSAddress'
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="PastoralFlagType"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT pastoral.FlagType.Id,
pastoral.FlagType.Name
FROM pastoral.FlagType
WHERE pastoral.FlagType.Deleted &lt;&gt; 1
ORDER BY pastoral.FlagType.Name</CommandText></Query><Fields><Field Name="Id"><DataField>Id</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Permission"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@userCode"><Value>=Parameters!userCode.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT 
[dbo].[f_CheckUserHasActivityPermission](@userCode, 'iSAMS_PASTORAL', 'PastoralFlag', 'Read', 0) AS intPFPermission
FROM TbliSAMSManagerUsers
WHERE	TbliSAMSManagerUsers.txtUserCode = @userCode</CommandText></Query><Fields><Field Name="intPFPermission"><DataField>intPFPermission</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix11"><TablixBody><TablixColumns><TablixColumn><Width>6cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>3.5cm</Width></TablixColumn><TablixColumn><Width>4cm</Width></TablixColumn><TablixColumn><Width>11.2cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox24"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Name</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox4</rd:DefaultName><Style><Border><Color>#373948</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox181"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Year Group</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>Textbox181</rd:DefaultName><Style><Border><Color>#373948</Color><Style>Solid</Style><Width>0.5pt</Width></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop