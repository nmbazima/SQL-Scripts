le><Width>0.5pt</Width></Border><BackgroundColor>#373948</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="txtProgramme5"><CanGrow>true</CanGrow><CanShrink>true</CanShrink><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtSurname.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun><TextRun><Value>, </Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun><TextRun><Value>=Fields!txtForename.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun><TextRun><Value>=IIF(Fields!txtForename.Value=Fields!txtPreName.Value OR Fields!txtPreName.Value="",""," (" + Fields!txtPreName.Value + ")")</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtProgramme1</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><Style>Solid</Style><Width>0.5pt</Width></Border><RightBorder><Style>None</Style></RightBorder><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="txtYearCode"><CanGrow>true</CanGrow><CanShrink>true</CanShrink><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtYearCode.Value</Value><Style><FontSize>12pt</FontSize><Color>#373948</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>txtYearCode</rd:DefaultName><Style><Border><Color>#c1bfc5</Color><