<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>7160eea3-e500-4ea7-b572-39e7de039e7b</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Main"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@SystemStatus"><Value>=Parameters!SystemStatus.Value</Value></QueryParameter><QueryParameter Name="@DateStart"><Value>=Parameters!DateStart.Value</Value></QueryParameter><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter><QueryParameter Name="@TeachingStaff"><Value>=Parameters!TeachingStaff.Value</Value></QueryParameter><QueryParameter Name="@PartTime"><Value>=Parameters!PartTime.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	TblStaff.Surname, 
		TblStaff.Initials, 
		TblStaff.User_Code, 
		TblStaff.Title, 
		TblStaff.Firstname, 
		TblStaff.MiddleNames, 
		TblStaff.DOB, ISNULL(TblStaff.Sex, 'U') AS 'Sex',
        TblStaff.CountryofResidence, 
		TblStaff.Nationality, 
		TblStaff.Language, 
		TblStaff.Religion, 
		TblStaff.EthnicGroup, 
		TblStaff.BirthPlace, 
		TblStaff.BirthCounty, 
        TblStaff.BirthCountry, 
		TblStaff.EnrolmentDate, 
		CAST(TblStaff.intEnrolmentSchoolYear AS NVARCHAR(4)) AS 'intEnrolmentSchoolYear', 
		TblStaff.EnrolmentTerm, 
		CAST(TblStaff.PreviousSchool AS NVARCHAR(MAX)) AS 'PreviousSchool', 
		TblStaff.LeavingDate, 
        CAST(TblStaff.intLeavingSchoolYear AS NVARCHAR(4)) AS 'intLeavingSchoolYear', 
		TblStaff.LeavingTerm, 
		CAST(TblStaff.FutureSchool AS NVARCHAR(MAX)) AS 'FutureSchool', 
		CAST(TblStaff.PartTime AS NVARCHAR(1)) AS 'PartTime', 
		CAST(TblStaff.HoursWorkedPW AS NVARCHAR(MAX)) AS 'HoursWorkedPW', 
		CAST(TblStaff.TeachingStaff AS NVARCHAR(1)) AS 'TeachingStaff', 
        CAST(TblStaff.SystemStatus AS NVARCHAR(MAX)) AS 'SystemStatus', 
		TblSchools.Name, 
		FutureScholol.Name AS 'FutureName', 
		TblStaff.TblStaffID, 
		TblStaff.MaritalStatus, 
		CAST(TblStaff.ChildrenInSchool AS NVARCHAR(1)) AS 'ChildrenInSchool', 
        TblStaff.txtLeavingReason, 
		CAST(TblStaff.intRetirementAge AS NVARCHAR(MAX)) AS 'intRetirementAge', 
		CAST(TblStaff.blnBaptised AS NVARCHAR(1)) AS 'blnBaptised', 
		CAST(TblStaff.blnConfirmation AS NVARCHAR(1)) AS 'blnConfirmation', 
		CAST(TblStaff.PersonalTutor AS NVARCHAR(1)) AS 'PersonalTutor', 
        TblUniversities.Name AS 'UniversityName'
FROM	TblStaff 
LEFT OUTER JOIN TblSchools ON TblStaff.PreviousSchool = TblSchools.TblSchoolsID 
LEFT OUTER JOIN TblSchools AS FutureScholol ON TblStaff.FutureSchool = FutureScholol.TblSchoolsID 
LEFT OUTER JOIN TblUniversities ON TblStaff.University = TblUniversities.UID
WHERE	(TblStaff.SystemStatus IN (@SystemStatus)) 
		AND (TblStaff.EnrolmentDate BETWEEN @DateStart AND @EndDate OR TblStaff.EnrolmentDate IS NULL) 
		AND (TblStaff.TeachingStaff IN (@TeachingStaff) OR TblStaff.TeachingStaff IS NULL) 
		AND (TblStaff.PartTime IN (@PartTime) OR TblStaff.PartTime IS NULL)</CommandText></Query><Fields><Field Name="Surname"><DataField>Surname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Initials"><DataField>Initials</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="User_Code"><DataField>User_Code</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Title"><DataField>Title</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Firstname"><DataField>Firstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="MiddleNames"><DataField>MiddleNames</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DOB"><DataField>DOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Sex"><DataField>Sex</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="CountryofResidence"><DataField>CountryofResidence</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Nationality"><DataField>Nationality</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Language"><DataField>Language</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Religion"><DataField>Religion</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="EthnicGroup"><DataField>EthnicGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BirthPlace"><DataField>BirthPlace</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BirthCounty"><DataField>BirthCounty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="BirthCountry"><DataField>BirthCountry</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="EnrolmentDate"><DataField>EnrolmentDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intEnrolmentSchoolYear"><DataField>intEnrolmentSchoolYear</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="EnrolmentTerm"><DataField>EnrolmentTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PreviousSchool"><DataField>PreviousSchool</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="LeavingDate"><DataField>LeavingDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="intLeavingSchoolYear"><DataField>intLeavingSchoolYear</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="LeavingTerm"><DataField>LeavingTerm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="FutureSchool"><DataField>FutureSchool</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PartTime"><DataField>PartTime</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="HoursWorkedPW"><DataField>HoursWorkedPW</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TeachingStaff"><DataField>TeachingStaff</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="SystemStatus"><DataField>SystemStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="FutureName"><DataField>FutureName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblStaffID"><DataField>TblStaffID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="MaritalStatus"><DataField>MaritalStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ChildrenInSchool"><DataField>ChildrenInSchool</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtLeavingReason"><DataField>txtLeavingReason</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intRetirementAge"><DataField>intRetirementAge</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnBaptised"><DataField>blnBaptised</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="blnConfirmation"><DataField>blnConfirmation</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PersonalTutor"><DataField>PersonalTutor</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="UniversityName"><DataField>UniversityName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields><Filters><Filter><FilterExpression>=IIF(Format(Parameters!DateStart.Value,"dd/MM/yyyy") = Format(Parameters!MinDate.Value,"dd/MM/yyyy"),true,isNothing(Fields!EnrolmentDate.Value))</FilterExpression><Operator>Equal</Operator><FilterValues><FilterValue>=IIF(Format(Parameters!DateStart.Value,"dd/MM/yyyy") = Format(Parameters!MinDate.Value,"dd/MM/yyyy"),true,false)</FilterValue></FilterValues></Filter><Filter><FilterExpression>=IIF(Format(Parameters!EndDate.Value,"dd/MM/yyyy") = Format(Parameters!MaxDate.Value,"dd/MM/yyyy"),true,isNothing(Fields!EnrolmentDate.Value))</FilterExpression><Operator>Equal</Operator><FilterValues><FilterValue>=IIF(Format(Parameters!EndDate.Value,"dd/MM/yyyy") = Format(Parameters!MaxDate.Value,"dd/MM/yyyy"),true,false)</FilterValue></FilterValues></Filter><Filter><FilterExpression>=IIF(Parameters!TeachingStaff.Count = 2 ,true,isNothing(Fields!TeachingStaff.Value))</FilterExpression><Operator>Equal</Operator><FilterValues><FilterValue>=IIF(Parameters!TeachingStaff.Count = 2,true,false)</FilterValue></FilterValues></Filter><Filter><FilterExpression>=IIF(Parameters!PartTime.Count = 2 ,true,isNothing(Fields!PartTime.Value))</FilterExpression><Operator>Equal</Operator><FilterValues><FilterValue>=IIF(Parameters!PartTime.Count = 2,true,false)</FilterValue></FilterValues></Filter></Filters></DataSet><DataSet Name="EnrolmentDate"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	MIN(EnrolmentDate) AS 'MinEDate',  
		MAX(EnrolmentDate) AS 'MaxEDate'  
FROM	TblStaff</CommandText><rd:UseGenericDesigner>true</rd:UseGenericDesigner></Query><Fields><Field Name="MinEDate"><DataField>MinEDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="MaxEDate"><DataField>MaxEDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="list1"><TablixBody><TablixColumns><TablixColumn><Width>8.6cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>4.1cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="list1_Contents"><ReportItems><Tablix Name="matrix1"><TablixCorner><TablixCornerRows><TablixCornerRow><TablixCornerCell><CellContents><Tablix Name="table2"><TablixBody><TablixColumns><TablixColumn><Width>3cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.45cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="textbox21"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!ColumnGrouping.Label</Value><Style><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>textbox21</rd:DefaultName><ZIndex>1</ZIndex><Style /></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.45cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="textbox22"><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!RowGrouping.Label</Value><Style><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>textbox22</rd:DefaultName><Style /></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGr