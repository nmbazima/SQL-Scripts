<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="iSAMS">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=NMMBAZIMA;Initial Catalog=iSAMS_Trident</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>94c49ad6-8b11-43f1-9f04-b794a3d8691f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="AcademicReports">
      <Query>
        <DataSourceName>iSAMS</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@intReportCycle">
            <Value>=Parameters!intReportCycle.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@intNCYear">
            <Value>=Parameters!intNCYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtForm">
            <Value>=Parameters!txtForm.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtSubject">
            <Value>=Parameters!txtSubject.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtSchoolID">
            <Value>=Parameters!txtSchoolID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@txtHouse">
            <Value>=Parameters!txtHouse.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT AcademicReports.*
FROM VwReportsManagementAcademicReports AS AcademicReports


WHERE (AcademicReports.intReportCycleID = @intReportCycle) 
AND (AcademicReports.intReportProgress = 1) 
AND (AcademicReports.intNCYear IN 
	(SELECT ID FROM dbo.SplitCSV(@intNCYear) AS SplitCSV_1) OR @intNCYear IS NULL) 
AND (AcademicReports.txtForm IN 
	(SELECT ID FROM dbo.SplitCSV(@txtForm) AS SplitCSV_1) OR @txtForm IS NULL) 
AND (AcademicReports.txtID IN 
	(SELECT ID FROM dbo.SplitCSV(@txtSubject) AS SplitCSV_1) OR @txtSubject IS NULL) 
AND (AcademicReports.txtSchoolID IN 
	(SELECT ID FROM dbo.SplitCSV(@txtSchoolID) AS SplitCSV_1) OR @txtSchoolID IS NULL) 
AND (AcademicReports.txtBoardingHouse IN
	(SELECT	ID	FROM dbo.SplitCSV(@txtHouse) AS SplitCSV_1) OR @txtHouse IS NULL 
	OR
	AcademicReports.txtAcademicHouse IN
	(SELECT ID FROM dbo.SplitCSV(@txtHouse) AS SplitCSV_1) OR @txtHouse IS NULL)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
