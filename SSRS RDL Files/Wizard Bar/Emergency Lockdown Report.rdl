<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMSTraining</DataSourceReference><rd:SecurityType xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">None</rd:SecurityType><rd:DataSourceID xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">862da1ce-cccd-4826-813c-c60fb8d44dc3</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="PupilLocation"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>Declare @txtStartDate datetime =  Dateadd(d,-1,getdate());
Declare @txtEndDate datetime = Dateadd(d,1,getdate());

DECLARE @PupilID AS nvarchar(max);
SET @PupilID = 	STUFF((	

SELECT DISTINCT ',' + TblPupilManagementPupils.txtSchoolID
FROM TblPupilManagementPupils
where intSystemStatus = 1
FOR XML PATH('')), 1, 1, '');



SELECT 
ISNULL(RIGHT('0' + txtStartTime, 5), CONVERT(char(5),dtRegistrationDateTime,108))  AS 'txtStartTime', 
ISNULL(RIGHT('0' + txtEndTime, 5), CONVERT(char(5),DATEADD(MINUTE, TblRegistrationSchoolRegistrationDateTime.intForward, Attendance.dtRegistrationDateTime),108))  AS 'txtEndTime', 
ISNULL(TblSchoolManagementClassrooms.txtName, FormRooms.txtName) AS txtRoomName,
ISNULL(TblSchoolManagementBuildings.txtName, FormBuildings.txtName) AS txtBuildingName,
TblTeachingManagerSubjects.txtSubjectName,
Attendance.*,
Pupils.txtForename, Pupils.txtPreName, Pupils.txtMiddleNames, Pupils.txtSurname, Pupils.txtAcademicHouse, 
Pupils.txtBoardingHouse, Pupils.intNCYear, Pupils.txtForm, 
RegistrationTeacher.Initials AS txtRegistrationTeacherSchoolInitials, 
RegistrationTeacher.Salutation AS txtRegistrationTeacherSchoolSalutation, 
RegistrationSubmitBy.Initials AS txtRegistrationSubmitBySchoolInitials, 
RegistrationSubmitBy.Salutation AS txtRegistrationSubmitBySchoolSalutation,
TimetableTeacher.Initials AS txtTimetableTeacherSchoolInitials, 
TimetableTeacher.Salutation AS txtTimetableTeacherSchoolSalutation, 
TimetableTeacher.Initials AS txtTimetableTeacherSubmitBySchoolInitials, 
TimetableTeacher.Salutation AS txtTimetableTeacherSubmitBySchoolSalutation
FROM 
dbo.uf_Registration_AttendanceBetweenDates(@txtStartDate,DATEADD(dd,1,@txtEndDate),@PupilID) AS Attendance

LEFT OUTER JOIN tblpupilmanagementpupils AS Pupils ON Attendance.txtSchoolID = Pupils.txtSchoolID

LEFT OUTER JOIN TblStaff AS RegistrationTeacher ON Attendance.txtRegistrationTeacherCode = RegistrationTeacher.User_Code 
LEFT OUTER JOIN TblStaff AS RegistrationSubmitBy ON Attendance.txtRegistrationSubmitBy = RegistrationSubmitBy.User_Code

INNER JOIN 
TblTimetableManagerWeeksAllocations ON 
Datepart(wk,dtRegistrationDateTime) = TblTimetableManagerWeeksAllocations.intYearWeek
AND Datepart(year,dtRegistrationDateTime) = TblTimetableManagerWeeksAllocations.intYear 

INNER JOIN
TblTimetableManagerDays on Datepart(weekday,dtRegistrationDateTime) = TblTimetableManagerDays.intDay
AND TblTimetableManagerDays.intWeek = TblTimetableManagerWeeksAllocations.intWeek
LEFT OUTER JOIN TblTimetableManagerPeriods on 
TblTimetableManagerPeriods.txtstarttime = LEFT(CONVERT(char(8), Attendance.dtRegistrationDateTime, 108), 5) and TblTimetableManagerDaysID = TblTimetableManagerPeriods.intDay
LEFT OUTER JOIN TblTimetableManagerSchedule on TblTimetableManagerPeriods.TblTimetableManagerPeriodsID = TblTimetableManagerSchedule.intPeriod and Attendance.txtRegistrationGroupName = TblTimetableManagerSchedule.txtCode and TblTimetableManagerSchedule.intTimetableID = (select TblTimetableManagerTimetablesID from TblTimetableManagerTimetables where intpublished =1)

LEFT OUTER JOIN TblStaff AS TimetableTeacher ON TblTimetableManagerSchedule.txtTeacher = TimetableTeacher.User_Code 

LEFT OUTER JOIN TblSchoolManagementClassrooms ON TblTimetableManagerSchedule.intRoom = TblSchoolManagementClassrooms.TblSchoolManagementClassroomsID
LEFT OUTER JOIN TblSchoolManagementBuildings ON TblSchoolManagementClassrooms.intBuilding =  TblSchoolManagementBuildings.TblSchoolManagementBuildingsID

LEFT OUTER JOIN 
TblSchoolManagementForms ON txtRegistrationGroupName = TblSchoolManagementForms.txtForm

LEFT OUTER JOIN TblSchoolManagementClassrooms AS FormRooms ON TblSchoolManagementForms.intRoom = FormRooms.TblSchoolManagementClassroomsID
LEFT OUTER JOIN TblSchoolManagementBuildings AS FormBuildings ON FormRooms.intBuilding =  FormBuildings.TblSchoolManagementBuildingsID

LEFT OUTER JOIN TblRegistrationSchoolRegistrationDateTime ON Attendance.dtRegistrationDateTime = TblRegistrationSchoolRegistrationDateTime.txtDateTime
AND Attendance.txtRegistrationAMPM = TblRegistrationSchoolRegistrationDateTime.txtAmPm

LEFT OUTER JOIN TblTeachingManagerSubjects ON Attendance.intRegistrationGroupSubjectID = TblTeachingManagerSubjects.TblTeachingManagerSubjectsID

WHERE
 
convert(char, getdate(), 103) =  convert(char, dtRegistrationDateTime, 103)

and 
CONVERT(char(5),getDATE(),108) BETWEEN
ISNULL(RIGHT('0' + txtStartTime, 5), CONVERT(char(5),dtRegistrationDateTime,108)) 
AND 
ISNULL(RIGHT('0' + txtEndTime, 5), CONVERT(char(5),DATEADD(MINUTE, TblRegistrationSchoolRegistrationDateTime.intForward, Attendance.dtRegistrationDateTime),108))  

OPTION (RECOMPILE)</CommandText></Query><Fields><Field Name="txtStartTime"><DataField>txtStartTime</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtEndTime"><DataField>txtEndTime</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtRoomName"><DataField>txtRoomName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtBuildingName"><DataField>txtBuildingName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtSubjectName"><DataField>txtSubjectName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intRegistrationDateTimeID"><DataField>intRegistrationDateTimeID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="dtRegistrationDateTime"><DataField>dtRegistrationDateTime</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.DateTime</rd:TypeName></Field><Field Name="txtRegistrationAMPM"><DataField>txtRegistrationAMPM</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtRegistrationName"><DataField>txtRegistrationName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intRegistrationPupilsID"><DataField>intRegistrationPupilsID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="intRegisterID"><DataField>intRegisterID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherCode"><DataField>txtRegistrationTeacherCode</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intRegistrationGroupID"><DataField>intRegistrationGroupID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtRegistrationGroupType"><DataField>txtRegistrationGroupType</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtRegistrationGroupName"><DataField>txtRegistrationGroupName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intRegistrationGroupSubjectID"><DataField>intRegistrationGroupSubjectID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtRegistrationSubmitBy"><DataField>txtRegistrationSubmitBy</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtRegistrationReason"><DataField>txtRegistrationReason</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intIsLate"><DataField>intIsLate</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Boolean</rd:TypeName></Field><Field Name="intMinutesLate"><DataField>intMinutesLate</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtRegistrationStatus"><DataField>txtRegistrationStatus</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtRegistrationStatisticalStatus"><DataField>txtRegistrationStatisticalStatus</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intCodeID"><DataField>intCodeID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtCode"><DataField>txtCode</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intCodeOrder"><DataField>intCodeOrder</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtCodeName"><DataField>txtCodeName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intIsIncludedInStatistics"><DataField>intIsIncludedInStatistics</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="intIsAuthorisedAbsence"><DataField>intIsAuthorisedAbsence</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Boolean</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtPreName"><DataField>txtPreName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtMiddleNames"><DataField>txtMiddleNames</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolInitials"><DataField>txtRegistrationTeacherSchoolInitials</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtRegistrationTeacherSchoolSalutation"><DataField>txtRegistrationTeacherSchoolSalutation</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySchoolInitials"><DataField>txtRegistrationSubmitBySchoolInitials</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtRegistrationSubmitBySchoolSalutation"><DataField>txtRegistrationSubmitBySchoolSalutation</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtTimetableTeacherSchoolInitials"><DataField>txtTimetableTeacherSchoolInitials</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtTimetableTeacherSchoolSalutation"><DataField>txtTimetableTeacherSchoolSalutation</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtTimetableTeacherSubmitBySchoolInitials"><DataField>txtTimetableTeacherSubmitBySchoolInitials</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtTimetableTeacherSubmitBySchoolSalutation"><DataField>txtTimetableTeacherSubmitBySchoolSalutation</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>
					SELECT	txtExternaliSAMSAddress AS 'txtiSAMSAddress'
					FROM	TbliSAMSManagerSettings
				</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>
					SELECT        txtPath + txtFilename AS txtSchoolLogoPath
					FROM            TblReportsCustomImages
					WHERE        (txtName LIKE '%School Logo%')
					ORDER BY dtSubmittedTime DESC
				</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>28.7cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>1.55cm</Height><TablixCells><TablixCell><CellContents><Rectangle Name="Rectangle1"><ReportItems><Tablix Name="Tablix2"><TablixBody><TablixColumns><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>3.3cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>1.5cm</Width></TablixColumn><TablixColumn><Width>2.7cm</Width></TablixColumn><TablixColumn><Width>2.7cm</Width></TablixColumn><TablixColumn><Width>1.6cm</Width></TablixColumn><TablixColumn><Width>2cm</Width></TablixColumn><TablixColumn><Width>3.4cm</Width></TablixColumn><TablixColumn><Width>1.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox64"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Building: </Value><Style><FontWeight>Bold</FontWeight></Style></TextRun><TextRun><Value>=Fields!txtBuildingName.Value</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">Textbox64</rd:DefaultName><Style><Border><Style>None</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>12</ColSpan></CellContents></Tabli