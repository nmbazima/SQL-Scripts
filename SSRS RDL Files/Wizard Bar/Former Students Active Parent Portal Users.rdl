<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>bf002bca-db3a-4190-8a0d-1a1764039471</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="ParentPortal"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>WITH CurrentFamilies AS
(
	SELECT DISTINCT
		CurrentPupilFamilies.intFamily
		FROM TblPupilManagementPupils AS CurrentPupilFamilies
		WHERE CurrentPupilFamilies.intSystemStatus = 1
		AND CurrentPupilFamilies.intFamily &lt;&gt; 0
		AND CurrentPupilFamilies.intFamily IS NOT NULL
),

FamiliesWithNoCurrentPupils AS
(
	SELECT DISTINCT
	TblPupilManagementPupils.intFamily
	FROM TblPupilManagementPupils
	WHERE TblPupilManagementPupils.intFamily &lt;&gt; 0
	AND TblPupilManagementPupils.intFamily IS NOT NULL
	AND TblPupilManagementPupils.intFamily NOT IN
	(
		SELECT intFamily
		FROM CurrentFamilies
	)
)


SELECT 
--core
TblPupilManagementPupils.txtSchoolID,
TblPupilManagementPupils.txtSurname,
TblPupilManagementPupils.txtForename,


ParentPortalUsers.TbliSAMSManagerUsersID AS intParentPortalUserID,
ParentPortalUsers.txtUsername AS txtParentPortalUserName,
ParentPortalUsers.txtFirstname AS txtParentPortalUserForename,
ParentPortalUsers.txtSurname AS txtParentPortalUserSurname,
ParentPortalUsers.txtEmailAddress AS txtParentPortalUserEmail,
ParentPortalUsers.txtCreateDateTime AS dtParentPortalUserCreateDateTime,
LastLoginDate.dtLastLoginDate

FROM TblPupilManagementPupils
INNER JOIN FamiliesWithNoCurrentPupils ON TblPupilManagementPupils.intFamily = FamiliesWithNoCurrentPupils.intFamily
INNER JOIN TblParentPortalUserLinks ON TblParentPortalUserLinks.txtID = TblPupilManagementPupils.intFamily AND TblParentPortalUserLinks.intType = 1
INNER  JOIN TbliSAMSManagerUsers AS ParentPortalUsers ON TblParentPortalUserLinks.txtUserCode = ParentPortalUsers.txtUserCode
OUTER APPLY (SELECT MAX(txtDateTime) AS 'dtLastLoginDate'
         FROM TblAuditLogin
         WHERE intLoginCode IN(1060, 6000)
		 AND TblAuditLogin.txtUserCode = ParentPortalUsers.txtUserCode
         ) AS LastLoginDate
WHERE ParentPortalUsers.txtStatus &lt;&gt; 'Disabled'
 AND (ParentPortalUsers.txtSecurityID = 'pp'
                OR ParentPortalUsers.intiSAMSLogin = 0
                AND ParentPortalUsers.intPPLogin = 1);
 
</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intParentPortalUserID"><DataField>intParentPortalUserID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtParentPortalUserName"><DataField>txtParentPortalUserName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtParentPortalUserForename"><DataField>txtParentPortalUserForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtParentPortalUserSurname"><DataField>txtParentPortalUserSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtParentPortalUserEmail"><DataField>txtParentPortalUserEmail</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dtParentPortalUserCreateDateTime"><DataField>dtParentPortalUserCreateDateTime</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="dtLastLoginDate"><DataField>dtLastLoginDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field></Fields></DataSet><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	txtExternaliSAMSAddress AS 'txtiSAMSAddress'
FROM	TbliSAMSManagerSettings</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT        txtPath + txtFilename AS txtSchoolLogoPath
FROM            TblReportsCustomImages
WHERE        (txtName LIKE '%School Logo%')
ORDER BY dtSubmittedTime DESC</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Tablix Name="Tablix2"><TablixBody><TablixColumns><TablixColumn><Width>5.2cm</Width></TablixColumn><TablixColumn><Width>2.8cm</Width></TablixColumn><TablixColumn><Width>2.8cm</Width></TablixColumn><TablixColumn><Width>5.2cm</Width></TablixColumn><TablixColumn><Width>3.2cm</Width></TablixColumn><TablixColumn><Width>3cm</Width></TablixColumn><TablixColumn><Width>6.5cm</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox7"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Username</Value><Style><FontFamily>Arial</FontFamily><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox7</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox11"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Forename</Value><Style><FontFamily>Arial</FontFamily><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox11</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox13"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Surname</Value><Style><FontFamily>Arial</FontFamily><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox13</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox15"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Email Address</Value><Style><FontFamily>Arial</FontFamily><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox15</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox21"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Create Date Time</Value><Style><FontFamily>Arial</FontFamily><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox21</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox23"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Last Login Date</Value><Style><FontFamily>Arial</FontFamily><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox23</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox1"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Student</Value><Style><FontFamily>Arial</FontFamily><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>Textbox1</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.5cm</Height><TablixCells><TablixCell><CellContents><Textbox Name="txtParentPortalUserName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtParentPortalUserName.Value</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>txtParentPortalUserName</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="txtParentPortalUserForename"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtParentPortalUserForename.Value</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>txtParentPortalUserForename</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="txtParentPortalUserSurname"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtParentPortalUserSurname.Value</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>txtParentPortalUserSurname</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="txtParentPortalUserEmail"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!txtParentPortalUserEmail.Value</Value><Style><FontFamily>Segoe UI</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>txtParentPortalUserEmail</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="txtCreateDateTime"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!dtParentPortalUserCreateDateTime.Value,"dd/MM/yyyy HH:mm")</Value><Style><FontFamily>Arial</FontFamily></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>txtCreateDateTime</rd:DefaultName><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="dtLastLoginDate"><CanG