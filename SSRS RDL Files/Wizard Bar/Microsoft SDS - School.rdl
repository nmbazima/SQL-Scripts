IIF(Lookup("Address 3", Fields!txtDisplayName.Value, Fields!txtValue.Value, "SchoolDetailsFromSystem") = "", "", " " &amp; Lookup("Address 3", Fields!txtDisplayName.Value, Fields!txtValue.Value, "SchoolDetailsFromSystem"))</Value><Style><FontFamily>arial</FontFamily></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="City"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Lookup("Town", Fields!txtDisplayName.Value, Fields!txtValue.Value, "SchoolDetailsFromSystem")</Value><Style><FontFamily>arial</FontFamily></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="State"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Lookup("Country", Fields!txtDisplayName.Value, Fields!txtValue.Value, "SchoolDetailsFromSystem")</Value><Style><FontFamily>arial</FontFamily></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Country"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Lookup("Country", Fields!txtDisplayName.Value, Fields!txtValue.Value, "SchoolDetailsFromSystem")</Value><Style><FontFamily>arial</FontFamily></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Zip"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Lookup("Postcode", Fields!txtDisplayName.Value, Fields!txtValue.Value, "SchoolDetailsFromSystem")</Value><Style><FontFamily>arial</FontFamily></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Phone"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Lookup("Phone Number", Fields!txtDisplayName.Value, Fields!txtValue.Value, "SchoolDetailsFromSystem")</Value><Style><FontFamily>arial</FontFamily></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Zone"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontFamily>arial</FontFamily></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><Group Name="DfE_Number"><GroupExpressions><GroupExpression>=Fields!DfE_Number.Value</GroupExpression></GroupExpressions></Group></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>SchoolDetails</DataSetName><SortExpressions><SortExpression><Value>=Fields!Name.Value</Value></SortExpression><SortExpression><Value>=Fields!DfE_Number.Value</Value></SortExpression></SortExpressions><Height>1.2cm</Height><Width>47cm</Width><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><Height>0.47244in</Height><Style /></Body><Width>18.50394in</Width><Page><PageHeight>29.7cm</PageHeight><PageWidth>21cm</PageWidth><LeftMargin>1cm</LeftMargin><RightMargin>1cm</RightMargin><TopMargin>1cm</TopMargin><BottomMargin>1cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>a228e47f-e72c-48a2-b1ad-ea41c84f35c6</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="SchoolDetails"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblSchoolManagementSchoolDivisions.TblSchoolManagementSchoolDivisionsID AS 'DfE Number', TblSchoolManagementSchoolDivisions.txtName AS 'Name',
		(SELECT MIN(TblSchoolManagementSchoolDivisionsYears.intNCYear) FROM TblSchoolManagementSchoolDivisionsYears WHERE TblSchoolManagementSchoolDivisionsYears.intDivision = TblSchoolManagementSchoolDivisions.TblSchoolManagementSchoolDivisionsID) AS 'intMinSchoolYear',
		(SELECT MAX(TblSchoolManagementSchoolDivisionsYears.intNCYear) FROM TblSchoolManagementSchoolDivisionsYears WHERE TblSchoolManagementSchoolDivisionsYears.intDivision = TblSchoolManagementSchoolDivisions.TblSchoolManagementSchoolDivisionsID) AS 'intMaxSchoolYear'
FROM	TblSchoolManagementSchoolDivisions</CommandText></Query><Fields><Field Name="DfE_Number"><DataField>DfE Number</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intMinSchoolYear"><DataField>intMinSchoolYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intMaxSchoolYear"><DataField>intMaxSchoolYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolDetailsFromSystem"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT  TblCensusManagerMetadataConfiguration.txtDisplayName, TblCensusManagerMetadataMapping.txtValue
FROM	   TblCensusManagerMetadataConfiguration
LEFT OUTER JOIN TblCensusManagerMetadataMapping ON TblCensusManagerMetadataConfiguration.TblCensusManagerMetadataConfigurationId = TblCensusManagerMetadataMapping.intMetaDataID</CommandText></Query><Fields><Field Name="txtDisplayName"><DataField>txtDisplayName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtValue"><DataField>txtValue</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>509d6c8a-b400-4940-9a67-b40af370e2ab</rd:ReportID></Report>