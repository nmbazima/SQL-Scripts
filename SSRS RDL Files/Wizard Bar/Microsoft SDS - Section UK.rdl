blixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><Group Name="ID_School_DfE_Number"><GroupExpressions><GroupExpression>=Fields!ID.Value</GroupExpression><GroupExpression>=Fields!School_DfE_Number.Value</GroupExpression></GroupExpressions></Group></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>SectionDetails</DataSetName><SortExpressions><SortExpression><Value>=Fields!Section_Name.Value</Value></SortExpression><SortExpression><Value>=Fields!School_DfE_Number.Value</Value></SortExpression><SortExpression><Value>=Fields!ID.Value</Value></SortExpression></SortExpressions><Height>1.2cm</Height><Width>42.5cm</Width><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><Height>0.47244in</Height><Style /></Body><Width>16.73228in</Width><Page><PageHeight>29.7cm</PageHeight><PageWidth>21cm</PageWidth><LeftMargin>1cm</LeftMargin><RightMargin>1cm</RightMargin><TopMargin>1cm</TopMargin><BottomMargin>1cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>a228e47f-e72c-48a2-b1ad-ea41c84f35c6</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="SectionDetails"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT	TblTeachingManagerSets.TblTeachingManagerSetsID AS 'ID', TblSchoolManagementSchoolDivisionsYears.intDivision AS 'School DfE Number', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(
		REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(TblTeachingManagerSets.txtName,'~',''),'#',''),'%',''),'&amp;',''),'*',''),'{','')
		,'}',''),'\',''),':',''),'&lt;',''),'&gt;',''),'?',''),'/',''),'+',''),'|',''),'"','') AS 'Section Name', 
		TblTeachingManagerSets.txtSetCode, 
		TblTeachingManagerSubjects.TblTeachingManagerSubjectsID, 
		TblTeachingManagerSubjects.txtSubjectName, 
		TblTeachingManagerSubjects.txtSubjectReportName, 
		TblTeachingManagerSubjects.intActive, 
		TblTeachingManagerSubjects.txtDescription, 
		TblTeachingManagerSets.txtSetNumber
FROM    TblTeachingManagerSets
LEFT OUTER JOIN TblTeachingManagerSubjects ON TblTeachingManagerSubjects.TblTeachingManagerSubjectsID = TblTeachingManagerSets.intSubject
LEFT OUTER JOIN TblSchoolManagementSchoolDivisionsYears ON TblTeachingManagerSets.intYear = TblSchoolManagementSchoolDivisionsYears.intNCYear
WHERE  TblTeachingManagerSubjects.intActive = 1</CommandText></Query><Fields><Field Name="ID"><DataField>ID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="School_DfE_Number"><DataField>School DfE Number</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Section_Name"><DataField>Section Name</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSetCode"><DataField>txtSetCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TblTeachingManagerSubjectsID"><DataField>TblTeachingManagerSubjectsID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtSubjectName"><DataField>txtSubjectName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSubjectReportName"><DataField>txtSubjectReportName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intActive"><DataField>intActive</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtDescription"><DataField>txtDescription</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSetNumber"><DataField>txtSetNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>509d6c8a-b400-4940-9a67-b40af370e2ab</rd:ReportID></Report>