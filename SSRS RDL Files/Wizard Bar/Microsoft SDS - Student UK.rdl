/Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ELL_Status"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontFamily>arial</FontFamily></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="FederalRace"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontFamily>arial</FontFamily></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Graduation"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value /><Style><FontFamily>arial</FontFamily></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><Group Name="ID_School_DfE_Number"><GroupExpressions><GroupExpression>=Fields!ID.Value</GroupExpression><GroupExpression>=Fields!School_DfE_Number.Value</GroupExpression></GroupExpressions></Group></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>StudentDetails</DataSetName><SortExpressions><SortExpression><Value>=Fields!School_DfE_Number.Value</Value></SortExpression><SortExpression><Value>=Fields!Username.Value</Value></SortExpression><SortExpression><Value>=Fields!ID.Value</Value></SortExpression></SortExpressions><Height>1.2cm</Height><Width>72.5cm</Width><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><Height>0.47244in</Height><Style /></Body><Width>28.54331in</Width><Page><PageHeight>29.7cm</PageHeight><PageWidth>21cm</PageWidth><LeftMargin>1cm</LeftMargin><RightMargin>1cm</RightMargin><TopMargin>1cm</TopMargin><BottomMargin>1cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>a228e47f-e72c-48a2-b1ad-ea41c84f35c6</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="StudentDetails"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT  TblPupilManagementPupils.txtSchoolID AS 'ID', TblSchoolManagementSchoolDivisionsYears.intDivision AS 'School DfE Number', TblPupilManagementPupils.txtEmailAddress AS 'Username', 
		TblPupilManagementPupils.txtHomeEmailAddress, TblPupilManagementPupils.intPersonID, TblPupilManagementPupils.intNCYear, TblPupilManagementPupils.intSystemStatus,
		TblPupilManagementPupils.txtGender, TblPupilManagementPupils.txtDOB, HomeAddress.txtAddress, HomeAddress.txtTown, HomeAddress.txtCounty, 
		HomeAddress.txtPostCode, HomeAddress.txtCountry, MailAddress.txtAddress AS 'txtMailAddress', MailAddress.txtTown AS 'txtMailTown', MailAddress.txtCounty
	    AS 'txtMailCounty', MailAddress.txtPostCode AS 'txtMailPostCode', MailAddress.txtCountry AS 'txtMailCountry'
FROM	   TblPupilManagementPupils
LEFT OUTER JOIN TblSchoolManagementSchoolDivisionsYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementSchoolDivisionsYears.intNCYear
LEFT OUTER JOIN (SELECT TblPupilManagementAddresses.txtAddress1 + CASE WHEN TblPupilManagementAddresses.txtAddress2 &lt;&gt; '' THEN ' ' + TblPupilManagementAddresses.txtAddress2 END + CASE WHEN TblPupilManagementAddresses.txtAddress3 &lt;&gt; '' THEN ' ' + TblPupilManagementAddresses.txtAddress3 END AS 'txtAddress',
						TblPupilManagementAddresses.txtTown, TblPupilManagementAddresses.txtCounty, TblPupilManagementAddresses.txtPostCode, TblPupilManagementAddresses.txtCountry, TblPupilManagementAddressLink.txtSchoolID
				 FROM	TblPupilManagementAddressLink
				 LEFT OUTER JOIN TblPupilManagementAddresses ON TblPupilManagementAddressLink.intAddressID = TblPupilManagementAddresses.TblPupilManagementAddressesID
				 WHERE   TblPupilManagementAddresses.intStudentHome = 1) HomeAddress ON TblPupilManagementPupils.txtSchoolID = HomeAddress.txtSchoolID
LEFT OUTER JOIN (SELECT TblPupilManagementAddresses.txtAddress1 + CASE WHEN TblPupilManagementAddresses.txtAddress2 &lt;&gt; '' THEN ' ' + TblPupilManagementAddresses.txtAddress2 END + CASE WHEN TblPupilManagementAddresses.txtAddress3 &lt;&gt; '' THEN ' ' + TblPupilManagementAddresses.txtAddress3 END AS 'txtAddress',
						TblPupilManagementAddresses.txtTown, TblPupilManagementAddresses.txtCounty, TblPupilManagementAddresses.txtPostCode, TblPupilManagementAddresses.txtCountry, TblPupilManagementAddressLink.txtSchoolID
				 FROM	   TblPupilManagementAddressLink
				 LEFT OUTER JOIN TblPupilManagementAddresses ON TblPupilManagementAddressLink.intAddressID = TblPupilManagementAddresses.TblPupilManagementAddressesID
				 WHERE   TblPupilManagementAddresses.intCorrespondenceMailMerge = 1) MailAddress ON TblPupilManagementPupils.txtSchoolID = MailAddress.txtSchoolID
WHERE   TblPupilManagementPupils.intSystemStatus = 1</CommandText></Query><Fields><Field Name="ID"><DataField>ID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="School_DfE_Number"><DataField>School DfE Number</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Username"><DataField>Username</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtHomeEmailAddress"><DataField>txtHomeEmailAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="intPersonID"><DataField>intPersonID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="intSystemStatus"><DataField>intSystemStatus</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtDOB"><DataField>txtDOB</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtAddress"><DataField>txtAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtTown"><DataField>txtTown</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCounty"><DataField>txtCounty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPostCode"><DataField>txtPostCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtCountry"><DataField>txtCountry</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMailAddress"><DataField>txtMailAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMailTown"><DataField>txtMailTown</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMailCounty"><DataField>txtMailCounty</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMailPostCode"><DataField>txtMailPostCode</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtMailCountry"><DataField>txtMailCountry</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>509d6c8a-b400-4940-9a67-b40af370e2ab</rd:ReportID></Report>