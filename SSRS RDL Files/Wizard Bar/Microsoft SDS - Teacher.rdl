ns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Qualification"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Qualifications.Value</Value><Style><FontFamily>arial</FontFamily></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Solid</Style><Width>0.5pt</Width></Border><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember><TablixMember><Group Name="ID_School_DfE_Number"><GroupExpressions><GroupExpression>=Fields!ID.Value</GroupExpression><GroupExpression>=Fields!School_DfE_Number.Value</GroupExpression></GroupExpressions></Group></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>TeacherDetails</DataSetName><SortExpressions><SortExpression><Value>=Fields!School_DfE_Number.Value</Value></SortExpression><SortExpression><Value>=Fields!Username.Value</Value></SortExpression><SortExpression><Value>=Fields!ID.Value</Value></SortExpression></SortExpressions><Height>1.2cm</Height><Width>27.5cm</Width><Style><Border><Style>None</Style></Border></Style></Tablix></ReportItems><Height>0.47244in</Height><Style /></Body><Width>10.82677in</Width><Page><PageHeight>29.7cm</PageHeight><PageWidth>21cm</PageWidth><LeftMargin>1cm</LeftMargin><RightMargin>1cm</RightMargin><TopMargin>1cm</TopMargin><BottomMargin>1cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>a228e47f-e72c-48a2-b1ad-ea41c84f35c6</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="TeacherDetails"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@blnTeachingStaff"><Value>=Parameters!blnTeachingStaff.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	TblStaff.TblStaffID AS 'ID', TblStaffManagementDivisions.intDivision AS 'School DfE Number', TblStaff.SchoolEmailAddress AS 'Username', TblStaff.SystemStatus, TblStaff.StaffID, TblStaff.Qualifications, TblStaff.Title, TblStaff.HAEmail, TblStaff.TAEmail
FROM	TblStaff
LEFT OUTER JOIN TblStaffManagementDivisions ON TblStaff.TblStaffID = TblStaffManagementDivisions.intStaff
WHERE	TblStaff.SystemStatus = 1
		AND ((@blnTeachingStaff = 'Teachers Only' AND TblStaff.TeachingStaff = 1) OR @blnTeachingStaff &lt;&gt; 'Teachers Only')</CommandText></Query><Fields><Field Name="ID"><DataField>ID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="School_DfE_Number"><DataField>School DfE Number</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Username"><DataField>Username</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="SystemStatus"><DataField>SystemStatus</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="StaffID"><DataField>StaffID</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Qualifications"><DataField>Qualifications</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Title"><DataField>Title</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="HAEmail"><DataField>HAEmail</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="TAEmail"><DataField>TAEmail</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportParameters><ReportParameter Name="blnTeachingStaff"><DataType>String</DataType><DefaultValue><Values><Value>Teachers Only</Value></Values></DefaultValue><Prompt>Staff Filter</Prompt><ValidValues><ParameterValues><ParameterValue><Value>Teachers Only</Value><Label>Teachers Only</Label></ParameterValue><ParameterValue><Value>All Staff</Value><Label>All Staff</Label></ParameterValue></ParameterValues></ValidValues></ReportParameter></ReportParameters><rd:ReportUnitType>Cm</rd:ReportUnitType><rd:ReportID>509d6c8a-b400-4940-9a67-b40af370e2ab</rd:ReportID></Report>