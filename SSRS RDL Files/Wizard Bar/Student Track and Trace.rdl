<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMSTraining</DataSourceReference><rd:SecurityType>None</rd:SecurityType><rd:DataSourceID>545e7d40-ba31-4b21-9730-1af427605be1</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="iSAMSAddress"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>
					SELECT	txtExternaliSAMSAddress AS 'txtiSAMSAddress'
					FROM	TbliSAMSManagerSettings
				</CommandText></Query><Fields><Field Name="txtiSAMSAddress"><DataField>txtiSAMSAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SchoolLogo"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>
					SELECT        txtPath + txtFilename AS txtSchoolLogoPath
					FROM            TblReportsCustomImages
					WHERE        (txtName LIKE '%School Logo%')
					ORDER BY dtSubmittedTime DESC
				</CommandText></Query><Fields><Field Name="txtSchoolLogoPath"><DataField>txtSchoolLogoPath</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="Students"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@intNCYear"><Value>=Parameters!intNCYear.Value</Value></QueryParameter></QueryParameters><CommandText>SELECT	
	TblPupilManagementPupils.txtSchoolID, 
	LTRIM(TblPupilManagementPupils.txtSurname + ', ' + TblPupilManagementPupils.txtForename) + ' (' + txtSchoolID + ')' AS 'txtStudentName'
FROM	TblPupilManagementPupils
WHERE TblPupilManagementPupils.intSystemStatus = 1 
AND TblPupilManagementPupils.intNCYear IN (@intNCYear)
ORDER BY txtStudentName</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtStudentName"><DataField>txtStudentName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="YearGroups"><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT 
intNCYear,
txtYearName
FROM TblSchoolManagementYears
ORDER BY intNCYear</CommandText></Query><Fields><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="TrackAndTrace"><Query><DataSourceName>iSAMS</DataSourceName><QueryParameters><QueryParameter Name="@StartDate"><Value>=Parameters!StartDate.Value</Value></QueryParameter><QueryParameter Name="@EndDate"><Value>=Parameters!EndDate.Value</Value></QueryParameter><QueryParameter Name="@txtSchoolID"><Value>=Parameters!txtSchoolID.Value</Value></QueryParameter></QueryParameters><CommandText>
-- only include dates that selected student was present for
With InContactDates AS
(
	SELECT DISTINCT Convert(Date,Attendance.dtRegistrationDateTime) AS dInContactDate
	FROM uf_Registration_AttendanceBetweenDates(@StartDate,DATEADD(DAY, 1, @EndDate),@txtSchoolID) AS Attendance
	WHERE Attendance.txtRegistrationStatus ='Present'
),

-- TIMETABLE
LessonScheduleForThatPeriod AS (
	SELECT
	InContactDates.dInContactDate,
	LessonSchedule.txtCode AS txtLessonCode,
	LessonSchedule.txtTeacher,
	LessonSchedule.TblTimetableManagerScheduleID
	FROM InContactDates
		OUTER APPLY (
		SELECT TblTimetableManagerSchedule.txtCode,
		TblTimetableManagerSchedule.txtTeacher,
		TblTimetableManagerSchedule.TblTimetableManagerScheduleID
		FROM TblTimetableManagerSchedule
		INNER JOIN TblTimetableManagerTimetables ON TblTimetableManagerSchedule.intTimetableID = TblTimetableManagerTimetables.TblTimetableManagerTimetablesID
		INNER JOIN TblTimetableManagerPeriods ON TblTimetableManagerSchedule.intPeriod = TblTimetableManagerPeriods.TblTimetableManagerPeriodsID
		INNER JOIN TblTimetableManagerDays ON TblTimetableManagerPeriods.intDay = TblTimetableManagerDays.TblTimetableManagerDaysID
		INNER JOIN TblTimetableManagerWeeksAllocations ON TblTimetableManagerDays.intWeek = TblTimetableManagerWeeksAllocations.intWeek
		WHERE TblTimetableManagerTimetables.intPublished = 1
			AND (TblTimetableManagerWeeksAllocations.intYear = DatePart(year,@StartDate)  OR TblTimetableManagerWeeksAllocations.intYear = DatePart(year,@EndDate))
			AND DatePart(weekday,InContactDates.dInContactDate) = TblTimetableManagerDays.intDay
			AND DatePart(year,InContactDates.dInContactDate) = TblTimetableManagerWeeksAllocations.intYear
			AND DatePart(week,InContactDates.dInContactDate) = TblTimetableManagerWeeksAllocations.intYearWeek
	) AS LessonSchedule
),

SetsStudentIn AS
(
	SELECT
		TblTeachingManagerSetLists.txtSchoolID,
		'Teaching Set' AS txtContactGroup,
		TblTeachingManagerSets.txtSetCode AS txtContactGroupName,
		LessonScheduleForThatPeriod.txtTeacher,
		LessonScheduleForThatPeriod.TblTimetableManagerScheduleID,
		LessonScheduleForThatPeriod.dInContactDate
		FROM TblTeachingManagerSetLists
		INNER JOIN TblTeachingManagerSets ON TblTeachingManagerSetLists.intSetID = TblTeachingManagerSets.TblTeachingManagerSetsID
		INNER JOIN LessonScheduleForThatPeriod ON TblTeachingManagerSets.txtSetCode = LessonScheduleForThatPeriod.txtLessonCode
		WHERE TblTeachingManagerSetLists.txtSchoolID = @txtSchoolID
),


FormsStudentIn AS
(
	SELECT
		TblPupilManagementPupils.txtSchoolID,
		'Teaching Form' AS txtContactGroup,
		TblTeachingManagerSubjectForms.txtTimetableCode AS txtContactGroupName,
		LessonScheduleForThatPeriod.txtTeacher,
		LessonScheduleForThatPeriod.TblTimetableManagerScheduleID,
		LessonScheduleForThatPeriod.dInContactDate
	FROM TblTeachingManagerSubjectForms
	INNER JOIN TblPupilManagementPupils ON TblTeachingManagerSubjectForms.txtForm = TblPupilManagementPupils.txtForm AND TblPupilManagementPupils.intSystemStatus = 1
	INNER JOIN LessonScheduleForThatPeriod ON TblTeachingManagerSubjectForms.txtTimetableCode = LessonScheduleForThatPeriod.txtLessonCode
	WHERE TblPupilManagementPupils.txtSchoolID = @txtSchoolID
),

TutorialsScheduleForThatPeriod AS 
(
	SELECT
	TutorialSchedule.txtSchoolID,
	'Tutorial' AS txtContactGroup,
	TutorialSchedule.txtDisplayName AS txtContactGroupName,
	TutorialSchedule.TblTimetableManagerTutorialsId,
	InContactDates.dInContactDate
	FROM InContactDates
		OUTER APPLY (
		SELECT
		TblTimetableManagerTutorials.txtDisplayName,
		TblTimetableManagerTutorials.TblTimetableManagerTutorialsId,
		TblTimetableManagerTutorialsPupils.txtSchoolId
		FROM TblTimetableManagerTutorialsPupils
		INNER JOIN TblTimetableManagerTutorials ON TblTimetableManagerTutorialsPupils.intTutorial = TblTimetableManagerTutorials.TblTimetableManagerTutorialsID
		INNER JOIN TblTimetableManagerTimetables ON TblTimetableManagerTutorials.intTimetableID = TblTimetableManagerTimetables.TblTimetableManagerTimetablesID
		--LEFT OUTER JOIN TblTimetableManagerTutorialsTeachers ON  TblTimetableManagerTutorials.TblTimetableManagerTutorialsID = TblTimetableManagerTutorialsTeachers.intTutorial
		LEFT OUTER JOIN TblTimetableManagerTutorialsPeriods ON TblTimetableManagerTutorials.TblTimetableManagerTutorialsID = TblTimetableManagerTutorialsPeriods.intTutorial
		INNER JOIN TblTimetableManagerPeriods ON TblTimetableManagerTutorialsPeriods.intPeriod = TblTimetableManagerPeriods.TblTimetableManagerPeriodsID
		INNER JOIN TblTimetableManagerDays ON TblTimetableManagerPeriods.intDay = TblTimetableManagerDays.TblTimetableManagerDaysID
		INNER JOIN TblTimetableManagerWeeksAllocations ON TblTimetableManagerDays.intWeek = TblTimetableManagerWeeksAllocations.intWeek
		WHERE TblTimetableManagerTimetables.intPublished = 1
			AND TblTimetableManagerTutorialsPupils.txtSchoolID = @txtSchoolID
			AND (TblTimetableManagerWeeksAllocations.intYear = DatePart(year,@StartDate)  OR TblTimetableManagerWeeksAllocations.intYear = DatePart(year,@EndDate))
			AND DatePart(weekday,InContactDates.dInContactDate) = TblTimetableManagerDays.intDay
			AND DatePart(year,InContactDates.dInContactDate) = TblTimetableManagerWeeksAllocations.intYear
			AND DatePart(week,InContactDates.dInContactDate) = TblTimetableManagerWeeksAllocations.intYearWeek

	) AS TutorialSchedule
),

YearScheduleForThatPeriod AS 
(
SELECT
	YearSchedule.txtSchoolID,
	'Year Schedule' AS txtContactGroup,
	YearSchedule.txtName AS txtContactGroupName,
	YearSchedule.TblTimetableManagerYearScheduleID,
	InContactDates.dInContactDate
	FROM InContactDates
		OUTER APPLY (
		SELECT
		TblTimetableManagerYearSchedule.txtName,
		TblTimetableManagerYearSchedule.TblTimetableManagerYearScheduleID,
		TblPupilManagementPupils.txtSchoolID
		FROM TblTimetableManagerYearSchedule
		INNER JOIN TblTimetableManagerTimetables ON TblTimetableManagerYearSchedule.intTimetableID = TblTimetableManagerTimetables.TblTimetableManagerTimetablesID 
		INNER JOIN TblPupilManagementPupils ON TblTimetableManagerYearSchedule.intNCYear = TblPupilManagementPupils.intNCYear AND TblPupilManagementPupils.intSystemStatus = 1
		INNER JOIN TblTimetableManagerPeriods ON TblTimetableManagerYearSchedule.intPeriod = TblTimetableManagerPeriods.TblTimetableManagerPeriodsID
		INNER JOIN TblTimetableManagerDays ON TblTimetableManagerPeriods.intDay = TblTimetableManagerDays.TblTimetableManagerDaysID
		INNER JOIN TblTimetableManagerWeeksAllocations ON TblTimetableManagerDays.intWeek = TblTimetableManagerWeeksAllocations.intWeek
		WHERE TblTimetableManagerTimetables.intPublished = 1
			AND TblPupilManagementPupils.txtSchoolID = @txtSchoolID
			AND (TblTimetableManagerWeeksAllocations.intYear = DatePart(year,@StartDate)  OR TblTimetableManagerWeeksAllocations.intYear = DatePart(year,@EndDate))
			AND DatePart(weekday,InContactDates.dInContactDate) = TblTimetableManagerDays.intDay
			AND DatePart(year,InContactDates.dInContactDate) = TblTimetableManagerWeeksAllocations.intYear
			AND DatePart(week,InContactDates.dInContactDate) = TblTimetableManagerWeeksAllocations.intYearWeek

	) AS YearSchedule
),

--ACTIVITIES
ActivityOccurrenceInThatPeriod AS
(
	SELECT
		TblActivityManagerEventPupilLink.txtSchoolId,
		'Activity' AS txtContactGroup,
		TblActivityManagerGroup.txtName AS txtContactGroupName,
		TblActivityManagerEvent.TblActivityManagerEventID,
		InContactDates.dInContactDate
	FROM InContactDates
	INNER JOIN TblActivityManagerEventOccurrence ON InContactDates.dInContactDate = Convert(Date,TblActivityManagerEventOccurrence.dteOccurrenceDate)
	INNER JOIN TblActivityManagerEvent ON TblActivityManagerEventOccurrence.intEventId = TblActivityManagerEvent.TblActivityManagerEventId
	INNER JOIN TblActivityManagerEventPupilLink ON TblActivityManagerEvent.TblActivityManagerEventId = TblActivityManagerEventPupilLink.intEventId 
	INNER JOIN TblActivityManagerGroup ON TblActivityManagerEvent.intGroup = TblActivityManagerGroup.TblActivityManagerGroupId
	INNER JOIN TblActivityManagerActivity ON TblActivityManagerGroup.intActivity = TblActivityManagerActivity.TblActivityManagerActivityId 
	WHERE TblActivityManagerEventPupilLink.txtSchoolID = @txtSchoolID
),

--EXAM MANAGER
ExternalExamsScheduledForThatPeriod AS
(
	SELECT
		VwExamManagerStudentExams.SchoolID AS txtSchoolID,
		'External Exam' AS txtContactGroup,
		VwExamManagerStudentExams.ComponentCode AS txtContactGroupName,
		VwExamManagerStudentExams.Location AS txtLocation,
		VwExamManagerStudentExams.ExamStart AS dtExamStart,
		InContactDates.dInContactDate
	FROM InContactDates
	INNER JOIN VwExamManagerStudentExams ON InContactDates.dInContactDate = Convert(Date,VwExamManagerStudentExams.ExamStart)
	WHERE VwExamManagerStudentExams.SchoolID = @txtSchoolID
),

--INTERNAL EXAMS
InternalExamsScheduledForThatPeriod AS
(
	SELECT
		TblInternalExamsEntries.txtSchoolID,
		'Internal Exam' AS txtContactGroup,
		TblInternalExamsPapers.txtPaperCode AS txtContactGroupName,
		TblInternalExamsPapers.intVenue,
		TblInternalExamsPapers.txtDate AS dtExamStart,
		TblInternalExamsPapers.txtActualTime,
		InContactDates.dInContactDate
	FROM InContactDates
	INNER JOIN TblInternalExamsPapers ON InContactDates.dInContactDate = Convert(Date,TblInternalExamsPapers.txtDate)
	INNER JOIN TblInternalExamsEntries ON TblInternalExamsPapers.txtPaperCode = TblInternalExamsEntries.txtPaperCode AND TblInternalExamsPapers.intSessionID = TblInternalExamsEntries.intSessionID
	WHERE TblInternalExamsEntries.txtSchoolID = @txtSchoolID
),

--MEDICAL CENTRE VISITS
MedicalVisitsForThatPeriod AS
(	
		SELECT
		TblPupilManagementPupils.txtSchoolID,
		'Medical Visit' AS txtContactGroup,
		TblMedicalVisitLocation.txtName AS txtContactGroupName,
		(SELECT TOP 1 txtSubmitBy FROM TblMedicalAuditLog WHERE TblMedicalAuditLog.intMedicalAuditBaseID = TblMedicalAuditBase.TblMedicalAuditBaseID AND intMedicalAuditActionID NOT IN (2) ORDER BY dSubmitDateTime_utc ASC) AS txtTeacher,
		InContactDates.dInContactDate
	FROM InContactDates
	INNER JOIN TblMedicalRecordVisit ON InContactDates.dInContactDate = Convert(Date,TblMedicalRecordVisit.dArrivedAt)
	INNER JOIN TblMedicalAuditBase ON TblMedicalAuditBase.TblMedicalAuditBaseId = TblMedicalRecordVisit.intMedicalAuditBaseId
	INNER JOIN TblPupilManagementPupils ON TblMedicalAuditBase.intPersonID = TblPupilManagementPupils.intPersonID
	LEFT OUTER JOIN TblMedicalVisitLocation ON TblMedicalRecordVisit.intLocationID = TblMedicalVisitLocation.TblMedicalVisitLocationID
	WHERE TblPupilManagementPupils.txtSchoolID = @txtSchoolID
),

--DETENTIONS
DetentionsScheduledForThatPeriod AS
(
	SELECT
		TblDisciplineManagerDetentionsPupils.txtSchoolID,
		'Detention' AS txtContactGroup,
		TblDisciplineManagerDetentionsSessions.txtSessionName AS txtContactGroupName,
		TblDisciplineManagerDetentionsPupils.intDetentionSessionID,
		TblDisciplineManagerDetentionsPupils.dDetentionDate,
		InContactDates.dInContactDate
	FROM InContactDates
	INNER JOIN TblDisciplineManagerDetentionsPupils ON InContactDates.dInContactDate = Convert(Date,TblDisciplineManagerDetentionsPupils.dDetentionDate)
	LEFT OUTER JOIN TblDisciplineManagerDetentionsSessions ON TblDisciplineManagerDetentionsPupils.intDetentionSessionID = TblDisciplineManagerDetentionsSessions.TblDisciplineManagerDetentionsSessionsID
	WHERE TblDisciplineManagerDetentionsPupils.txtSchoolID = @txtSchoolID
),

--ADMISSIONS VISITS
AdmissionsVisitsScheduledForThatPeriod AS
(
	SELECT 
	TblAdmissionsVisitsItineraryPupilsLink.txtSchoolID,
	'Admissions Visit' AS txtContactGroup,
	TblAdmissionsVisits.txtVisitName AS txtContactGroupName,
	TblAdmissionsVisits.TblAdmissionsVisitsID,
	InContactDates.dInContactDate
	FROM TblAdmissionsVisitsItinerary
	INNER JOIN TblAdmissionsVisitsItineraryPupilsLink ON TblAdmissionsVisitsItineraryPupilsLink.intAdmissionsVisitsItineraryID = TblAdmissionsVisitsItinerary.TblAdmissionsVisitsItineraryID
	INNER JOIN TblAdmissionsVisits ON TblAdmissionsVisits.TblAdmissionsVisitsID = TblAdmissionsVisitsItinerary.intVisitID
	INNER JOIN InContactDates ON InContactDates.dInContactDate = Convert(Date,TblAdmissionsVisits.txtVisitStartDateTime)
	WHERE TblAdmissionsVisitsItineraryPupilsLink.txtSchoolID = @txtSchoolID

	UNION

	SELECT 
	TblAdmissionsVisitsItineraryPupilGuideLink.txtSchoolID,
	'Admissions Visit' AS txtContactGroup,
	TblAdmissionsVisits.txtVisitName AS txtContactGroupName,
	TblAdmissionsVisits.TblAdmissionsVisitsID,
	InContactDates.dInContactDate
	FROM TblAdmissionsVisitsItinerary
	INNER JOIN TblAdmissionsVisitsItineraryPupilGuideLink ON TblAdmissionsVisitsItineraryPupilGuideLink.intAdmissionsVisitsItineraryID = TblAdmissionsVisitsItinerary.TblAdmissionsVisitsItineraryID
	INNER JOIN TblAdmissionsVisits ON TblAdmissionsVisits.TblAdmissionsVisitsID = TblAdmissionsVisitsItinerary.intVisitID
	INNER JOIN InContactDates ON InContactDates.dInContactDate = Convert(Date,TblAdmissionsVisits.txtVisitStartDateTime)
	WHERE TblAdmissionsVisitsItineraryPupilGuideLink.txtSchoolID = @txtSchoolID

	UNION 

	SELECT 
	TblAdmissionsVisitsPupilsLink.txtSchoolID,
	'Admissions Visit' AS txtContactGroup,
	TblAdmissionsVisits.txtVisitName AS txtContactGroupName,
	TblAdmissionsVisits.TblAdmissionsVisitsID,
	InContactDates.dInContactDate
	FROM TblAdmissionsVisits
	INNER JOIN TblAdmissionsVisitsPupilsLink ON TblAdmissionsVisitsPupilsLink.intAdmissionsVisitsID = TblAdmissionsVisits.TblAdmissionsVisitsID
	INNER JOIN InContactDates ON InContactDates.dInContactDate = Convert(Date,TblAdmissionsVisits.txtVisitStartDateTime)
	WHERE TblAdmissionsVisitsPupilsLink.txtSchoolID = @txtSchoolID
),

StudentsInContact AS
(
	--teaching sets
	SELECT 
		SetsStudentIn.txtSchoolID,
		SetsStudentIn.txtContactGroup,
		SetsStudentIn.txtContactGroupName,
		SetsStudentIn.dInContactDate,
		TblTeachingManagerSetLists.txtSchoolID AS txtStudentInContactID
	FROM SetsStudentIn
	INNER JOIN TblTeachingManagerSets ON SetsStudentIn.txtContactGroupName = TblTeachingManagerSets.txtSetCode
	INNER JOIN TblTeachingManagerSetLists ON TblTeachingManagerSets.TblTeachingManagerSetsID = TblTeachingManagerSetLists.intSetID

	UNION ALL

	-- teaching forms
	SELECT 
		FormsStudentIn.txtSchoolID,
		FormsStudentIn.txtContactGroup,
		FormsStudentIn.txtContactGroupName,
		FormsStudentIn.dInContactDate,
		TblPupilManagementPupils.txtSchoolID AS txtStudentInContactID
	FROM FormsStudentIn
	INNER JOIN TblTeachingManagerSubjectForms ON FormsStudentIn.txtContactGroupName = TblTeachingManagerSubjectForms.txtTimetableCode
	INNER JOIN TblPupilManagementPupils ON TblTeachingManagerSubjectForms.txtForm = TblPupilManagementPupils.txtForm AND TblPupilManagementPupils.intSystemStatus = 1

	UNION ALL
	--tutorials
	SELECT
		TutorialsScheduleForThatPeriod.txtSchoolId,
		TutorialsScheduleForThatPeriod.txtContactGroup,
		TutorialsScheduleForThatPeriod.txtContactGroupName,
		TutorialsScheduleForThatPeriod.dInContactDate,
		TblTimetableManagerTutorialsPupils.txtSchoolId AS txtStudentInContactID
	FROM TutorialsScheduleForThatPeriod
	INNER JOIN TblTimetableManagerTutorials ON TutorialsScheduleForThatPeriod.TblTimetableManagerTutorialsId = TblTimetableManagerTutorials.TblTimetableManagerTutorialsID
	INNER JOIN TblTimetableManagerTutorialsPupils ON  TblTimetableManagerTutorials.TblTimetableManagerTutorialsID = TblTimetableManagerTutorialsPupils.intTutorial

	UNION ALL
	--year schedule
	SELECT
		YearScheduleForThatPeriod.txtSchoolID,
		YearScheduleForThatPeriod.txtContactGroup,
		YearScheduleForThatPeriod.txtContactGroupName,
		YearScheduleForThatPeriod.dInContactDate,
		TblPupilManagementPupils.txtSchoolId AS txtStudentInContactID
	FROM YearScheduleForThatPeriod
	INNER JOIN TblTimetableManagerYearSchedule ON YearScheduleForThatPeriod.TblTimetableManagerYearScheduleID = TblTimetableManagerYearSchedule.TblTimetableManagerYearScheduleID
	INNER JOIN TblPupilManagementPupils ON TblTimetableManagerYearSchedule.intNCYear = TblPupilManagementPupils.intNCYear AND TblPupilManagementPupils.intSystemStatus = 1

	UNION ALL
	--activity
	SELECT
		ActivityOccurrenceInThatPeriod.txtSchoolID,
		ActivityOccurrenceInThatPeriod.txtContactGroup,
		ActivityOccurrenceInThatPeriod.txtContactGroupName,
		ActivityOccurrenceInThatPeriod.dInContactDate,
		TblActivityManagerEventPupilLink.txtSchoolId AS txtStudentInContactID
	FROM ActivityOccurrenceInThatPeriod
	INNER JOIN TblActivityManagerEvent ON ActivityOccurrenceInThatPeriod.TblActivityManagerEventId = TblActivityManagerEvent.TblActivityManagerEventID
	INNER JOIN TblActivityManagerEventPupilLink ON TblActivityManagerEvent.TblActivityManagerEventId = TblActivityManagerEventPupilLink.intEventId 

	UNION ALL
	--external exam
	SELECT
		ExternalExamsScheduledForThatPeriod.txtSchoolID,
		ExternalExamsScheduledForThatPeriod.txtContactGroup,
		ExternalExamsScheduledForThatPeriod.txtContactGroupName,
		ExternalExamsScheduledForThatPeriod.dInContactDate,
		VwExamManagerStudentExams.SchoolID AS txtStudentInContactID
	FROM ExternalExamsScheduledForThatPeriod
	INNER JOIN VwExamManagerStudentExams ON ExternalExamsScheduledForThatPeriod.txtLocation = VwExamManagerStudentExams.Location AND ExternalExamsScheduledForThatPeriod.dtExamStart = VwExamManagerStudentExams.ExamStart

	UNION ALL
	--internal exams
	SELECT
		InternalExamsScheduledForThatPeriod.txtSchoolID,
		InternalExamsScheduledForThatPeriod.txtContactGroup,
		InternalExamsScheduledForThatPeriod.txtContactGroupName,
		InternalExamsScheduledForThatPeriod.dInContactDate,
		TblInternalExamsEntries.txtSchoolID AS txtStudentInContactID
	FROM InternalExamsScheduledForThatPeriod
	INNER JOIN TblInternalExamsPapers ON InternalExamsScheduledForThatPeriod.intVenue = TblInternalExamsPapers.intVenue 
		AND InternalExamsScheduledForThatPeriod.dtExamStart = TblInternalExamsPapers.txtDate
		AND InternalExamsScheduledForThatPeriod.txtActualTime = TblInternalExamsPapers.txtActualTime
	INNER JOIN TblInternalExamsEntries ON TblInternalExamsPapers.txtPaperCode = TblInternalExamsEntries.txtPaperCode AND TblInternalExamsPapers.intSessionID = TblInternalExamsEntries.intSessionID 

	UNION ALL
	--detentions
	SELECT
		DetentionsScheduledForThatPeriod.txtSchoolID,
		DetentionsScheduledForThatPeriod.txtContactGroup,
		DetentionsScheduledForThatPeriod.txtContactGroupName,
		DetentionsScheduledForThatPeriod.dInContactDate,
		TblDisciplineManagerDetentionsPupils.txtSchoolID AS txtStudentInContactID
	FROM DetentionsScheduledForThatPeriod
	INNER JOIN TblDisciplineManagerDetentionsPupils ON DetentionsScheduledForThatPeriod.intDetentionSessionID = TblDisciplineManagerDetentionsPupils.intDetentionSessionID 
	AND DetentionsScheduledForThatPeriod.dDetentionDate = TblDisciplineManagerDetentionsPupils.dDetentionDate

	UNION ALL
	--admissions visit
	SELECT
		AdmissionsVisitsScheduledForThatPeriod.txtSchoolID,
		AdmissionsVisitsScheduledForThatPeriod.txtContactGroup,
		AdmissionsVisitsScheduledForThatPeriod.txtContactGroupName,
		AdmissionsVisitsScheduledForThatPeriod.dInContactDate,
		StudentsVisit.txtSchoolID AS txtStudentInContactID
	FROM AdmissionsVisitsScheduledForThatPeriod
	CROSS APPLY
	(
		SELECT 
		TblAdmissionsVisitsItineraryPupilsLink.txtSchoolID
		FROM TblAdmissionsVisitsItinerary
		INNER JOIN TblAdmissionsVisitsItineraryPupilsLink ON TblAdmissionsVisitsItineraryPupilsLink.intAdmissionsVisitsItineraryID = TblAdmissionsVisitsItinerary.TblAdmissionsVisitsItineraryID
		WHERE TblAdmissionsVisitsItinerary.intVisitID = AdmissionsVisitsScheduledForThatPeriod.TblAdmissionsVisitsID

		UNION

		SELECT 
		TblAdmissionsVisitsItineraryPupilGuideLink.txtSchoolID
		FROM TblAdmissionsVisitsItinerary
		INNER JOIN TblAdmissionsVisitsItineraryPupilGuideLink ON TblAdmissionsVisitsItineraryPupilGuideLink.intAdmissionsVisitsItineraryID = TblAdmissionsVisitsItinerary.TblAdmissionsVisitsItineraryID
		WHERE TblAdmissionsVisitsItinerary.intVisitID = AdmissionsVisitsScheduledForThatPeriod.TblAdmissionsVisitsID

		UNION 

		SELECT 
		TblAdmissionsVisitsPupilsLink.txtSchoolID
		FROM TblAdmissionsVisitsPupilsLink
		WHERE TblAdmissionsVisitsPupilsLink.intAdmissionsVisitsID = AdmissionsVisitsScheduledForThatPeriod.TblAdmissionsVisitsID
	) AS StudentsVisit
),

TeachersInContact AS
(
	--teaching sets
	SELECT 
		SetsStudentIn.txtSchoolID,
		SetsStudentIn.txtContactGroup,
		SetsStudentIn.txtContactGroupName,
		SetsStudentIn.dInContactDate,
		CASE WHEN TblCoverManagerCover.txtCoveredTeacher IS NOT NULL THEN TblCoverManagerCover.txtCoveredTeacher ELSE SetsStudentIn.txtTeacher END AS txtTeacher
	FROM SetsStudentIn
	LEFT OUTER JOIN TblCoverManagerCover 
		ON SetsStudentIn.TblTimetableManagerScheduleID = TblCoverManagerCover.TblTimetableManagerScheduleID
		AND SetsStudentIn.dInContactDate = Convert(date,TblCoverManagerCover.dteDate)


	UNION ALL
	-- teaching forms
	SELECT 
		FormsStudentIn.txtSchoolID,
		FormsStudentIn.txtContactGroup,
		FormsStudentIn.txtContactGroupName,
		FormsStudentIn.dInContactDate,
		CASE WHEN TblCoverManagerCover.txtCoveredTeacher IS NOT NULL THEN TblCoverManagerCover.txtCoveredTeacher ELSE FormsStudentIn.txtTeacher END AS txtTeacher
	FROM FormsStudentIn
	LEFT OUTER JOIN TblCoverManagerCover ON FormsStudentIn.TblTimetableManagerScheduleID = TblCoverManagerCover.TblTimetableManagerScheduleID

	UNION ALL
	--tutorials
	SELECT
		TutorialsScheduleForThatPeriod.txtSchoolId,
		TutorialsScheduleForThatPeriod.txtContactGroup,
		TutorialsScheduleForThatPeriod.txtContactGroupName,
		TutorialsScheduleForThatPeriod.dInContactDate,
		TblTimetableManagerTutorialsTeachers.txtTeacher
	FROM TutorialsScheduleForThatPeriod
	INNER JOIN TblTimetableManagerTutorialsTeachers ON  TutorialsScheduleForThatPeriod.TblTimetableManagerTutorialsID = TblTimetableManagerTutorialsTeachers.intTutorial
	
	UNION ALL
	--year schedule
	SELECT
		YearScheduleForThatPeriod.txtSchoolID,
		YearScheduleForThatPeriod.txtContactGroup,
		YearScheduleForThatPeriod.txtContactGroupName,
		YearScheduleForThatPeriod.dInContactDate,
		TblTimetableManagerYearSchedule.txtTeacher
	FROM YearScheduleForThatPeriod
	INNER JOIN TblTimetableManagerYearSchedule ON YearScheduleForThatPeriod.TblTimetableManagerYearScheduleID = TblTimetableManagerYearSchedule.TblTimetableManagerYearScheduleID

	UNION ALL
	--activity
	SELECT
		ActivityOccurrenceInThatPeriod.txtSchoolID,
		ActivityOccurrenceInThatPeriod.txtContactGroup,
		ActivityOccurrenceInThatPeriod.txtContactGroupName,
		ActivityOccurrenceInThatPeriod.dInContactDate,
		TblActivityManagerEventTeacherLink.txtTeacherId AS txtTeacher
	FROM ActivityOccurrenceInThatPeriod
	INNER JOIN TblActivityManagerEvent ON ActivityOccurrenceInThatPeriod.TblActivityManagerEventId = TblActivityManagerEvent.TblActivityManagerEventID
	INNER JOIN TblActivityManagerEventTeacherLink ON TblActivityManagerEvent.TblActivityManagerEventId = TblActivityManagerEventTeacherLink.intEventId 

	UNION ALL
	--medical visit
		SELECT
		MedicalVisitsForThatPeriod.txtSchoolID,
		MedicalVisitsForThatPeriod.txtContactGroup,
		MedicalVisitsForThatPeriod.txtContactGroupName,
		MedicalVisitsForThatPeriod.dInContactDate,
		MedicalVisitsForThatPeriod.txtTeacher
	FROM MedicalVisitsForThatPeriod

    UNION ALL
	--detentions
	SELECT
		DetentionsScheduledForThatPeriod.txtSchoolID,
		DetentionsScheduledForThatPeriod.txtContactGroup,
		DetentionsScheduledForThatPeriod.txtContactGroupName,
		DetentionsScheduledForThatPeriod.dInContactDate,
		TblDisciplineManagerDetentionsTeachers.txtUserCode AS txtTeacher
	FROM DetentionsScheduledForThatPeriod
	INNER JOIN TblDisciplineManagerDetentionsTeachers ON DetentionsScheduledForThatPeriod.intDetentionSessionID = TblDisciplineManagerDetentionsTeachers.intDetentionSession 
	AND DetentionsScheduledForThatPeriod.dDetentionDate = TblDisciplineManagerDetentionsTeachers.dDetentionDate

	UNION ALL
	--admissions visit
	SELECT
		AdmissionsVisitsScheduledForThatPeriod.txtSchoolID,
		AdmissionsVisitsScheduledForThatPeriod.txtContactGroup,
		AdmissionsVisitsScheduledForThatPeriod.txtContactGroupName,
		AdmissionsVisitsScheduledForThatPeriod.dInContactDate,
		StudentsVisit.txtUserCode AS txtTeacher
	FROM AdmissionsVisitsScheduledForThatPeriod
	CROSS APPLY
	(
		SELECT 
		TblAdmissionsVisitsItineraryStaffLink.txtUserCode
		FROM TblAdmissionsVisitsItinerary
		INNER JOIN TblAdmissionsVisitsItineraryStaffLink ON TblAdmissionsVisitsItineraryStaffLink.intAdmissionsVisitsItineraryID = TblAdmissionsVisitsItinerary.TblAdmissionsVisitsItineraryID
		WHERE TblAdmissionsVisitsItinerary.intVisitID = AdmissionsVisitsScheduledForThatPeriod.TblAdmissionsVisitsID

		UNION

		SELECT 
		TblAdmissionsVisitsItineraryStaffGuideLink.txtUserCode
		FROM TblAdmissionsVisitsItinerary
		INNER JOIN TblAdmissionsVisitsItineraryStaffGuideLink ON TblAdmissionsVisitsItineraryStaffGuideLink.intAdmissionsVisitsItineraryID = TblAdmissionsVisitsItinerary.TblAdmissionsVisitsItineraryID
		WHERE TblAdmissionsVisitsItinerary.intVisitID = AdmissionsVisitsScheduledForThatPeriod.TblAdmissionsVisitsID

		UNION 

		SELECT 
		TblAdmissionsVisitsStaffLink.txtUserCode
		FROM TblAdmissionsVisitsStaffLink
		WHERE TblAdmissionsVisitsStaffLink.intAdmissionsVisitsID = AdmissionsVisitsScheduledForThatPeriod.TblAdmissionsVisitsID
	) AS StudentsVisit
)

SELECT DISTINCT
	StudentsInContact.txtSchoolID,
	TblPupilManagementPupils.txtSurname,
	TblPupilManagementPupils.txtForename,
	TblSchoolManagementYears.txtYearName,
	TblPupilManagementPupils.txtForm,
	TblPupilManagementPupils.txtBoardingHouse,
	TblPupilManagementPupils.txtType AS txtStatus,
	TblPupilManagementPupils.txtAcademicHouse,
	PastoralTutor.Firstname AS txtPastoralTutorFirstname,
	PastoralTutor.Surname AS txtPastoralTutorSurname,
	StudentsInContact.dInContactDate,
	StudentsInContact.txtContactGroup,
	StudentsInContact.txtContactGroupName,
	'Student' AS txtPersonInContactWithType,
	StudentsInContact.txtStudentInContactID AS txtPersonInContactWithID,
	InContactWith.txtSurname AS txtPersonInContactWithSurname,
	InContactWith.txtForename AS txtPersonInContactWithForename,
	InContactWithYearGroup.txtYearName AS txtPersonInContactWithYearName,
	InContactWith.txtForm AS txtPersonInContactWithForm,
	InContactWith.txtBoardingHouse AS txtPersonInContactWithBoardingHouse
FROM StudentsInContact
--CROSS APPLY uf_Registration_AttendanceBetweenDates(StudentsInContact.dInContactDate,DateAdd(day,1,StudentsInContact.dInContactDate),StudentsInContact.txtStudentInContactID) AS Attendance
INNER JOIN TblRegistrationSchoolRegistrationPupils 
	ON StudentsInContact.txtStudentInContactID = TblRegistrationSchoolRegistrationPupils.txtSchoolID
	AND TblRegistrationSchoolRegistrationPupils.blnRegistered = 1 
	AND TblRegistrationSchoolRegistrationPupils.txtSubmitBy IS NOT NULL 
INNER JOIN TblRegistrationSchoolRegistrationRegister 
	ON TblRegistrationSchoolRegistrationPupils.intRegister = TblRegistrationSchoolRegistrationRegister.TblRegistrationSchoolRegistrationRegisterID
INNER JOIN TblRegistrationSchoolRegistrationDateTime 
	ON TblRegistrationSchoolRegistrationRegister.intRegistrationDateTime = TblRegistrationSchoolRegistrationDateTime.TblRegistrationSchoolRegistrationDateTimeID
	AND Convert(Date,TblRegistrationSchoolRegistrationDateTime.txtDateTime) = StudentsInContact.dInContactDate
INNER JOIN TblPupilManagementPupils ON StudentsInContact.txtSchoolID = TblPupilManagementPupils.txtSchoolID
LEFT OUTER JOIN TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear
LEFT OUTER JOIN TblStaff AS PastoralTutor ON TblPupilManagementPupils.txtTutor = PastoralTutor.User_Code
INNER JOIN TblPupilManagementPupils AS InContactWith ON StudentsInContact.txtStudentInContactID = InContactWith.txtSchoolID
LEFT OUTER JOIN TblSchoolManagementYears AS InContactWithYearGroup ON InContactWith.intNCYear = InContactWithYearGroup.intNCYear
WHERE StudentsInContact.txtSchoolID &lt;&gt; StudentsInContact.txtStudentInContactID

UNION ALL

SELECT 
	TeachersInContact.txtSchoolID,
	TblPupilManagementPupils.txtSurname,
	TblPupilManagementPupils.txtForename,
	TblSchoolManagementYears.txtYearName,
	TblPupilManagementPupils.txtForm,
	TblPupilManagementPupils.txtBoardingHouse,
	TblPupilManagementPupils.txtType AS txtStatus,
	TblPupilManagementPupils.txtAcademicHouse,
	PastoralTutor.Firstname AS txtPastoralTutorFirstname,
	PastoralTutor.Surname AS txtPastoralTutorSurname,
	TeachersInContact.dInContactDate,
	TeachersInContact.txtContactGroup,
	TeachersInContact.txtContactGroupName,
	'Staff' AS txtPersonInContactWithType,
	TeachersInContact.txtTeacher AS txtPersonInContactWithID,
	TblStaff.Surname AS txtPersonInContactWithSurname,
	TblStaff.Firstname AS txtPersonInContactWithForename,
	NULL AS txtPersonInContactWithYearName,
	NULL AS txtPersonInContactWithForm,
	NULL AS txtPersonInContactWithBoardingHouse
FROM TeachersInContact
INNER JOIN TblPupilManagementPupils ON TeachersInContact.txtSchoolID = TblPupilManagementPupils.txtSchoolID
LEFT OUTER JOIN TblSchoolManagementYears ON TblPupilManagementPupils.intNCYear = TblSchoolManagementYears.intNCYear
LEFT OUTER JOIN TblStaff AS PastoralTutor ON TblPupilManagementPupils.txtTutor = PastoralTutor.User_Code
INNER JOIN TblStaff ON TeachersInContact.txtTeacher = TblStaff.User_Code

</CommandText></Query><Fields><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtYearName"><DataField>txtYearName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtStatus"><DataField>txtStatus</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="dInContactDate"><DataField>dInContactDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="txtAcademicHouse"><DataField>txtAcademicHouse</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtContactGroup"><DataField>txtContactGroup</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPastoralTutorFirstname"><DataField>txtPastoralTutorFirstname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtContactGroupName"><DataField>txtContactGroupName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPersonInContactWithType"><DataField>txtPersonInContactWithType</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPastoralTutorSurname"><DataField>txtPastoralTutorSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPersonInContactWithID"><DataField>txtPersonInContactWithID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPersonInContactWithSurname"><DataField>txtPersonInContactWithSurname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="txtPersonInContactWithForename"><DataField>txtP