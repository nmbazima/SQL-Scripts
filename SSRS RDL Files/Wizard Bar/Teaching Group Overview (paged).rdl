extRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow></TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup><KeepTogether>true</KeepTogether></TablixMember><TablixMember><KeepWithGroup>Before</KeepWithGroup><KeepTogether>true</KeepTogether></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>Pupils</DataSetName><Top>1.6176cm</Top><Left>3cm</Left><Height>1.25001cm</Height><Width>15cm</Width><ZIndex>1</ZIndex><Visibility><Hidden>=IIF((Count(Fields!txtSchoolID.Value) &gt; 0), true, false)</Hidden></Visibility><DataElementOutput>NoOutput</DataElementOutput><Style /></Tablix></ReportItems><Height>4.6175cm</Height><Style /></Body><ReportParameters><ReportParameter Name="SetID"><DataType>Integer</DataType><Nullable>true</Nullable><Prompt>SetID</Prompt><ValidValues><DataSetReference><DataSetName>Sets</DataSetName><ValueField>TblTeachingManagerSetsID</ValueField><LabelField>txtSetCode</LabelField></DataSetReference></ValidValues></ReportParameter><ReportParameter Name="FormID"><DataType>Integer</DataType><Nullable>true</Nullable><Prompt>FormID</Prompt><ValidValues><DataSetReference><DataSetName>Forms</DataSetName><ValueField>TblTeachingManagerSubjectFormsId</ValueField><LabelField>txtForm</LabelField></DataSetReference></ValidValues></ReportParameter></ReportParameters><Code>function GetValue(value as string, def as string) as string

if value is nothing then
  return def
else
  return value
end if

end function



function GetPupilImage(value as string, server as string) as string

if value is nothing then
  return server &amp; "/system/images/general/photo_portrait.gif" 
else
  return server &amp; "/" &amp; value
end if

end function



function GetSENFlagImage(value as string, server as string) as string

  dim result as string = server &amp; "/system/images/16/"

  select case value
    case "1" 
	result = result &amp; "star_grey.gif"
    case "2" 
	result = result &amp; "star_yellow.gif"    
    case "3" 
	result = result &amp; "star_red.gif"    
    case "4" 
	result = result &amp; "star_blue.gif"      
  end select

  return result

end function</Code><Width>21cm</Width><Page><PageFooter><Height>1.99cm</Height><PrintOnFirstPage>true</PrintOnFirstPage><PrintOnLastPage>true</PrintOnLastPage><ReportItems><Rectangle Name="Rectangle3"><ReportItems><Textbox Name="txtFooter_PrintBy"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=" Printed on " + Globals!ExecutionTime.ToString()</Value><Style><FontFamily>Tahoma</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Top>0.37722cm</Top><Left>7.58629cm</Left><Height>0.5cm</Height><Width>11.69769cm</Width><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><Textbox Name="txtFooter_TimeTaken"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Execution Time: " +
