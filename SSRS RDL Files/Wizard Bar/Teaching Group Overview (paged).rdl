<?xml version="1.0" encoding="utf-8"?><Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"><DataSources><DataSource Name="iSAMS"><DataSourceReference>iSAMS</DataSourceReference><rd:DataSourceID xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">b61d9389-5b9f-4dcb-b07f-70c96d81eed9</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="Sets"><Fields><Field Name="TblTeachingManagerSetsID"><DataField>TblTeachingManagerSetsID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtSetCode"><DataField>txtSetCode</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intCustomOrder"><DataField>intCustomOrder</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtSubjectName"><DataField>txtSubjectName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intYear"><DataField>intYear</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtSetNumber"><DataField>txtSetNumber</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field></Fields><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT        0 AS intOrder, NULL AS TblTeachingManagerSetsID, 'None' AS txtSetCode, 0 AS intCustomOrder, '' AS txtSubjectName, 0 AS intYear, '' AS txtSetNumber
UNION ALL
SELECT        1 AS intOrder, sets.TblTeachingManagerSetsID, sets.txtSetCode, subject.intCustomOrder, subject.txtSubjectName, sets.intYear, sets.txtSetNumber
FROM            TblTeachingManagerSets AS sets INNER JOIN
                         TblTeachingManagerSubjects AS subject ON sets.intSubject = subject.TblTeachingManagerSubjectsID
WHERE        (ISNULL(sets.intHideSet, 0) &lt;&gt; 1) AND (ISNULL(subject.intHidden, 0) &lt;&gt; 1) AND (subject.intActive = 1)
ORDER BY intOrder, intCustomOrder, txtSubjectName, intYear, txtSetNumber, txtSetCode</CommandText></Query></DataSet><DataSet Name="Pupils"><Fields><Field Name="txtForename"><DataField>txtForename</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="GroupCode"><DataField>GroupCode</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="GroupName"><DataField>GroupName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtSchoolID"><DataField>txtSchoolID</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="GroupSubjectCode"><DataField>GroupSubjectCode</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="GroupSubjectName"><DataField>GroupSubjectName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtSurname"><DataField>txtSurname</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="GroupSubjectReportName"><DataField>GroupSubjectReportName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="GroupTeacher"><DataField>GroupTeacher</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="GroupYear"><DataField>GroupYear</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtPrename"><DataField>txtPreName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="GroupYearCode"><DataField>GroupYearCode</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtGender"><DataField>txtGender</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intNCYear"><DataField>intNCYear</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtYearCode"><DataField>txtYearCode</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtBoardingHouse"><DataField>txtBoardingHouse</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="txtPupilPicturePath"><DataField>txtPupilPicturePath</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="HasSENInfo"><DataField>HasSENInfo</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="intSENFlag"><DataField>intSENFlag</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtNotes"><DataField>txtNotes</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="SenFlagTitle"><DataField>SenFlagTitle</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field></Fields><Query><DataSourceName>iSAMS</DataSourceName><CommandText>;WITH senflags AS (
	SELECT txtMildFlag, txtMediumFlag, txtSevereFlag, txtMonitorFlag
	FROM TblSENManagerConfiguration
), groupDetails as
(
	SELECT        
	sets.txtSetCode as [GroupCode], 
	sets.txtName as [GroupName], 
	subject.txtSubjectCode as [GroupSubjectCode], 
	subject.txtSubjectName as [GroupSubjectName], 
	subject.txtSubjectReportName as [GroupSubjectReportName], 
	staff.Salutation as [GroupTeacher], 
	sets.intYear as [GroupYear], 
	setyear.txtYearCode as [GroupYearCode], 
	setlist.txtSchoolID 

	FROM TblTeachingManagerSets AS sets 
	INNER JOIN TblTeachingManagerSubjects AS subject ON sets.intSubject = subject.TblTeachingManagerSubjectsID 
	LEFT OUTER JOIN TblSchoolManagementYears AS setyear ON sets.intYear = setyear.intNCYear 
	LEFT OUTER JOIN TblStaff AS staff ON sets.txtTeacher = staff.User_Code 
	INNER JOIN TblTeachingManagerSetLists AS setlist ON sets.TblTeachingManagerSetsID = setlist.intSetID 

	WHERE sets.TblTeachingManagerSetsID = @SetID
	
	UNION ALL
	
	SELECT        	
	forms.txtTimetableCode as [GroupCode], 
	forms.txtForm as [GroupName], 
	subject.txtSubjectCode as [GroupSubjectCode], 
	subject.txtSubjectName as [GroupSubjectName], 
	subject.txtSubjectReportName as [GroupSubjectReportName], 
	staff.Salutation as [GroupTeacher], 
	pupils.intNCYear as [GroupYear], 
	formyear.txtYearCode as [GroupYearCode], 
	pupils.txtSchoolID 

	FROM TblTeachingManagerSubjectForms AS forms 
	INNER JOIN TblTeachingManagerSubjects AS subject ON forms.intSubject = subject.TblTeachingManagerSubjectsID 
	LEFT OUTER JOIN TblStaff AS staff ON forms.txtTeacher = staff.User_Code 
	INNER JOIN TblPupilManagementPupils AS pupils ON forms.txtForm = pupils.txtForm 
	LEFT OUTER JOIN TblSchoolManagementYears AS formyear ON pupils.intNCYear = formyear.intNCYear 

	WHERE forms.TblTeachingManagerSubjectFormsId = @FormID		
)
    
SELECT        
groupDetails.*, 
pupil.txtForename, 
pupil.txtSurname, 
pupil.txtPreName, 
pupil.txtGender, 
pupil.intNCYear, year.txtYearCode, pupil.txtForm, pupil.txtBoardingHouse,
(
	SELECT TOP(1) txtPath
	FROM TblPupilManagementPictures
	WHERE (txtSchoolID = pupil.txtSchoolID)
	ORDER BY intOrder DESC
) AS txtPupilPicturePath, 
CASE WHEN IsNull(sen.intSENFlag, 0) &gt; 0 OR IsNull(CAST(sen.txtNotes AS nvarchar(MAX)), '') &lt;&gt; '' THEN 1 ELSE 0 END AS HasSENInfo, 
sen.intSENFlag, 
CASE 
	WHEN sen.intSENFlag = 1 THEN (SELECT txtMildFlag FROM senflags) 
	WHEN sen.intSENFlag = 2 THEN (SELECT txtMediumFlag FROM senflags) 
	WHEN sen.intSENFlag = 3 THEN (SELECT txtSevereFlag FROM senflags) 
	WHEN sen.intSENFlag = 4 THEN (SELECT txtMonitorFlag	FROM senflags) 
	ELSE NULL 
END AS SenFlagTitle, 
sen.txtNotes

FROM groupDetails 
INNER JOIN TblPupilManagementPupils AS pupil ON groupDetails.txtSchoolID = pupil.txtSchoolID 
INNER JOIN TblSchoolManagementYears AS year ON pupil.intNCYear = year.intNCYear 
LEFT OUTER JOIN TblSENManagerRegister AS sen ON pupil.txtSchoolID = sen.txtSchoolID

ORDER BY pupil.txtSurname, pupil.txtForename, pupil.txtSchoolID</CommandText><QueryParameters><QueryParameter Name="@SetID"><Value>=Parameters!SetID.Value</Value></QueryParameter><QueryParameter Name="@FormID"><Value>=Parameters!FormID.Value</Value></QueryParameter></QueryParameters></Query></DataSet><DataSet Name="Server"><Fields><Field Name="txtInternaliSAMSAddress"><DataField>txtInternaliSAMSAddress</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field></Fields><Query><DataSourceName>iSAMS</DataSourceName><CommandText>SELECT txtInternaliSAMSAddress
FROM TbliSAMSManagerSettings</CommandText></Query></DataSet><DataSet Name="Forms"><Fields><Field Name="TblTeachingManagerSubjectFormsId"><DataField>TblTeachingManagerSubjectFormsId</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="intOrder"><DataField>intOrder</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtForm"><DataField>txtForm</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field><Field Name="intCustomOrder"><DataField>intCustomOrder</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.Int32</rd:TypeName></Field><Field Name="txtSubjectName"><DataField>txtSubjectName</DataField><rd:TypeName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">System.String</rd:TypeName></Field></Fields><Query><DataSourceName>iSAMS</DataSourceName><CommandText>if @SetID is null
begin

select 0 as intOrder, NULL as TblTeachingManagerSubjectFormsId, 'None' as txtForm, 0 as intCustomOrder, '' as txtSubjectName

union all 

select 1 as intOrder, forms.TblTeachingManagerSubjectFormsId,
forms.txtForm + ' (' + forms.txtTimetableCode + ')' as txtForm,
subject.intCustomOrder, subject.txtSubjectName

from TblTeachingManagerSubjectForms forms
inner join tblTeachingManagerSubjects subject on forms.intSubject = subject.tblTeachingManagerSubjectsId

order by intOrder, intCustomOrder, txtSubjectName, txtForm

end
else

select NULL as TblTeachingManagerSubjectFormsId, 'Please deselect set' as txtForm</CommandText><QueryParameters><QueryParameter Name="@SetID"><Value>=Parameters!SetID.Value</Value></QueryParameter></QueryParameters><rd:UseGenericDesigner xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">true</rd:UseGenericDesigner></Query></DataSet></DataSets><Body><ReportItems><Tablix Name="tbl_Main"><TablixBody><TablixColumns><TablixColumn><Width>0.3899in</Width></TablixColumn><TablixColumn><Width>2.70132in</Width></TablixColumn><TablixColumn><Width>1.20995in</Width></TablixColumn><TablixColumn><Width>1.20994in</Width></TablixColumn><TablixColumn><Width>1.20994in</Width></TablixColumn><TablixColumn><Width>0.87106in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.95021in</Height><TablixCells><TablixCell><CellContents><Tablix Name="tbl_ReportTitle"><TablixBody><TablixColumns><TablixColumn><Width>2.03295in</Width></TablixColumn><TablixColumn><Width>1.61206in</Width></TablixColumn><TablixColumn><Width>1.45966in</Width></TablixColumn><TablixColumn><Width>2.48744in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.39903in</Height><TablixCells><TablixCell><CellContents><Textbox Name="lbl_ReportTitle"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Teaching Group Overview</Value><Style><FontSize>16pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Style>Solid</Style></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox><ColSpan>3</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell /><TablixCell><CellContents><Textbox Name="lbl_SetCode"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!GroupCode.Value, "Pupils")</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><BottomBorder><Style>Solid</Style></BottomBorder><VerticalAlign>Top</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.27559in</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox18"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Code:</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox32"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Code.GetValue(First(Fields!GroupCode.Value, "Pupils"), "-")</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">Textbox32</rd:DefaultName><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox25"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Subject:</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">Textbox25</rd:DefaultName><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="Textbox19"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Code.GetValue(First(Fields!GroupSubjectReportName.Value, "Pupils"), First(Fields!GroupSubjectName.Value, "Pupils")) &amp; " (" &amp; Code.GetValue(First(Fields!GroupSubjectCode.Value, "Pupils"),"-") &amp; ")"</Value><Style /></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">Textbox19</rd:DefaultName><Style><Border><Style>None</Style></Border><VerticalAlign>Middle</VerticalAlign><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow><TablixRow><Height>0.27559in</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox20"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Teacher:</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><LeftIndent>0cm</LeftIndent><HangingIndent>0cm</HangingIndent><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">Textbox20</rd:DefaultName><Style><Border><Style>None</Style></Border><BottomBorder><Color>Black</Color><Style>Solid</Style><Width>1pt</Width></BottomBorder><VerticalAlign>Middle</VerticalAlign><Paddin